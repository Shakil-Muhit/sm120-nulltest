   123	            [ -s "${base}_${rep}.csv" ] || { echo "    MISSING export: ${base}_${rep}.csv"; missing=1; }
   124	        done
   125	        python3 -c "import json;json.dump({'complete': $(( 1 - missing )) == 1, 'graph_trace_mode': '$gmode'}, open('${base}_exports.json','w'))"
   126	    fi
   127	    return 0
   128	}
