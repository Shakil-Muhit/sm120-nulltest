    67	
    68	def _db(num, den):
    69	    """Registered semantics: num>0, den==0 -> 'inf' (perfect match);
    70	    num==0 -> 'undefined' (zero reference/projection); non-finite inputs ->
    71	    'undefined'; else a float."""
    72	    if not (math.isfinite(num) and math.isfinite(den)):
    73	        return 'undefined'
    74	    if num == 0:
    75	        return 'undefined'
    76	    if den == 0:
    77	        return 'inf'
    78	    return float(10 * math.log10(num / den))
    79	
    80	
    81	def sdr_db(ref, est):
    82	    ref = ref.reshape(-1).double()
    83	    est = est.reshape(-1).double()
    84	    return _db(float((ref ** 2).sum()), float(((ref - est) ** 2).sum()))
    85	
    86	
    87	def si_sdr_db(ref, est):
    88	    ref = ref.reshape(-1).double()
    89	    est = est.reshape(-1).double()
    90	    ref = ref - ref.mean()
    91	    est = est - est.mean()
    92	    rr = float((ref ** 2).sum())
    93	    if rr == 0:
    94	        return 'undefined'
    95	    s = (est * ref).sum() / rr * ref
    96	    return _db(float((s ** 2).sum()), float(((est - s) ** 2).sum()))
    97	
    98	
    99	def _mean_with_inf(values):
   100	    finite = [v for v in values if isinstance(v, float)]
   101	    n_inf = sum(1 for v in values if v == 'inf')
   102	    n_undef = sum(1 for v in values if v == 'undefined')
   103	    return {'mean_finite_db': float(np.mean(finite)) if finite else None,
   104	            'n_finite': len(finite), 'n_inf': n_inf, 'n_undefined': n_undef}
   105	
   106	
   107	def a_output_path(ref_dir, chunk, index):
   108	    return os.path.join(ref_dir, f'sdr_A_c{chunk}_clip{index:02d}.pt')
   109	
   110	
   111	def separate_clip(step, ctx, mixture, chunk):
   112	    """Non-overlapping chunked processing + concatenation (registered policy)."""
   113	    assert CLIP_SAMPLES % chunk == 0, (CLIP_SAMPLES, chunk)
   114	    outs = []
   115	    with torch.no_grad(), ctx():
   116	        for i in range(CLIP_SAMPLES // chunk):
   117	            x = mixture[:, i * chunk:(i + 1) * chunk].unsqueeze(0).cuda()
   118	            out = step(x)
   119	            torch.cuda.synchronize()
   120	            out = out.float().clone()            # borrowed replay buffer -> owned
   121	            if out.dim() == 3:
   122	                out = out[0]
   123	            assert out.shape == (2, chunk), tuple(out.shape)
   124	            outs.append(out.cpu())
   125	    return torch.cat(outs, dim=-1)
   126	
   127	
   128	def run_gate(step, ctx, clips, ref_dir, chunk, save_reference=False, manifest_id=None):
   129	    import provenance
   130	    rows = []
   131	    for c in clips:
   132	        est = separate_clip(step, ctx, c['mixture'], chunk)
   133	        vocals = c['vocals']
   134	        row = {'index': c['index'], 'track': c['track'],
   135	               'sdr_ref_db': sdr_db(vocals, est),
   136	               'si_sdr_ref_db': si_sdr_db(vocals, est),
   137	               'finite': bool(torch.isfinite(est).all())}
   138	        path = a_output_path(ref_dir, chunk, c['index'])
   139	        if save_reference:
   140	            os.makedirs(ref_dir, exist_ok=True)
   141	            torch.save(est, path)
   142	            if manifest_id is not None:
   143	                provenance.bind_artifact(path, manifest_id)
   144	            row['saved'] = path
   145	        else:
   146	            if not os.path.exists(path):
   147	                raise FileNotFoundError(f'eager-A clip output missing: {path}')
   148	            if manifest_id is not None:
   149	                provenance.check_artifact(path, manifest_id)
   150	            a_out = torch.load(path, weights_only=True)
   151	            row['sdr_ref_A_db'] = sdr_db(vocals, a_out)
   152	            d = (row['sdr_ref_db'] - row['sdr_ref_A_db']
   153	                 if isinstance(row['sdr_ref_db'], float) and isinstance(row['sdr_ref_A_db'], float)
   154	                 else None)
   155	            row['delta_sdr_ref_db'] = d
   156	            row['sdr_vs_A_db'] = sdr_db(a_out, est)
   157	            row['si_sdr_vs_A_db'] = si_sdr_db(a_out, est)
   158	            row['max_abs_diff_vs_A'] = float((a_out - est).abs().max())
   159	        rows.append(row)
   160	    rec = {'clips': rows, 'operating_point': chunk,
   161	           'chunks_per_clip': CLIP_SAMPLES // chunk,
   162	           'reconstruction': 'non-overlapping concatenation',
   163	           'threshold_mean_delta_sdr_db': THRESHOLD_DB, 'n_clips': len(rows)}
   164	    rec['sdr_ref_summary'] = _mean_with_inf([r['sdr_ref_db'] for r in rows])
   165	    rec['mean_sdr_ref_db'] = rec['sdr_ref_summary']['mean_finite_db']
   166	    if save_reference:
   167	        rec['status'] = 'REFERENCE_SAVED'
   168	        return rec
   169	    # the gate uses the SDR_ref terms only: both arm and A must be finite
   170	    deltas = [r['delta_sdr_ref_db'] for r in rows]
   171	    if any(d is None for d in deltas):
   172	        rec['status'] = 'FAIL'
   173	        rec['reason'] = ('a paired SDR_ref term is non-finite ("inf" = perfect match to the '
   174	                         'reference stem, "undefined" = zero reference) — not gateable')
   175	        return rec
   176	    rec['mean_delta_sdr_ref_db'] = float(np.mean(deltas))
   177	    rec['min_delta_sdr_ref_db'] = float(np.min(deltas))
   178	    # output fidelity vs A: infinities are expected for A itself and are kept
   179	    rec['sdr_vs_A_summary'] = _mean_with_inf([r['sdr_vs_A_db'] for r in rows])
   180	    rec['all_finite'] = all(r['finite'] for r in rows)
   181	    rec['status'] = ('PASS' if rec['all_finite'] and
   182	                     rec['mean_delta_sdr_ref_db'] >= THRESHOLD_DB else 'FAIL')
   183	    return rec

