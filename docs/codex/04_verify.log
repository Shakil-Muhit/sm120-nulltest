    58	def perturbation(evidence):
    59	    out = {}
    60	    for path in glob.glob(os.path.join(evidence, 'full_*_pert_unprofiled.json')):
    61	        base = j(path)
    62	        arm, chunk = base['arm'], base['chunk']
    63	        rec = {'unprofiled_block_ms': block_median(base), 'status': 'ok', 'problems': []}
    64	        q = _qualified(base)
    65	        if q:
    66	            rec['problems'].append(f'unprofiled: {q}')
    67	        for mode in ('graph', 'node'):
    68	            p = os.path.join(evidence, f'full_{arm}_c{chunk}_pert_{mode}.json')
    69	            r = j(p) if os.path.exists(p) else None
    70	            q = _qualified(r)
    71	            if q:
    72	                rec['problems'].append(f'{mode}: {q}')
    73	                rec[f'{mode}_block_ms'] = block_median(r) if r else None
    74	                rec[f'{mode}_over_unprofiled'] = None
    75	                continue
    76	            if r.get('manifest_id') != base.get('manifest_id') or r.get('effective_variant') != base.get('effective_variant'):
    77	                rec['problems'].append(f'{mode}: manifest/variant differs from the unprofiled run')
    78	                rec[f'{mode}_over_unprofiled'] = None
    79	                continue
    80	            m = block_median(r)
    81	            rec[f'{mode}_block_ms'] = m
    82	            rec[f'{mode}_over_unprofiled'] = m / rec['unprofiled_block_ms'] if (m and rec['unprofiled_block_ms']) else None
    83	        if rec['problems'] or rec.get('node_over_unprofiled') is None:
    84	            rec['status'] = 'UNRESOLVED'
    85	            rec['caveat_required'] = 'UNRESOLVED'
    86	        else:
    87	            rec['caveat_required'] = rec['node_over_unprofiled'] > 1.05
    88	        rec['inflation_factor_node'] = rec.get('node_over_unprofiled')
    89	        out[f'{arm}_{chunk}'] = rec
    90	    return out
    91	
