    60	def joint_settle(built, arms, rounds=2, passes=3):
    61	    """Alternate the two steps. The recording state is snapshotted BEFORE the
    62	    first round and after every round; stable iff unchanged across ALL rounds
    63	    (a re-recording of the arm built first shows up in round 1), and no new
    64	    graph breaks / unimplemented ops appear at any point."""
    65	    snaps = [tm.recording_state()]
    66	    for r in range(rounds + 1):
    67	        for arm in arms:
    68	            b = built[arm]
    69	            with torch.no_grad(), b['ctx']():
    70	                for _ in range(passes):
    71	                    b['step'](b['x'])
    72	        torch.cuda.synchronize()
    73	        snaps.append(tm.recording_state())
    74	    verdicts = [tm.recording_stable(a, c) for a, c in zip(snaps, snaps[1:])]
    75	    breaks = [sum(x['counters'].get('graph_break', {}).values()) +
    76	              sum(x['counters'].get('unimplemented', {}).values()) for x in snaps]
    77	    return {'stable': (None if any(v is None for v in verdicts) else all(verdicts)),
    78	            'new_breaks_during_joint_settle': breaks[-1] - breaks[0],
    79	            'rounds': rounds, 'snapshots': snaps}
