   117	def time_chain(launch, n, capture, label):
   118	    for _ in range(WARMUP):
   119	        launch()
   120	    torch.cuda.synchronize()
   121	    graph = None
   122	    if capture:
   123	        s = torch.cuda.Stream()
   124	        s.wait_stream(torch.cuda.current_stream())
   125	        with torch.cuda.stream(s):
   126	            launch()
   127	        torch.cuda.current_stream().wait_stream(s)
   128	        torch.cuda.synchronize()
   129	        graph = torch.cuda.CUDAGraph()
   130	        with torch.cuda.graph(graph):
   131	            launch()
   132	        graph.replay()
   133	        torch.cuda.synchronize()
   134	    times = []
   135	    torch.cuda.nvtx.range_push(label)
   136	    for _ in range(REPEATS):
   137	        e0 = torch.cuda.Event(enable_timing=True)
   138	        e1 = torch.cuda.Event(enable_timing=True)
   139	        e0.record()
   140	        if graph is not None:
   141	            graph.replay()
   142	        else:
   143	            launch()
   144	        e1.record()
   145	        torch.cuda.synchronize()
   146	        times.append(e0.elapsed_time(e1) * 1e3)      # us
   147	    torch.cuda.nvtx.range_pop()
   148	    return {'chain_us_median': statistics.median(times),
   149	            'chain_us_min': min(times), 'chain_us_max': max(times),
   150	            'per_launch_us': statistics.median(times) / n, 'n': n, 'repeats': REPEATS}
   151	
   152	
   153	def fit(points):
   154	    """least squares T = a + b*N over (N, T_median) points"""
   155	    if len(points) < 2:
   156	        return None
   157	    xs = [p[0] for p in points]
   158	    ys = [p[1] for p in points]
   159	    mx, my = sum(xs) / len(xs), sum(ys) / len(ys)
   160	    sxx = sum((x - mx) ** 2 for x in xs)
   161	    b = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / sxx if sxx else None
   162	    return {'slope_us_per_node': b, 'intercept_us': (my - b * mx) if b is not None else None,
   163	            'points': points}
   164	
   165	
   166	def analyze_trace(base, out, traced_json=None):
   167	    """Per NVTX chain segment: kernel durations and serial inter-kernel gaps.
   168	    Joined with the traced run's own JSON (gate-03 f40): a segment is only
   169	    accepted when its case status is 'ok' (dependency proof + PTX passed) and
   170	    the segment holds exactly N x REPEATS kernels; else UNRESOLVED."""
   171	    cases = {}
   172	    if traced_json and os.path.exists(traced_json):
   173	        cases = json.load(open(traced_json)).get('chains', {})
   174	    def read(path):
   175	        with open(path, newline='') as f:
   176	            rows = list(csv.reader(f))
   177	        return rows[0], rows[1:]
   178	    head, rows = read(base + '_cuda_gpu_trace.csv')
   179	    c_s = next(i for i, h in enumerate(head) if 'Start' in h)
   180	    c_d = next(i for i, h in enumerate(head) if 'Duration' in h)
   181	    c_n = next(i for i, h in enumerate(head) if h.strip().strip('"') == 'Name')
   182	    kern = []
   183	    for r in rows:
   184	        try:
   185	            kern.append((int(float(r[c_s].replace(',', ''))), int(float(r[c_d].replace(',', ''))), r[c_n]))
   186	        except (ValueError, IndexError):
   187	            continue
   188	    kern.sort()
   189	    head, rows = read(base + '_nvtx_gpu_proj_trace.csv')
   190	    c_name = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Name', 'Range'))
   191	    c_start = next(i for i, h in enumerate(head) if 'Start' in h)
   192	    c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
   193	    segs = {}
   194	    for r in rows:
   195	        nm = r[c_name].strip().strip('"').split(':')[-1]
   196	        if '/' not in nm:
   197	            continue
   198	        try:
   199	            s = int(float(r[c_start].replace(',', '')))
   200	            d = int(float(r[c_dur].replace(',', '')))
   201	        except ValueError:
   202	            continue
   203	        segs[nm] = (s, s + d)
   204	    res = {}
   205	    for nm, (s, e) in segs.items():
   206	        ks = [k for k in kern if s <= k[0] < e]
   207	        case = cases.get(nm)
   208	        n = int(nm.rsplit('N', 1)[1]) if 'N' in nm else None
   209	        expected = n * REPEATS if n else None
   210	        if case is not None and case.get('status') != 'ok':
   211	            res[nm] = {'kernels': len(ks), 'status': f"UNRESOLVED: case status {case.get('status')}"}
   212	            continue
   213	        if expected is not None and len(ks) != expected:
   214	            res[nm] = {'kernels': len(ks), 'expected_kernels': expected,
   215	                       'status': 'UNRESOLVED: kernel count != N x REPEATS'}
   216	            continue
   217	        if len(ks) < 2:
   218	            res[nm] = {'kernels': len(ks), 'status': 'UNRESOLVED: too few kernels in range'}
   219	            continue
   220	        durs = [k[1] for k in ks]
   221	        gaps = [ks[i + 1][0] - (ks[i][0] + ks[i][1]) for i in range(len(ks) - 1)]
   222	        res[nm] = {'kernels': len(ks), 'expected_kernels': expected, 'status': 'ok',
   223	                   'case_status': (case or {}).get('status'),
   224	                   'kernel_us_median': statistics.median(durs) / 1e3,
   225	                   'gap_us_median': statistics.median(gaps) / 1e3,
   226	                   'gap_us_min': min(gaps) / 1e3, 'gap_us_max': max(gaps) / 1e3,
   227	                   'negative_gap_fraction': sum(1 for g in gaps if g < 0) / len(gaps),
   228	                   'note': ('overlapping kernels (PDL): gap is not a boundary estimate'
   229	                            if 'pdl' in nm else 'serial gap = boundary estimate for this mode')}
   230	    with open(out, 'w') as f:
   231	        json.dump(res, f, indent=1)
   232	    for nm, r in sorted(res.items()):
   233	        if 'gap_us_median' in r:
   234	            print(f"[boundary/trace] {nm}: kernel {r['kernel_us_median']:.3f} us, gap {r['gap_us_median']:.3f} us "
   235	                  f"({r['kernels']} kernels)")
   236	    print(f'-> {out}')
   237	
