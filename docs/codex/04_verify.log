   309	                               footprint=v['footprint']).get('ideal_us_l2') for v in vals]
   310	                row.update(flops_per_pass=0.0, bytes_per_pass=by, ideal_us_hbm=hbm,
   311	                           ideal_us_l2=(sum(l2) if all(x is not None for x in l2) else None),
   312	                           resolution='wrapper access bytes, per-call ideals summed '
   313	                                      '(zero-FLOP pricing: registered deviation for fused pointwise/reduction kernels)')
   314	                if hbm > row['time_us_per_pass']:
   315	                    row['bound_not_tight'] = ('HBM-model ideal exceeds the measured time: the byte '
   316	                                              'footprint over-counts (slice reads) and/or L2 absorbed '
   317	                                              'traffic; recoverable share under the HBM model = 0')
   318	                row['recoverable_share_hbm_model'] = max(0.0, 1.0 - hbm / row['time_us_per_pass']) if row['time_us_per_pass'] else None
   319	            else:
   320	                row['resolution'] = 'UNRESOLVED: an access/dtype/shape could not be resolved'
   321	        elif cls == 'SDPA':
