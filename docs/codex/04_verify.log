   130	# bounded auxiliary command: run_aux NAME CAP -- cmd...   (supervisor messages
   131	# go to STDERR so a redirected stdout stays clean; a terminal JSON records
   132	# the outcome either way)
   133	aux_json() {   # name status reason
   134	    python3 -c "import json,sys;json.dump({'item':sys.argv[1],'status':sys.argv[2],'reason':sys.argv[3]},open('$EVID/aux_'+sys.argv[1]+'.json','w'))" "$1" "$2" "$3"
   135	}
   136	run_aux() {
   137	    local name="$1" want="$2"; shift 2; [ "$1" = "--" ] && shift
   138	    local cap; cap=$(cap_for "$want")
   139	    if [ "$cap" -lt 60 ]; then
   140	        echo "--- $name: DEADLINE -> skipped (UNTESTED) ---" >&2
   141	        aux_json "$name" UNTESTED "session deadline"; return 1
   142	    fi
   143	    echo "--- $name $(date -Is) cap=${cap}s ---" >&2
   144	    timeout -k 30 "$cap" "$@"; local rc=$?
   145	    if [ "$rc" = "0" ]; then aux_json "$name" OK ""; else
   146	        echo "    $name exit $rc" >&2
   147	        aux_json "$name" $([ "$rc" = "124" ] && echo UNTESTED || echo FAILED) "exit $rc"
   148	    fi
   149	    return $rc
   150	}
   151	
   152	clocks_start() {   # file
   153	    nvidia-smi --query-gpu=timestamp,uuid,clocks.sm,clocks.mem,power.draw,temperature.gpu,utilization.gpu \
   154	        --format=csv,noheader -l 1 > "$1" 2>/dev/null &
   155	    CLK_PID=$!
   156	    trap 'kill $CLK_PID 2>/dev/null' EXIT
   157	}
     1	#!/bin/bash
     2	# SESSION 1 (prereg_amendments.md §5) — the full-model arm matrix, unprofiled.
     3	#   [0] preflight: nsys, deps, clip pack, provenance + SESSION MANIFEST,
     4	#       clock sampler (timestamp+uuid), session deadline clock
     5	#   [1] eager-A references at both operating points (validation refs + SDR
     6	#       clip outputs under the registered chunked policy)
     7	#   [2] planted-fault validator checks: tight (+1e-3) and loose (+5e-2) —
     8	#       both MUST FAIL; a PASS aborts the session
