    47	def read_kern_sum(path):
    48	    with open(path, newline='') as f:
    49	        rd = csv.reader(f)
    50	        head = next(rd)
    51	        c_t = next(i for i, h in enumerate(head) if 'Total Time' in h)
    52	        c_i = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Instances', 'Kern Inst') or 'Instances' in h)
    53	        c_n = next(i for i, h in enumerate(head) if h.strip().strip('"') == 'Name')
    54	        out = {}
    55	        for r in rd:
    56	            try:
    57	                out[r[c_n]] = {'total_ns': int(float(r[c_t].replace(',', ''))),
    58	                               'instances': int(float(r[c_i].replace(',', '')))}
    59	            except (ValueError, IndexError):
    60	                continue
    61	    return out
