   336	def refined_access(k, role):
   337	    """(reads, writes, unresolved) for a param role, derived from the kernel
   338	    SOURCE (gate-04 f32): in_out_ptr reads iff a tl.load on it exists and
   339	    writes iff a tl.store exists; neither found -> unresolved (charged
   340	    conservatively as read+write, and the site is flagged)."""
   341	    if role.startswith('in_out_ptr'):
   342	        r = role in k.get('loads_present', k.get('load_exprs', {}))
   343	        w = role in k.get('stores_present', k.get('store_exprs', {}))
   344	        return (r, w, not (r or w))
   345	    if role.startswith('in_ptr'):
   346	        return (True, False, role not in k.get('loads_present', k.get('load_exprs', {})))
   347	    if role.startswith('out_ptr'):
   348	        return (False, True, role not in k.get('stores_present', k.get('store_exprs', {})))
   349	    return (False, False, True)
