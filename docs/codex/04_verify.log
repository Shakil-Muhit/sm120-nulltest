   105	        --capture-range-end=stop --cuda-graph-trace="$gmode" --force-overwrite=true \
   106	        -o "$base" python "$RUN" --arm "$arm" --chunk "$chunk" --tag "$tag" \
   107	        --iters "$ITERS" --repeats 1 --nvtx-pass --clips-dir "$CLIPS_DIR" --evidence-dir "$EVID" "$@" \
   108	        2> "$EVID/torchlogs_${arm}_${chunk}_${tag}.log"
   109	    local rc=$?
   110	    if [ "$rc" != "0" ]; then
   111	        echo "    trace run exit $rc"
   112	        [ -s "$path" ] || terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "trace run exit $rc"
   113	        return 1
   114	    fi
   115	    [ -s "$base.nsys-rep" ] || { echo "    no .nsys-rep"; return 1; }
   116	    if [ "$gmode" = "node" ]; then
   117	        nsys stats --force-export=true --force-overwrite=true --format csv \
   118	            --report cuda_gpu_trace --report cuda_gpu_kern_sum --report cuda_api_trace \
   119	            --report nvtx_gpu_proj_trace --report nvtx_gpu_proj_sum \
   120	            --output "$base" "$base.nsys-rep" > /dev/null 2>&1 || echo "    WARN: some exports failed for $base"
