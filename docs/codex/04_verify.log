    93	def boundary_perturbation(evidence):
    94	    a, b = (os.path.join(evidence, 'boundary_bench.json'), os.path.join(evidence, 'boundary_bench_traced.json'))
    95	    if not (os.path.exists(a) and os.path.exists(b)):
    96	        return {'status': 'UNRESOLVED: unprofiled or traced boundary run missing'}
    97	    ua, tb = j(a), j(b)
    98	    out = {}
    99	    for key, rec in ua.get('chains', {}).items():
   100	        t = tb.get('chains', {}).get(key, {})
   101	        if rec.get('status') == 'ok' and t.get('status') == 'ok':
   102	            out[key] = {'unprofiled_per_launch_us': rec['per_launch_us'],
   103	                        'traced_per_launch_us': t['per_launch_us'],
   104	                        'traced_over_unprofiled': t['per_launch_us'] / rec['per_launch_us']}
   105	    return out
   106	
   107	
   108	def source_map(evidence, iters):
   109	    out = {}
   110	    for path in glob.glob(os.path.join(evidence, 'traces', 'ideal_costs_*_*.json')):
   111	        ic = j(path)
   112	        arm, chunk = ic['arm'], ic['chunk']
   113	        sel = ic.get('variant_selection') or {}
   114	        dump = os.path.join(evidence, 'traces', f'dump_{arm}_{chunk}_trace')
   115	        rec = {'variant_selection': sel.get('status'), 'kernels': {}, 'coverage': None}
   116	        if sel.get('status') == 'ok' and os.path.isdir(dump):
   117	            wanted = set(sel.get('selected') or [])
   118	            for g in parse_output_code(dump):
   119	                rel = os.path.relpath(g['path'], dump)
   120	                if rel not in wanted:
   121	                    continue
   122	                for name, k in g['kernels'].items():
   123	                    rec['kernels'][name] = {'fused_ops': k.get('ops') or [],
   124	                                            'ops_source': k.get('ops_source'), 'source_file': rel}
   125	            fused_rows = [r for r in ic['rows'] if r['class'] == 'INDUCTOR_FUSED']
   126	            tot = sum(r['time_us_per_pass'] for r in fused_rows)
   127	            mapped = sum(r['time_us_per_pass'] for r in fused_rows
   128	                         if any(r['kernel'].startswith(n) for n in rec['kernels']))
   129	            rec['coverage'] = {'fused_time_us_per_pass': tot, 'mapped_time_us_per_pass': mapped,
   130	                               'share': (mapped / tot) if tot else None}
   131	        out[f'{arm}_{chunk}'] = rec
   132	        csv_path = os.path.join(evidence, 'traces', f'kernel_source_map_{arm}_{chunk}.csv')
   133	        with open(csv_path, 'w', newline='') as f:
   134	            w = csv.writer(f)
   135	            w.writerow(['kernel', 'fused_ops', 'ops_source', 'source_file'])
   136	            for name, k in sorted(rec['kernels'].items()):
   137	                w.writerow([name, ';'.join(k['fused_ops']), k['ops_source'], k['source_file']])
   138	    return out
   139	
   140	
   141	def main():
   142	    ap = argparse.ArgumentParser()
   143	    ap.add_argument('--evidence-dir', required=True)
   144	    ap.add_argument('--iters', type=int, default=50)
   145	    ap.add_argument('--out', required=True)
   146	    args = ap.parse_args()
   147	    res = {'perturbation': perturbation(args.evidence_dir),
   148	           'boundary_perturbation': boundary_perturbation(args.evidence_dir),
   149	           'source_map': source_map(args.evidence_dir, args.iters)}
   150	    with open(args.out, 'w') as f:
   151	        json.dump(res, f, indent=1)
   152	    for k, v in res['perturbation'].items():
   153	        print(f"[perturbation] {k}: {v['status']} graph x{v.get('graph_over_unprofiled') or 0:.3f} node x"
   154	              f"{v.get('node_over_unprofiled') or 0:.3f} caveat={v['caveat_required']} {v['problems']}")
   155	    for k, v in res['source_map'].items():
   156	        cov = v.get('coverage') or {}
   157	        print(f"[source_map] {k}: variants={v['variant_selection']} coverage={cov.get('share')}")
   158	    print(f'-> {args.out}')
   159	
   160	
   161	if __name__ == '__main__':
   162	    main()

