   109	    from kernel_map import read_gpu_trace, nvtx_pass_windows, split_passes
   110	    rows = read_gpu_trace(base + '_cuda_gpu_trace.csv')
   111	    windows, err = nvtx_pass_windows(base + '_nvtx_gpu_proj_trace.csv')
   112	    if err or len(windows) != expected_passes:
   113	        return None
   114	    passes, _ = split_passes(rows, windows, classify)
   115	    fams = None
   116	    for p in passes:
   117	        sd = [r['name'] for r in p if classify(r['name']) == 'SDPA' and _family(r['name'])]
   118	        if len(sd) != 12:
   119	            return None
   120	        f = [_family(n) for n in sd]
   121	        if fams is None:
   122	            fams = f
   123	        elif f != fams:
   124	            return None
   125	    time_f = {fams[i] for i in range(0, 12, 2)}
   126	    freq_f = {fams[i] for i in range(1, 12, 2)}
   127	    return {'time': time_f.pop() if len(time_f) == 1 else None,
   128	            'freq': freq_f.pop() if len(freq_f) == 1 else None,
   129	            'note': '12 SDPA executions per pass in (time, freq) x 6 order (registered axis order)'}
   130	
   131	
   132	def main():
   133	    ap = argparse.ArgumentParser()
   134	    ap.add_argument('--out', required=True)
   135	    ap.add_argument('--model-trace-352800', default=None, help='export basename of the C3 8-s node trace')
   136	    ap.add_argument('--model-trace-4410', default=None, help='export basename of the C3 4410 node trace')
   137	    ap.add_argument('--passes', type=int, default=50)
   138	    args = ap.parse_args()
   139	    assert torch.cuda.is_available()
   140	    gen = torch.Generator(device='cpu').manual_seed(3)
   141	    # deployed backend per (chunk, axis) from the C3 traces; anything not
   142	    # established from a trace is UNRESOLVED (no ratio), never assumed
   143	    model_backend = {}
   144	    for chunk, base in ((352800, args.model_trace_352800), (4410, args.model_trace_4410)):
   145	        model_backend[chunk] = deployed_backends(base, args.passes) if base else None
   146	    result = {'device': torch.cuda.get_device_name(0), 'torch': torch.__version__,
   147	              'dtype': 'float16', 'heads': H, 'dim_head': D, 'bands': 60,
   148	              'scale': 'default dim_head**-0.5', 'dropout': 0.0,
   149	              'model_backend_per_chunk': {str(k): v for k, v in model_backend.items()}, 'cases': {}}
   150	    for chunk, T in FRAMES.items():
