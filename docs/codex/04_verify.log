   371	
   372	def is_permuted(shape, stride):
   373	    """Permuted = the stride ORDER differs from row-major: fastest dim not
   374	    unit-stride OR strides (over size>1 dims) not non-increasing."""
   375	    if not shape or len(stride) != len(shape):
   376	        return False
   377	    nt = [(s, x) for s, x in zip(shape, stride) if s > 1]
   378	    if not nt:
   379	        return False
   380	    if nt[-1][1] != 1:
   381	        return True
   382	    return any(nt[i][1] < nt[i + 1][1] for i in range(len(nt) - 1))
   383	
   384	
   385	def accessed_elems(shape, stride):
   386	    """Distinct elements a strided view can touch: broadcast dims (stride 0)
   387	    contribute 1, overlapping windows (unfold-style strides) are bounded by
   388	    the address extent 1 + sum((size-1)*|stride|); never more than numel."""
   389	    if not shape:
   390	        return 0
   391	    numel = 1
   392	    for d in shape:
   393	        numel *= int(d)
   394	    if not stride or len(stride) != len(shape):
   395	        return numel
   396	    nz = 1
   397	    extent = 1
   398	    for d, st in zip(shape, stride):
   399	        d, st = int(d), abs(int(st))
   400	        if d == 0:
   401	            return 0
   402	        if st != 0:
   403	            nz *= d
   404	            extent += (d - 1) * st
   405	    return min(numel, nz, extent)
   406	
   407	
   408	def nbytes(shape, dtype):
   409	    n = 1
   410	    for s in shape or ():
   411	        n *= s
   412	    return n * DTYPE_BYTES.get(dtype or 'torch.float16', 2)
