     7	
     8	import argparse
     9	import json
    10	import os
    11	
    12	MATRIX_S1 = [(a, c) for c in (352800, 4410) for a in ('A', 'C3', 'C1', 'H', 'G', 'B', 'E', 'D', 'F')] + \
    13	            [('C1D', 352800), ('C2', 352800), ('C2', 4410)]
    14	PAIRS_S1 = [('C1', 'C3'), ('C1', 'C1D'), ('C3', 'H')]
    15	SWEEP_S2 = [(a, c) for c in (22050, 88200) for a in ('A', 'C3', 'G', 'H')]
    16	TRACES_S2 = [(a, c) for c in (352800, 4410) for a in ('A', 'ANVTX', 'C3', 'G', 'H', 'C1', 'B', 'E', 'F')] + [('C2', 4410)]
