   351	
   352	def read_permuted_state(k, role, meta):
   353	    """Tri-state permuted classification for one READING param (gate-04 f32):
   354	    'yes'  — view meta is permuted, or the load index expr differs from the
   355	             kernel's single store expr;
   356	    'no'   — load expr equals the single store expr;
   357	    'unresolved' — load expr missing, or zero / multiple distinct store exprs
   358	             (an unrelated output with the same expr could hide a permuted
   359	             read feeding another output)."""
   360	    stores = set(k.get('store_exprs', {}).values())
   361	    le = k.get('load_exprs', {}).get(role)
   362	    expected_stores = set(k.get('stores_present', k.get('store_exprs', {})))
   363	    if le is None or expected_stores != set(k.get('store_exprs', {})):
   364	        return 'unresolved'
   365	    if is_permuted(meta['shape'], meta['stride']):
   366	        return 'yes'
   367	    if len(stores) == 1:
   368	        return 'yes' if le not in stores else 'no'
   369	    return 'unresolved'
