   127	    if _git(_ROOT, 'status', '--porcelain'):
   128	        raise RuntimeError('tree is not clean; the session manifest binds a committed tree')
   129	    cur = identity(paths, env)
   130	    for key, val in cur.items():
   131	        if rec.get(key) != val:
   132	            raise RuntimeError(f'session manifest mismatch in {key}')
   133	    return rec
