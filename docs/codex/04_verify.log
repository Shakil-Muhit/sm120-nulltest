    47	NS = (10, 100, 1000, 2000)
    48	REPEATS = 20
    49	WARMUP = 5
    50	
    51	# Triton JIT resolves kernel globals at MODULE scope: the gdc intrinsics and
    52	# both kernels must be module-level. The triton 3.4.0 wheel ships
    53	# language/extra/cuda/gdc.py with the pre-3.4 `_builder=` signature while the
    54	# 3.4 code generator passes `_semantic=` ("gdc_wait() got an unexpected keyword
    55	# argument '_semantic'", ml-beast 2026-09-20), so the SAME two one-line PTX
    56	# intrinsics are defined here with the 3.4 signature (griddepcontrol.wait /
    57	# griddepcontrol.launch_dependents — identical asm strings to the wheel's).
    58	from triton.language import core as _core
    59	
    60	try:
    61	    @_core.extern
    62	    def gdc_wait(_semantic=None):
    63	        _core.inline_asm_elementwise("griddepcontrol.wait; // dummy $0", "=r", [],
    64	                                     dtype=_core.int32, is_pure=False, pack=1,
    65	                                     _semantic=_semantic)
    66	
    67	    @_core.extern
    68	    def gdc_launch_dependents(_semantic=None):
    69	        _core.inline_asm_elementwise("griddepcontrol.launch_dependents; // dummy $0", "=r", [],
    70	                                     dtype=_core.int32, is_pure=False, pack=1,
    71	                                     _semantic=_semantic)
    72	    HAVE_GDC = True
    73	except Exception:                                                            # pragma: no cover
    74	    HAVE_GDC = False
    75	
