   241	            else:
   242	                out['variant_selection'] = {'status': 'ok', 'rule': how,
   243	                                            'selected': [os.path.relpath(g['path'], args.dump_dir) for g in chosen]}
   244	                for g in chosen:
   245	                    for c in g['calls']:
   246	                        if c['kind'] == 'triton':
