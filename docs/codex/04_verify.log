   166	def sdpa_class_costs(chunk):
   167	    T = FRAMES[chunk]
   168	    H, D, F = MODEL['heads'], MODEL['dim_head'], MODEL['bands']
   169	    fl = by = 0.0
   170	    for B, N in ((F, T), (T, F)):
   171	        fl += 6 * 4.0 * B * H * N * N * D
   172	        by += 6 * 4 * B * H * N * D * 2
   173	    return fl, by
   174	
   175	
   176	def gemm_site(call, gr):
   177	    reads = [arg_meta(gr, a) for a in call['args'] if a.get('read')]
   178	    writes = [arg_meta(gr, a) for a in call['args'] if a.get('write')]
   179	    mats = [m for m in reads if len(m['shape']) in (2, 3)]
   180	    if len(mats) < 2 or not writes:
   181	        return None
   182	    a, b = mats[-2], mats[-1]
   183	    if any(m['dtype'] is None for m in mats + writes):
   184	        return None
   185	    if len(a['shape']) == 2 and len(b['shape']) == 2:
   186	        M, K = a['shape']; K2, N = b['shape']; batch = 1
   187	    elif len(a['shape']) == 3 and len(b['shape']) == 3:
   188	        batch, M, K = a['shape']; _, K2, N = b['shape']
   189	    else:
   190	        return None
   191	    if K != K2:
   192	        return None
   193	    by = sum(nbytes(m['shape'], m['dtype']) for m in mats) + sum(nbytes(m['shape'], m['dtype']) for m in writes)
   194	    return {'M': M, 'N': N, 'K': K, 'batch': batch, 'dtype': a['dtype'],
   195	            'flops': 2.0 * batch * M * N * K, 'bytes': by}
   196	
   197	
   198	def ideal_us(flops, by, dtype, bw_l2, l2_bytes, footprint=None):
   199	    """Per CALL. footprint = the call's unique resident bytes (max of read /
   200	    write sets is used as a lower bound when aliases are unknown); the L2
   201	    ideal applies only when footprint <= l2_bytes."""
   202	    p = (P_FP32_TFLOPS if dtype in ('torch.float32', 'torch.float64') else P_FP16_TFLOPS) * 1e12
   203	    t_flop = flops / p * 1e6
   204	    t_hbm = by / (BW_HBM_TBPS * 1e12) * 1e6
   205	    rec = {'ideal_us_hbm': max(t_flop, t_hbm)}
   206	    fp = footprint if footprint is not None else by
   207	    if bw_l2 and l2_bytes and fp <= l2_bytes:
   208	        rec['ideal_us_l2'] = max(t_flop, by / (bw_l2 * 1e12) * 1e6)
   209	    return rec
