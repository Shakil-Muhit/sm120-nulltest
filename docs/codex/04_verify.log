     1	"""Attention backend microbenchmark (plan 1.5; prereg_amendments.md §5), v2.
     2	
     3	Two layout families per (operating point, axis):
     4	  model      : the layouts the compiled model actually feeds to SDPA (read
     5	               from the C3 generated code, axial-layout-scoping evidence):
     6	               q and k are (b, n, h, d)-contiguous rotary outputs presented
     7	               as (b, h, n, d) views — strides (n*h*d, d, h*d, 1); v is a
     8	               view into the fused qkv GEMM output (b, n, 3*h*d) — strides
     9	               (n*3*h*d, d, 3*h*d, 1), storage offset 2*h*d
    10	  contiguous : (b, h, n, d) contiguous (separate experiment, not the model)
    11	Shapes: time-axis batch = 60 bands, seq = T frames; freq-axis batch = T,
    12	seq = 60; heads 8, dim_head 64, fp16; scale = default (dim_head**-0.5),
    13	dropout 0 — the model's Attend settings. Backends forced one at a time
    14	(flash / efficient / cudnn / math); unsupported combinations are recorded.
    15	Reference for the error column: fp32 inputs with the MATH backend forced.
    16	Timing: CUDA-graph replay of BLOCK launches, events, median of REPEATS.
    17	The model's deployed backend is read from a trace kernel summary
    18	(--model-kern-sum, e.g. the C3 node trace): flash if flash kernels dominate
    19	the SDPA class, cudnn if cuDNN kernels do, else efficient; without a trace
    20	the ratio is reported against 'flash' and flagged ASSUMED.
    21	"""
    22	
    23	import argparse
    24	import csv
    25	import json
    26	import statistics
    27	
    28	import torch
    29	import torch.nn.functional as F
    30	from torch.nn.attention import SDPBackend, sdpa_kernel
    31	
    32	BLOCK = 20
    33	REPEATS = 20
    34	FRAMES = {352800: 801, 4410: 11}
    35	BACKENDS = {'flash': SDPBackend.FLASH_ATTENTION, 'efficient': SDPBackend.EFFICIENT_ATTENTION,
    36	            'cudnn': SDPBackend.CUDNN_ATTENTION, 'math': SDPBackend.MATH}
    37	H, D = 8, 64
    38	
    39	
    40	def model_layout(b, n, gen):
    41	    """q, k: views of (b, n, h, d)-contiguous buffers; v: view into (b, n, 3hd)."""
    42	    qk_store = [torch.randn(b, n, H, D, generator=gen).to('cuda', torch.float16) for _ in range(2)]
    43	    q = qk_store[0].permute(0, 2, 1, 3)
    44	    k = qk_store[1].permute(0, 2, 1, 3)
    45	    qkv = torch.randn(b, n, 3 * H * D, generator=gen).to('cuda', torch.float16)
    46	    v = qkv.view(b, n, 3, H, D)[:, :, 2].permute(0, 2, 1, 3)
    47	    assert q.stride() == (n * H * D, D, H * D, 1) and v.stride() == (n * 3 * H * D, D, 3 * H * D, 1)
    48	    return q, k, v, [qk_store, qkv]
    49	
    50	
    51	def contiguous_layout(b, n, gen):
    52	    t = [torch.randn(b, H, n, D, generator=gen).to('cuda', torch.float16) for _ in range(3)]
    53	    return t[0], t[1], t[2], t
    54	
    55	
    56	def bench(q, k, v, backend):
    57	    def fn():
    58	        with sdpa_kernel([backend]):
    59	            return F.scaled_dot_product_attention(q, k, v)
    60	    for _ in range(5):
    61	        fn()
    62	    torch.cuda.synchronize()
    63	    s = torch.cuda.Stream()
    64	    s.wait_stream(torch.cuda.current_stream())
    65	    with torch.cuda.stream(s):
    66	        fn()
    67	    torch.cuda.current_stream().wait_stream(s)
    68	    torch.cuda.synchronize()
    69	    g = torch.cuda.CUDAGraph()
    70	    with torch.cuda.graph(g):
    71	        for _ in range(BLOCK):
    72	            fn()
    73	    times = []
    74	    for _ in range(REPEATS):
    75	        e0 = torch.cuda.Event(enable_timing=True)
    76	        e1 = torch.cuda.Event(enable_timing=True)
    77	        e0.record()
    78	        g.replay()
    79	        e1.record()
    80	        torch.cuda.synchronize()
    81	        times.append(e0.elapsed_time(e1) * 1e3 / BLOCK)
    82	    return statistics.median(times), min(times), max(times)
    83	
    84	
    85	def _family(name):
    86	    """Attention EXECUTION kernel family; Triton/preprocessing names are never
    87	    attention executions."""
    88	    n = name.lower()
    89	    if n.startswith('triton') or 'triton_' in n:
    90	        return None
    91	    if 'flash' in n and ('fwd' in n or 'attn' in n or 'kernel' in n):
    92	        return 'flash'
    93	    if 'cudnn' in n or 'fmha_v2' in n or 'sm100_fmha' in n or 'sm90_fmha' in n:
    94	        return 'cudnn'
    95	    if 'fmha' in n or 'mem_eff' in n or 'efficient' in n or 'attention_kernel' in n:
    96	        return 'efficient'
    97	    return None
    98	
    99	
   100	def deployed_backends(base, expected_passes=50):
   101	    """Per (axis) at the trace's operating point: the attention execution
   102	    family of the 12 SDPA events per pass, in order (time, freq) x 6 layers.
   103	    Returns {'time': family|None, 'freq': family|None, 'note': ...} or None
   104	    (UNRESOLVED) when the per-pass SDPA structure is not the registered one."""
