     1	"""Task-quality gate (prereg_amendments.md §2): 8 fixed MUSDB18-HQ test clips,
     2	evaluated at EVERY compared operating point, paired against eager arm A at
     3	that same operating point.
     4	
     5	Reconstruction policy (registered): each 8.000-s clip (352800 samples) is
     6	processed as non-overlapping consecutive chunks of the operating point's size
     7	(1 x 352800, 4 x 88200, 16 x 22050, 80 x 4410) and the chunk outputs are
     8	concatenated (no overlap, no crossfade). Short-chunk SDR_ref values are
     9	therefore NOT quality claims about the model; the gate is the paired
    10	regression vs A under the identical policy.
    11	
    12	Metrics (stereo signals flattened to one vector; float64 accumulation):
    13	  SDR(ref, est)   = 10 log10( ||ref||^2 / ||ref - est||^2 )         (plain)
    14	  SI-SDR(ref, est): both zero-mean; s = <est,ref>/||ref||^2 * ref;
    15	                    10 log10( ||s||^2 / ||est - s||^2 )
    16	computed (a) vs the reference vocals stem and (b) vs the saved eager-A output
    17	for the same clip at the same operating point. A perfect match yields +inf
    18	(reported as the string "inf"). Gate: mean over the 8 clips of
    19	ΔSDR_ref = SDR_ref(arm) - SDR_ref(A) >= -0.1 dB; per-clip minimum, SI-SDR and
    20	the vs-A numbers are reported alongside (the gate is the mean).
    21	"""
    22	
    23	import hashlib
    24	import json
    25	import math
    26	import os
    27	
    28	import numpy as np
    29	import soundfile as sf
    30	import torch
    31	
    32	CLIP_SAMPLES = 352800
    33	THRESHOLD_DB = -0.1
    34	
    35	
    36	def _sha256(path):
    37	    h = hashlib.sha256()
    38	    with open(path, 'rb') as f:
    39	        for block in iter(lambda: f.read(1 << 20), b''):
    40	            h.update(block)
    41	    return h.hexdigest()
    42	
    43	
    44	def load_clips(clips_dir, manifest_path):
    45	    """Verifies every wav's sha256 against the manifest (loud failure)."""
    46	    with open(manifest_path) as f:
    47	        man = json.load(f)
    48	    clips = []
    49	    for c in man['clips']:
    50	        rec = {'index': c['index'], 'track': c['track'], 'start_sample': c['start_sample']}
    51	        for kind in ('mixture', 'vocals'):
    52	            entry = c['files'][kind]
    53	            path = os.path.join(clips_dir, entry['name'])
    54	            if not os.path.exists(path):
    55	                raise FileNotFoundError(f'clip missing: {path}')
    56	            got = _sha256(path)
    57	            if got != entry['sha256']:
    58	                raise ValueError(f'clip sha256 mismatch: {path} {got} != {entry["sha256"]}')
    59	            audio, sr = sf.read(path, dtype='float32', always_2d=True)   # (n, 2)
    60	            assert sr == 44100 and audio.shape == (CLIP_SAMPLES, 2), (path, sr, audio.shape)
    61	            rec[kind] = torch.from_numpy(audio.T.copy())                  # (2, n)
    62	        clips.append(rec)
    63	    assert len(clips) == 8, f'expected 8 clips, got {len(clips)}'
    64	    assert len({c['track'] for c in clips}) == 8, 'clips must come from 8 distinct tracks'
    65	    return man, clips
