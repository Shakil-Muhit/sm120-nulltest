    64	def per_pass_sequence(base, expected_passes):
    65	    """ORDERED per-pass Triton kernel sequence + SDPA/GEMM class counts; every
    66	    pass must agree and the pass count must equal the expected one."""
    67	    rows = read_gpu_trace(base + '_cuda_gpu_trace.csv')
    68	    windows, err = nvtx_pass_windows(base + '_nvtx_gpu_proj_trace.csv')
    69	    if err or not windows:
    70	        return None, f'nvtx windows unavailable: {err}'
    71	    passes, _ = split_passes(rows, windows, classify)
    72	    passes = [p for p in passes if p]
    73	    if expected_passes and len(passes) != expected_passes:
    74	        return None, f'{len(passes)} passes in the trace != expected {expected_passes}'
    75	    seqs = [[r['name'] for r in p if classify(r['name']) == 'INDUCTOR_FUSED'] for p in passes]
    76	    counts = [collections.Counter(classify(r['name']) for r in p) for p in passes]
    77	    if any(sq != seqs[0] for sq in seqs) or any(c != counts[0] for c in counts):
    78	        return None, 'per-pass kernel sequences / class counts differ across passes'
    79	    return {'triton_seq': seqs[0], 'class_counts': counts[0]}, None
