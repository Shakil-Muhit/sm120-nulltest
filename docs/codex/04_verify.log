     1	"""Three timing views for multi-stream arms (plan 1.7; prereg_amendments §5).
     2	
     3	From a node-level cuda_gpu_trace export with outer NVTX pass windows:
     4	  (i)   summed kernel durations per pass
     5	  (ii)  union of kernel intervals per pass (busy union — overlap collapsed)
     6	  (iii) OBSERVED-ORDER critical-path estimate per pass. DEPENDENCY MODEL
     7	        (stated; gate-02 f27): the trace exports no event/graph edges, so the
     8	        only dependencies that can be asserted are observed orderings —
     9	        edge a -> b iff a ENDED before b STARTED and (same stream) or
    10	        (different streams: the fork/join structure of F/G means a side-stream
    11	        kernel can only depend on main-stream work that finished before it,
    12	        and vice versa). Overlapping kernels never depend on each other.
    13	        Critical path = longest chain of pairwise non-overlapping kernels
    14	        (sum of durations). By construction critical_path <= union <= span
    15	        (asserted); this is an UPPER BOUND on the true dependency path, labelled
    16	        as such — never the true event graph.
    17	Every view is reported per pass and as the median over passes; "busy" is
    18	never reported without its view.
    19	"""
    20	
    21	import argparse
    22	import csv
    23	import json
    24	import re
    25	import statistics
    26	
    27	
    28	def read_rows(path):
    29	    with open(path, newline='') as f:
    30	        rd = csv.reader(f)
    31	        head = next(rd)
    32	        def col(*names, contains=None):
    33	            for n in names:
    34	                for i, h in enumerate(head):
    35	                    if h.strip().strip('"') == n:
    36	                        return i
    37	            if contains:
    38	                for i, h in enumerate(head):
    39	                    if contains in h:
    40	                        return i
    41	            return None
    42	        c_s, c_d = col('Start (ns)', contains='Start'), col('Duration (ns)', contains='Duration')
    43	        c_n, c_st = col('Name'), col('Strm', 'Stream', contains='Strm')
    44	        rows = []
    45	        for r in rd:
    46	            try:
    47	                rows.append({'start': int(float(r[c_s].replace(',', ''))),
    48	                             'dur': int(float(r[c_d].replace(',', ''))),
    49	                             'name': r[c_n], 'stream': r[c_st] if c_st is not None else '0'})
    50	            except (ValueError, IndexError):
    51	                continue
    52	    rows.sort(key=lambda x: x['start'])
    53	    return rows
    54	
    55	
    56	def windows(path):
    57	    with open(path, newline='') as f:
    58	        rd = csv.reader(f)
    59	        head = next(rd)
    60	        c_name = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Name', 'Range'))
    61	        c_start = next(i for i, h in enumerate(head) if 'Start' in h)
    62	        c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
    63	        wins = {}
    64	        for r in rd:
    65	            m = re.fullmatch(r'pass_(\d+)', r[c_name].strip().strip('"').split(':')[-1])
    66	            if m:
    67	                try:
    68	                    s = int(float(r[c_start].replace(',', '')))
    69	                    d = int(float(r[c_dur].replace(',', '')))
    70	                except ValueError:
    71	                    continue
    72	                wins[int(m.group(1))] = (s, s + d)
    73	    return [wins[i] for i in sorted(wins)]
    74	
    75	
    76	def union_ns(rows):
    77	    total, cur_s, cur_e = 0, None, None
    78	    for r in rows:
    79	        s, e = r['start'], r['start'] + r['dur']
    80	        if cur_e is None or s > cur_e:
    81	            if cur_e is not None:
    82	                total += cur_e - cur_s
    83	            cur_s, cur_e = s, e
    84	        else:
    85	            cur_e = max(cur_e, e)
    86	    if cur_e is not None:
    87	        total += cur_e - cur_s
    88	    return total
    89	
    90	
    91	def critical_path_ns(rows):
    92	    """Longest chain of pairwise non-overlapping kernels (ended-before-started
    93	    edges); O(n^2) per pass is fine for ~1-2k kernels."""
    94	    if not rows:
    95	        return 0, '-'
    96	    order = sorted(rows, key=lambda x: (x['start'], x['start'] + x['dur']))
    97	    ends = [r['start'] + r['dur'] for r in order]
    98	    best = [0] * len(order)
    99	    for i, r in enumerate(order):
   100	        pred = 0
   101	        for j in range(i):
   102	            if ends[j] <= r['start'] and best[j] > pred:
   103	                pred = best[j]
   104	        best[i] = pred + r['dur']
   105	    by_stream = {}
   106	    for r in rows:
   107	        by_stream[r['stream']] = by_stream.get(r['stream'], 0) + 1
   108	    dominant = max(by_stream, key=by_stream.get)
   109	    return max(best), dominant
   110	
   111	
   112	def main():
   113	    ap = argparse.ArgumentParser()
   114	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
   115	    ap.add_argument('--out', required=True)
   116	    ap.add_argument('--arm', default='')
   117	    args = ap.parse_args()
   118	    rows = read_rows(args.base + '_cuda_gpu_trace.csv')
   119	    wins = windows(args.base + '_nvtx_gpu_proj_trace.csv')
   120	    assert wins, 'no pass windows'
   121	    per = []
   122	    for s, e in wins:
   123	        p = [r for r in rows if s <= r['start'] < e]
   124	        cp, dom = critical_path_ns(p)
   125	        u = union_ns(p)
   126	        span = (max(r['start'] + r['dur'] for r in p) - min(r['start'] for r in p)) if p else 0
   127	        assert cp <= u + 1 and u <= span + 1, (cp, u, span)   # observed-order bound
   128	        per.append({'kernels': len(p), 'streams': sorted({r['stream'] for r in p}),
   129	                    'sum_ns': sum(r['dur'] for r in p), 'union_ns': u,
   130	                    'critical_path_observed_order_ns': cp, 'span_ns': span,
   131	                    'window_ns': e - s, 'dominant_stream': dom})
   132	    def med(k):
   133	        return statistics.median(x[k] for x in per)
   134	    out = {'arm': args.arm, 'passes': len(per),
   135	           'median_us': {k: med(k) / 1e3 for k in ('sum_ns', 'union_ns', 'critical_path_observed_order_ns', 'span_ns', 'window_ns')},
   136	           'median_kernels_per_pass': med('kernels'),
   137	           'streams_seen': sorted({s for x in per for s in x['streams']}),
   138	           'dependency_model': ('observed-order: edge a->b iff a ended before b started; '
   139	                                'longest chain of non-overlapping kernels; an UPPER BOUND on the '
   140	                                'true dependency path (no event/graph edges are exported)'),
   141	           'per_pass': per}
   142	    with open(args.out, 'w') as f:
   143	        json.dump(out, f, indent=1)
   144	    m = out['median_us']
   145	    print(f"[views] {args.arm}: sum {m['sum_ns']:.1f} us | union {m['union_ns']:.1f} us | "
   146	          f"observed-order critical path {m['critical_path_observed_order_ns']:.1f} us | span "
   147	          f"{m['span_ns']:.1f} us | streams {out['streams_seen']}")
   148	
   149	
   150	if __name__ == '__main__':
   151	    main()

