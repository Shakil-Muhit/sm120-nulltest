   567	def split_passes(rows, windows, classify):
   568	    if windows:
   569	        return [[r for r in rows if s <= r['start'] < e]
   570	                for s, e in windows], 'nvtx-windows'
   571	    sdpa_idx = [i for i, r in enumerate(rows) if classify(r['name']) == 'SDPA']
   572	    n_pass = max(1, round(len(sdpa_idx) / 12)) if sdpa_idx else 1
   573	    gaps = [(rows[i + 1]['start'] - (rows[i]['start'] + rows[i]['dur']), i)
   574	            for i in range(len(rows) - 1)]
   575	    cuts = sorted(i for _, i in sorted(gaps, key=lambda g: -g[0])[:n_pass - 1])
   576	    passes, prev = [], 0
   577	    for c in cuts:
   578	        passes.append(rows[prev:c + 1])
   579	        prev = c + 1
   580	    passes.append(rows[prev:])
   581	    return passes, 'gap-heuristic'
