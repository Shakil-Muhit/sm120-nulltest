    19	def main():
    20	    ap = argparse.ArgumentParser()
    21	    ap.add_argument('--evidence-dir', required=True)
    22	    ap.add_argument('--session', choices=['session1', 'session2'], required=True)
    23	    args = ap.parse_args()
    24	    ev = args.evidence_dir
    25	    summary = json.load(open(os.path.join(ev, 'summary_full.json')))
    26	    cells, pairs = summary['cells'], summary.get('matched_pairs', {})
    27	    items = []
    28	    if args.session == 'session1':
    29	        for a, c in MATRIX_S1:
    30	            cell = cells.get(f'{a}_{c}')
    31	            ok = bool(cell and cell['headline_status'] == 'HEADLINE')
    32	            note = None
    33	            if not ok and a == 'C2':
    34	                # registered C2 rule: a timed-out cold attempt is not retried and the
    35	                # remaining restarts are UNTESTED (unavailable performance, not a
    36	                # session defect) — complete iff every required restart is a terminal
    37	                # UNTESTED record citing the allowance / no-retry / timeout rule
    38	                recs = [summary['runs'].get(f'C2_{c}_r{i}') for i in (1, 2, 3)]
    39	                if all(r and r.get('status') == 'UNTESTED' and any(
    40	                        t in (r.get('error') or '') for t in ('timeout', 'allowance', 'no-retry')) for r in recs):
    41	                    ok, note = True, 'UNTESTED under the registered C2 allowance rule'
    42	            items.append({'item': f'matrix {a}@{c}', 'complete': ok, 'note': note,
    43	                          'reason': None if ok else (cell or {}).get('reasons', ['no runs'])})
    44	        for a, b in PAIRS_S1:
    45	            p = pairs.get(f'{a}_vs_{b}_c352800')
    46	            ok = bool(p and p['pair_headline'] == 'HEADLINE')
    47	            items.append({'item': f'matched {a} vs {b} @352800', 'complete': ok,
    48	                          'reason': None if ok else (p or {}).get('reasons', ['no pair runs'])})
    49	        for name in ('full_A_c4410_planted_tight.json', 'full_A_c4410_planted_loose.json',
    50	                     'c3_operator_qualification.json'):
    51	            ok = os.path.exists(os.path.join(ev, name))
    52	            items.append({'item': name, 'complete': ok, 'reason': None if ok else ['missing']})
    53	    else:
    54	        for a, c in SWEEP_S2:
    55	            cell = cells.get(f'{a}_{c}')
    56	            ok = bool(cell and cell['headline_status'] == 'HEADLINE')
    57	            items.append({'item': f'sweep {a}@{c}', 'complete': ok,
    58	                          'reason': None if ok else (cell or {}).get('reasons', ['no runs'])})
    59	        for a, c in TRACES_S2:
    60	            exp = os.path.join(ev, 'traces', f'trace_{a}_{c}_trace_exports.json')
    61	            ok = os.path.exists(exp) and json.load(open(exp)).get('complete') is True
    62	            items.append({'item': f'trace {a}@{c}', 'complete': bool(ok), 'reason': None if ok else ['exports incomplete or missing']})
    63	        for name in ('attn_backend_bench.json', 'boundary_bench.json', 'boundary_bench_trace_analysis.json',
    64	                     'perturbation_and_source_map.json'):
    65	            ok = os.path.exists(os.path.join(ev, name))
    66	            items.append({'item': name, 'complete': ok, 'reason': None if ok else ['missing']})
    67	    n_ok = sum(1 for i in items if i['complete'])
    68	    status = {'session': args.session, 'items': items, 'complete_items': n_ok, 'total_items': len(items),
    69	              'verdict': 'COMPLETE' if n_ok == len(items) else 'INCOMPLETE'}
    70	    with open(os.path.join(ev, 'session_status.json'), 'w') as f:
    71	        json.dump(status, f, indent=1)
    72	    print(f"[completeness] {args.session}: {status['verdict']} ({n_ok}/{len(items)} mandatory items)")
    73	    for i in items:
    74	        if not i['complete']:
    75	            print(f"   INCOMPLETE {i['item']}: {i['reason']}")
    76	
