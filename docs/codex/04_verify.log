   227	                         'BW_hbm_tbps': BW_HBM_TBPS, 'BW_l2_tbps': args.bw_l2_tbps, 'l2_bytes': args.l2_bytes},
   228	           'variant_selection': None, 'rows': [], 'gemm_sites': [], 'unresolved': []}
   229	
