import sys,copy,collections,io,json,contextlib
from unittest.mock import patch
sys.path.insert(0,'fullmodel')
import collect_full as c, ideal_costs as ic

def rec(arm,tag,manifest='M',var='matrix-variant'):
 return {'arm':arm,'chunk':352800,'tag':tag,'status':'VALID','tier':'loose','manifest_id':manifest,'effective_variant':var,'headline_eligible':True,'min_of_medians_ms':10.,'median_spread_ms':0.,'throughput_ms_per_pass_best':8.,'validation':{'status':'PASS'},'sdr_gate':{'status':'PASS','operating_point':352800,'mean_delta_sdr_ref_db':0.}}
rs={t:rec('C1',t) for t in c.REQUIRED_RESTARTS}
mix=copy.deepcopy(rs);mix['r2']['manifest_id']='M2'
print('mixed_manifest_cell',c.cell(mix)['headline_status'])
invalid=copy.deepcopy(rs)
for r in invalid.values(): r['status']='INVALID'; r['validation']={'status':'FAIL'}
print('invalid_records_trusted_flag',c.cell(invalid)['headline_status'])
files={f'/ev/full_{a}_c352800_{t}.json':json.dumps(rec(a,t)) for a in ('C1','C3') for t in c.REQUIRED_RESTARTS}
for t in c.REQUIRED_MATCHED:
 files[f'/ev/matched_C1_C3_c352800_{t}.json']=json.dumps({'pair':['C1','C3'],'chunk':352800,'tag':t,'status':'VALID','manifest_id':'M','effective_variants':{'C1':'DIFFERENT_FROM_MATRIX','C3':'DIFFERENT_FROM_MATRIX'},'pair_eligible':True,'matched_delta_ms':{'median':1.,'median_pct_of_a':10.}})
saved={}
class Save(io.StringIO):
 def __init__(self,path): super().__init__(); self.path=path
 def close(self): saved[self.path]=self.getvalue(); super().close()
def op(path,mode='r',*a,**kw): return Save(path) if 'w' in mode else io.StringIO(files[path])
def gl(p): return [k for k in files if ('/full_' in k if '/full_' in p else '/matched_' in k)]
with patch('builtins.open',op),patch.object(c.glob,'glob',gl),patch.object(sys,'argv',['collect_full','--evidence-dir','/ev']),contextlib.redirect_stdout(io.StringIO()): c.main()
print('mismatched_variant_pair',json.loads(saved['/ev/summary_full.json'])['matched_pairs'])

def graph(path,sites=1,space=16,extern=False):
 name='triton_poi_fused_same_0'
