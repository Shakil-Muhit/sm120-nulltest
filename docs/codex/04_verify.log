   118	    for r in $(seq 1 "$RESTARTS"); do
   119	        left=$(( C2_BUDGET_S - ($(date +%s) - C2_T0) ))
   120	        path="$EVID/full_C2_c${chunk}_r${r}.json"
   121	        if [ "$cold_timed_out" = "1" ]; then
   122	            terminal_json "$path" C2 "$chunk" "r$r" UNTESTED "not attempted: identical cold attempt timed out (no-retry rule)"; continue
   123	        fi
   124	        if [ "$left" -lt "$T_MIN" ]; then
