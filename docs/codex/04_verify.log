   302	
   303	def resolve(gr, buf):
   304	    """Follow alias chain to the base buffer; return (base, view_meta|None)."""
   305	    meta = None
   306	    seen = set()
   307	    while buf in gr['aliases'] and buf not in seen:
   308	        seen.add(buf)
   309	        a = gr['aliases'][buf]
   310	        if meta is None and 'shape' in a:
   311	            meta = {'shape': a['shape'], 'stride': a['stride']}
   312	        buf = a['base']
   313	    return buf, meta
   314	
   315	
   316	def arg_meta(gr, a):
   317	    """Effective (shape, stride, dtype, base) the kernel sees for arg a.
   318	    Shape precedence: reinterpret literal > alias view meta > an
   319	    assert_size_stride/alloc on the arg's OWN name (fallback outputs and
   320	    getitem results are asserted by name) > the base allocation."""
   321	    base, alias_meta = resolve(gr, a['buf'])
   322	    alloc = gr['allocs'].get(base, {})
   323	    own = gr['allocs'].get(a['buf'], {})
   324	    if a.get('reinterpret') and a.get('shape'):
   325	        shape, stride = a['shape'], a['stride']
   326	    elif alias_meta:
   327	        shape, stride = alias_meta['shape'], alias_meta['stride']
   328	    elif own.get('shape'):
   329	        shape, stride = own['shape'], own.get('stride', ())
   330	    else:
   331	        shape, stride = alloc.get('shape', ()), alloc.get('stride', ())
   332	    return {'shape': shape or (), 'stride': stride or (),
   333	            'dtype': alloc.get('dtype') or own.get('dtype'), 'base': base}
