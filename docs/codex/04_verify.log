    82	def graph_signature(g):
    83	    """What pricing sees of a graph: the ordered Triton calls with each
    84	    argument's (role, shape, stride, element type). Two graphs with equal
    85	    signatures are interchangeable for the byte model."""
    86	    sig = []
    87	    for c in g['calls']:
    88	        if c['kind'] != 'triton':
    89	            continue
    90	        k = g['kernels'].get(c['name'], {})
    91	        args = []
    92	        for a in c['args']:
    93	            m = arg_meta(g, a)
    94	            args.append((a.get('role', ''), tuple(m['shape']), tuple(m['stride']),
    95	                         k.get('ptr_dtypes', {}).get(a.get('role', ''), m['dtype'])))
    96	        sig.append((c['name'], tuple(args)))
    97	    return tuple(sig)
