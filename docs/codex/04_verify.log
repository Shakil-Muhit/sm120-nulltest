    53	def pass_windows(nvtx_csv):
    54	    head, rows = read_csv(nvtx_csv)
    55	    c_name = col(head, 'Name', 'Range', contains='Name')
    56	    c_ps, c_pd = col(head, 'Projected Start (ns)', contains='Projected Start'), col(head, 'Projected Duration (ns)', contains='Projected Duration')
    57	    c_os, c_od = col(head, 'Orig Start (ns)', contains='Orig Start'), col(head, 'Orig Duration (ns)', contains='Orig Duration')
    58	    if c_ps is None:
    59	        c_ps, c_pd = col(head, contains='Start'), col(head, contains='Duration')
    60	    wins = {}
    61	    for r in rows:
    62	        m = re.fullmatch(r'pass_(\d+)', r[c_name].strip().strip('"').split(':')[-1])
    63	        if not m:
    64	            continue
    65	        if int(m.group(1)) in wins:
    66	            raise SystemExit(f'duplicate NVTX pass id {m.group(1)}')
    67	        try:
    68	            gs, gd = int(float(r[c_ps].replace(',', ''))), int(float(r[c_pd].replace(',', '')))
    69	            if c_os is not None:
    70	                cs, cd = int(float(r[c_os].replace(',', ''))), int(float(r[c_od].replace(',', '')))
    71	            else:
    72	                cs, cd = gs, gd
    73	        except ValueError:
    74	            continue
