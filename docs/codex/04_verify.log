    39	def _qualified(run):
    40	    """One-block perturbation protocol: VALID, validation PASS, exactly one
    41	    block of 50 passes, manifest-bound, effective variant recorded."""
    42	    if not run or run.get('status') != 'VALID':
    43	        return 'run missing or not VALID'
    44	    if (run.get('validation') or {}).get('status') != 'PASS':
    45	        return 'validation not PASS'
    46	    t = run.get('timing') or {}
    47	    if len(t.get('blocks') or []) != 1 or t.get('iters_per_block') != 50:
    48	        return 'not a one-block x 50 run'
    49	    if run.get('manifest_id') is None:
    50	        return 'not manifest-bound'
    51	    if run.get('settle') and run['settle'].get('settle_capped'):
    52	        return 'settle capped'
    53	    if run.get('counters_stable') is False:
    54	        return 'recording unstable'
    55	    return None
