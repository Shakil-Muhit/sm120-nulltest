   222	def compare_outputs(out, ref, tier):
   223	    rtol, atol = TIERS[tier]
   224	    out = out.float()
   225	    ref = ref.float()
   226	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   227	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   228	    if out.shape != ref.shape:
   229	        rec['reason'] = 'shape mismatch'
   230	        rec['max_abs_diff'] = None
   231	        return rec
   232	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   233	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   234	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   235	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   236	    if not (fin_out and fin_ref):
   237	        rec['reason'] = 'non-finite values present'
   238	        return rec
   239	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   240	    if not rec['ok']:
   241	        rec['reason'] = 'tolerance exceeded'
   242	    return rec
