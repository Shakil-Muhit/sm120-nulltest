    80	def compile_stable(before, after):
    81	    """Recording/compilation stability (gate-02 f21): no NEW graph breaks or
    82	    unimplemented ops, the same number of unique Dynamo graphs, and EVERY
    83	    Inductor cudagraph counter unchanged (recordings, skips, non-static
    84	    input recordings). Per-call counters (calls, frames) are ignored."""
    85	    for k in STABILITY_KEYS:
    86	        if before.get(k, {}) != after.get(k, {}):
    87	            return False
    88	    if before.get('stats', {}).get('unique_graphs') != after.get('stats', {}).get('unique_graphs'):
    89	        return False
    90	    b_ind = {k: v for k, v in before.get('inductor', {}).items() if 'cudagraph' in k}
    91	    a_ind = {k: v for k, v in after.get('inductor', {}).items() if 'cudagraph' in k}
    92	    return b_ind == a_ind
