   168	def timed_run(step, x, ctx, iters=50, nvtx_pass=False):
   169	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   170	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   171	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   172	    pass windows for the exports; never inside compiled code)."""
   173	    with torch.no_grad(), ctx():
   174	        torch.cuda.synchronize()
   175	        torch.cuda.profiler.start()
   176	        latency_ms = []
   177	        for i in range(iters):
   178	            if nvtx_pass:
   179	                torch.cuda.nvtx.range_push(f'pass_{i}')
   180	            t0 = time.perf_counter()
   181	            step(x)
   182	            torch.cuda.synchronize()
   183	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   184	            if nvtx_pass:
   185	                torch.cuda.nvtx.range_pop()
   186	        torch.cuda.profiler.stop()
   187	
   188	        torch.cuda.synchronize()
   189	        t0 = time.perf_counter()
   190	        for _ in range(iters):
   191	            step(x)
   192	        torch.cuda.synchronize()
   193	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   194	    return latency_ms, throughput_ms
