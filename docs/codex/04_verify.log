   325	        rows.append(row)
   326	    out['rows'] = rows
   327	    out['gemm_sites'] = gemm_sites
   328	    out['class_totals_us_per_pass'] = {c: sum(r['time_us_per_pass'] for r in rows if r['class'] == c)
   329	                                       for c in ('GEMM', 'SDPA', 'INDUCTOR_FUSED', 'COPY', 'FFT', 'OTHER')}
   330	    fl, by = sdpa_class_costs(args.chunk)
   331	    out['sdpa_class'] = {'calls_per_pass': 12, 'flops_per_pass': fl, 'bytes_per_pass': by,
   332	                         **ideal_us(fl, by, 'torch.float16', None, None),
