    35	def read_csv(path):
    36	    with open(path, newline='') as f:
    37	        rows = list(csv.reader(f))
    38	    return rows[0], rows[1:]
    39	
    40	
    41	def col(head, *names, contains=None):
    42	    for name in names:
    43	        for i, h in enumerate(head):
    44	            if h.strip().strip('"') == name:
    45	                return i
    46	    if contains:
    47	        for i, h in enumerate(head):
    48	            if contains in h:
    49	                return i
    50	    return None
