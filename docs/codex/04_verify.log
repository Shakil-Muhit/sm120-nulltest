   100	def select_variants(graphs, observed):
   101	    """Executed variant(s): the ORDERED per-pass Triton sequence must equal the
   102	    concatenation of graph Triton sequences (graphs may repeat). Graphs whose
   103	    kernel sequences AND call signatures are identical form one equivalence
   104	    class (interchangeable for pricing). The decomposition into classes must
   105	    be UNIQUE (counted exhaustively with memoisation); zero or several
   106	    decompositions -> None. Graphs without Triton kernels are invisible to
   107	    the decomposition (stated in the rule text)."""
   108	    import sys
   109	    sys.setrecursionlimit(max(10000, sys.getrecursionlimit()))
   110	    seqs = [tuple(c['name'] for c in g['calls'] if c['kind'] == 'triton') for g in graphs]
   111	    sigs = [graph_signature(g) for g in graphs]
   112	    cls_of, reps = {}, []
   113	    for i, sg in enumerate(sigs):
   114	        for ci, r in enumerate(reps):
   115	            if sigs[r] == sg:
   116	                cls_of[i] = ci
   117	                break
   118	        else:
   119	            reps.append(i)
   120	            cls_of[i] = len(reps) - 1
   121	    target = tuple(observed['triton_seq'])
   122	    n = len(target)
   123	    memo = {}
   124	
   125	    def ways(pos):
   126	        if pos == n:
   127	            return 1, ()
   128	        if pos in memo:
   129	            return memo[pos]
   130	        total, witness, seen = 0, None, set()
   131	        for i, sq in enumerate(seqs):
   132	            if not sq or cls_of[i] in seen or target[pos:pos + len(sq)] != sq:
   133	                continue
   134	            seen.add(cls_of[i])
   135	            w, wit = ways(pos + len(sq))
   136	            if w:
   137	                total += w
   138	                if witness is None:
   139	                    witness = (i,) + wit
   140	        memo[pos] = (min(total, 2), witness)     # cap: only 0 / 1 / many matters
   141	        return memo[pos]
   142	
   143	    count, witness = ways(0)
   144	    if count == 0:
   145	        return None, 'no concatenation of compiled graphs reproduces the per-pass Triton sequence'
   146	    if count > 1:
   147	        return None, 'the per-pass Triton sequence has several distinct decompositions into compiled graphs'
   148	    chosen = [graphs[i] for i in witness]
   149	    invisible = sum(1 for sq in seqs if not sq)
   150	    # extern reconciliation: SDPA fallbacks must equal the traced SDPA class
   151	    # count; GEMM class events must be >= extern mm/bmm/addmm calls (cuBLAS may
   152	    # launch more than one kernel per call, never fewer)
   153	    n_sdpa = sum(1 for g in chosen for c in g['calls'] if c['kind'] == 'fallback' and 'scaled_dot_product' in c['name'])
   154	    n_gemm = sum(1 for g in chosen for c in g['calls'] if c['kind'] == 'extern' and any(t in c['name'] for t in ('mm', 'bmm', 'addmm')))
   155	    cc = observed['class_counts']
   156	    if n_sdpa != cc.get('SDPA', 0):
   157	        return None, f'SDPA reconciliation failed: wrapper {n_sdpa} vs trace {cc.get("SDPA", 0)}'
   158	    if cc.get('GEMM', 0) < n_gemm:
   159	        return None, f'GEMM reconciliation failed: trace {cc.get("GEMM", 0)} events < {n_gemm} extern calls'
   160	    return chosen, (f'{len(chosen)} graph executions per pass from {len(set(witness))} distinct graphs '
   161	                    f'({len(reps)} signature classes among {len(graphs)} compiled); unique decomposition; '
   162	                    f'SDPA {n_sdpa} reconciled; GEMM events {cc.get("GEMM", 0)} >= {n_gemm} extern calls; '
   163	                    f'{invisible} compiled graphs without Triton kernels are invisible to the decomposition')
