   532	def nvtx_pass_windows(path):
   533	    """pass_<i> projected ranges; require unique ids and non-overlap."""
   534	    try:
   535	        with open(path, newline='') as f:
   536	            rd = csv.reader(f)
   537	            head = next(rd)
   538	            c_name = next(i for i, h in enumerate(head)
   539	                          if h.strip().strip('"') in ('Name', 'Range'))
   540	            c_start = next(i for i, h in enumerate(head) if 'Start' in h)
   541	            c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
   542	            wins = {}
   543	            for r in rd:
   544	                nm = r[c_name].strip().strip('"').split(':')[-1]
   545	                if re.fullmatch(r'pass_\d+', nm):
   546	                    try:
   547	                        s = int(float(r[c_start].replace(',', '')))
   548	                        d = int(float(r[c_dur].replace(',', '')))
   549	                    except ValueError:
   550	                        continue
   551	                    i = int(nm.split('_')[1])
   552	                    if i in wins:
   553	                        return [], f'duplicate nvtx pass id {i}'
   554	                    wins[i] = (s, s + d)
   555	            ids = sorted(wins)
   556	            if ids != list(range(len(ids))):
   557	                return [], f'non-contiguous nvtx pass ids ({len(ids)} found)'
   558	            ordered = [wins[i] for i in ids]
   559	            for a, b in zip(ordered, ordered[1:]):
   560	                if b[0] < a[1]:
   561	                    return [], 'overlapping nvtx pass windows'
   562	            return ordered, None
   563	    except Exception as e:
   564	        return [], f'nvtx parse failed: {e}'
