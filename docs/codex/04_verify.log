    85	# run_traced ARM CHUNK TAG GRAPHMODE(node|graph) [extra...]  — one 5a block under nsys
    86	run_traced() {
    87	    local arm="$1" chunk="$2" tag="$3" gmode="$4"; shift 4
    88	    local base="$EVID/traces/trace_${arm}_${chunk}_${tag}"
    89	    local path="$EVID/full_${arm}_c${chunk}_${tag}.json"
    90	    local cap; cap=$(cap_for "$(tmo_for "$arm")")
