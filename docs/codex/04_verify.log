    77	@triton.jit
    78	def add_one(x_ptr):
    79	    v = tl.load(x_ptr)
    80	    tl.store(x_ptr, v + 1)
    81	
    82	
    83	if HAVE_GDC:
    84	    @triton.jit
    85	    def add_one_pdl(x_ptr):
    86	        gdc_wait()                       # wait for the primary before the dependent load
    87	        v = tl.load(x_ptr)
    88	        tl.store(x_ptr, v + 1)
    89	        gdc_launch_dependents()          # let the next kernel launch early
    90	else:
    91	    add_one_pdl = None
    92	
    93	
    94	def _trivial_kernels():
    95	    return add_one, add_one_pdl
