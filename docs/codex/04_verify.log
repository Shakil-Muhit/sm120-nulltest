   147	def graph_gate(require_zero_breaks):
   148	    """Compile-arm gate (prereg_amendments.md §1, C3/H): graph breaks and
   149	    unimplemented ops from the Dynamo counters; cudagraph skips from the
   150	    Inductor counters (plan 0.3 input)."""
