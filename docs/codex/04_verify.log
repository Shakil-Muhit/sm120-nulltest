    98	        run_matched "${pr%%:*}" "${pr##*:}" 352800 "m$r"
    99	    done
   100	done
   101	
   102	echo "=== [5] arm matrix, round-major ==="
   103	for r in $(seq 1 "$RESTARTS"); do
   104	    for chunk in 352800 4410; do
   105	        for arm in $ARMS; do
   106	            [ "$chunk" != "352800" ] && [ "$arm" = "C1D" ] && continue
