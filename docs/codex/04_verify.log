   197	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   198	    """Five repeats of the 5a block; min-of-medians + median spread; every
   199	    per-iteration list preserved; block wall timestamps for the clock log."""
   200	    blocks = []
   201	    for r in range(repeats):
   202	        t_start = time.time()
   203	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   204	        t_end = time.time()
   205	        s = sorted(lat)
   206	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   207	                       'latency_median_ms': median(lat),
   208	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   209	                       'throughput_ms_per_pass': thr,
   210	                       'unix_start': t_start, 'unix_end': t_end})
   211	    meds = [b['latency_median_ms'] for b in blocks]
   212	    return {'blocks': blocks, 'latency_medians_ms': meds,
   213	            'min_of_medians_ms': min(meds),
   214	            'median_spread_ms': max(meds) - min(meds),
   215	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   216	            'serialization_delta_pct': [
   217	                (b['latency_median_ms'] - b['throughput_ms_per_pass'])
   218	                / b['throughput_ms_per_pass'] * 100.0 for b in blocks],
   219	            'iters_per_block': iters, 'repeats': repeats}
