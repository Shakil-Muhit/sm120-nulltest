    61	def joint_settle(built, arms, rounds=2, passes=3):
    62	    """Alternate the two steps. The recording state is snapshotted BEFORE the
    63	    first round and after every round; stable iff unchanged across ALL rounds
    64	    (a re-recording of the arm built first shows up in round 1), and no new
    65	    graph breaks / unimplemented ops appear at any point."""
    66	    snaps = [tm.recording_state()]
    67	    for r in range(rounds + 1):
    68	        for arm in arms:
    69	            b = built[arm]
    70	            with torch.no_grad(), b['ctx']():
    71	                for _ in range(passes):
    72	                    b['step'](b['x'])
    73	        torch.cuda.synchronize()
    74	        snaps.append(tm.recording_state())
    75	    verdicts = [tm.recording_stable(a, c) for a, c in zip(snaps, snaps[1:])]
    76	    breaks = [sum(x['counters'].get('graph_break', {}).values()) +
    77	              sum(x['counters'].get('unimplemented', {}).values()) for x in snaps]
    78	    return {'stable': (None if any(v is None for v in verdicts) else all(verdicts)),
    79	            'new_breaks_during_joint_settle': breaks[-1] - breaks[0],
    80	            'rounds': rounds, 'snapshots': snaps}
