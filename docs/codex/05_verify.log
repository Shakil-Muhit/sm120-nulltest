   367	def refined_access(k, role):
   368	    """(reads, writes, unresolved) for a param role, derived from the kernel
   369	    SOURCE (gate-04 f32): in_out_ptr reads iff a tl.load on it exists and
   370	    writes iff a tl.store exists; neither found -> unresolved (charged
   371	    conservatively as read+write, and the site is flagged)."""
   372	    if role.startswith('in_out_ptr'):
   373	        r = role in k.get('loads_present', k.get('load_exprs', {}))
   374	        w = role in k.get('stores_present', k.get('store_exprs', {}))
   375	        return (r, w, not (r or w))
   376	    if role.startswith('in_ptr'):
   377	        return (True, False, role not in k.get('loads_present', k.get('load_exprs', {})))
   378	    if role.startswith('out_ptr'):
   379	        return (False, True, role not in k.get('stores_present', k.get('store_exprs', {})))
   380	    return (False, False, True)
