   229	                   'kernel_us_median': statistics.median(durs) / 1e3,
   230	                   'gap_us_median': statistics.median(gaps) / 1e3,
   231	                   'gap_us_min': min(gaps) / 1e3, 'gap_us_max': max(gaps) / 1e3,
   232	                   'negative_gap_fraction': sum(1 for g in gaps if g < 0) / len(gaps),
   233	                   'note': ('overlapping kernels (PDL): gap is not a boundary estimate'
   234	                            if 'pdl' in nm else 'serial gap = boundary estimate for this mode')}
   235	    res['_qualification'] = {'traced_json': traced_json, 'cases': len(cases), 'note': qual_note,
   236	                             'accepted_segments': sum(1 for k, v in res.items() if not k.startswith('_') and v.get('status') == 'ok')}
   237	    with open(out, 'w') as f:
   238	        json.dump(res, f, indent=1)
   239	    for nm, r in sorted(res.items()):
   240	        if 'gap_us_median' in r:
   241	            print(f"[boundary/trace] {nm}: kernel {r['kernel_us_median']:.3f} us, gap {r['gap_us_median']:.3f} us "
   242	                  f"({r['kernels']} kernels)")
   243	    print(f'-> {out}')
   244	
   245	
   246	def main():
   247	    ap = argparse.ArgumentParser()
   248	    ap.add_argument('--out', required=True)
   249	    ap.add_argument('--analyze-trace', default=None, help='export basename of a traced run')
   250	    ap.add_argument('--traced-json', default=None, help='the traced run\'s own boundary JSON')
   251	    args = ap.parse_args()

