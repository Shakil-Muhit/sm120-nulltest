   136	def bind_artifact(path, manifest_id):
   137	    """Per-artifact lineage sidecar: <path>.lineage.json = {manifest_id, sha256}."""
   138	    with open(path + '.lineage.json', 'w') as f:
   139	        json.dump({'manifest_id': manifest_id, 'sha256': sha256_file(path)}, f)
   140	
   141	
   142	def check_artifact(path, manifest_id):
   143	    side = path + '.lineage.json'
   144	    if not os.path.exists(side):
   145	        raise RuntimeError(f'artifact without lineage: {path}')
   146	    with open(side) as f:
   147	        rec = json.load(f)
   148	    if manifest_id is not None and rec.get('manifest_id') != manifest_id:
   149	        raise RuntimeError(f'artifact belongs to another session manifest: {path}')
   150	    if rec.get('sha256') != sha256_file(path):
   151	        raise RuntimeError(f'artifact changed since it was bound: {path}')

