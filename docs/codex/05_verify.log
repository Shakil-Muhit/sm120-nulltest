   106	def create_manifest(evidence_dir, paths, env, session):
   107	    if _git(_ROOT, 'status', '--porcelain'):
   108	        raise RuntimeError('session requires a committed, clean tree')
   109	    rec = {'manifest_id': str(uuid.uuid4()), 'session': session,
   110	           'created_utc': datetime.now(timezone.utc).isoformat(), 'env': env,
   111	           **identity(paths, env)}
   112	    path = os.path.join(evidence_dir, 'session_manifest.json')
   113	    if os.path.exists(path):
   114	        raise RuntimeError(f'{path} exists — one manifest per evidence directory')
   115	    with open(path, 'w') as f:
   116	        json.dump(rec, f, indent=1)
   117	    return rec
