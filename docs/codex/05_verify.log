   104	def boundary_perturbation(evidence):
   105	    a, b = (os.path.join(evidence, 'boundary_bench.json'), os.path.join(evidence, 'boundary_bench_traced.json'))
   106	    if not (os.path.exists(a) and os.path.exists(b)):
   107	        return {'status': 'UNRESOLVED: unprofiled or traced boundary run missing'}
   108	    ua, tb = j(a), j(b)
   109	    out = {}
   110	    for key, rec in ua.get('chains', {}).items():
   111	        t = tb.get('chains', {}).get(key, {})
   112	        if rec.get('status') == 'ok' and t.get('status') == 'ok':
   113	            out[key] = {'unprofiled_per_launch_us': rec['per_launch_us'],
   114	                        'traced_per_launch_us': t['per_launch_us'],
   115	                        'traced_over_unprofiled': t['per_launch_us'] / rec['per_launch_us']}
   116	    return out
