    81	def sdr_db(ref, est):
    82	    ref = ref.reshape(-1).double()
    83	    est = est.reshape(-1).double()
    84	    return _db(float((ref ** 2).sum()), float(((ref - est) ** 2).sum()))
    85	
    86	
    87	def si_sdr_db(ref, est):
    88	    ref = ref.reshape(-1).double()
    89	    est = est.reshape(-1).double()
    90	    ref = ref - ref.mean()
    91	    est = est - est.mean()
    92	    rr = float((ref ** 2).sum())
    93	    if rr == 0:
    94	        return 'undefined'
    95	    s = (est * ref).sum() / rr * ref
    96	    return _db(float((s ** 2).sum()), float(((est - s) ** 2).sum()))
