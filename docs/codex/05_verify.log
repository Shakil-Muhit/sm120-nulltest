   114	def pair_problems(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   115	    problems = []
   116	    if m is None:
   117	        return ['record missing']
   118	    if m.get('status') != 'VALID':
   119	        problems.append(f"status {m.get('status')}")
   120	    if not m.get('manifest_id'):
   121	        problems.append('not bound to a session manifest')
   122	    if (m.get('iters'), m.get('repeats')) != (iters, repeats):
   123	        problems.append(f"protocol {m.get('repeats')}x{m.get('iters')} is not the registered {repeats}x{iters}")
   124	    js = m.get('joint_settle') or {}
   125	    if js.get('stable') is not True:
   126	        problems.append('joint settle not affirmatively stable')
   127	    if js.get('new_breaks_during_joint_settle'):
   128	        problems.append('new graph breaks during the joint settle')
   129	    for arm, a in (m.get('arms') or {}).items():
   130	        if a.get('build_status') != 'OK':
   131	            problems.append(f'{arm}: build {a.get("build_status")}')
   132	            continue
   133	        v = a.get('validation') or {}
   134	        if v.get('status') != 'PASS':
   135	            problems.append(f"{arm}: validation {v.get('status', 'NONE')}")
   136	        elif not all(p.get('ref_sha256') for p in v.get('passes') or []):
   137	            problems.append(f'{arm}: references not lineage-checked')
   138	        if (a.get('graph_gate') or {}).get('status') != 'PASS':
   139	            problems.append(f'{arm}: graph gate not PASS')
   140	        if (a.get('settle') or {}).get('settle_capped'):
   141	            problems.append(f'{arm}: settle capped')
   142	        blocks = [b for b in (m.get('blocks') or []) if b.get('arm') == arm]
   143	        if len(blocks) != repeats or any(len(b.get('latency_ms_per_iter') or []) != iters for b in blocks):
   144	            problems.append(f'{arm}: blocks do not hold the registered {repeats}x{iters}')
   145	        if not all(b.get('counters_stable') is True for b in blocks):
   146	            problems.append(f'{arm}: recording not affirmatively stable during a block')
   147	    return problems
