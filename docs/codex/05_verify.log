   257	def bind_refs(ref_dir, manifest_id, write=False):
   258	    """Directory marker (kept for the session preflight); every reference
   259	    file additionally carries its own lineage sidecar (provenance.bind_artifact)."""
   260	    path = os.path.join(ref_dir, 'manifest_id.txt')
   261	    if write:
   262	        os.makedirs(ref_dir, exist_ok=True)
   263	        with open(path, 'w') as f:
   264	            f.write(manifest_id + '\n')
   265	        return
   266	    if manifest_id is None:
   267	        return
   268	    if not os.path.exists(path) or open(path).read().strip() != manifest_id:
   269	        raise RuntimeError('reference outputs are not bound to this session manifest')
   270	
   271	
   272	def validate(step, ctx, tier, chunk, ref_dir, save_reference=False, manifest_id=None):
   273	    """AUDIT-MAP[2] mechanics: two passes, different data (asserted), each
   274	    compared to the SAVED eager-A output for that (chunk, seed). With
   275	    save_reference=True (arm A reference step) the outputs are written
   276	    instead of compared."""
   277	    passes, prev_x = [], None
   278	    for seed in VAL_SEEDS:
   279	        x = make_input(chunk, seed)
   280	        if prev_x is not None:
   281	            assert not torch.equal(x, prev_x), \
   282	                'validation passes must use different input data'
   283	        prev_x = x
   284	        with torch.no_grad(), ctx():
   285	            out = step(x)
   286	            torch.cuda.synchronize()
   287	            out = out.clone()            # borrow discipline (build_spec rule 1)
   288	        path = ref_path(ref_dir, chunk, seed)
   289	        if save_reference:
   290	            os.makedirs(ref_dir, exist_ok=True)
   291	            torch.save(out.float().cpu(), path)
   292	            if manifest_id is not None:
   293	                provenance.bind_artifact(path, manifest_id)
   294	            passes.append({'seed': seed, 'saved': path, 'ref_sha256': provenance.sha256_file(path),
   295	                           'finite': bool(torch.isfinite(out).all())})
   296	            continue
   297	        if not os.path.exists(path):
   298	            raise FileNotFoundError(f'reference output missing: {path} '
   299	                                    '(run the arm-A reference step first)')
   300	        if manifest_id is not None:
   301	            provenance.check_artifact(path, manifest_id)
   302	        ref = torch.load(path, map_location='cuda', weights_only=True)
   303	        rec = compare_outputs(out, ref, tier)
   304	        rec['seed'] = seed
   305	        # persisted, checked reference identity (gate-04 f47): the hash the
   306	        # lineage check saw, so collectors can join restarts on it
   307	        rec['ref_sha256'] = provenance.sha256_file(path) if manifest_id is not None else None
   308	        passes.append(rec)
   309	        del ref
   310	    if save_reference:
   311	        return {'status': 'REFERENCE_SAVED', 'tier': tier, 'passes': passes}
   312	    ok = all(p['ok'] for p in passes)
   313	    return {'status': 'PASS' if ok else 'FAIL', 'tier': tier,
   314	            'rtol': TIERS[tier][0], 'atol': TIERS[tier][1], 'passes': passes}
