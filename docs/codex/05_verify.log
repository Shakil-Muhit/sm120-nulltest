   334	def resolve(gr, buf):
   335	    """Follow alias chain to the base buffer; return (base, view_meta|None)."""
   336	    meta = None
   337	    seen = set()
   338	    while buf in gr['aliases'] and buf not in seen:
   339	        seen.add(buf)
   340	        a = gr['aliases'][buf]
   341	        if meta is None and 'shape' in a:
   342	            meta = {'shape': a['shape'], 'stride': a['stride']}
   343	        buf = a['base']
   344	    return buf, meta
