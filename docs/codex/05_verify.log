    52	def run_problems(rec, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS,
    53	                 require_manifest=True, require_timing=True):
    54	    """All reasons a single-arm record is NOT a qualified measurement."""
    55	    problems = []
    56	    if rec is None:
    57	        return ['record missing']
    58	    if rec.get('status') != 'VALID':
    59	        problems.append(f"status {rec.get('status')}")
    60	    if rec.get('arm') == 'ANVTX':
    61	        problems.append('attribution arm')
    62	    if rec.get('nvtx_pass'):
    63	        problems.append('traced/attribution run')
    64	    if rec.get('planted_fault') or rec.get('planted_fault_const') is not None:
    65	        problems.append('planted fault run')
    66	    v = rec.get('validation') or {}
    67	    if v.get('status') != 'PASS':
    68	        problems.append(f"validation {v.get('status', 'NONE')}")
    69	    else:
    70	        if not all(p.get('ref_sha256') for p in v.get('passes') or []):
    71	            problems.append('validation references not lineage-checked (no persisted hash)')
    72	    if require_manifest and not rec.get('manifest_id'):
    73	        problems.append('not bound to a session manifest')
    74	    if require_timing:
    75	        b = _blocks_ok(rec.get('timing'), iters, repeats)
    76	        if b:
    77	            problems.append(b)
    78	    if not rec.get('effective_variant') and any(k in rec for k in VARIANT_FIELDS):
    79	        problems.append('effective variant not recorded')
    80	    if rec.get('arm') in COMPILE_ARMS:
    81	        if rec.get('counters_stable') is not True:
    82	            problems.append('recording stability not affirmatively established')
    83	        s = rec.get('settle') or {}
    84	        if s.get('settle_capped'):
    85	            problems.append('compile settle capped')
    86	        g = rec.get('graph_gate') or {}
    87	        if g.get('status') != 'PASS':
    88	            problems.append(f"graph gate {g.get('status', 'NONE')}")
    89	    if rec.get('sdr_gate') and rec['sdr_gate'].get('status') not in ('PASS', 'REFERENCE_SAVED'):
    90	        problems.append(f"SDR gate {rec['sdr_gate'].get('status')}")
    91	    return problems
