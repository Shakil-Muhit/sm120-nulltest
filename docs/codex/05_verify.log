    40	def make_input(chunk, seed, device='cuda'):
    41	    """Deterministic input independent of device RNG (sm120 make_input)."""
    42	    gen = torch.Generator(device='cpu').manual_seed(seed)
    43	    return torch.randn(1, CHANNELS, chunk, generator=gen).to(device)
