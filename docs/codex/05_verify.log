   155	def graph_gate(require_zero_breaks):
   156	    """Compile-arm gate (prereg_amendments.md §1, C3/H): graph breaks and
   157	    unimplemented ops from the Dynamo counters; cudagraph skips from the
   158	    Inductor counters (plan 0.3 input)."""
   159	    snap = dynamo_counters()
   160	    breaks = sum(snap.get('graph_break', {}).values())
   161	    unsupported = sum(snap.get('unimplemented', {}).values())
   162	    inductor = snap.get('inductor', {})
   163	    skips = {k: v for k, v in inductor.items() if 'cudagraph' in k}
   164	    rec = {'graph_break_count': breaks, 'unimplemented_count': unsupported,
   165	           'unique_graphs': snap.get('stats', {}).get('unique_graphs', 0),
   166	           'cudagraph_counters': skips,
   167	           'suppress_errors': bool(torch._dynamo.config.suppress_errors),
   168	           'require_zero_breaks': require_zero_breaks,
   169	           'graph_break_reasons': list(snap.get('graph_break', {}).keys())[:40]}
   170	    rec['status'] = ('PASS' if (not require_zero_breaks or
   171	                                (breaks == 0 and unsupported == 0))
   172	                     and not rec['suppress_errors'] else 'FAIL')
   173	    return rec
