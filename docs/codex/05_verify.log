   334	def resolve(gr, buf):
   335	    """Follow alias chain to the base buffer; return (base, view_meta|None)."""
   336	    meta = None
   337	    seen = set()
   338	    while buf in gr['aliases'] and buf not in seen:
   339	        seen.add(buf)
   340	        a = gr['aliases'][buf]
   341	        if meta is None and 'shape' in a:
   342	            meta = {'shape': a['shape'], 'stride': a['stride']}
   343	        buf = a['base']
   344	    return buf, meta
   345	
   346	
   347	def arg_meta(gr, a):
   348	    """Effective (shape, stride, dtype, base) the kernel sees for arg a.
   349	    Shape precedence: reinterpret literal > alias view meta > an
   350	    assert_size_stride/alloc on the arg's OWN name (fallback outputs and
   351	    getitem results are asserted by name) > the base allocation."""
   352	    base, alias_meta = resolve(gr, a['buf'])
   353	    alloc = gr['allocs'].get(base, {})
   354	    own = gr['allocs'].get(a['buf'], {})
   355	    if a.get('reinterpret') and a.get('shape'):
   356	        shape, stride = a['shape'], a['stride']
   357	    elif alias_meta:
   358	        shape, stride = alias_meta['shape'], alias_meta['stride']
   359	    elif own.get('shape'):
   360	        shape, stride = own['shape'], own.get('stride', ())
   361	    else:
   362	        shape, stride = alloc.get('shape', ()), alloc.get('stride', ())
   363	    return {'shape': shape or (), 'stride': stride or (),
   364	            'dtype': alloc.get('dtype') or own.get('dtype'), 'base': base}
