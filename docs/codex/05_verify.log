   230	def compare_outputs(out, ref, tier):
   231	    rtol, atol = TIERS[tier]
   232	    out = out.float()
   233	    ref = ref.float()
   234	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   235	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   236	    if out.shape != ref.shape:
   237	        rec['reason'] = 'shape mismatch'
   238	        rec['max_abs_diff'] = None
   239	        return rec
   240	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   241	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   242	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   243	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   244	    if not (fin_out and fin_ref):
   245	        rec['reason'] = 'non-finite values present'
   246	        return rec
   247	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   248	    if not rec['ok']:
   249	        rec['reason'] = 'tolerance exceeded'
   250	    return rec
