    82	def main():
    83	    ap = argparse.ArgumentParser()
    84	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
    85	    ap.add_argument('--out', required=True)
    86	    ap.add_argument('--arm', default='')
    87	    ap.add_argument('--expected-passes', type=int, default=None)
    88	    args = ap.parse_args()
    89	    wins = pass_windows(args.base + '_nvtx_gpu_proj_trace.csv')
    90	    assert wins, 'no pass_<i> NVTX windows in the projection export'
    91	
    92	    head, rows = read_csv(args.base + '_cuda_api_trace.csv')
    93	    c_start, c_name = col(head, 'Start (ns)', contains='Start'), col(head, 'Name')
    94	    c_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
    95	    api = []
    96	    for r in rows:
    97	        try:
    98	            api.append({'start': int(float(r[c_start].replace(',', ''))), 'name': r[c_name],
    99	                        'corr': r[c_corr].strip() if c_corr is not None else ''})
   100	        except (ValueError, IndexError):
   101	            continue
   102	    graph_corrs = {a['corr'] for a in api if 'GraphLaunch' in a['name'] and a['corr']}
   103	    launch_corrs = {a['corr'] for a in api if 'LaunchKernel' in a['name'] and a['corr']}
   104	
   105	    head, rows = read_csv(args.base + '_cuda_gpu_trace.csv')
   106	    g_start, g_name = col(head, 'Start (ns)', contains='Start'), col(head, 'Name')
   107	    g_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
   108	    kern = []
   109	    for r in rows:
   110	        try:
   111	            kern.append({'start': int(float(r[g_start].replace(',', ''))), 'name': r[g_name],
   112	                         'corr': r[g_corr].strip() if g_corr is not None else ''})
   113	        except (ValueError, IndexError):
   114	            continue
   115	
   116	    per_pass = []
   117	    for w in wins:
   118	        cs, ce = w['cpu']
   119	        gs, ge = w['gpu']
   120	        a_in = [a for a in api if cs <= a['start'] < ce]
   121	        k_in = [k for k in kern if gs <= k['start'] < ge]
   122	        graph_launches = [a for a in a_in if 'GraphLaunch' in a['name']]
   123	        eager_launch = sum(1 for a in a_in if 'LaunchKernel' in a['name'])
   124	        memcpy_api = sum(1 for a in a_in if 'Memcpy' in a['name'] or 'Memset' in a['name'])
   125	        # nsys lists memcpy/memset operations as GPU-trace rows ('[CUDA memcpy ...]',
   126	        # '[CUDA memset]'); they correlate to cudaMemcpyAsync/cudaMemsetAsync, are
   127	        # not kernels, and are reported in their own category (never 'unresolved')
   128	        memops = [k for k in k_in if k['name'].startswith('[CUDA mem')]
   129	        kernels_only = [k for k in k_in if not k['name'].startswith('[CUDA mem')]
   130	        memops_in_graph = [k for k in memops if k['corr'] in graph_corrs]
   131	        captured = [k for k in kernels_only if k['corr'] in graph_corrs]
   132	        eager = [k for k in kernels_only if k['corr'] in launch_corrs and k['corr'] not in graph_corrs]
   133	        unresolved = [k for k in kernels_only if k['corr'] not in graph_corrs and k['corr'] not in launch_corrs]
   134	        staging = [k for k in eager if is_staging(k['name'])]
   135	        uncaptured = [k for k in eager if k not in staging]
   136	        per_pass.append({'graph_launch_calls': len(graph_launches),
   137	                         'graph_launch_instances': len({a['corr'] for a in graph_launches}),
   138	                         'eager_kernel_launch_calls': eager_launch,
   139	                         'memcpy_memset_api_calls': memcpy_api,
   140	                         'kernels_total': len(kernels_only),
   141	                         'memops_total': len(memops),
   142	                         'memops_inside_replay': len(memops_in_graph),
   143	                         'memops_eager': len(memops) - len(memops_in_graph),
   144	                         'memop_names': sorted({k['name'] for k in memops}),
   145	                         'captured_model_kernels': len(captured),
   146	                         'input_staging_kernels': len(staging),
   147	                         'uncaptured_model_kernels': len(uncaptured),
   148	                         'unresolved_kernels': len(unresolved),
   149	                         'uncaptured_names': sorted({k['name'][:90] for k in uncaptured}),
   150	                         'unresolved_names': sorted({k['name'][:90] for k in unresolved})})
   151	    keys = ('graph_launch_calls', 'graph_launch_instances', 'eager_kernel_launch_calls',
   152	            'memcpy_memset_api_calls', 'kernels_total', 'memops_total', 'memops_inside_replay',
   153	            'memops_eager', 'captured_model_kernels', 'input_staging_kernels',
   154	            'uncaptured_model_kernels', 'unresolved_kernels')
   155	    summary = {'arm': args.arm, 'passes': len(per_pass), 'expected_passes': args.expected_passes,
   156	               'method': 'CorrId correlation: kernel captured iff its CorrId belongs to a '
   157	                         'cudaGraphLaunch/cuGraphLaunch API call; CPU NVTX windows for API rows, '
   158	                         'GPU-projected windows for kernels',
   159	               'median': {k: statistics.median(p[k] for p in per_pass) for k in keys},
   160	               'max_uncaptured_in_any_pass': max(p['uncaptured_model_kernels'] for p in per_pass),
   161	               'max_unresolved_in_any_pass': max(p['unresolved_kernels'] for p in per_pass),
   162	               'min_graph_launches_in_any_pass': min(p['graph_launch_calls'] for p in per_pass),
