   146	        return None                      # unresolved: observer missing
   147	    ta, tb = a['tree'], b['tree']
   148	    return (compile_stable(a['counters'], b['counters']) and
   149	            ta.get('manager_id') == tb.get('manager_id') and
   150	            ta.get('node_ids') == tb.get('node_ids') and
   151	            ta.get('function_ids') == tb.get('function_ids') and
   152	            ta['roots'] == tb['roots'])
