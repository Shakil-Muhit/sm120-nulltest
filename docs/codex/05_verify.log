   111	def separate_clip(step, ctx, mixture, chunk):
   112	    """Non-overlapping chunked processing + concatenation (registered policy)."""
   113	    assert CLIP_SAMPLES % chunk == 0, (CLIP_SAMPLES, chunk)
   114	    outs = []
   115	    with torch.no_grad(), ctx():
   116	        for i in range(CLIP_SAMPLES // chunk):
   117	            x = mixture[:, i * chunk:(i + 1) * chunk].unsqueeze(0).cuda()
   118	            out = step(x)
   119	            torch.cuda.synchronize()
   120	            out = out.float().clone()            # borrowed replay buffer -> owned
   121	            if out.dim() == 3:
   122	                out = out[0]
   123	            assert out.shape == (2, chunk), tuple(out.shape)
   124	            outs.append(out.cpu())
   125	    return torch.cat(outs, dim=-1)
