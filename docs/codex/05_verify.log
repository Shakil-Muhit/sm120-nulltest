    50	        settle = tm.settle_compile(step, x, ctx, settle_max, 5)
    51	        gate = tm.graph_gate(arm in arms_mod.REQUIRE_ZERO_BREAKS)
    52	    else:
    53	        with torch.no_grad(), ctx():
    54	            for _ in range(10):
    55	                step(x)
    56	        torch.cuda.synchronize()
    57	    return {'model': model, 'step': step, 'ctx': ctx, 'x': x, 'info': info,
    58	            'settle': settle, 'gate': gate, 'use_amp': use_amp}
