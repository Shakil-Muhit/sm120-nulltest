    22	def _blocks_ok(timing, iters, repeats):
    23	    if not timing:
    24	        return 'no timed region'
    25	    if timing.get('repeats') != repeats or timing.get('iters_per_block') != iters:
    26	        return (f"protocol {timing.get('repeats')}x{timing.get('iters_per_block')} "
    27	                f"is not the registered {repeats}x{iters}")
    28	    blocks = timing.get('blocks') or []
    29	    if len(blocks) != repeats:
    30	        return f'{len(blocks)} blocks recorded, {repeats} required'
    31	    for b in blocks:
    32	        if len(b.get('latency_ms_per_iter') or []) != iters:
    33	            return 'a block did not record exactly the registered pass count'
    34	        if not isinstance(b.get('throughput_ms_per_pass'), (int, float)):
    35	            return 'a block lacks a throughput record'
    36	    return None
