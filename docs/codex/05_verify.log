   175	
   176	def timed_run(step, x, ctx, iters=50, nvtx_pass=False):
   177	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   178	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   179	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   180	    pass windows for the exports; never inside compiled code)."""
   181	    with torch.no_grad(), ctx():
   182	        torch.cuda.synchronize()
   183	        torch.cuda.profiler.start()
   184	        latency_ms = []
   185	        for i in range(iters):
   186	            if nvtx_pass:
   187	                torch.cuda.nvtx.range_push(f'pass_{i}')
   188	            t0 = time.perf_counter()
   189	            step(x)
   190	            torch.cuda.synchronize()
   191	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   192	            if nvtx_pass:
   193	                torch.cuda.nvtx.range_pop()
   194	        torch.cuda.profiler.stop()
   195	
   196	        torch.cuda.synchronize()
   197	        t0 = time.perf_counter()
   198	        for _ in range(iters):
   199	            step(x)
   200	        torch.cuda.synchronize()
   201	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   202	    return latency_ms, throughput_ms
   203	
   204	
   205	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   206	    """Five repeats of the 5a block; min-of-medians + median spread; every
   207	    per-iteration list preserved; block wall timestamps for the clock log."""
   208	    blocks = []
   209	    for r in range(repeats):
   210	        t_start = time.time()
   211	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   212	        t_end = time.time()
   213	        s = sorted(lat)
   214	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   215	                       'latency_median_ms': median(lat),
   216	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   217	                       'throughput_ms_per_pass': thr,
   218	                       'unix_start': t_start, 'unix_end': t_end})
   219	    meds = [b['latency_median_ms'] for b in blocks]
   220	    return {'blocks': blocks, 'latency_medians_ms': meds,
   221	            'min_of_medians_ms': min(meds),
   222	            'median_spread_ms': max(meds) - min(meds),
   223	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   224	            'serialization_delta_pct': [
   225	                (b['latency_median_ms'] - b['throughput_ms_per_pass'])
   226	                / b['throughput_ms_per_pass'] * 100.0 for b in blocks],
   227	            'iters_per_block': iters, 'repeats': repeats}
