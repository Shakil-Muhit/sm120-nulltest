    10	echo "=== [2/4] nsight-systems ==="
    11	if command -v nsys >/dev/null 2>&1; then
    12	    echo "nsys already present"
    13	else
    14	    apt-get update -qq
    15	    # attempt 1: whatever repos the image already carries
    16	    if ! apt-get install -y -qq nsight-systems-cli 2>/dev/null; then
    17	        echo "adding NVIDIA devtools repo..."
    18	        apt-get install -y -qq wget gnupg ca-certificates
    19	        wget -qO- https://developer.download.nvidia.com/devtools/repos/ubuntu2204/amd64/nvidia.pub \
    20	            | gpg --dearmor > /usr/share/keyrings/nvidia-devtools.gpg
    21	        echo "deb [signed-by=/usr/share/keyrings/nvidia-devtools.gpg] https://developer.download.nvidia.com/devtools/repos/ubuntu2204/amd64/ /" \
    22	            > /etc/apt/sources.list.d/nvidia-devtools.list
    23	        apt-get update -qq
    24	        # package naming drifts (nsight-systems-cli vs nsight-systems-<ver>): prefer the
    25	        # CLI meta-package when the repo offers it (2026-09-20: candidate 2026.5.1.161),
    26	        # else the newest versioned package; never the 2021 'nsight-systems-target' stub
    27	        if apt-cache policy nsight-systems-cli 2>/dev/null | grep -q 'Candidate: [0-9]'; then
    28	            PKG=nsight-systems-cli
    29	        else
    30	            PKG=$(apt-cache search '^nsight-systems-20' | awk '{print $1}' | sort -V | tail -1)
    31	        fi
    32	        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${PKG:-nsight-systems-cli}"
    33	    fi
    34	fi
    35	command -v nsys >/dev/null 2>&1 && nsys --version | head -1 \
    36	    || { echo "FATAL: nsys install failed. Inspect: apt-cache search nsight-systems"; exit 1; }
    37	
    38	echo "=== [3/4] counter check (informational; timing + nsys work even if locked) ==="
    39	if command -v ncu >/dev/null 2>&1; then
    40	    ncu --set basic -c 1 python -c "import torch; (torch.randn(256,256,device='cuda')@torch.randn(256,256,device='cuda')).sum().item()" 2>&1 | tail -2
    41	else
    42	    echo "ncu not on PATH — fine for null test"
    43	fi
    44	
    45	echo "=== [4/4] workspace + session hygiene ==="
    46	apt-get install -y -qq tmux
    47	mkdir -p ~/work/evidence
    48	cd ~/work && echo "POD READY $(date -Is)" | tee evidence/pod_ready.txt
    49	
    50	# ============================================================================
    51	# Sections [5/6] and [6/6] appended per session-owner resolution (2026-08-16):
    52	# setup.sh may be EXTENDED, not rewritten. Sections [1/4]-[4/4] above are
    53	# byte-identical to the provided file; the closing ">>> Next: tmux" hint
    54	# (originally the last two lines) is relocated below [6/6] so it remains the
    55	# final output. Flagged in README "Deviations & ambiguities".
    56	# Idempotency: every step checks-before-does — running setup.sh twice on the
    57	# same pod is safe and fast (matches the nsys section's pattern).
    58	# ============================================================================
    59	
    60	# [4/4] above ended with `cd ~/work`, so a relative BASH_SOURCE (the normal
    61	# `bash setup.sh` from the repo root) must be resolved from the ORIGINAL
    62	# invocation directory — which is exactly what line 42's cd left in OLDPWD.
    63	REPO_DIR="$(cd "${OLDPWD:-$PWD}" && cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    64	MSST_DIR="${MSST_DIR:-$HOME/work/msst}"
    65	
    66	echo "=== [5/6] public model code (P8 full-forward trace ONLY — arms never touch it) ==="
    67	# Python deps FIRST, before any gate that can exit: the arms need librosa/
    68	# einops regardless of the P8 pin state, so a pin problem must not leave the
    69	# pod without arm dependencies.
    70	# Minimal set only — NOT the msst repo's full requirements.txt (flagged in
    71	# README "Deviations"):
    72	#   librosa einops                            — already imported by frontend.py
    73	#   pyyaml omegaconf ml_collections soundfile wandb — utils/settings.py import chain
    74	#   beartype rotary_embedding_torch           — models/bs_roformer/mel_band_roformer.py
    75	#   tqdm packaging loralib                    — utils/model_utils.py, models/bs_roformer/attend.py
    76	# (verified against the PINNED commit ea7eb9c / v1.0.21 — wandb and loralib are
    77	#  top-level imports there, unlike at upstream HEAD)
    78	pip install -q librosa einops pyyaml omegaconf ml_collections soundfile wandb beartype rotary_embedding_torch tqdm packaging loralib
    79	python -c "import yaml, omegaconf, ml_collections, soundfile, wandb, beartype, rotary_embedding_torch, einops, librosa, tqdm, packaging, loralib" \
    80	    || { echo "FATAL: P8 model-path imports failed after pip install"; exit 1; }
    81	
    82	# Pinned commit lives in configs/msst_commit.txt (session owner fills it in).
    83	MSST_COMMIT="$(grep -v '^[[:space:]]*#' "$REPO_DIR/configs/msst_commit.txt" 2>/dev/null | grep -m1 '[^[:space:]]' | tr -d '[:space:]')"
    84	if [ -z "$MSST_COMMIT" ]; then
    85	    echo "FATAL: configs/msst_commit.txt has no commit hash. Fill in the pinned"
    86	    echo "       commit of ZFTurbo/Music-Source-Separation-Training, then re-run."
    87	    exit 1
    88	fi
    89	case "$MSST_COMMIT" in
    90	    *[!0-9a-f]*)
    91	        echo "FATAL: '$MSST_COMMIT' in configs/msst_commit.txt is not a commit hash"; exit 1 ;;
    92	esac
    93	if [ "${#MSST_COMMIT}" -ne 40 ]; then
    94	    echo "FATAL: configs/msst_commit.txt must hold the FULL 40-char commit hash"
    95	    echo "       (got ${#MSST_COMMIT} chars: '$MSST_COMMIT') — provenance pin"
    96	    exit 1
    97	fi
    98	if [ ! -d "$MSST_DIR/.git" ]; then
    99	    git clone https://github.com/ZFTurbo/Music-Source-Separation-Training.git "$MSST_DIR" \
   100	        || { echo "FATAL: clone of public model repo failed"; exit 1; }
   101	fi
   102	if [ "$(git -C "$MSST_DIR" rev-parse HEAD)" != "$MSST_COMMIT" ]; then
   103	    git -C "$MSST_DIR" fetch --quiet origin || true
   104	    git -C "$MSST_DIR" checkout --quiet --detach "$MSST_COMMIT" \
   105	        || { echo "FATAL: pinned commit $MSST_COMMIT not found in $MSST_DIR"; exit 1; }
   106	fi
   107	echo "msst pinned at $(git -C "$MSST_DIR" rev-parse HEAD)" | tee -a ~/work/evidence/pod_ready.txt
   108	
   109	echo "=== [6/6] checkpoint fetch (hash-verified, cached, skip-if-present) ==="
   110	bash "$REPO_DIR/scripts/fetch_checkpoint.sh" || exit 1
   111	
   112	echo ""
   113	echo ">>> Next: tmux new -s run    (so a dropped browser tab can't kill the arms)"

