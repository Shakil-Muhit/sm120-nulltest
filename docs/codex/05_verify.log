   603	    n_pass = max(1, round(len(sdpa_idx) / 12)) if sdpa_idx else 1
   604	    gaps = [(rows[i + 1]['start'] - (rows[i]['start'] + rows[i]['dur']), i)
   605	            for i in range(len(rows) - 1)]
   606	    cuts = sorted(i for _, i in sorted(gaps, key=lambda g: -g[0])[:n_pass - 1])
   607	    passes, prev = [], 0
   608	    for c in cuts:
   609	        passes.append(rows[prev:c + 1])
   610	        prev = c + 1
   611	    passes.append(rows[prev:])
   612	    return passes, 'gap-heuristic'
