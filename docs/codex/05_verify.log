   169	                if len(mv) != 1 or (r1 and qualify.variant(r1) not in mv):
   170	                    reasons.append(f'{arm}: matched variant differs from its r1 SDR-qualified variant')
   171	            deltas = {t: (m.get('matched_delta_ms') or {}).get('median') for t, m in by_tag.items()}
   172	            entry = {'required': {t: (m or {}).get('pair_eligible') for t, m in req.items()},
   173	                     'deltas_ms': deltas, 'reasons': reasons,
   174	                     'pair_headline': 'HEADLINE' if not reasons else 'INCOMPLETE'}
   175	            if not reasons:
   176	                entry['median_delta_ms'] = statistics.median(req[t]['matched_delta_ms']['median'] for t in REQUIRED_MATCHED)
   177	                entry['median_delta_pct_of_a'] = statistics.median(req[t]['matched_delta_ms']['median_pct_of_a'] for t in REQUIRED_MATCHED)
   178	            pair_summary[key] = entry
   179	            print(f"  {key}: {entry['pair_headline']} deltas {deltas} "
   180	                  + (f"-> median {entry['median_delta_ms']:+.4f} ms ({entry['median_delta_pct_of_a']:+.2f}% of a)" if not reasons else f"reasons {reasons}"))
   181	    out = os.path.join(args.evidence_dir, 'summary_full.json')
   182	    with open(out, 'w') as f:
   183	        json.dump({'cells': {f'{a}_{c}': v for (a, c), v in cells.items()},
   184	                   'matched_pairs': pair_summary,
   185	                   'runs': {f'{a}_{c}_{t}': r for (a, c), tr in runs.items() for t, r in tr.items()}},
   186	                  f, indent=1)
   187	    print(f'\nwritten: {out}')
