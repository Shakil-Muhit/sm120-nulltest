     3	#   pod_run.sh ship        re-ship the COMMITTED tree (git bundle) to the pod, keep evidence/
     4	#   pod_run.sh session1    launch scripts/session1.sh in a detached tmux session on the pod
     5	#   pod_run.sh session2    launch scripts/session2.sh likewise
     6	#   pod_run.sh tail        follow the pod's session console log
     7	#   pod_run.sh status      tmux + GPU + last console lines
     8	#   pod_run.sh extract     tar the pod's evidence/ into ~/ms/evidence_pod/<ts>/ (OFF-POD copy)
     9	#   pod_run.sh terminate   terminate THIS pod by exact id (refuses if evidence was never extracted)
    10	set -u
    11	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    12	KEY="$HOME/.runpod/ssh/RunPod-Key-Go"
    13	export PATH="$HOME/.local/bin:$PATH"
    14	[ -f "$REPO_DIR/pod.env" ] || { echo "FATAL: pod.env missing (run scripts/pod_up.sh)"; exit 1; }
    15	. "$REPO_DIR/pod.env"
    16	SSH="ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -i $KEY -p $POD_PORT root@$POD_HOST"
    17	SCP="scp -o StrictHostKeyChecking=no -i $KEY -P $POD_PORT"
    18	CMD="${1:-status}"
    19	case "$CMD" in
    20	  ship)
    21	    cd "$REPO_DIR"
    22	    [ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "FATAL: commit first"; exit 1; }
    23	    COMMIT=$(git rev-parse HEAD)
    24	    git bundle create /tmp/sm120.bundle HEAD main 2>/dev/null || git bundle create /tmp/sm120.bundle HEAD
    25	    $SCP /tmp/sm120.bundle "root@$POD_HOST:/root/sm120.bundle"
    26	    # keep evidence/ (git-ignored) across re-ships; refuse while a session runs
    27	    $SSH "tmux has-session -t run 2>/dev/null && { echo 'FATAL: a session is running'; exit 1; }
    28	          set -e; cd /root/sm120-nulltest && git fetch -q /root/sm120.bundle HEAD && git checkout -q $COMMIT && git status --porcelain --untracked-files=no | wc -l && git rev-parse HEAD"
    29	    ;;
    30	  session1|session2)
    31	    $SSH "cd /root/sm120-nulltest && mkdir -p evidence && tmux has-session -t run 2>/dev/null && { echo 'FATAL: a tmux session named run already exists'; exit 1; }
    32	          export MSST_DIR=/root/work/msst CLIPS_DIR=/root/work/sdr_clips PYTHONDONTWRITEBYTECODE=1
    33	          tmux new -d -s run \"bash scripts/$CMD.sh > evidence/${CMD}.log 2>&1; echo EXIT=\\\$? >> evidence/${CMD}.log\"
    34	          sleep 3; tail -n 5 evidence/${CMD}.log"
    35	    ;;
    36	  tail)
    37	    LOGN="${2:-session1}"
    38	    $SSH "tail -n 40 -F /root/sm120-nulltest/evidence/${LOGN}.log"
    39	    ;;
    40	  status)
    41	    $SSH "tmux ls 2>/dev/null || echo 'no tmux session'; nvidia-smi --query-gpu=name,utilization.gpu,memory.used,clocks.sm --format=csv,noheader; ls /root/sm120-nulltest/evidence 2>/dev/null | wc -l; for f in /root/sm120-nulltest/evidence/session*.log; do [ -f \$f ] && { echo \"--- \$f\"; tail -n 6 \$f; }; done"
    42	    ;;
    43	  extract)
    44	    set -o pipefail
    45	    TS=$(date +%Y%m%d_%H%M)
    46	    DEST="$HOME/ms/evidence_pod/${POD_ID}_$TS"
    47	    mkdir -p "$DEST"
    48	    REMOTE_N=$($SSH "cd /root/sm120-nulltest && find evidence -type f | wc -l") || { echo "FATAL: cannot count remote files"; exit 1; }
    49	    $SSH "cd /root/sm120-nulltest && tar czf - evidence" > "$DEST/evidence.tgz" || { echo "FATAL: transfer failed"; exit 1; }
    50	    tar tzf "$DEST/evidence.tgz" > /dev/null || { echo "FATAL: archive invalid"; exit 1; }
    51	    tar xzf "$DEST/evidence.tgz" -C "$DEST" || { echo "FATAL: extraction failed"; exit 1; }
    52	    LOCAL_N=$(find "$DEST/evidence" -type f | wc -l)
    53	    [ "$LOCAL_N" -eq "$REMOTE_N" ] || { echo "FATAL: file count mismatch remote=$REMOTE_N local=$LOCAL_N"; exit 1; }
    54	    SHA=$(sha256sum "$DEST/evidence.tgz" | cut -d" " -f1)
    55	    # receipt bound to THIS pod id + archive hash (gate-04 f59)
    56	    echo "POD_ID=$POD_ID DEST=$DEST FILES=$LOCAL_N SHA256=$SHA TS=$TS" >> "$REPO_DIR/pod.env.extracted"
    57	    du -sh "$DEST"; ls "$DEST/evidence" | head -20
    58	    echo "EXTRACTED -> $DEST ($LOCAL_N files, sha256 $SHA)"
    59	    ;;
    60	  terminate)
    61	    grep -q "^POD_ID=$POD_ID " "$REPO_DIR/pod.env.extracted" 2>/dev/null \
    62	        || { echo "FATAL: no validated extraction receipt for pod $POD_ID — extract first"; exit 1; }
    63	    LAST=$(grep "^POD_ID=$POD_ID " "$REPO_DIR/pod.env.extracted" | tail -1)
    64	    D=$(echo "$LAST" | sed -n "s/.*DEST=\([^ ]*\).*/\1/p"); H=$(echo "$LAST" | sed -n "s/.*SHA256=\([^ ]*\).*/\1/p")
    65	    [ -f "$D/evidence.tgz" ] && [ "$(sha256sum "$D/evidence.tgz" | cut -d" " -f1)" = "$H" ] \
    66	        || { echo "FATAL: extracted archive missing or changed ($D)"; exit 1; }
    67	    echo "terminating pod $POD_ID (melband_profiling) — production pods untouched; evidence at $D"
    68	    runpodctl pod terminate "$POD_ID"
    69	    ;;
    70	  *) echo "usage: $0 ship|session1|session2|tail [name]|status|extract|terminate"; exit 2 ;;
    71	esac
     1	#!/bin/bash
     2	# SM120 sprint — pod setup. Run once on a fresh RunPod PyTorch pod (you are root).
     3	# Usage:  bash setup.sh
     4	set -u   # deliberately NOT -e: fallbacks are handled explicitly
     5	
     6	echo "=== [1/4] environment fingerprint ==="
     7	nvidia-smi --query-gpu=name,driver_version --format=csv,noheader || true
     8	python -c "import torch, triton; print('torch', torch.__version__, '| triton', triton.__version__, '| cap', torch.cuda.get_device_capability())"
