    46	def settle_compile(step, x, ctx, max_iters=60, consecutive=5):
    47	    """Run until torch._dynamo counters are unchanged for `consecutive`
    48	    passes (sm120 settle_compile; str-keyed snapshot)."""
    49	    import torch._dynamo.utils as dynamo_utils
    50	
    51	    def snap():
    52	        return {str(k): {str(kk): int(vv) for kk, vv in v.items()}
    53	                for k, v in dynamo_utils.counters.items()}
    54	
    55	    t0 = time.perf_counter()
    56	    prev, stable, it = snap(), 0, 0
    57	    with torch.no_grad(), ctx():
    58	        while stable < consecutive and it < max_iters:
    59	            step(x)
    60	            it += 1
    61	            cur = snap()
    62	            stable = stable + 1 if cur == prev else 0
    63	            prev = cur
    64	    torch.cuda.synchronize()
    65	    return {'settle_iters': it, 'settle_stable_tail': stable,
    66	            'settle_capped': stable < consecutive,
    67	            'settle_wall_s': round(time.perf_counter() - t0, 3),
    68	            'dynamo_counters': prev}
    69	
    70	
    71	def dynamo_counters():
    72	    from torch._dynamo.utils import counters
    73	    return {str(k): {str(kk): int(vv) for kk, vv in v.items()}
    74	            for k, v in counters.items()}
    75	
    76	
    77	STABILITY_KEYS = ('graph_break', 'unimplemented')
    78	
    79	
    80	def compile_stable(before, after):
    81	    """Recording/compilation stability (gate-02 f21): no NEW graph breaks or
    82	    unimplemented ops, the same number of unique Dynamo graphs, and EVERY
    83	    Inductor cudagraph counter unchanged (recordings, skips, non-static
    84	    input recordings). Per-call counters (calls, frames) are ignored."""
    85	    for k in STABILITY_KEYS:
    86	        if before.get(k, {}) != after.get(k, {}):
    87	            return False
    88	    if before.get('stats', {}).get('unique_graphs') != after.get('stats', {}).get('unique_graphs'):
    89	        return False
    90	    b_ind = {k: v for k, v in before.get('inductor', {}).items() if 'cudagraph' in k}
    91	    a_ind = {k: v for k, v in after.get('inductor', {}).items() if 'cudagraph' in k}
    92	    return b_ind == a_ind
    93	
    94	
    95	def cudagraph_tree_state():
    96	    """Recording observer (gate-03 f36): the cudagraph-trees manager's recorded
    97	    graph NODES (roots and all descendants) — the identity set that must not
    98	    change between measured phases. torch 2.8: TreeManager.roots is
    99	    {FunctionID: [CUDAGraphNode]}, each node has .children of the same shape.
   100	    'available': False -> the observer is missing and a compiled run cannot
   101	    be accepted (unresolved recording state)."""
   102	    try:
   103	        from torch._inductor import cudagraph_trees
   104	        container = cudagraph_trees.get_container(0)
   105	        mgr = getattr(container, 'tree_manager', None)
   106	        if mgr is None:
   107	            return {'available': False, 'reason': 'no tree manager on device 0'}
   108	        roots = getattr(mgr, 'roots', None)
   109	        if not isinstance(roots, dict):
   110	            return {'available': False, 'reason': 'roots not a dict'}
   111	        n_roots, stack, node_ids = 0, [], []
   112	        for lst in roots.values():
   113	            for node in lst:
   114	                n_roots += 1
   115	                stack.append(node)
   116	        seen = set()
   117	        while stack:
   118	            node = stack.pop()
   119	            if id(node) in seen:
   120	                continue
   121	            seen.add(id(node))
   122	            node_ids.append(id(node))
   123	            ch = getattr(node, 'children', None)
   124	            if isinstance(ch, dict):
   125	                for lst in ch.values():
   126	                    stack.extend(lst)
   127	        ids = getattr(mgr, 'ids_to_funcs', None) or getattr(mgr, 'ids_to_stack', None)
   128	        # identities retained (gate-04 f48): manager object, every recorded node,
   129	        # and the function-id set; compared as sets, not counts
   130	        return {'available': True, 'roots': n_roots, 'nodes': len(node_ids),
   131	                'manager_id': id(mgr), 'node_ids': sorted(node_ids),
   132	                'function_ids': sorted(str(k) for k in ids) if isinstance(ids, dict) else None,
   133	                'functions': len(ids) if ids is not None else None,
   134	                'current_gen': getattr(mgr, 'current_gen', None)}
   135	    except Exception as e:
   136	        return {'available': False, 'reason': f'{type(e).__name__}: {e}'[:120]}
   137	
   138	
   139	def recording_state():
   140	    """Counters + tree node identity, compared together by phase."""
   141	    return {'counters': dynamo_counters(), 'tree': cudagraph_tree_state()}
