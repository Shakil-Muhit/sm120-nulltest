    94	def sdr_problems(rec, chunk, manifest_id, var):
    95	    """The registered SDR qualification record for a cell: r1, same manifest,
    96	    same variant, gate PASS at that operating point, clip outputs lineage-hashed."""
    97	    if not rec or not rec.get('sdr_gate'):
    98	        return ['no SDR record in r1']
    99	    out = []
   100	    g = rec['sdr_gate']
   101	    if manifest_id and rec.get('manifest_id') != manifest_id:
   102	        out.append('r1 SDR record belongs to another manifest')
   103	    if var and variant(rec) != var:
   104	        out.append('r1 SDR record has another effective variant')
   105	    if rec.get('chunk') != chunk:
   106	        out.append('r1 SDR record operating point mismatch')
   107	    if g.get('status') != 'PASS':
   108	        out.append(f"SDR gate {g.get('status')}")
   109	    if not all(row.get('a_output_sha256') for row in g.get('clips') or []):
   110	        out.append('eager-A clip outputs not lineage-hashed')
   111	    return out
