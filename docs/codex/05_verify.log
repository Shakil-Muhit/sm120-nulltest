   164	               'unresolved_names_union': sorted({n for p in per_pass for n in p['unresolved_names']}),
   165	               'per_pass': per_pass}
   166	    # affirmative qualification required (gate-04 f49): the registered pass
   167	    # count must be given and met, and the node-level export record must
