    39	def reference_hashes(rec):
    40	    """Checked reference hashes persisted by the run (validation refs and,
    41	    when the SDR gate ran, eager-A clip outputs)."""
    42	    out = {}
    43	    for p in (rec.get('validation') or {}).get('passes') or []:
    44	        if p.get('ref_sha256'):
    45	            out[f"seed{p.get('seed')}"] = p['ref_sha256']
    46	    for row in (rec.get('sdr_gate') or {}).get('clips') or []:
    47	        if row.get('a_output_sha256'):
    48	            out[f"clip{row.get('index')}"] = row['a_output_sha256']
    49	    return out
