   169	    complete = args.expected_passes is not None and len(per_pass) == args.expected_passes
   170	    exports = args.base + '_exports.json'
   171	    exports_ok = False
   172	    if os.path.exists(exports):
   173	        try:
   174	            ex = json.load(open(exports))
   175	            exports_ok = ex.get('complete') is True and ex.get('graph_trace_mode') == 'node'
   176	        except Exception:
   177	            exports_ok = False
   178	    summary['pass_count_complete'] = complete
   179	    summary['exports_complete'] = exports_ok
   180	    summary['qualified'] = bool(complete and exports_ok)
   181	    summary['min_captured_in_any_pass'] = min(p['captured_model_kernels'] for p in per_pass)
   182	    summary['fully_graphed'] = bool(summary['qualified']
   183	                                    and summary['min_graph_launches_in_any_pass'] >= 1
   184	                                    and summary['min_captured_in_any_pass'] > 0
   185	                                    and summary['max_uncaptured_in_any_pass'] == 0
