   383	def read_permuted_state(k, role, meta):
   384	    """Tri-state permuted classification for one READING param (gate-04 f32):
   385	    'yes'  — view meta is permuted, or the load index expr differs from the
   386	             kernel's single store expr;
   387	    'no'   — load expr equals the single store expr;
   388	    'unresolved' — load expr missing, or zero / multiple distinct store exprs
   389	             (an unrelated output with the same expr could hide a permuted
   390	             read feeding another output)."""
   391	    stores = set(k.get('store_exprs', {}).values())
   392	    le = k.get('load_exprs', {}).get(role)
   393	    expected_stores = set(k.get('stores_present', k.get('store_exprs', {})))
   394	    if le is None or expected_stores != set(k.get('store_exprs', {})):
   395	        return 'unresolved'
   396	    if is_permuted(meta['shape'], meta['stride']):
   397	        return 'yes'
   398	    if len(stores) == 1:
   399	        return 'yes' if le not in stores else 'no'
   400	    return 'unresolved'
