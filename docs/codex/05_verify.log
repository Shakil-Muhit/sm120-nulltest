   403	def is_permuted(shape, stride):
   404	    """Permuted = the stride ORDER differs from row-major: fastest dim not
   405	    unit-stride OR strides (over size>1 dims) not non-increasing."""
   406	    if not shape or len(stride) != len(shape):
   407	        return False
   408	    nt = [(s, x) for s, x in zip(shape, stride) if s > 1]
   409	    if not nt:
   410	        return False
   411	    if nt[-1][1] != 1:
   412	        return True
   413	    return any(nt[i][1] < nt[i + 1][1] for i in range(len(nt) - 1))
   414	
   415	
   416	def accessed_elems(shape, stride):
   417	    """Distinct elements a strided view can touch: broadcast dims (stride 0)
   418	    contribute 1, overlapping windows (unfold-style strides) are bounded by
   419	    the address extent 1 + sum((size-1)*|stride|); never more than numel."""
   420	    if not shape:
   421	        return 0
   422	    numel = 1
   423	    for d in shape:
   424	        numel *= int(d)
   425	    if not stride or len(stride) != len(shape):
   426	        return numel
   427	    nz = 1
   428	    extent = 1
   429	    for d, st in zip(shape, stride):
   430	        d, st = int(d), abs(int(st))
   431	        if d == 0:
   432	            return 0
   433	        if st != 0:
   434	            nz *= d
   435	            extent += (d - 1) * st
   436	    return min(numel, nz, extent)
