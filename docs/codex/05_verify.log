    98	def pdl_ptx_has_griddepcontrol(kernel):
    99	    """Inspect the compiled PTX of the PDL kernel (after at least one launch)."""
   100	    try:
   101	        caches = getattr(kernel, 'device_caches', None) or {}
   102	        for dev, entry in caches.items():
   103	            cache = entry[0] if isinstance(entry, (tuple, list)) else entry
   104	            for ck in cache.values():
   105	                asm = getattr(ck, 'asm', None) or {}
   106	                ptx = asm.get('ptx', '')
   107	                if ptx:
   108	                    has_wait = 'griddepcontrol.wait' in ptx
   109	                    has_launch = 'griddepcontrol.launch_dependents' in ptx
   110	                    return True if (has_wait and has_launch) else \
   111	                        f'FAILED: wait={has_wait} launch_dependents={has_launch}'
   112	        return 'UNRESOLVED: no compiled kernel in device cache'
   113	    except Exception as e:
   114	        return f'UNRESOLVED: {type(e).__name__}'
