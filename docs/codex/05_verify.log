   317	def env_fingerprint():
   318	    try:
   319	        driver = subprocess.run(
   320	            ['nvidia-smi', '--query-gpu=driver_version', '--format=csv,noheader'],
   321	            capture_output=True, text=True, timeout=10).stdout.strip().splitlines()[0]
   322	    except Exception:
   323	        driver = 'unavailable'
   324	    import triton
   325	    try:
   326	        uuid = subprocess.run(
   327	            ['nvidia-smi', '--query-gpu=uuid', '--format=csv,noheader', '-i',
   328	             os.environ.get('CUDA_VISIBLE_DEVICES', '0').split(',')[0]],
   329	            capture_output=True, text=True, timeout=10).stdout.strip().splitlines()[0]
   330	    except Exception:
   331	        uuid = 'unavailable'
   332	    props = torch.cuda.get_device_properties(0)
   333	    return {'torch': torch.__version__, 'triton': triton.__version__,
   334	            'cuda_build': torch.version.cuda, 'driver': driver,
   335	            'gpu': torch.cuda.get_device_name(0), 'gpu_uuid': uuid,
   336	            'l2_cache_bytes': getattr(props, 'L2_cache_size', None),
   337	            'sm_count': props.multi_processor_count,
   338	            'total_memory_bytes': props.total_memory,
   339	            'capability': list(torch.cuda.get_device_capability(0)),
   340	            'python': platform.python_version(), 'hostname': platform.node(),
   341	            'cuda_visible_devices': os.environ.get('CUDA_VISIBLE_DEVICES', ''),
   342	            'timestamp_utc': datetime.now(timezone.utc).isoformat()}
