    41	    counters.clear()               # this arm's gate reflects only its own compilation
    42	    model, config, use_amp, ctx, ctx_nocache = loader.load_public_model(
    43	        paths['msst'], paths['ckpt'], paths['config'])
    44	    x = tm.make_input(chunk, tm.TIMING_SEED)
    45	    info = {'capture_scope': None, 'capture_adapter': None, 'capture_attempts': [],
    46	            'stream_count': None, 'compile_mode': None, 'notes': []}
    47	    step = arms_mod.build_arm_step(arm, model, x, ctx_nocache, streams, info, gen_dir)
    48	    settle = gate = None
