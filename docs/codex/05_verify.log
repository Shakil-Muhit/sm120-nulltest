   180	    # output fidelity vs A: infinities are expected for A itself and are kept
   181	    rec['sdr_vs_A_summary'] = _mean_with_inf([r['sdr_vs_A_db'] for r in rows])
   182	    rec['all_finite'] = all(r['finite'] for r in rows)
