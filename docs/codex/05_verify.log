   446	def merge_path(wrapper, pos, producer_before):
   447	    """Follow the SDPA output through gating to its projection, not just its
   448	    first consumer. Unknown ops/accesses keep the verdict unresolved.
   449	    Storage reuse is qualified by the reaching writer's position.
   450	    """
   451	    start = wrapper[pos]
   452	    if not start.get('assigned'):
   453	        return 'unresolved', ['missing SDPA output']
   454	    live = {start['assigned']: pos}
   455	    path = []
   456	    for i in range(pos + 1, len(wrapper)):
   457	        c = wrapper[i]
   458	        if c['g'] != start['g'] or 'scaled_dot_product' in c['name']:
   459	            break
   460	        hits = []
   461	        for a in c['args']:
   462	            base, _ = resolve(c['gr'], a['buf'])
   463	            if (a.get('read') and base in live and
   464	                    producer_before(c['g'], base, i) == live[base]):
   465	                hits.append(a)
   466	        if not hits:
   467	            continue
   468	        path.append(c['name'])
   469	        if c['kind'] == 'extern' and c['name'] in ('extern.mm', 'extern.addmm', 'extern.bmm'):
   470	            return 'true', path
   471	        k = c['gr']['kernels'].get(c['name'], {})
   472	        ops = k.get('ops', [])
   473	        if any(o in ('aten.clone', 'aten.copy', 'aten.copy_', 'aten.contiguous') for o in ops):
   474	            return 'false', path
   475	        if c['kind'] != 'triton' or not ops or not c.get('align_ok', False):
   476	            return 'unresolved', path
   477	        # Gating is arithmetic, but it must not conceal a fused layout copy.
   478	        if any(o not in ('aten.mul', 'aten.sigmoid', 'aten._to_copy',
   479	                         'prims.convert_element_type') for o in ops):
   480	            return 'unresolved', path
   481	        for a in hits:
   482	            state = read_permuted_state(k, a.get('role', ''), arg_meta(c['gr'], a))
   483	            if state != 'no':
   484	                return ('false' if state == 'yes' else 'unresolved'), path
   485	        outputs = [a for a in c['args'] if a.get('write')]
   486	        if not outputs:
   487	            return 'unresolved', path
   488	        for a in outputs:
   489	            live[resolve(c['gr'], a['buf'])[0]] = i
   490	    return 'unresolved', path
