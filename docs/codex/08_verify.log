   355	def trace_problems(rec, iters=REGISTERED_ITERS):
   356	    """A one-block traced or perturbation run (never a headline): everything a
   357	    measurement needs except the multi-block protocol; nvtx is allowed."""
   358	    if rec is None:
   359	        return ['record missing']
   360	    problems = []
   361	    if rec.get('status') != 'VALID':
   362	        problems.append(f"status {rec.get('status')}")
   363	    if rec.get('planted_fault') or rec.get('planted_fault_const') is not None:
   364	        problems.append('planted fault run')
   365	    problems += validation_problems(rec)
   366	    if not rec.get('manifest_id'):
   367	        problems.append('not bound to a session manifest')
   368	    if recomputed_timing(rec.get('timing'), iters, 1) is None:
   369	        problems.append('one-block timing samples incomplete, non-finite, or contradicting stored summaries')
   370	    if not rec.get('effective_variant'):
   371	        problems.append('effective variant not recorded')
   372	    if rec.get('arm') in COMPILE_ARMS:
   373	        st = stability_recomputed(rec)
   374	        if rec.get('counters_stable') is not True or st is not True:
   375	            problems.append('recording stability not affirmatively established from the stored snapshots')
   376	        if (rec.get('settle') or {}).get('settle_capped'):
   377	            problems.append('compile settle capped')
   378	        problems += gate_problems(rec.get('arm'), rec.get('graph_gate'),
   379	                                  (rec.get('counter_snapshots') or {}).get('after_settle'))
   380	    return problems
