    41	def make_input(chunk, seed, device='cuda'):
    42	    """Deterministic input independent of device RNG (sm120 make_input)."""
    43	    gen = torch.Generator(device='cpu').manual_seed(seed)
    44	    return torch.randn(1, CHANNELS, chunk, generator=gen).to(device)
