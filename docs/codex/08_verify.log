   278	def gate_problems(arm, gate, snapshot_after_settle):
   279	    """The complete graph-gate predicate, shared by every consumer (gate-06 f83):
   280	    counters, suppress_errors, zero-break rule for C3/H, and reconciliation with
   281	    the after-settle snapshot's counters."""
   282	    out = []
   283	    g = gate or {}
   284	    if g.get('status') != 'PASS':
   285	        out.append(f"graph gate {g.get('status', 'NONE')}")
   286	    if g.get('suppress_errors') is not False:
   287	        out.append('graph gate: suppress_errors not affirmatively False')
   288	    if not isinstance(g.get('graph_break_count'), int) or not isinstance(g.get('unimplemented_count'), int):
   289	        out.append('graph gate counters missing')
   290	        return out
   291	    if arm in ZERO_BREAK_ARMS and (g['graph_break_count'] != 0 or g['unimplemented_count'] != 0
   292	                                  or g.get('require_zero_breaks') is not True):
   293	        out.append('zero-break gate: graph breaks / unimplemented ops not 0 (or rule not applied)')
   294	    c = (snapshot_after_settle or {}).get('counters') if isinstance(snapshot_after_settle, dict) else None
   295	    if not isinstance(c, dict):
   296	        out.append('graph gate: no after-settle snapshot to reconcile against')
   297	    else:
   298	        if sum(c.get('graph_break', {}).values()) != g['graph_break_count'] or \
   299	                sum(c.get('unimplemented', {}).values()) != g['unimplemented_count']:
   300	            out.append('graph gate counters disagree with the after-settle snapshot')
   301	    return out
