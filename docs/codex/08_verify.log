   167	def graph_gate(require_zero_breaks):
   168	    """Compile-arm gate (prereg_amendments.md §1, C3/H): graph breaks and
   169	    unimplemented ops from the Dynamo counters; cudagraph skips from the
   170	    Inductor counters (plan 0.3 input)."""
   171	    snap = dynamo_counters()
   172	    breaks = sum(snap.get('graph_break', {}).values())
   173	    unsupported = sum(snap.get('unimplemented', {}).values())
   174	    inductor = snap.get('inductor', {})
   175	    skips = {k: v for k, v in inductor.items() if 'cudagraph' in k}
   176	    rec = {'graph_break_count': breaks, 'unimplemented_count': unsupported,
   177	           'unique_graphs': snap.get('stats', {}).get('unique_graphs', 0),
   178	           'cudagraph_counters': skips,
   179	           'suppress_errors': bool(torch._dynamo.config.suppress_errors),
   180	           'require_zero_breaks': require_zero_breaks,
   181	           'graph_break_reasons': list(snap.get('graph_break', {}).keys())[:40]}
   182	    rec['status'] = ('PASS' if (not require_zero_breaks or
   183	                                (breaks == 0 and unsupported == 0))
   184	                     and not rec['suppress_errors'] else 'FAIL')
   185	    return rec
