   177	def validation_problems(rec):
   178	    """The validation payload itself (gate-05 f61): both registered seeds,
   179	    every pass ok with a finite max_abs_diff under the arm's registered tier
   180	    tolerances, lineage hash persisted, and the stored status equal to the
   181	    recomputed one."""
   182	    out = []
   183	    v = rec.get('validation') or {}
   184	    if v.get('status') == 'REFERENCE_SAVED':
   185	        return ['validation REFERENCE_SAVED (a reference-writing run is never a measurement)']
   186	    arm = rec.get('arm')
   187	    tier = TIER_OF.get(arm)
   188	    if rec.get('forced_tier'):
   189	        tier = rec['forced_tier']
   190	    passes = v.get('passes') or []
   191	    seeds = sorted(p.get('seed') for p in passes)
   192	    if seeds != sorted(VALIDATION_SEEDS):
   193	        out.append(f'validation seeds {seeds} are not the registered {list(VALIDATION_SEEDS)}')
   194	    if tier and v.get('tier') != tier:
   195	        out.append(f"validation tier {v.get('tier')} is not the registered {tier}")
   196	    if tier and (v.get('rtol'), v.get('atol')) != TIERS[tier]:
   197	        out.append('validation tolerances are not the registered tier values')
   198	    if rec.get('forced_tier') and rec.get('planted_fault_const') is None:
   199	        out.append('tier override on a non-planted record')
   200	    ok_all = bool(passes)
   201	    for p in passes:
   202	        # every per-pass invariant (gate-06 f80): shapes equal, both operands finite,
   203	        # the pass's own tolerances equal the registered tier, zero violating
   204	        # elements, and the stored ok flag consistent with all of that
   205	        shape = p.get('shape_out')
   206	        shape_ok = (isinstance(shape, list) and shape and all(isinstance(d, int) and not isinstance(d, bool) and d > 0 for d in shape))
   207	        numel = 1
   208	        for d in (shape or []):
   209	            numel *= d if isinstance(d, int) else 0
   210	        good = (p.get('ok') is True and _finite(p.get('max_abs_diff')) and p['max_abs_diff'] >= 0
   211	                and p.get('ref_sha256') and shape_ok and p.get('shape_ref') == shape
   212	                and p.get('n_elements') == numel and _finite(p.get('max_abs_ref')) and p['max_abs_ref'] >= 0
   213	                and p.get('finite_out') is True and p.get('finite_ref') is True
   214	                and (tier is None or (p.get('rtol'), p.get('atol')) == TIERS[tier])
   215	                and p.get('violations') == 0
   216	                and p['max_abs_diff'] <= p['atol'] + p['rtol'] * p['max_abs_ref'] + 1e-12)
   217	        if not good:
   218	            ok_all = False
   219	    recomputed = 'PASS' if ok_all else 'FAIL'
   220	    if v.get('status') != 'PASS' or recomputed != 'PASS':
   221	        out.append(f"validation {v.get('status', 'NONE')} (recomputed {recomputed})")
   222	    return out
