class MemFile(io.StringIO):
    def __init__(self, fs, path, value='', writing=False):
        super().__init__(value); self.fs=fs;self.path=path;self.writing=writing
    def close(self):
        if not self.closed and self.writing: self.fs[self.path]=self.getvalue()
        super().close()
class VFS:
    def __init__(self):self.files={}
    def put(self,path,x):self.files[path]=json.dumps(x) if not isinstance(x,str) else x
    def get(self,path):return json.loads(self.files[path])
    def open(self,path,mode='r',*args,**kw):
        path=str(path)
        if path.startswith('/fixture/'):
            if 'b' in mode:
                return io.BytesIO(self.files[path].encode())
            if 'w' in mode:return MemFile(self.files,path,writing=True)
            if path not in self.files:raise FileNotFoundError(path)
            return MemFile(self.files,path,self.files[path])
        return self.orig_open(path,mode,*args,**kw)
    @contextlib.contextmanager
    def mounted(self):
        import builtins
        self.orig_open=builtins.open; oldglob=col.glob.glob;oldexists=os.path.exists;olddir=os.path.isdir
        def globber(p,*args,**kw):
            return [f for f in self.files if fnmatch.fnmatch(f,p)] if p.startswith('/fixture/') else oldglob(p,*args,**kw)
        with patch('builtins.open',self.open), patch.object(col.glob,'glob',side_effect=globber), \\
             patch.object(os.path,'exists',side_effect=lambda p:str(p) in self.files if str(p).startswith('/fixture/') else oldexists(p)), \\
             patch.object(os.path,'isdir',side_effect=lambda p:any(f.startswith(str(p)+'/') for f in self.files) if str(p).startswith('/fixture/') else olddir(p)):
            yield
