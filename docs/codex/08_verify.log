     1	#!/bin/bash
     2	# Drive the session pod from muhit-pc (after scripts/pod_up.sh wrote pod.env).
     3	#   pod_run.sh ship        re-ship the COMMITTED tree (git bundle) to the pod, keep evidence/
     4	#   pod_run.sh session1    launch scripts/session1.sh in a detached tmux session on the pod
     5	#   pod_run.sh session2    launch scripts/session2.sh likewise
     6	#   pod_run.sh tail        follow the pod's session console log
     7	#   pod_run.sh status      tmux + GPU + last console lines
     8	#   pod_run.sh extract     tar the pod's evidence/ into ~/ms/evidence_pod/<ts>/ (OFF-POD copy)
     9	#   pod_run.sh terminate   terminate THIS pod by exact id (refuses if evidence was never extracted)
    10	set -u
    11	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    12	KEY="$HOME/.runpod/ssh/RunPod-Key-Go"
    13	export PATH="$HOME/.local/bin:$PATH"
    14	[ -f "$REPO_DIR/pod.env" ] || { echo "FATAL: pod.env missing (run scripts/pod_up.sh)"; exit 1; }
    15	. "$REPO_DIR/pod.env"
    16	SSH="ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -i $KEY -p $POD_PORT root@$POD_HOST"
    17	SCP="scp -o StrictHostKeyChecking=no -i $KEY -P $POD_PORT"
    18	CMD="${1:-status}"
    19	case "$CMD" in
    20	  ship)
    21	    cd "$REPO_DIR"
    22	    [ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "FATAL: commit first"; exit 1; }
    23	    COMMIT=$(git rev-parse HEAD)
    24	    git bundle create /tmp/sm120.bundle HEAD main 2>/dev/null || git bundle create /tmp/sm120.bundle HEAD
    25	    $SCP /tmp/sm120.bundle "root@$POD_HOST:/root/sm120.bundle"
    26	    # keep evidence/ (git-ignored) across re-ships; refuse while a session runs
    27	    $SSH "tmux has-session -t run 2>/dev/null && { echo 'FATAL: a session is running'; exit 1; }
    28	          set -e; cd /root/sm120-nulltest && git fetch -q /root/sm120.bundle HEAD && git checkout -q $COMMIT && git status --porcelain --untracked-files=no | wc -l && git rev-parse HEAD"
    29	    ;;
    30	  session1|session2)
    31	    $SSH "cd /root/sm120-nulltest && mkdir -p evidence && { [ -e evidence/.terminating ] && { echo 'FATAL: termination lock present'; exit 1; }; tmux has-session -t run 2>/dev/null && { echo 'FATAL: a tmux session named run already exists'; exit 1; }; }
    32	          export MSST_DIR=/root/work/msst CLIPS_DIR=/root/work/sdr_clips PYTHONDONTWRITEBYTECODE=1
    33	          tmux new -d -s run \"bash scripts/$CMD.sh > evidence/${CMD}.log 2>&1; echo EXIT=\\\$? >> evidence/${CMD}.log\"
    34	          sleep 3; tail -n 5 evidence/${CMD}.log"
    35	    ;;
    36	  tail)
    37	    LOGN="${2:-session1}"
    38	    $SSH "tail -n 40 -F /root/sm120-nulltest/evidence/${LOGN}.log"
    39	    ;;
    40	  status)
    41	    $SSH "tmux ls 2>/dev/null || echo 'no tmux session'; nvidia-smi --query-gpu=name,utilization.gpu,memory.used,clocks.sm --format=csv,noheader; ls /root/sm120-nulltest/evidence 2>/dev/null | wc -l; for f in /root/sm120-nulltest/evidence/session*.log; do [ -f \$f ] && { echo \"--- \$f\"; tail -n 6 \$f; }; done"
    42	    ;;
    43	  extract)
    44	    set -o pipefail
    45	    TS=$(date +%Y%m%d_%H%M)
    46	    DEST="$HOME/ms/evidence_pod/${POD_ID}_$TS"
    47	    mkdir -p "$DEST"
    48	    # writers must be stopped and the content must not move during extraction (gate-06 f95)
    49	    $SSH "tmux has-session -t run 2>/dev/null" && { echo "FATAL: a session is still running on the pod"; exit 1; }
    50	    HASH_CMD="cd /root/sm120-nulltest && find evidence -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1"
    51	    PRE_SHA=$($SSH "$HASH_CMD") || { echo "FATAL: remote content hash failed"; exit 1; }
    52	    REMOTE_N=$($SSH "cd /root/sm120-nulltest && find evidence -type f | wc -l") || { echo "FATAL: cannot count remote files"; exit 1; }
    53	    $SSH "cd /root/sm120-nulltest && tar czf - evidence" > "$DEST/evidence.tgz" || { echo "FATAL: transfer failed"; exit 1; }
    54	    tar tzf "$DEST/evidence.tgz" > /dev/null || { echo "FATAL: archive invalid"; exit 1; }
    55	    tar xzf "$DEST/evidence.tgz" -C "$DEST" || { echo "FATAL: extraction failed"; exit 1; }
    56	    LOCAL_N=$(find "$DEST/evidence" -type f | wc -l)
    57	    [ "$LOCAL_N" -eq "$REMOTE_N" ] || { echo "FATAL: file count mismatch remote=$REMOTE_N local=$LOCAL_N"; exit 1; }
    58	    SHA=$(sha256sum "$DEST/evidence.tgz" | cut -d" " -f1)
    59	    # content hash of the REMOTE evidence at extraction time: the receipt is
    60	    # invalid once any later measurement changes the pod's evidence (gate-05 f77)
    61	    REMOTE_SHA=$($SSH "$HASH_CMD") || { echo "FATAL: remote content hash failed"; exit 1; }
    62	    [ "$REMOTE_SHA" = "$PRE_SHA" ] || { echo "FATAL: remote evidence changed during extraction (before $PRE_SHA, after $REMOTE_SHA)"; exit 1; }
    63	    LOCAL_SHA=$(cd "$DEST" && find evidence -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
    64	    [ "$LOCAL_SHA" = "$REMOTE_SHA" ] || { echo "FATAL: extracted content manifest differs from the remote one"; exit 1; }
    65	    echo "POD_ID=$POD_ID DEST=$DEST FILES=$LOCAL_N SHA256=$SHA REMOTE=$REMOTE_SHA TS=$TS" >> "$REPO_DIR/pod.env.extracted"
    66	    du -sh "$DEST"; ls "$DEST/evidence" | head -20
    67	    echo "EXTRACTED -> $DEST ($LOCAL_N files, sha256 $SHA)"
    68	    ;;
    69	  terminate)
    70	    grep -q "^POD_ID=$POD_ID " "$REPO_DIR/pod.env.extracted" 2>/dev/null \
    71	        || { echo "FATAL: no validated extraction receipt for pod $POD_ID — extract first"; exit 1; }
    72	    # exclusion held through the decision (gate-07 f109): the lock refuses any new
    73	    # session launch; a running session refuses termination
    74	    $SSH "cd /root/sm120-nulltest && touch evidence/.terminating && { tmux has-session -t run 2>/dev/null && { rm -f evidence/.terminating; echo 'FATAL: a session is running'; exit 1; }; exit 0; }" \
    75	        || { echo "FATAL: could not take the termination lock"; exit 1; }
    76	    LAST=$(grep "^POD_ID=$POD_ID " "$REPO_DIR/pod.env.extracted" | tail -1)
    77	    D=$(echo "$LAST" | sed -n "s/.*DEST=\([^ ]*\).*/\1/p"); H=$(echo "$LAST" | sed -n "s/.*SHA256=\([^ ]*\).*/\1/p")
    78	    R=$(echo "$LAST" | sed -n "s/.*REMOTE=\([^ ]*\).*/\1/p")
    79	    [ -f "$D/evidence.tgz" ] && [ "$(sha256sum "$D/evidence.tgz" | cut -d" " -f1)" = "$H" ] \
    80	        || { echo "FATAL: extracted archive missing or changed ($D)"; exit 1; }
    81	    NOW=$($SSH "cd /root/sm120-nulltest && find evidence -type f ! -name .terminating -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1") || { echo "FATAL: cannot hash remote evidence"; exit 1; }
    82	    [ -n "$R" ] && [ "$NOW" = "$R" ] || { $SSH "rm -f /root/sm120-nulltest/evidence/.terminating"; echo "FATAL: remote evidence changed since the last extraction (extract again)"; exit 1; }
    83	    echo "terminating pod $POD_ID (melband_profiling) — production pods untouched; evidence at $D"
    84	    runpodctl pod terminate "$POD_ID"
    85	    ;;
    86	  *) echo "usage: $0 ship|session1|session2|tail [name]|status|extract|terminate"; exit 2 ;;
    87	esac

