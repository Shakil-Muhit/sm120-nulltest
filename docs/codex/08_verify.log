   100	
   101	def _canon_expr(e):
   102	    return re.sub(r'\s+', '', e or '')
   103	
   104	
   105	def access_expressions(source, params):
   106	    """Parse complete pointer expressions, including multiple accesses.
   107	    A regex ending at the first ')' loses nested arithmetic and later loads.
   108	    """
   109	    exprs = {'load': {}, 'store': {}}
   110	    present = {'load': set(), 'store': set()}
   111	    for node in ast.walk(ast.parse(source)):
   112	        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Attribute):
   113	            continue
   114	        op = node.func.attr
   115	        if op not in exprs or not node.args:
   116	            continue
   117	        pointer = node.args[0]
   118	        names = {n.id for n in ast.walk(pointer) if isinstance(n, ast.Name)}
   119	        for p in set(params) & names:
   120	            present[op].add(p)
   121	            offset = None
   122	            if isinstance(pointer, ast.Name) and pointer.id == p:
   123	                offset = '0'
   124	            elif isinstance(pointer, ast.BinOp) and isinstance(pointer.op, ast.Add):
   125	                if isinstance(pointer.left, ast.Name) and pointer.left.id == p:
   126	                    offset = _canon_expr(ast.unparse(pointer.right))
   127	            exprs[op].setdefault(p, set()).add(offset)
   128	    result = {}
   129	    for op in exprs:
   130	        result[op + '_exprs'] = {p: next(iter(values)) for p, values in exprs[op].items()
   131	                                if len(values) == 1 and None not in values}
   132	        result[op + 's_present'] = sorted(present[op])
   133	    return result
   134	
