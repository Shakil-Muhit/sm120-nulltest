    23	def compile_stable(before, after):
    24	    """Recording/compilation stability (gate-02 f21): no NEW graph breaks or
    25	    unimplemented ops, the same number of unique Dynamo graphs, and EVERY
    26	    Inductor cudagraph counter unchanged. Per-call counters are ignored."""
    27	    for k in STABILITY_KEYS:
    28	        if (before or {}).get(k, {}) != (after or {}).get(k, {}):
    29	            return False
    30	    if (before or {}).get('stats', {}).get('unique_graphs') != (after or {}).get('stats', {}).get('unique_graphs'):
    31	        return False
    32	    b_ind = {k: v for k, v in (before or {}).get('inductor', {}).items() if 'cudagraph' in k}
    33	    a_ind = {k: v for k, v in (after or {}).get('inductor', {}).items() if 'cudagraph' in k}
    34	    return b_ind == a_ind
