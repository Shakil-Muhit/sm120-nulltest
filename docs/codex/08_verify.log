    84	def main():
    85	    ap = argparse.ArgumentParser()
    86	    ap.add_argument('--pair', nargs=2, required=True, metavar=('ARM_A', 'ARM_B'))
    87	    ap.add_argument('--chunk', type=int, required=True, choices=list(arms_mod.CHUNKS))
    88	    ap.add_argument('--tag', default='m1')
    89	    ap.add_argument('--iters', type=int, default=50)
    90	    ap.add_argument('--repeats', type=int, default=5)
    91	    ap.add_argument('--streams', type=int, default=arms_mod.DEFAULT_STREAMS)
    92	    ap.add_argument('--settle-max', type=int, default=60)
    93	    ap.add_argument('--evidence-dir', '--out-dir', dest='evidence_dir',
    94	                    default=os.path.join(_ROOT, 'evidence'))
    95	    ap.add_argument('--ref-dir', default=None)
    96	    ap.add_argument('--no-manifest', action='store_true')
    97	    args = ap.parse_args()
    98	    if (args.iters, args.repeats) != (50, 5):
    99	        print('[matched] WARNING: not the registered 5 x 50 protocol — pair ineligible')
   100	    assert torch.cuda.is_available()
   101	    os.makedirs(args.evidence_dir, exist_ok=True)
   102	    ref_dir = args.ref_dir or os.path.join(args.evidence_dir, 'ref')
   103	    a, b = args.pair
   104	    out_path = os.path.join(args.evidence_dir, f'matched_{a}_{b}_c{args.chunk}_{args.tag}.json')
   105	    result = {'pair': [a, b], 'chunk': args.chunk, 'tag': args.tag, 'status': 'VALID',
   106	              'error': None, 'env': tm.env_fingerprint(), 'arms': {}, 'blocks': [],
   107	              'iters': args.iters, 'repeats': args.repeats,
   108	              'torch_logs_env': os.environ.get('TORCH_LOGS'), 'manifest_id': None,
   109	              'pair_eligible': None, 'ineligibility_reasons': []}
   110	    reasons = result['ineligibility_reasons']
   111	    try:
   112	        paths = loader.paths_from_env()
   113	        result['provenance'] = provenance.verify(paths)
   114	        if not args.no_manifest:
   115	            result['manifest_id'] = provenance.load_manifest(
   116	                args.evidence_dir, paths, tm.env_fingerprint())['manifest_id']
   117	            tm.bind_refs(ref_dir, result['manifest_id'])
   118	        else:
   119	            reasons.append('not bound to a session manifest')
   120	        if (args.iters, args.repeats) != (50, 5):
   121	            reasons.append(f'protocol {args.repeats}x{args.iters} is not the registered 5x50')
   122	        built = {}
   123	        for arm in (a, b):
   124	            gen_dir = os.path.join(args.evidence_dir, 'generated', f'matched_{arm}_c{args.chunk}_{args.tag}')
   125	            try:
   126	                built[arm] = build_one(arm, args.chunk, args.streams, gen_dir, paths, args.settle_max)
   127	                bi = built[arm]
   128	                result['arms'][arm] = {'build_status': 'OK', 'settle': bi['settle'], 'graph_gate': bi['gate'],
   129	                                       'gate_snapshot': bi.get('gate_snapshot'),
   130	                                       'capture_scope': bi['info'].get('capture_scope'),
   131	                                       'capture_adapter_active': bi['info'].get('capture_adapter_active'),
   132	                                       'compile_mode': bi['info'].get('compile_mode'),
   133	                                       'stream_count': bi['info'].get('stream_count')}
   134	                if bi['settle'] and bi['settle']['settle_capped']:
   135	                    reasons.append(f'{arm}: settle capped')
   136	                if bi['gate'] and bi['gate']['status'] != 'PASS':
   137	                    reasons.append(f'{arm}: graph gate FAIL')
   138	                print(f'[matched] {arm}: built (scope {bi["info"].get("capture_scope")}, gate '
   139	                      f'{(bi["gate"] or {}).get("status")})')
   140	            except Exception:
   141	                result['arms'][arm] = {'build_status': 'FAILED', 'error': traceback.format_exc()}
   142	                reasons.append(f'{arm}: build failed')
   143	                print(f'[matched] {arm}: BUILD FAILED (recorded)', file=sys.stderr)
   144	        if not all(result['arms'][x]['build_status'] == 'OK' for x in (a, b)):
   145	            result['status'] = 'INVALID'
   146	        else:
   147	            js = joint_settle(built, (a, b))
   148	            result['joint_settle'] = js
   149	            if js['stable'] is None:
   150	                reasons.append('joint settle: recording observer unavailable (UNRESOLVED)')
   151	            elif not js['stable']:
   152	                reasons.append('joint alternation did not settle (recording state changed)')
   153	            if js['new_breaks_during_joint_settle']:
   154	                reasons.append(f"{js['new_breaks_during_joint_settle']} new graph breaks/unimplemented "
   155	                               'during the joint settle')
   156	            # per-arm zero-break requalification after the joint settle (global delta)
   157	            before_val = tm.recording_state()
