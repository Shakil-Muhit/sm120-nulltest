   357	# ------------------------------------------------------------- resolution ---
   358	
   359	def resolve(gr, buf):
   360	    """Follow alias chain to the base buffer; return (base, view_meta|None)."""
   361	    meta = None
   362	    seen = set()
   363	    while buf in gr['aliases'] and buf not in seen:
   364	        seen.add(buf)
   365	        a = gr['aliases'][buf]
   366	        if meta is None and 'shape' in a:
   367	            meta = {'shape': a['shape'], 'stride': a['stride']}
   368	        buf = a['base']
   369	    return buf, meta
   370	
   371	
   372	def arg_meta(gr, a):
   373	    """Effective (shape, stride, dtype, base) the kernel sees for arg a.
   374	    Shape precedence: reinterpret literal > alias view meta > an
   375	    assert_size_stride/alloc on the arg's OWN name (fallback outputs and
   376	    getitem results are asserted by name) > the base allocation."""
   377	    base, alias_meta = resolve(gr, a['buf'])
   378	    alloc = gr['allocs'].get(base, {})
   379	    own = gr['allocs'].get(a['buf'], {})
   380	    if a.get('reinterpret') and a.get('shape'):
   381	        shape, stride = a['shape'], a['stride']
   382	    elif alias_meta:
   383	        shape, stride = alias_meta['shape'], alias_meta['stride']
   384	    elif own.get('shape'):
   385	        shape, stride = own['shape'], own.get('stride', ())
   386	    else:
   387	        shape, stride = alloc.get('shape', ()), alloc.get('stride', ())
   388	    return {'shape': shape or (), 'stride': stride or (),
   389	            'dtype': alloc.get('dtype') or own.get('dtype'), 'base': base}
   390	
   391	
   392	def refined_access(k, role):
   393	    """(reads, writes, unresolved) for a param role, derived from the kernel
   394	    SOURCE (gate-04 f32): in_out_ptr reads iff a tl.load on it exists and
   395	    writes iff a tl.store exists; neither found -> unresolved (charged
   396	    conservatively as read+write, and the site is flagged)."""
   397	    if role.startswith('in_out_ptr'):
   398	        r = role in k.get('loads_present', k.get('load_exprs', {}))
   399	        w = role in k.get('stores_present', k.get('store_exprs', {}))
   400	        return (r, w, not (r or w))
   401	    if role.startswith('in_ptr'):
   402	        return (True, False, role not in k.get('loads_present', k.get('load_exprs', {})))
   403	    if role.startswith('out_ptr'):
   404	        return (False, True, role not in k.get('stores_present', k.get('store_exprs', {})))
   405	    return (False, False, True)
   406	
   407	
   408	def read_permuted_state(k, role, meta):
   409	    """Tri-state permuted classification for one READING param (gate-04 f32):
   410	    'yes'  — view meta is permuted, or the load index expr differs from the
   411	             kernel's single store expr;
   412	    'no'   — load expr equals the single store expr;
   413	    'unresolved' — load expr missing, or zero / multiple distinct store exprs
   414	             (an unrelated output with the same expr could hide a permuted
   415	             read feeding another output)."""
   416	    stores = set(k.get('store_exprs', {}).values())
   417	    le = k.get('load_exprs', {}).get(role)
   418	    expected_stores = set(k.get('stores_present', k.get('store_exprs', {})))
   419	    if le is None or expected_stores != set(k.get('store_exprs', {})):
   420	        return 'unresolved'
   421	    if is_permuted(meta['shape'], meta['stride']):
   422	        return 'yes'
   423	    if len(stores) == 1:
   424	        return 'yes' if le not in stores else 'no'
   425	    return 'unresolved'
   426	
   427	
   428	def is_permuted(shape, stride):
   429	    """Permuted = the stride ORDER differs from row-major: fastest dim not
   430	    unit-stride OR strides (over size>1 dims) not non-increasing."""
   431	    if not shape or len(stride) != len(shape):
   432	        return False
   433	    nt = [(s, x) for s, x in zip(shape, stride) if s > 1]
   434	    if not nt:
   435	        return False
   436	    if nt[-1][1] != 1:
   437	        return True
   438	    return any(nt[i][1] < nt[i + 1][1] for i in range(len(nt) - 1))
   439	
