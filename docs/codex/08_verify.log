     7	# stage (qualification and microbenchmarks included).
     8	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
     9	EVID="${EVID:-$REPO_DIR/evidence}"
    10	REF="$EVID/ref"
    11	ITERS="${ITERS:-50}"
    12	REPEATS="${REPEATS:-5}"
    13	RESTARTS="${RESTARTS:-3}"
    14	CLIPS_DIR="${CLIPS_DIR:-$HOME/work/sdr_clips}"
    15	T_COMPILE="${T_COMPILE:-1500}"
    16	T_OTHER="${T_OTHER:-900}"
    17	T_MIN="${T_MIN:-240}"                            # below this, a cell is not started
    18	SESSION_BUDGET_S="${SESSION_BUDGET_S:-10800}"
    19	EXTRACT_RESERVE_S="${EXTRACT_RESERVE_S:-900}"
    20	RUN="$REPO_DIR/fullmodel/run_full_arm.py"
    21	MATCHED="$REPO_DIR/fullmodel/matched_run.py"
    22	T0=$(date +%s)
    23	[ -e "$EVID/.terminating" ] && { echo "FATAL: termination lock present in $EVID — no session may start"; exit 1; }
    24	
    25	remaining() { echo $(( SESSION_BUDGET_S - EXTRACT_RESERVE_S - ($(date +%s) - T0) )); }
    26	cap_for()   { local want="$1" rem; rem=$(remaining); [ "$rem" -lt "$want" ] && echo "$rem" || echo "$want"; }
    27	
    28	logs_for() { case "$1" in C1|C2|C3|C1A|C1D|H) echo "graph_breaks,recompiles,perf_hints,cudagraphs" ;; *) echo "" ;; esac; }
    29	tmo_for()  { case "$1" in C1|C2|C3|C1A|C1D|H) echo "$T_COMPILE" ;; *) echo "$T_OTHER" ;; esac; }
    30	
    31	terminal_json() {   # path arm chunk tag status reason
    32	    python3 - "$@" <<'PYEOF'
    33	import json, sys
    34	path, arm, chunk, tag, status, reason = sys.argv[1:]
    35	json.dump({'arm': arm, 'chunk': int(chunk), 'tag': tag, 'status': status,
    36	           'error': reason, 'headline_eligible': False,
    37	           'ineligibility_reasons': [reason]}, open(path, 'w'), indent=1)
    38	PYEOF
    39	}
