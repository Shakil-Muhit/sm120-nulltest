    41	# run_one ARM CHUNK TAG [extra args...]  — one fresh process, env via array
    42	run_one() {
    43	    local arm="$1" chunk="$2" tag="$3"; shift 3
    44	    local path="$EVID/full_${arm}_c${chunk}_${tag}.json"
    45	    local cap; cap=$(cap_for "$(tmo_for "$arm")")
    46	    rm -f "$path"                       # no stale artifact survives a new attempt (gate-05 f75 / gate-06 f94)
    47	    if [ "$cap" -lt "$T_MIN" ]; then
    48	        echo "--- arm=$arm chunk=$chunk tag=$tag: DEADLINE (usable $cap s) -> UNTESTED ---"
    49	        terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "session deadline: not started"
    50	        return
    51	    fi
    52	    local envv=() logs; logs="$(logs_for "$arm")"
    53	    [ -n "$logs" ] && envv+=("TORCH_LOGS=$logs")
    54	    echo "--- arm=$arm chunk=$chunk tag=$tag $(date -Is) cap=${cap}s remaining=$(remaining)s ---"
    55	    env "${envv[@]}" timeout -k 30 "$cap" python "$RUN" --arm "$arm" --chunk "$chunk" \
    56	        --tag "$tag" --iters "$ITERS" --repeats "$REPEATS" --clips-dir "$CLIPS_DIR" \
    57	        --evidence-dir "$EVID" "$@" 2> "$EVID/torchlogs_${arm}_${chunk}_${tag}.log"
    58	    local rc=$?
