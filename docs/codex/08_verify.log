   145	def _blocks_ok(timing, iters, repeats):
   146	    if not timing:
   147	        return 'no timed region'
   148	    if timing.get('repeats') != repeats or timing.get('iters_per_block') != iters:
   149	        return (f"protocol {timing.get('repeats')}x{timing.get('iters_per_block')} "
   150	                f"is not the registered {repeats}x{iters}")
   151	    blocks = timing.get('blocks') or []
   152	    if len(blocks) != repeats:
   153	        return f'{len(blocks)} blocks recorded, {repeats} required'
   154	    for b in blocks:
   155	        if len(b.get('latency_ms_per_iter') or []) != iters:
   156	            return 'a block did not record exactly the registered pass count'
   157	        if not isinstance(b.get('throughput_ms_per_pass'), (int, float)):
   158	            return 'a block lacks a throughput record'
   159	    return None
