    68	def recording_stable(a, b):
    69	    """None when the observer is missing or a snapshot is incomplete
    70	    (unresolved); else identity-set equality."""
    71	    if not (snapshot_complete(a) and snapshot_complete(b)):
    72	        return None
    73	    ta, tb = a['tree'], b['tree']
    74	    return (compile_stable(a.get('counters'), b.get('counters')) and
    75	            ta.get('manager_id') == tb.get('manager_id') and
    76	            ta.get('node_ids') == tb.get('node_ids') and
    77	            ta.get('function_ids') == tb.get('function_ids') and
    78	            ta.get('roots') == tb.get('roots'))
