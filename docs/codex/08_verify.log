   162	def reference_hashes(rec, include_clips=False):
   163	    """Checked reference hashes persisted by the run: the validation
   164	    references every restart checks (the cross-restart join key) and, only
   165	    when asked, the eager-A clip outputs the r1 SDR gate checked."""
   166	    out = {}
   167	    for p in (rec.get('validation') or {}).get('passes') or []:
   168	        if p.get('ref_sha256'):
   169	            out[f"seed{p.get('seed')}"] = p['ref_sha256']
   170	    if include_clips:
   171	        for row in (rec.get('sdr_gate') or {}).get('clips') or []:
   172	            if row.get('a_output_sha256'):
   173	                out[f"clip{row.get('index')}"] = row['a_output_sha256']
   174	    return out
