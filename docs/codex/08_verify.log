   265	def stability_recomputed(rec):
   266	    """Recording stability recomputed from the stored phase snapshots; every
   267	    required phase must be present and complete, else None (unresolved)."""
   268	    snaps = rec.get('counter_snapshots') or {}
   269	    seq = [snaps.get(k) for k in required_phases(rec)]
   270	    if any(not snapshot_complete(x) for x in seq) or len(seq) < 2:
   271	        return None
   272	    verdicts = [recording_stable(a, b) for a, b in zip(seq, seq[1:])]
   273	    if any(v is None for v in verdicts):
   274	        return None
   275	    return all(verdicts)
