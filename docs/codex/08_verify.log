    39	def build_one(arm, chunk, streams, gen_dir, paths, settle_max):
    40	    from torch._dynamo.utils import counters
    41	    counters.clear()               # this arm's gate reflects only its own compilation
    42	    model, config, use_amp, ctx, ctx_nocache = loader.load_public_model(
    43	        paths['msst'], paths['ckpt'], paths['config'])
    44	    x = tm.make_input(chunk, tm.TIMING_SEED)
    45	    info = {'capture_scope': None, 'capture_adapter': None, 'capture_attempts': [],
    46	            'stream_count': None, 'compile_mode': None, 'notes': []}
    47	    step = arms_mod.build_arm_step(arm, model, x, ctx_nocache, streams, info, gen_dir)
    48	    settle = gate = gate_snapshot = None
    49	    if arm in arms_mod.COMPILE_ARMS:
    50	        settle = tm.settle_compile(step, x, ctx, settle_max, 5)
    51	        gate = tm.graph_gate(arm in arms_mod.REQUIRE_ZERO_BREAKS)
    52	        gate_snapshot = tm.recording_state()      # reconciliation reference for this arm's gate (gate-06 f83)
    53	    else:
    54	        with torch.no_grad(), ctx():
    55	            for _ in range(10):
    56	                step(x)
    57	        torch.cuda.synchronize()
    58	    return {'model': model, 'step': step, 'ctx': ctx, 'x': x, 'info': info,
    59	            'settle': settle, 'gate': gate, 'gate_snapshot': gate_snapshot, 'use_amp': use_amp}
