   383	def sdr_problems(rec, chunk, manifest_id, var):
   384	    """The registered SDR qualification record for a cell: r1, same manifest,
   385	    same variant, gate PASS at that operating point, clip outputs lineage-hashed."""
   386	    if not rec or not rec.get('sdr_gate'):
   387	        return ['no SDR record in r1']
   388	    out = []
   389	    g = rec['sdr_gate']
   390	    if manifest_id and rec.get('manifest_id') != manifest_id:
   391	        out.append('r1 SDR record belongs to another manifest')
   392	    if var and variant(rec) != var:
   393	        out.append('r1 SDR record has another effective variant')
   394	    if rec.get('chunk') != chunk:
   395	        out.append('r1 SDR record operating point mismatch')
   396	    st, why = sdr_recomputed(g)
   397	    if st != 'PASS':
   398	        out.append(f"SDR gate {why or st}")
   399	    if g.get('operating_point') != chunk:
   400	        out.append('SDR record operating point mismatch')
   401	    return out
