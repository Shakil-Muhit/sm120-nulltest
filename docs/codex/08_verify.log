    37	def snapshot_complete(x):
    38	    """A recording snapshot must carry complete counters and observer fields."""
    39	    if not isinstance(x, dict):
    40	        return False
    41	    c, t = x.get('counters'), x.get('tree')
    42	    if not isinstance(c, dict) or not isinstance(t, dict):
    43	        return False
    44	    # dynamo counters only carry keys that occurred: graph_break / unimplemented
    45	    # are absent when zero; stats and inductor are always present
    46	    if not (isinstance(c.get('stats'), dict) and isinstance(c.get('inductor'), dict)):
    47	        return False
    48	    ug = c['stats'].get('unique_graphs')
    49	    if not (isinstance(ug, int) and not isinstance(ug, bool) and ug >= 0):
    50	        return False
    51	    for k in ('graph_break', 'unimplemented'):
    52	        if k in c and not isinstance(c[k], dict):
    53	            return False
    54	    if not t.get('available') or t.get('identity_mode') != 'registry':
    55	        return False
    56	    ids, fids = t.get('node_ids'), t.get('function_ids')
    57	    if not (isinstance(ids, list) and all(isinstance(i, int) and not isinstance(i, bool) for i in ids)
    58	            and len(set(ids)) == len(ids)):
    59	        return False
    60	    if not (isinstance(t.get('nodes'), int) and isinstance(t.get('roots'), int)
    61	            and t['nodes'] == len(ids) and 0 <= t['roots'] <= t['nodes']):
    62	        return False
    63	    if not (isinstance(fids, list) and all(isinstance(f, str) for f in fids)):
    64	        return False
    65	    return isinstance(t.get('manager_id'), int) and not isinstance(t.get('manager_id'), bool)
