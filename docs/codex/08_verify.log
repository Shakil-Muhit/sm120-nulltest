   136	def parse_output_code(dump_dir):
   137	    """Parse every output_code.py: kernel defs (ops, param roles, load/store
   138	    index exprs) keyed by wrapper symbol, and the call() body in execution
   139	    order with ORDERED, role-tagged args."""
   140	    files = sorted(glob.glob(os.path.join(dump_dir, '**', 'output_code.py'),
   141	                             recursive=True))
   142	    graphs = []
   143	    for path in files:
   144	        src = open(path).read()
   145	        source_literals = {}
   146	        for node in ast.parse(src).body:
   147	            if (isinstance(node, ast.Assign) and len(node.targets) == 1
   148	                    and isinstance(node.targets[0], ast.Name)
   149	                    and isinstance(node.value, ast.Call)
   150	                    and isinstance(node.value.func, ast.Attribute)
   151	                    and node.value.func.attr == 'triton'
   152	                    and len(node.value.args) >= 2
   153	                    and isinstance(node.value.args[1], ast.Constant)
   154	                    and isinstance(node.value.args[1].value, str)):
   155	                source_literals[node.targets[0].id] = node.value.args[1].value
   156	        assigns = list(ASSIGN_TRITON_RE.finditer(src))
   157	        kernels = {}
   158	        for idx, am in enumerate(assigns):
   159	            lhs, inner = am.group(1), am.group(2)
   160	            lo = assigns[idx - 1].end() if idx else 0
   161	            hi = assigns[idx + 1].start() if idx + 1 < len(assigns) else len(src)
   162	            window = src[lo:am.start()]
   163	            cm = None
   164	            for cm in ATEN_COMMENT_RE.finditer(window):
   165	                pass                      # LAST comment before this assignment
   166	            k = {'inner_name': inner, 'inner_mismatch': inner != lhs}
   167	            if cm:
   168	                k['ops'] = [o.strip() for o in cm.group(1).split(',') if o.strip()]
   169	                k['ops_source'] = 'aten_comment'
   170	            else:
   171	                raw = ops_from_name(lhs)
   172	                k['ops'] = []
   173	                k['ops_source'] = 'name' if raw else 'unknown'
   174	                k['ops_raw_name'] = raw
   175	            body = src[am.end():hi]       # this kernel's own source slice
   176	            pm = re.search(r'def\s+' + re.escape(inner) + r'\s*\(([^)]*)\)', body)
   177	            params, numeric = [], []
   178	            if pm:
   179	                for tok in pm.group(1).split(','):
   180	                    name_only = tok.split(':')[0].split('=')[0].strip()
   181	                    if not name_only:
   182	                        continue
   183	                    if name_only.startswith(('in_ptr', 'out_ptr', 'in_out_ptr')):
   184	                        params.append(name_only)
   185	                    elif 'constexpr' in tok:
   186	                        continue
   187	                    else:
   188	                        numeric.append(name_only)      # xnumel / rnumel / ks* ...
   189	            k['params'] = params
   190	            k['numeric_params'] = numeric
   191	            k['load_exprs'] = {}
   192	            k['store_exprs'] = {}
   193	            k['loads_present'] = []
   194	            k['stores_present'] = []
   195	            k['load_sites'] = {}
   196	            k['store_sites'] = {}
   197	            for p in params:
   198	                nl = len(re.findall(r'tl\.load\(\s*' + re.escape(p) + r'\b', body))
   199	                ns = len(re.findall(r'tl\.store\(\s*' + re.escape(p) + r'\b', body))
   200	                k['load_sites'][p] = nl
   201	                k['store_sites'][p] = ns
   202	                if nl:
   203	                    k['loads_present'].append(p)
   204	                if ns:
   205	                    k['stores_present'].append(p)
   206	                lm = re.search(r'tl\.load\(' + re.escape(p) + r'\s*\+\s*\(([^)]*)\)', body)
   207	                sm2 = re.search(r'tl\.store\(' + re.escape(p) + r'\s*\+\s*\(([^)]*)\)', body)
   208	                if lm:
   209	                    k['load_exprs'][p] = _canon_expr(lm.group(1))
   210	                if sm2:
   211	                    k['store_exprs'][p] = _canon_expr(sm2.group(1))
   212	            if lhs in source_literals:
   213	                k.update(access_expressions(source_literals[lhs], params))
   214	            # pointer element types from the kernel's own triton_meta signature
   215	            # (authoritative: the compiled kernel's ABI), e.g. 'in_ptr0': '*fp16'
   216	            sg = SIGNATURE_RE.search(body)
   217	            k['ptr_dtypes'] = dict(SIG_ITEM_RE.findall(sg.group(1))) if sg else {}
   218	            src_text = source_literals.get(lhs) or body
   219	            k['source_sha256'] = hashlib.sha256(src_text.encode()).hexdigest()
   220	            kernels[lhs] = k
   221	        # graph-input dtypes from the benchmark section (rand_strided(...))
   222	        input_dtypes = {m.group(1): m.group(4) for m in RAND_STRIDED_RE.finditer(src)}
   223	
   224	        try:
   225	            body = src.split('def call(')[1]
   226	        except IndexError:
   227	            continue
   228	        allocs, aliases, calls, unparsed = {}, {}, [], []
   229	        body_start = src[:src.index('def call(')].count('\n') + 1
   230	        # logical statements: physical lines are joined until their brackets
   231	        # balance, so a multiline call is parsed (or recorded unparsed) whole
   232	        # (gate-07 f107)
   233	        logical, buf, depth, start_line = [], '', 0, None
   234	        for phys_no, phys in enumerate(body.splitlines(), body_start):
   235	            if start_line is None:
   236	                start_line = phys_no
   237	            buf = (buf + ' ' + phys.strip()) if buf else phys
   238	            depth += phys.count('(') + phys.count('[') - phys.count(')') - phys.count(']')
   239	            if depth <= 0:
   240	                logical.append((start_line, buf))
   241	                buf, depth, start_line = '', 0, None
   242	        if buf:
   243	            logical.append((start_line, buf))
   244	        for body_line, line in logical:
   245	            stripped = line.strip()
   246	            if stripped.startswith('return ') or stripped.startswith('def ') or stripped.startswith('#'):
   247	                if stripped.startswith('return '):
   248	                    break
   249	                continue
   250	            am = ALLOC_RE.match(line)
   251	            if am:
   252	                allocs[am.group(1)] = {'shape': _ints(am.group(2)),
   253	                                       'stride': _ints(am.group(3)),
   254	                                       'dtype': am.group(4)}
   255	                continue
   256	            xm = ALIAS_RE.match(line)
   257	            if xm:
   258	                aliases[xm.group(1)] = {'base': xm.group(2),
   259	                                        'shape': _ints(xm.group(3)),
   260	                                        'stride': _ints(xm.group(4))}
   261	                continue
   262	            rm = RENAME_RE.match(line)
   263	            if rm and rm.group(1) != rm.group(2):
   264	                aliases[rm.group(1)] = {'base': rm.group(2)}   # plain reuse
   265	                continue
   266	            gm = GETITEM_RE.match(line)
   267	            if gm:
   268	                aliases[gm.group(1)] = {'base': gm.group(2),
   269	                                        'item': int(gm.group(3))}
   270	                continue
   271	            sm = ASSERT_RE.match(line)
   272	            if sm:
   273	                allocs.setdefault(sm.group(1), {'shape': _ints(sm.group(2)),
   274	                                                'stride': _ints(sm.group(3)),
   275	                                                'dtype': input_dtypes.get(sm.group(1))})
   276	                continue
   277	            tm = TRITON_CALL_RE.match(line)
   278	            em = EXTERN_CALL_RE.match(line)
   279	            fm = FALLBACK_RE.match(line)
   280	            if not (tm or em or fm):
   281	                # an executable call the parser does not recognise is recorded
   282	                # verbatim (gate-06 f91); it prevents equivalence downstream
   283	                if EXECUTABLE_HINT_RE.search(line) and 'async_compile' not in line:
   284	                    unparsed.append(' '.join(line.split()))
   285	                continue
   286	            if tm:
   287	                kind, name, argstr, assigned = 'triton', tm.group(1), tm.group(2), None
   288	            elif em:
   289	                kind, name, argstr, assigned = ('extern', f'extern.{em.group(2)}',
   290	                                                em.group(3), em.group(1))
   291	            else:
   292	                kind, name, argstr, assigned = ('fallback', f'{fm.group(2)}.{fm.group(3)}',
   293	                                                fm.group(4), fm.group(1))
   294	            out_kw = re.search(r'\bout\s*=', argstr)
   295	            args = []
   296	            for mt in ARG_TOKEN_RE.finditer(argstr):
   297	                if mt.group(1):
   298	                    a = {'buf': mt.group(1), 'shape': _ints(mt.group(2)),
   299	                         'stride': _ints(mt.group(3)), 'reinterpret': True}
   300	                else:
   301	                    a = {'buf': mt.group(4), 'shape': None, 'stride': None,
   302	                         'reinterpret': False}
   303	                a['in_out_kw'] = bool(out_kw and mt.start() > out_kw.start())
   304	                args.append(a)
   305	            if kind == 'triton':
   306	                params = kernels.get(name, {}).get('params', [])
   307	                align_ok = len(params) == len(args)
   308	                # positional literals after the pointer arguments, bound later to
   309	                # the kernel's numeric params (gate-04 f52); keyword args excluded
   310	                inner = argstr
   311	                depth, pos_args, cur = 0, [], ''
   312	                for ch in inner:
   313	                    if ch in '([':
   314	                        depth += 1
   315	                    elif ch in ')]':
   316	                        depth -= 1
   317	                    if ch == ',' and depth == 0:
   318	                        pos_args.append(cur.strip())
   319	                        cur = ''
   320	                    else:
   321	                        cur += ch
   322	                if cur.strip():
   323	                    pos_args.append(cur.strip())
   324	                pos_args = [x for x in pos_args if '=' not in x.split('(')[0]]
   325	                numeric_literals = pos_args[len(args):]
   326	                for i, a in enumerate(args):
   327	                    role = params[i] if i < len(params) else ''
   328	                    a['read'] = role.startswith(('in_ptr', 'in_out_ptr'))
   329	                    a['write'] = role.startswith(('out_ptr', 'in_out_ptr'))
   330	                    a['role'] = role or 'unaligned'
   331	                    a['read'], a['write'], a['access_unresolved'] = refined_access(
   332	                        kernels.get(name, {}), a['role'])
   333	                calls.append({'kind': kind, 'name': name, 'args': args,
   334	                              'align_ok': align_ok, 'assigned': None,
   335	                              'numeric_literals': numeric_literals,
   336	                              'line': line.strip()})
   337	            elif kind == 'extern':
   338	                for a in args:
   339	                    a['write'] = a['in_out_kw']
   340	                    a['read'] = not a['in_out_kw']
   341	                    a['role'] = 'out' if a['write'] else 'in'
   342	                calls.append({'kind': kind, 'name': name, 'args': args,
   343	                              'align_ok': True, 'assigned': assigned,
   344	                              'line': line.strip()})
   345	            else:
   346	                for a in args:
   347	                    a['read'], a['write'], a['role'] = True, False, 'in'
   348	                calls.append({'kind': kind, 'name': name, 'args': args,
   349	                              'align_ok': True, 'assigned': assigned,
   350	                              'line': line.strip()})
   351	            calls[-1]['source_line'] = body_line
   352	        graphs.append({'path': path, 'calls': calls, 'allocs': allocs,
   353	                       'aliases': aliases, 'kernels': kernels, 'unparsed': unparsed})
   354	    return graphs
