    60	        terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "timeout after ${cap}s"
    61	        echo "    TIMEOUT -> UNTESTED recorded"
    62	    elif [ "$rc" != "0" ]; then
    63	        echo "    process exit $rc"
    64	        [ -s "$path" ] || terminal_json "$path" "$arm" "$chunk" "$tag" INVALID "process exit $rc without JSON"
    65	    fi
    66	}
    67	
    68	# run_matched ARM_A ARM_B CHUNK TAG
    69	run_matched() {
    70	    local a="$1" b="$2" chunk="$3" tag="$4"
    71	    local path="$EVID/matched_${a}_${b}_c${chunk}_${tag}.json"
    72	    local cap; cap=$(cap_for "$T_COMPILE")
    73	    rm -f "$path"
    74	    if [ "$cap" -lt "$T_MIN" ]; then
    75	        echo "--- matched $a/$b $tag: DEADLINE -> UNTESTED ---"
    76	        python3 -c "import json;json.dump({'pair':['$a','$b'],'chunk':$chunk,'tag':'$tag','status':'UNTESTED','error':'session deadline','pair_eligible':False},open('$path','w'),indent=1)"
    77	        return
    78	    fi
    79	    echo "--- matched pair $a vs $b chunk=$chunk tag=$tag $(date -Is) cap=${cap}s ---"
    80	    env TORCH_LOGS="graph_breaks,recompiles,cudagraphs" timeout -k 30 "$cap" python "$MATCHED" \
    81	        --pair "$a" "$b" --chunk "$chunk" --tag "$tag" --iters "$ITERS" --repeats "$REPEATS" \
    82	        --evidence-dir "$EVID" 2> "$EVID/torchlogs_matched_${a}_${b}_${chunk}_${tag}.log"
    83	    local rc=$?
    84	    [ "$rc" = "0" ] || echo "    matched exit $rc"
    85	    [ -s "$path" ] || python3 -c "import json;json.dump({'pair':['$a','$b'],'chunk':$chunk,'tag':'$tag','status':'UNTESTED','error':'exit $rc','pair_eligible':False},open('$path','w'),indent=1)"
    86	}
    87	
    88	# run_traced ARM CHUNK TAG GRAPHMODE(node|graph) [extra...]  — one 5a block under nsys
    89	run_traced() {
    90	    local arm="$1" chunk="$2" tag="$3" gmode="$4"; shift 4
    91	    local base="$EVID/traces/trace_${arm}_${chunk}_${tag}"
    92	    local path="$EVID/full_${arm}_c${chunk}_${tag}.json"
    93	    local cap; cap=$(cap_for "$(tmo_for "$arm")")
    94	    mkdir -p "$EVID/traces"
    95	    # every artifact of THIS attempt is invalidated before anything else (gate-06 f94):
    96	    # its run JSON, report, exports — and, only for the main 'trace' tag, the
    97	    # reductions derived from it (perturbation traces own no reductions; f79)
    98	    rm -f "$path" "$base.nsys-rep" "$base.sqlite" "${base}"_*.csv "${base}_exports.json"
    99	    if [ "$tag" = "trace" ]; then
   100	        rm -f "$EVID/traces/graph_verify_${arm}_${chunk}.json" "$EVID/traces/timing_views_${arm}_${chunk}.json" \
   101	              "$EVID/traces/ideal_costs_${arm}_${chunk}.json" "$EVID/traces/ideal_costs_${arm}_${chunk}.csv" \
   102	              "$EVID/aux_graph_verify_${arm}_${chunk}.json" "$EVID/aux_timing_views_${arm}_${chunk}.json" \
   103	              "$EVID/aux_ideal_costs_${arm}_${chunk}.json"
   104	    fi
   105	    if [ "$cap" -lt "$T_MIN" ]; then
   106	        echo "--- TRACE $arm/$chunk/$tag: DEADLINE -> UNTESTED ---"
   107	        terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "session deadline: not started"
   108	        return 1
   109	    fi
   110	    local envv=("TORCHINDUCTOR_UNIQUE_KERNEL_NAMES=1") logs; logs="$(logs_for "$arm")"
   111	    [ -n "$logs" ] && envv+=("TORCH_LOGS=$logs")
   112	    if [ -n "$logs" ] && [ "$gmode" = "node" ]; then
   113	        local dump="$EVID/traces/dump_${arm}_${chunk}_${tag}"; rm -rf "$dump"; mkdir -p "$dump"
   114	        envv+=("TORCH_COMPILE_DEBUG=1" "TORCH_COMPILE_DEBUG_DIR=$dump" "TORCHINDUCTOR_FORCE_DISABLE_CACHES=1")
   115	    fi
   116	    echo "--- TRACE arm=$arm chunk=$chunk tag=$tag graph-trace=$gmode $(date -Is) cap=${cap}s ---"
   117	    env "${envv[@]}" timeout -k 30 "$cap" nsys profile --capture-range=cudaProfilerApi \
   118	        --capture-range-end=stop --cuda-graph-trace="$gmode" --force-overwrite=true \
   119	        -o "$base" python "$RUN" --arm "$arm" --chunk "$chunk" --tag "$tag" \
   120	        --iters "$ITERS" --repeats 1 --nvtx-pass --clips-dir "$CLIPS_DIR" --evidence-dir "$EVID" "$@" \
   121	        2> "$EVID/torchlogs_${arm}_${chunk}_${tag}.log"
   122	    local rc=$?
   123	    if [ "$rc" != "0" ]; then
   124	        echo "    trace run exit $rc"
   125	        [ -s "$path" ] || terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "trace run exit $rc"
   126	        return 1
   127	    fi
   128	    [ -s "$base.nsys-rep" ] || { echo "    no .nsys-rep"; return 1; }
   129	    if [ "$gmode" = "node" ]; then
   130	        # stale outputs invalidated BEFORE the attempt; the export is bounded and
   131	        # its exit code decides completeness (gate-04 f57)
   132	        rm -f "${base}"_*.csv "${base}_exports.json" "${base}.sqlite"
   133	        local ecap; ecap=$(cap_for 900)
   134	        local erc=1
   135	        if [ "$ecap" -ge 60 ]; then
   136	            timeout -k 30 "$ecap" nsys stats --force-export=true --force-overwrite=true --format csv \
   137	                --report cuda_gpu_trace --report cuda_gpu_kern_sum --report cuda_api_trace \
   138	                --report nvtx_gpu_proj_trace --report nvtx_gpu_proj_sum \
   139	                --output "$base" "$base.nsys-rep" > /dev/null 2>&1; erc=$?
