    62	def joint_settle(built, arms, rounds=2, passes=3):
    63	    """Alternate the two steps. The recording state is snapshotted BEFORE the
    64	    first round and after every round; stable iff unchanged across ALL rounds
    65	    (a re-recording of the arm built first shows up in round 1), and no new
    66	    graph breaks / unimplemented ops appear at any point."""
    67	    snaps = [tm.recording_state()]
    68	    for r in range(rounds + 1):
    69	        for arm in arms:
    70	            b = built[arm]
    71	            with torch.no_grad(), b['ctx']():
    72	                for _ in range(passes):
    73	                    b['step'](b['x'])
    74	        torch.cuda.synchronize()
    75	        snaps.append(tm.recording_state())
    76	    verdicts = [tm.recording_stable(a, c) for a, c in zip(snaps, snaps[1:])]
    77	    breaks = [sum(x['counters'].get('graph_break', {}).values()) +
    78	              sum(x['counters'].get('unimplemented', {}).values()) for x in snaps]
    79	    return {'stable': (None if any(v is None for v in verdicts) else all(verdicts)),
    80	            'new_breaks_during_joint_settle': breaks[-1] - breaks[0],
    81	            'rounds': rounds, 'snapshots': snaps}
