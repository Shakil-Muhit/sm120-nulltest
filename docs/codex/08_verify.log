   195	def sdpa_class_costs(chunk):
   196	    T = FRAMES[chunk]
   197	    H, D, F = MODEL['heads'], MODEL['dim_head'], MODEL['bands']
   198	    fl = by = 0.0
   199	    for B, N in ((F, T), (T, F)):
   200	        fl += 6 * 4.0 * B * H * N * N * D
   201	        by += 6 * 4 * B * H * N * D * 2
   202	    return fl, by
   203	
   204	
   205	def gemm_site(call, gr):
   206	    reads = [arg_meta(gr, a) for a in call['args'] if a.get('read')]
   207	    writes = [arg_meta(gr, a) for a in call['args'] if a.get('write')]
   208	    mats = [m for m in reads if len(m['shape']) in (2, 3)]
   209	    if len(mats) < 2 or not writes:
   210	        return None
   211	    a, b = mats[-2], mats[-1]
   212	    if any(m['dtype'] is None for m in mats + writes):
   213	        return None
   214	    if len(a['shape']) == 2 and len(b['shape']) == 2:
   215	        M, K = a['shape']; K2, N = b['shape']; batch = 1
   216	    elif len(a['shape']) == 3 and len(b['shape']) == 3:
   217	        batch, M, K = a['shape']; _, K2, N = b['shape']
   218	    else:
   219	        return None
   220	    if K != K2:
   221	        return None
   222	    by = sum(nbytes(m['shape'], m['dtype']) for m in mats) + sum(nbytes(m['shape'], m['dtype']) for m in writes)
   223	    return {'M': M, 'N': N, 'K': K, 'batch': batch, 'dtype': a['dtype'],
   224	            'flops': 2.0 * batch * M * N * K, 'bytes': by}
   225	
   226	
   227	def storage_extent(shape, stride):
   228	    """Elements spanned by an allocation's address range: 1 + sum((size-1)*|stride|)."""
   229	    if not shape:
   230	        return 0
   231	    ext = 1
   232	    for d, st in zip(shape, stride or [0] * len(shape)):
   233	        if int(d) == 0:
   234	            return 0
   235	        ext += (int(d) - 1) * abs(int(st))
   236	    return ext
   237	
   238	
   239	def ideal_us(flops, by, dtype, bw_l2, l2_bytes, footprint=None):
   240	    """Per CALL. footprint = the call's unique resident bytes (max of read /
   241	    write sets is used as a lower bound when aliases are unknown); the L2
   242	    ideal applies only when footprint <= l2_bytes."""
   243	    p = (P_FP32_TFLOPS if dtype in ('torch.float32', 'torch.float64') else P_FP16_TFLOPS) * 1e12
   244	    t_flop = flops / p * 1e6
   245	    t_hbm = by / (BW_HBM_TBPS * 1e12) * 1e6
   246	    rec = {'ideal_us_hbm': max(t_flop, t_hbm)}
   247	    fp = footprint if footprint is not None else by
   248	    if bw_l2 and l2_bytes and fp <= l2_bytes:
   249	        rec['ideal_us_l2'] = max(t_flop, by / (bw_l2 * 1e12) * 1e6)
   250	    return rec
