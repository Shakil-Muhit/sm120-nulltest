    95	def recomputed_timing(timing, iters, repeats):
    96	    """Statistics recomputed from the recorded samples (gate-05 f64); None if
    97	    the samples are not a complete, finite, positive registered payload or if
    98	    any NESTED stored summary contradicts its own samples (gate-06 f88)."""
    99	    blocks = (timing or {}).get('blocks') or []
   100	    if len(blocks) != repeats:
   101	        return None
   102	    if [b.get('repeat') for b in blocks] != list(range(repeats)):
   103	        return None
   104	    meds, thr = [], []
   105	    for b in blocks:
   106	        lat = b.get('latency_ms_per_iter') or []
   107	        if len(lat) != iters or not all(_finite(x) and x > 0 for x in lat):
   108	            return None
   109	        if not (_finite(b.get('throughput_ms_per_pass')) and b['throughput_ms_per_pass'] > 0):
   110	            return None
   111	        srt = sorted(lat)
   112	        if not (_close(b.get('latency_median_ms'), _median(lat), 1e-9, 1e-9)
   113	                and _close(b.get('latency_min_ms'), srt[0], 1e-9, 1e-9)
   114	                and _close(b.get('latency_max_ms'), srt[-1], 1e-9, 1e-9)):
   115	            return None
   116	        if not (_finite(b.get('unix_start')) and _finite(b.get('unix_end')) and b['unix_end'] >= b['unix_start']):
   117	            return None
   118	        meds.append(_median(lat))
   119	        thr.append(b['throughput_ms_per_pass'])
   120	    t = timing
   121	    rt = {'block_medians_ms': meds, 'min_of_medians_ms': min(meds),
   122	          'median_spread_ms': max(meds) - min(meds), 'throughput_best_ms': min(thr)}
   123	    lm = t.get('latency_medians_ms')
   124	    if lm is not None and not (isinstance(lm, list) and len(lm) == repeats
   125	                               and all(_close(a, b, 1e-9, 1e-9) for a, b in zip(lm, meds))):
   126	        return None
   127	    sd = t.get('serialization_delta_pct')
   128	    if sd is not None and not (isinstance(sd, list) and len(sd) == repeats and all(_finite(x) for x in sd)):
   129	        return None
   130	    for k_t, k_rt in (('min_of_medians_ms', 'min_of_medians_ms'), ('median_spread_ms', 'median_spread_ms'),
   131	                      ('throughput_ms_per_pass_best', 'throughput_best_ms')):
   132	        if k_t in t and not _close(t.get(k_t), rt[k_rt], 1e-9, 1e-9):
   133	            return None
   134	    if t.get('repeats') != repeats or t.get('iters_per_block') != iters:
   135	        return None
   136	    return rt
