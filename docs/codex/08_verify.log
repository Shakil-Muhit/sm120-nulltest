   304	def run_problems(rec, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS,
   305	                 require_manifest=True, require_timing=True):
   306	    """All reasons a single-arm record is NOT a qualified measurement."""
   307	    problems = []
   308	    if rec is None:
   309	        return ['record missing']
   310	    if rec.get('status') != 'VALID':
   311	        problems.append(f"status {rec.get('status')}")
   312	    if rec.get('arm') == 'ANVTX':
   313	        problems.append('attribution arm')
   314	    if rec.get('nvtx_pass'):
   315	        problems.append('traced/attribution run')
   316	    if rec.get('planted_fault') or rec.get('planted_fault_const') is not None:
   317	        problems.append('planted fault run')
   318	    problems += validation_problems(rec)
   319	    if require_manifest and not rec.get('manifest_id'):
   320	        problems.append('not bound to a session manifest')
   321	    if require_timing:
   322	        b = _blocks_ok(rec.get('timing'), iters, repeats)
   323	        if b:
   324	            problems.append(b)
   325	    if not rec.get('effective_variant') and any(k in rec for k in VARIANT_FIELDS):
   326	        problems.append('effective variant not recorded')
   327	    if rec.get('arm') in COMPILE_ARMS:
   328	        st = stability_recomputed(rec)
   329	        if rec.get('counters_stable') is not True or st is not True:
   330	            problems.append('recording stability not affirmatively established from the stored snapshots')
   331	        s = rec.get('settle') or {}
   332	        if s.get('settle_capped') or s.get('stable') is False:
   333	            problems.append('compile settle capped or unstable')
   334	        problems += gate_problems(rec.get('arm'), rec.get('graph_gate'),
   335	                                  (rec.get('counter_snapshots') or {}).get('after_settle'))
   336	    if require_timing and rec.get('timing'):
   337	        rt = recomputed_timing(rec['timing'], iters, repeats)
   338	        if rt is None:
   339	            problems.append('timing samples incomplete or non-finite')
   340	        else:
   341	            for k_rec, k_rt in (('min_of_medians_ms', 'min_of_medians_ms'), ('median_spread_ms', 'median_spread_ms'),
   342	                                ('throughput_ms_per_pass_best', 'throughput_best_ms')):
   343	                if not _close(rec.get(k_rec), rt[k_rt], 1e-9, 1e-9):
   344	                    problems.append(f'stored {k_rec} differs from the value recomputed from samples')
   345	    if rec.get('sdr_gate') and rec['sdr_gate'].get('status') != 'REFERENCE_SAVED':
   346	        st, why = sdr_recomputed(rec['sdr_gate'])
   347	        if st != 'PASS':
   348	            problems.append(f"SDR gate {why or st}")
   349	    # stored-flag contradictions in BOTH directions (gate-05 f62)
   350	    if rec.get('headline_eligible') is False and not problems:
   351	        problems.append(f"stored eligibility flag says ineligible: {rec.get('ineligibility_reasons')}")
   352	    return problems
   353	
