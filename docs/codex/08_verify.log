   338	def env_fingerprint():
   339	    try:
   340	        driver = subprocess.run(
   341	            ['nvidia-smi', '--query-gpu=driver_version', '--format=csv,noheader'],
   342	            capture_output=True, text=True, timeout=10).stdout.strip().splitlines()[0]
   343	    except Exception:
   344	        driver = 'unavailable'
   345	    import triton
   346	    try:
   347	        uuid = subprocess.run(
   348	            ['nvidia-smi', '--query-gpu=uuid', '--format=csv,noheader', '-i',
   349	             os.environ.get('CUDA_VISIBLE_DEVICES', '0').split(',')[0]],
   350	            capture_output=True, text=True, timeout=10).stdout.strip().splitlines()[0]
   351	    except Exception:
   352	        uuid = 'unavailable'
   353	    props = torch.cuda.get_device_properties(0)
   354	    return {'torch': torch.__version__, 'triton': triton.__version__,
   355	            'cuda_build': torch.version.cuda, 'driver': driver,
   356	            'gpu': torch.cuda.get_device_name(0), 'gpu_uuid': uuid,
   357	            'l2_cache_bytes': getattr(props, 'L2_cache_size', None),
   358	            'sm_count': props.multi_processor_count,
   359	            'total_memory_bytes': props.total_memory,
   360	            'capability': list(torch.cuda.get_device_capability(0)),
   361	            'python': platform.python_version(), 'hostname': platform.node(),
   362	            'cuda_visible_devices': os.environ.get('CUDA_VISIBLE_DEVICES', ''),
   363	            'timestamp_utc': datetime.now(timezone.utc).isoformat()}
