   255	def required_phases(rec):
   256	    """The exact snapshot schema of a compiled run (gate-06 f82)."""
   257	    phases = ['after_settle', 'after_validation']
   258	    if rec.get('timing'):
   259	        phases += ['before_timing', 'after_timing']
   260	    if rec.get('sdr_gate'):
   261	        phases.append('after_sdr')
   262	    return phases
