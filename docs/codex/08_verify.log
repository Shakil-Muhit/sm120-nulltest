   498	def recomputed_matched_delta(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   499	    """Matched delta (a - b per block, median, % of a) recomputed from samples."""
   500	    a, b = m.get('pair') or (None, None)
   501	    per = {}
   502	    for arm in (a, b):
   503	        blocks = sorted((x for x in (m.get('blocks') or []) if x.get('arm') == arm), key=lambda x: x.get('repeat', 0))
   504	        if len(blocks) != repeats or [x.get('repeat') for x in blocks] != list(range(repeats)):
   505	            return None
   506	        if any(len(x.get('latency_ms_per_iter') or []) != iters or
   507	               not all(_finite(v) and v > 0 for v in x['latency_ms_per_iter']) for x in blocks):
   508	            return None
   509	        per[arm] = [_median(x['latency_ms_per_iter']) for x in blocks]
   510	    diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   511	    return {'a_minus_b_per_block': diffs, 'median': _median(diffs), 'min': min(diffs), 'max': max(diffs),
   512	            'median_pct_of_a': _median(diffs) / _median(per[a]) * 100.0}

