   225	def sdr_recomputed(gate):
   226	    """Recompute the SDR gate from its rows: exactly eight distinct clips,
   227	    every delta finite, mean vs the registered threshold."""
   228	    rows = (gate or {}).get('clips') or []
   229	    idx = sorted(r.get('index') for r in rows)
   230	    if idx != list(range(SDR_CLIPS)):
   231	        return None, f'clip indices {idx} are not the registered 0..{SDR_CLIPS - 1}'
   232	    if gate.get('n_clips') != SDR_CLIPS:
   233	        return None, 'stored n_clips differs from the registered clip count'
   234	    # paired terms recomputed (gate-06 f81): both SDR_ref terms finite, the
   235	    # stored delta equal to their difference
   236	    deltas = []
   237	    for r in rows:
   238	        a, b = r.get('sdr_ref_db'), r.get('sdr_ref_A_db')
   239	        if not (_finite(a) and _finite(b)):
   240	            return None, 'a paired SDR_ref term is missing or non-finite'
   241	        if not _close(r.get('delta_sdr_ref_db'), a - b, 1e-9, 1e-9):
   242	            return None, 'a stored clip delta differs from its paired terms'
   243	        deltas.append(a - b)
   244	    if not all(r.get('a_output_sha256') for r in rows):
   245	        return None, 'eager-A clip outputs not lineage-hashed'
   246	    mean = sum(deltas) / len(deltas)
   247	    status = 'PASS' if mean >= SDR_THRESHOLD_DB else 'FAIL'
   248	    if gate.get('mean_delta_sdr_ref_db') is None or not _close(gate['mean_delta_sdr_ref_db'], mean, 1e-9, 1e-9):
   249	        return None, 'stored mean delta differs from the recomputed one'
   250	    if gate.get('status') != status:
   251	        return None, f"stored SDR status {gate.get('status')} differs from the recomputed {status}"
   252	    return status, None
   253	
