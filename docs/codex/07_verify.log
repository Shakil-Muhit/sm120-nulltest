   234	def ideal_us(flops, by, dtype, bw_l2, l2_bytes, footprint=None):
   235	    """Per CALL. footprint = the call's unique resident bytes (max of read /
   236	    write sets is used as a lower bound when aliases are unknown); the L2
   237	    ideal applies only when footprint <= l2_bytes."""
   238	    p = (P_FP32_TFLOPS if dtype in ('torch.float32', 'torch.float64') else P_FP16_TFLOPS) * 1e12
   239	    t_flop = flops / p * 1e6
   240	    t_hbm = by / (BW_HBM_TBPS * 1e12) * 1e6
   241	    rec = {'ideal_us_hbm': max(t_flop, t_hbm)}
   242	    fp = footprint if footprint is not None else by
   243	    if bw_l2 and l2_bytes and fp <= l2_bytes:
   244	        rec['ideal_us_l2'] = max(t_flop, by / (bw_l2 * 1e12) * 1e6)
   245	    return rec
