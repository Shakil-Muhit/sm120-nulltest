   357	
   358	def sdr_problems(rec, chunk, manifest_id, var):
   359	    """The registered SDR qualification record for a cell: r1, same manifest,
   360	    same variant, gate PASS at that operating point, clip outputs lineage-hashed."""
   361	    if not rec or not rec.get('sdr_gate'):
   362	        return ['no SDR record in r1']
   363	    out = []
   364	    g = rec['sdr_gate']
   365	    if manifest_id and rec.get('manifest_id') != manifest_id:
   366	        out.append('r1 SDR record belongs to another manifest')
   367	    if var and variant(rec) != var:
   368	        out.append('r1 SDR record has another effective variant')
   369	    if rec.get('chunk') != chunk:
   370	        out.append('r1 SDR record operating point mismatch')
   371	    st, why = sdr_recomputed(g)
   372	    if st != 'PASS':
   373	        out.append(f"SDR gate {why or st}")
   374	    if g.get('operating_point') != chunk:
   375	        out.append('SDR record operating point mismatch')
   376	    return out
