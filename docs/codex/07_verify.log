   190	def sdpa_class_costs(chunk):
   191	    T = FRAMES[chunk]
   192	    H, D, F = MODEL['heads'], MODEL['dim_head'], MODEL['bands']
   193	    fl = by = 0.0
   194	    for B, N in ((F, T), (T, F)):
   195	        fl += 6 * 4.0 * B * H * N * N * D
   196	        by += 6 * 4 * B * H * N * D * 2
   197	    return fl, by
