   278	def run_problems(rec, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS,
   279	                 require_manifest=True, require_timing=True):
   280	    """All reasons a single-arm record is NOT a qualified measurement."""
   281	    problems = []
   282	    if rec is None:
   283	        return ['record missing']
   284	    if rec.get('status') != 'VALID':
   285	        problems.append(f"status {rec.get('status')}")
   286	    if rec.get('arm') == 'ANVTX':
   287	        problems.append('attribution arm')
   288	    if rec.get('nvtx_pass'):
   289	        problems.append('traced/attribution run')
   290	    if rec.get('planted_fault') or rec.get('planted_fault_const') is not None:
   291	        problems.append('planted fault run')
   292	    problems += validation_problems(rec)
   293	    if require_manifest and not rec.get('manifest_id'):
   294	        problems.append('not bound to a session manifest')
   295	    if require_timing:
   296	        b = _blocks_ok(rec.get('timing'), iters, repeats)
   297	        if b:
   298	            problems.append(b)
   299	    if not rec.get('effective_variant') and any(k in rec for k in VARIANT_FIELDS):
   300	        problems.append('effective variant not recorded')
   301	    if rec.get('arm') in COMPILE_ARMS:
   302	        st = stability_recomputed(rec)
   303	        if rec.get('counters_stable') is not True or st is not True:
   304	            problems.append('recording stability not affirmatively established from the stored snapshots')
   305	        s = rec.get('settle') or {}
   306	        if s.get('settle_capped') or s.get('stable') is False:
   307	            problems.append('compile settle capped or unstable')
   308	        problems += gate_problems(rec.get('arm'), rec.get('graph_gate'),
   309	                                  (rec.get('counter_snapshots') or {}).get('after_settle'))
   310	    if require_timing and rec.get('timing'):
   311	        rt = recomputed_timing(rec['timing'], iters, repeats)
   312	        if rt is None:
   313	            problems.append('timing samples incomplete or non-finite')
   314	        else:
   315	            for k_rec, k_rt in (('min_of_medians_ms', 'min_of_medians_ms'), ('median_spread_ms', 'median_spread_ms'),
   316	                                ('throughput_ms_per_pass_best', 'throughput_best_ms')):
   317	                if not _close(rec.get(k_rec), rt[k_rt], 1e-9, 1e-9):
   318	                    problems.append(f'stored {k_rec} differs from the value recomputed from samples')
   319	    if rec.get('sdr_gate') and rec['sdr_gate'].get('status') != 'REFERENCE_SAVED':
   320	        st, why = sdr_recomputed(rec['sdr_gate'])
   321	        if st != 'PASS':
   322	            problems.append(f"SDR gate {why or st}")
   323	    # stored-flag contradictions in BOTH directions (gate-05 f62)
   324	    if rec.get('headline_eligible') is False and not problems:
   325	        problems.append(f"stored eligibility flag says ineligible: {rec.get('ineligibility_reasons')}")
   326	    return problems
