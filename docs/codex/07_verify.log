    56	def cell(tag_runs):
    57	    req = {t: tag_runs.get(t) for t in REQUIRED_RESTARTS}
    58	    present = [r for r in req.values() if r]
    59	    chunk = present[0]['chunk'] if present else None
    60	    manifests = sorted({str(r.get('manifest_id')) for r in present})
    61	    variants = sorted({variant(r) for r in present})
    62	    ref_hashes = sorted({json.dumps(qualify.reference_hashes(r), sort_keys=True) for r in present})
    63	    manifest_id = manifests[0] if len(manifests) == 1 else None
    64	    var = variants[0] if len(variants) == 1 else None
    65	    sdr, sdr_delta, sdr_note = sdr_from_r1(tag_runs, chunk, manifest_id, var)
    66	    c = {'restarts_found': sorted(t for t in tag_runs if t.startswith('r')),
    67	         'statuses': {t: (r or {}).get('status', 'MISSING') for t, r in req.items()},
    68	         'tier': sorted({r.get('registered_tier') or r.get('tier') for r in present if r.get('tier')}),
    69	         'validation': {t: ((r or {}).get('validation') or {}).get('status', 'NONE') for t, r in req.items()},
    70	         'sdr_gate': sdr, 'mean_delta_sdr_ref_db': sdr_delta, 'sdr_note': sdr_note,
    71	         'manifests': manifests, 'variants': variants,
    72	         'graph_breaks': sorted({str(((r or {}).get('graph_gate') or {}).get('graph_break_count')) for r in present}),
    73	         'per_restart_min_of_medians_ms': {t: (r or {}).get('min_of_medians_ms') for t, r in req.items()},
    74	         'per_restart_spread_ms': {t: (r or {}).get('median_spread_ms') for t, r in req.items()},
    75	         'headline_status': 'INCOMPLETE', 'headline_ms': None, 'restart_spread_ms': None,
    76	         'throughput_best_ms': None, 'reasons': []}
    77	    for t, r in req.items():
    78	        if r is None:
    79	            c['reasons'].append(f'{t} missing')
    80	            continue
    81	        probs = qualify.run_problems(r)          # independent of stored flags (gate-04 f47)
    82	        if probs:
    83	            c['reasons'].append(f"{t}: {'; '.join(probs)}")
    84	        if r.get('headline_eligible') and probs:
    85	            c['reasons'].append(f'{t}: stored eligibility flag contradicts the record')
    86	    if len(manifests) != 1 or manifests == ['None']:
    87	        c['reasons'].append(f'restarts do not share one session manifest: {manifests}')
    88	    if len(variants) != 1:
    89	        c['reasons'].append(f'effective variants differ: {variants}')
    90	    if len(ref_hashes) != 1 or ref_hashes == ['{}']:
    91	        c['reasons'].append('restarts were not validated against one lineage-hashed reference set')
    92	    c['reference_hashes'] = json.loads(ref_hashes[0]) if len(ref_hashes) == 1 else None
    93	    c['clip_output_hashes'] = qualify.reference_hashes(tag_runs['r1'], include_clips=True) if tag_runs.get('r1') else None
    94	    if sdr != 'PASS':
    95	        c['reasons'].append(f'SDR qualification (r1) at this operating point: {sdr}' + (f' ({sdr_note})' if sdr_note else ''))
    96	    if not c['reasons']:
