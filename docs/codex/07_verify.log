   120	def load_manifest(evidence_dir, paths, env):
   121	    """Re-derives the complete identity and compares EVERY field."""
   122	    path = os.path.join(evidence_dir, 'session_manifest.json')
   123	    if not os.path.exists(path):
   124	        raise RuntimeError('session_manifest.json missing — run the session preflight')
   125	    with open(path) as f:
   126	        rec = json.load(f)
   127	    if _git(_ROOT, 'status', '--porcelain'):
   128	        raise RuntimeError('tree is not clean; the session manifest binds a committed tree')
   129	    cur = identity(paths, env)
   130	    for key, val in cur.items():
   131	        if rec.get(key) != val:
   132	            raise RuntimeError(f'session manifest mismatch in {key}')
   133	    return rec
