   200	def gemm_site(call, gr):
   201	    reads = [arg_meta(gr, a) for a in call['args'] if a.get('read')]
   202	    writes = [arg_meta(gr, a) for a in call['args'] if a.get('write')]
   203	    mats = [m for m in reads if len(m['shape']) in (2, 3)]
   204	    if len(mats) < 2 or not writes:
   205	        return None
   206	    a, b = mats[-2], mats[-1]
   207	    if any(m['dtype'] is None for m in mats + writes):
   208	        return None
   209	    if len(a['shape']) == 2 and len(b['shape']) == 2:
   210	        M, K = a['shape']; K2, N = b['shape']; batch = 1
   211	    elif len(a['shape']) == 3 and len(b['shape']) == 3:
   212	        batch, M, K = a['shape']; _, K2, N = b['shape']
   213	    else:
   214	        return None
   215	    if K != K2:
   216	        return None
   217	    by = sum(nbytes(m['shape'], m['dtype']) for m in mats) + sum(nbytes(m['shape'], m['dtype']) for m in writes)
   218	    return {'M': M, 'N': N, 'K': K, 'batch': batch, 'dtype': a['dtype'],
   219	            'flops': 2.0 * batch * M * N * K, 'bytes': by}
   220	
