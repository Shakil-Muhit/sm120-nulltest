   117	def time_chain(launch, n, capture, label):
   118	    for _ in range(WARMUP):
   119	        launch()
   120	    torch.cuda.synchronize()
   121	    graph = None
   122	    if capture:
   123	        s = torch.cuda.Stream()
   124	        s.wait_stream(torch.cuda.current_stream())
   125	        with torch.cuda.stream(s):
   126	            launch()
   127	        torch.cuda.current_stream().wait_stream(s)
   128	        torch.cuda.synchronize()
   129	        graph = torch.cuda.CUDAGraph()
   130	        with torch.cuda.graph(graph):
   131	            launch()
   132	        graph.replay()
   133	        torch.cuda.synchronize()
   134	    times = []
   135	    torch.cuda.nvtx.range_push(label)
   136	    for _ in range(REPEATS):
   137	        e0 = torch.cuda.Event(enable_timing=True)
   138	        e1 = torch.cuda.Event(enable_timing=True)
   139	        e0.record()
   140	        if graph is not None:
   141	            graph.replay()
   142	        else:
   143	            launch()
   144	        e1.record()
   145	        torch.cuda.synchronize()
   146	        times.append(e0.elapsed_time(e1) * 1e3)      # us
   147	    torch.cuda.nvtx.range_pop()
   148	    return {'chain_us_median': statistics.median(times),
   149	            'chain_us_min': min(times), 'chain_us_max': max(times),
   150	            'per_launch_us': statistics.median(times) / n, 'n': n, 'repeats': REPEATS}
