   222	def storage_extent(shape, stride):
   223	    """Elements spanned by an allocation's address range: 1 + sum((size-1)*|stride|)."""
   224	    if not shape:
   225	        return 0
   226	    ext = 1
   227	    for d, st in zip(shape, stride or [0] * len(shape)):
   228	        if int(d) == 0:
   229	            return 0
   230	        ext += (int(d) - 1) * abs(int(st))
   231	    return ext
