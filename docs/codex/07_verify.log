   110	L2B=$(python3 -c "import json;print(json.load(open('$EVID/boundary_bench.json')).get('l2_resident_bandwidth',{}).get('l2_cache_bytes',''))" 2>/dev/null)
   111	for chunk in 352800 4410; do
