   440	def recomputed_matched_delta(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   441	    """Matched delta (a - b per block, median, % of a) recomputed from samples."""
   442	    a, b = m.get('pair') or (None, None)
   443	    per = {}
   444	    for arm in (a, b):
   445	        blocks = sorted((x for x in (m.get('blocks') or []) if x.get('arm') == arm), key=lambda x: x.get('repeat', 0))
   446	        if len(blocks) != repeats or [x.get('repeat') for x in blocks] != list(range(repeats)):
   447	            return None
   448	        if any(len(x.get('latency_ms_per_iter') or []) != iters or
   449	               not all(_finite(v) and v > 0 for v in x['latency_ms_per_iter']) for x in blocks):
   450	            return None
   451	        per[arm] = [_median(x['latency_ms_per_iter']) for x in blocks]
   452	    diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   453	    return {'a_minus_b_per_block': diffs, 'median': _median(diffs), 'min': min(diffs), 'max': max(diffs),
   454	            'median_pct_of_a': _median(diffs) / _median(per[a]) * 100.0}

