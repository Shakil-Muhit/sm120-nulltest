   293	def validate(step, ctx, tier, chunk, ref_dir, save_reference=False, manifest_id=None):
   294	    """AUDIT-MAP[2] mechanics: two passes, different data (asserted), each
   295	    compared to the SAVED eager-A output for that (chunk, seed). With
   296	    save_reference=True (arm A reference step) the outputs are written
   297	    instead of compared."""
   298	    passes, prev_x = [], None
   299	    for seed in VAL_SEEDS:
   300	        x = make_input(chunk, seed)
   301	        if prev_x is not None:
   302	            assert not torch.equal(x, prev_x), \
   303	                'validation passes must use different input data'
   304	        prev_x = x
   305	        with torch.no_grad(), ctx():
   306	            out = step(x)
   307	            torch.cuda.synchronize()
   308	            out = out.clone()            # borrow discipline (build_spec rule 1)
   309	        path = ref_path(ref_dir, chunk, seed)
   310	        if save_reference:
   311	            os.makedirs(ref_dir, exist_ok=True)
   312	            torch.save(out.float().cpu(), path)
   313	            if manifest_id is not None:
   314	                provenance.bind_artifact(path, manifest_id)
   315	            passes.append({'seed': seed, 'saved': path, 'ref_sha256': provenance.sha256_file(path),
   316	                           'finite': bool(torch.isfinite(out).all())})
   317	            continue
   318	        if not os.path.exists(path):
   319	            raise FileNotFoundError(f'reference output missing: {path} '
   320	                                    '(run the arm-A reference step first)')
   321	        if manifest_id is not None:
   322	            provenance.check_artifact(path, manifest_id)
   323	        ref = torch.load(path, map_location='cuda', weights_only=True)
   324	        rec = compare_outputs(out, ref, tier)
   325	        rec['seed'] = seed
   326	        # persisted, checked reference identity (gate-04 f47): the hash the
   327	        # lineage check saw, so collectors can join restarts on it
   328	        rec['ref_sha256'] = provenance.sha256_file(path) if manifest_id is not None else None
   329	        passes.append(rec)
   330	        del ref
   331	    if save_reference:
   332	        return {'status': 'REFERENCE_SAVED', 'tier': tier, 'passes': passes}
   333	    ok = all(p['ok'] for p in passes)
   334	    return {'status': 'PASS' if ok else 'FAIL', 'tier': tier,
   335	            'rtol': TIERS[tier][0], 'atol': TIERS[tier][1], 'passes': passes}
