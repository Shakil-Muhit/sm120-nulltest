    97	def identity(paths, env):
    98	    """Every field the manifest binds; compared verbatim by load_manifest."""
    99	    return {'repo_commit': _git(_ROOT, 'rev-parse', 'HEAD'),
   100	            'registration_sha256': sha256_file(os.path.join(_ROOT, 'prereg_amendments.md')),
   101	            'clips_manifest_sha256': sha256_file(os.path.join(_ROOT, 'configs', 'sdr_clips.json')),
   102	            'code': code_hashes(), 'provenance': verify(paths),
   103	            'runtime': {k: env.get(k) for k in ('torch', 'triton', 'cuda_build', 'driver', 'gpu', 'gpu_uuid')}}
