   190	        except (ValueError, IndexError):
   191	            continue
   192	    kern.sort()
   193	    head, rows = read(base + '_nvtx_gpu_proj_trace.csv')
   194	    c_name = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Name', 'Range'))
   195	    c_start = next(i for i, h in enumerate(head) if 'Start' in h)
   196	    c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
