    40	def pins():
    41	    lines = [l.strip() for l in open(os.path.join(_ROOT, 'configs', 'msst_commit.txt'))
    42	             if l.strip() and not l.strip().startswith('#')]
    43	    msst_commit = lines[0]
    44	    data = [l.strip() for l in open(os.path.join(_ROOT, 'configs', 'checkpoint.txt'))
    45	            if l.strip() and not l.strip().startswith('#')]
    46	    assert len(data) == 3, 'configs/checkpoint.txt must hold URL / sha256 / config path'
    47	    return {'msst_commit': msst_commit, 'ckpt_url': data[0], 'ckpt_sha256': data[1].lower(),
    48	            'config_rel': data[2]}
