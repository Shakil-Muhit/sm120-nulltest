   109	            c['per_restart_min_of_medians_ms'] = {t: rts[t]['min_of_medians_ms'] for t in REQUIRED_RESTARTS}
   110	            c['per_restart_spread_ms'] = {t: rts[t]['median_spread_ms'] for t in REQUIRED_RESTARTS}
   111	    vals = [v for v in c['per_restart_min_of_medians_ms'].values() if v]
