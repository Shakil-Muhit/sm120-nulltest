   329	def trace_problems(rec, iters=REGISTERED_ITERS):
   330	    """A one-block traced or perturbation run (never a headline): everything a
   331	    measurement needs except the multi-block protocol; nvtx is allowed."""
   332	    if rec is None:
   333	        return ['record missing']
   334	    problems = []
   335	    if rec.get('status') != 'VALID':
   336	        problems.append(f"status {rec.get('status')}")
   337	    if rec.get('planted_fault') or rec.get('planted_fault_const') is not None:
   338	        problems.append('planted fault run')
   339	    if rec.get('arm') != 'ANVTX':
   340	        problems += validation_problems(rec)
   341	    if not rec.get('manifest_id'):
   342	        problems.append('not bound to a session manifest')
   343	    if recomputed_timing(rec.get('timing'), iters, 1) is None:
   344	        problems.append('one-block timing samples incomplete, non-finite, or contradicting stored summaries')
   345	    if not rec.get('effective_variant'):
   346	        problems.append('effective variant not recorded')
   347	    if rec.get('arm') in COMPILE_ARMS:
   348	        st = stability_recomputed(rec)
   349	        if rec.get('counters_stable') is not True or st is not True:
   350	            problems.append('recording stability not affirmatively established from the stored snapshots')
   351	        if (rec.get('settle') or {}).get('settle_capped'):
   352	            problems.append('compile settle capped')
   353	        problems += gate_problems(rec.get('arm'), rec.get('graph_gate'),
   354	                                  (rec.get('counter_snapshots') or {}).get('after_settle'))
   355	    return problems
