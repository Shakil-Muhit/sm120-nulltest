   609	def split_passes(rows, windows, classify):
   610	    if windows:
   611	        return [[r for r in rows if s <= r['start'] < e]
   612	                for s, e in windows], 'nvtx-windows'
   613	    sdpa_idx = [i for i, r in enumerate(rows) if classify(r['name']) == 'SDPA']
   614	    n_pass = max(1, round(len(sdpa_idx) / 12)) if sdpa_idx else 1
   615	    gaps = [(rows[i + 1]['start'] - (rows[i]['start'] + rows[i]['dur']), i)
   616	            for i in range(len(rows) - 1)]
   617	    cuts = sorted(i for _, i in sorted(gaps, key=lambda g: -g[0])[:n_pass - 1])
   618	    passes, prev = [], 0
   619	    for c in cuts:
   620	        passes.append(rows[prev:c + 1])
   621	        prev = c + 1
   622	    passes.append(rows[prev:])
   623	    return passes, 'gap-heuristic'
