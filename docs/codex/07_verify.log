   574	def nvtx_pass_windows(path):
   575	    """pass_<i> projected ranges; require unique ids and non-overlap."""
   576	    try:
   577	        with open(path, newline='') as f:
   578	            rd = csv.reader(f)
   579	            head = next(rd)
   580	            c_name = next(i for i, h in enumerate(head)
   581	                          if h.strip().strip('"') in ('Name', 'Range'))
   582	            c_start = next(i for i, h in enumerate(head) if 'Start' in h)
   583	            c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
   584	            wins = {}
   585	            for r in rd:
   586	                nm = r[c_name].strip().strip('"').split(':')[-1]
   587	                if re.fullmatch(r'pass_\d+', nm):
   588	                    try:
   589	                        s = int(float(r[c_start].replace(',', '')))
   590	                        d = int(float(r[c_dur].replace(',', '')))
   591	                    except ValueError:
   592	                        continue
   593	                    i = int(nm.split('_')[1])
   594	                    if i in wins:
   595	                        return [], f'duplicate nvtx pass id {i}'
   596	                    wins[i] = (s, s + d)
   597	            ids = sorted(wins)
   598	            if ids != list(range(len(ids))):
   599	                return [], f'non-contiguous nvtx pass ids ({len(ids)} found)'
   600	            ordered = [wins[i] for i in ids]
   601	            for a, b in zip(ordered, ordered[1:]):
   602	                if b[0] < a[1]:
   603	                    return [], 'overlapping nvtx pass windows'
   604	            return ordered, None
   605	    except Exception as e:
   606	        return [], f'nvtx parse failed: {e}'
