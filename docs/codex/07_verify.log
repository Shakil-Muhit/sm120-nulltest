   260	    if g.get('suppress_errors') is not False:
   261	        out.append('graph gate: suppress_errors not affirmatively False')
   262	    if not isinstance(g.get('graph_break_count'), int) or not isinstance(g.get('unimplemented_count'), int):
   263	        out.append('graph gate counters missing')
   264	        return out
   265	    if arm in ZERO_BREAK_ARMS and (g['graph_break_count'] != 0 or g['unimplemented_count'] != 0
   266	                                  or g.get('require_zero_breaks') is not True):
   267	        out.append('zero-break gate: graph breaks / unimplemented ops not 0 (or rule not applied)')
   268	    c = (snapshot_after_settle or {}).get('counters') if isinstance(snapshot_after_settle, dict) else None
   269	    if not isinstance(c, dict):
   270	        out.append('graph gate: no after-settle snapshot to reconcile against')
   271	    else:
   272	        if sum(c.get('graph_break', {}).values()) != g['graph_break_count'] or \
   273	                sum(c.get('unimplemented', {}).values()) != g['unimplemented_count']:
   274	            out.append('graph gate counters disagree with the after-settle snapshot')
   275	    return out
