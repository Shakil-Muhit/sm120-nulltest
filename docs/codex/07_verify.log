    55	def verify(paths):
    56	    """Returns the provenance record; raises RuntimeError on any mismatch
    57	    (model pins AND runtime pins)."""
    58	    import torch
    59	    import triton
    60	    if torch.__version__ != REGISTERED_TORCH or triton.__version__ != REGISTERED_TRITON:
    61	        raise RuntimeError(f'runtime pins: torch {torch.__version__} / triton {triton.__version__} '
    62	                           f'!= registered {REGISTERED_TORCH} / {REGISTERED_TRITON}')
    63	    p = pins()
    64	    head = _git(paths['msst'], 'rev-parse', 'HEAD')
    65	    if head != p['msst_commit']:
    66	        raise RuntimeError(f"msst clone HEAD {head} != pinned {p['msst_commit']}")
    67	    dirty = _git(paths['msst'], 'status', '--porcelain')
    68	    if dirty:
    69	        raise RuntimeError('msst clone is not clean:\n' + dirty[:500])
    70	    ck = sha256_file(paths['ckpt'])
    71	    if ck != p['ckpt_sha256']:
    72	        raise RuntimeError(f"checkpoint sha256 {ck} != pinned {p['ckpt_sha256']}")
    73	    expected_cfg = os.path.realpath(os.path.join(paths['msst'], p['config_rel']))
    74	    if os.path.realpath(paths['config']) != expected_cfg:
    75	        raise RuntimeError(f"config {paths['config']} is not the registered {expected_cfg}")
    76	    return {'msst_commit': head, 'msst_clean': True, 'ckpt_sha256': ck,
    77	            'config': expected_cfg, 'config_sha256': sha256_file(expected_cfg),
    78	            'torch': torch.__version__, 'triton': triton.__version__}
