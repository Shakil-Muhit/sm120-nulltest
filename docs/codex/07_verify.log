   242	def compare_outputs(out, ref, tier):
   243	    rtol, atol = TIERS[tier]
   244	    out = out.float()
   245	    ref = ref.float()
   246	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   247	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   248	    if out.shape != ref.shape:
   249	        rec['reason'] = 'shape mismatch'
   250	        rec['max_abs_diff'] = None
   251	        return rec
   252	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   253	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   254	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   255	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   256	    if not (fin_out and fin_ref):
   257	        rec['reason'] = 'non-finite values present'
   258	        return rec
   259	    # the tolerance verdict is persisted in a form a validator can re-derive:
   260	    # the number of elements violating |out-ref| <= atol + rtol*|ref| (gate-06 f80)
   261	    viol = int(((out - ref).abs() > (atol + rtol * ref.abs())).sum().item())
   262	    rec['violations'] = viol
   263	    rec['n_elements'] = int(out.numel())
   264	    rec['max_abs_ref'] = float(ref.abs().max().item())
   265	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   266	    if rec['ok'] != (viol == 0):
   267	        rec['ok'] = False
   268	        rec['reason'] = 'allclose and element count disagree'
   269	    elif not rec['ok']:
   270	        rec['reason'] = 'tolerance exceeded'
   271	    return rec
