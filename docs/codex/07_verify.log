    93	def graph_signature(g):
    94	    """What pricing sees of a graph: the ordered Triton calls with each
    95	    argument's (role, shape, stride, element type). Two graphs with equal
    96	    signatures are interchangeable for the byte model."""
    97	    sig = []
    98	    for c in g['calls']:
    99	        k = g['kernels'].get(c['name'], {}) if c['kind'] == 'triton' else {}
   100	        args = []
   101	        for a in c['args']:
   102	            m = arg_meta(g, a)
   103	            base = m.get('base')
   104	            alloc = g['allocs'].get(base, {})
   105	            # allocation / alias semantics used by pricing (gate-05 f68)
   106	            args.append((a.get('role', ''), tuple(m['shape']), tuple(m['stride']),
   107	                         k.get('ptr_dtypes', {}).get(a.get('role', ''), m['dtype']),
   108	                         base, tuple(alloc.get('shape') or ()), tuple(alloc.get('stride') or ()),
   109	                         alloc.get('dtype'), bool(a.get('reinterpret'))))
   110	        # complete pricing semantics: kernel body hash, access sites, iteration
   111	        # literals, and the FULL normalised call text (scalar/list/keyword args
   112	        # of extern, fallback and custom-op calls included)
   113	        sig.append((c['kind'], c['name'], tuple(args), k.get('source_sha256'),
   114	                    tuple(sorted((k.get('load_sites') or {}).items())),
   115	                    tuple(sorted((k.get('store_sites') or {}).items())),
   116	                    tuple(c.get('numeric_literals') or ()),
   117	                    ' '.join((c.get('line') or '').split())))
   118	    # unparsed executable lines (gate-06 f91) are part of the identity: two
   119	    # graphs differing in an unparsed call are never interchangeable
   120	    sig.append(('unparsed', tuple(g.get('unparsed') or ())))
   121	    return tuple(sig)
