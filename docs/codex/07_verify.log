   112	def main():
   113	    ap = argparse.ArgumentParser()
   114	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
   115	    ap.add_argument('--out', required=True)
   116	    ap.add_argument('--arm', default='')
   117	    args = ap.parse_args()
   118	    rows = read_rows(args.base + '_cuda_gpu_trace.csv')
   119	    wins = windows(args.base + '_nvtx_gpu_proj_trace.csv')
   120	    assert wins, 'no pass windows'
   121	    per = []
   122	    for s, e in wins:
   123	        allrows = [r for r in rows if s <= r['start'] < e]
   124	        # kernels only (gate-04 f58): memcpy/memset rows are memops, reported
   125	        # separately and never counted as kernel time
   126	        p = [r for r in allrows if not r['name'].startswith('[CUDA mem')]
   127	        mem = [r for r in allrows if r['name'].startswith('[CUDA mem')]
   128	        cp, dom = critical_path_ns(p)
   129	        u = union_ns(p)
   130	        span = (max(r['start'] + r['dur'] for r in p) - min(r['start'] for r in p)) if p else 0
   131	        assert cp <= u + 1 and u <= span + 1, (cp, u, span)   # observed-order bound
   132	        per.append({'kernels': len(p), 'memops': len(mem), 'memops_sum_ns': sum(r['dur'] for r in mem),
   133	                    'streams': sorted({r['stream'] for r in p}),
   134	                    'sum_ns': sum(r['dur'] for r in p), 'union_ns': u,
   135	                    'critical_path_observed_order_ns': cp, 'span_ns': span,
   136	                    'window_ns': e - s, 'dominant_stream': dom})
   137	    def med(k):
   138	        return statistics.median(x[k] for x in per)
   139	    out = {'arm': args.arm, 'passes': len(per),
   140	           'median_us': {k: med(k) / 1e3 for k in ('sum_ns', 'union_ns', 'critical_path_observed_order_ns', 'span_ns', 'window_ns')},
   141	           'median_kernels_per_pass': med('kernels'),
   142	           'streams_seen': sorted({s for x in per for s in x['streams']}),
   143	           'dependency_model': ('observed-order: edge a->b iff a ended before b started; '
   144	                                'longest chain of non-overlapping kernels; an UPPER BOUND on the '
   145	                                'true dependency path (no event/graph edges are exported)'),
   146	           'per_pass': per}
   147	    with open(args.out, 'w') as f:
   148	        json.dump(out, f, indent=1)
   149	    m = out['median_us']
   150	    print(f"[views] {args.arm}: sum {m['sum_ns']:.1f} us | union {m['union_ns']:.1f} us | "
   151	          f"observed-order critical path {m['critical_path_observed_order_ns']:.1f} us | span "
   152	          f"{m['span_ns']:.1f} us | streams {out['streams_seen']}")
