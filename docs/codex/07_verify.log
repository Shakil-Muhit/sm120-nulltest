   120	def pair_summaries(evidence_dir, cells, runs, verbose=False):
   121	    pairs = {}
   122	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'matched_*.json'))):
   123	        with open(path) as f:
   124	            m = json.load(f)
   125	        a, b = m['pair']
   126	        key = f"{a}_vs_{b}_c{m['chunk']}"
   127	        pairs.setdefault(key, {})[m['tag']] = m
   128	    pair_summary = {}
   129	    if pairs and verbose:
   130	        print('\nmatched pairs (median over alternating blocks of a - b, ms):')
   131	    for key, by_tag in sorted(pairs.items()):
   132	        a, b = key.split('_vs_')[0], key.split('_vs_')[1].rsplit('_c', 1)[0]
   133	        chunk = int(key.rsplit('_c', 1)[1])
   134	        reasons = []
   135	        req = {t: by_tag.get(t) for t in REQUIRED_MATCHED}
   136	        for t, m in req.items():
   137	            if m is None:
   138	                reasons.append(f'{t} missing')
   139	                continue
   140	            probs = qualify.pair_problems(m)     # independent of stored flags
   141	            if probs:
   142	                reasons.append(f"{t}: {'; '.join(probs)}")
   143	        present = [m for m in req.values() if m]
   144	        mans = sorted({str(m.get('manifest_id')) for m in present})
   145	        vars_ = sorted({json.dumps({k: qualify.variant(v) for k, v in (m.get('arms') or {}).items()}, sort_keys=True)
   146	                        for m in present})
   147	        if len(mans) != 1 or mans == ['None']:
   148	            reasons.append(f'matched restarts do not share one manifest: {mans}')
   149	        if len(vars_) != 1:
   150	            reasons.append('matched restarts differ in effective variants')
   151	        for arm in (a, b):
   152	            ca = cells.get((arm, chunk)) if isinstance(next(iter(cells), None), tuple) else cells.get(f'{arm}_{chunk}')
   153	            r1 = (runs.get((arm, chunk)) or {}).get('r1')
   154	            if not ca or ca['sdr_gate'] != 'PASS':
   155	                reasons.append(f'{arm}: SDR qualification at {chunk} is {(ca or {}).get("sdr_gate", "NONE")}')
   156	                continue
   157	            if mans and ca['manifests'] != mans:
   158	                reasons.append(f'{arm}: SDR qualification from another manifest')
   159	            mv = {qualify.variant((m.get('arms') or {}).get(arm) or {}) for m in present}
   160	            if len(mv) != 1 or (r1 and qualify.variant(r1) not in mv):
   161	                reasons.append(f'{arm}: matched variant differs from its r1 SDR-qualified variant')
   162	        rec_d = {t: (qualify.recomputed_matched_delta(m) if m else None) for t, m in by_tag.items()}
   163	        for t, m in req.items():
   164	            if m and rec_d.get(t) and (m.get('matched_delta_ms') or {}).get('median') is not None:
   165	                if abs(rec_d[t]['median'] - m['matched_delta_ms']['median']) > 1e-9:
   166	                    reasons.append(f'{t}: stored matched delta differs from the value recomputed from samples')
   167	        deltas = {t: (d['median'] if d else None) for t, d in rec_d.items()}
   168	        entry = {'required': {t: (m or {}).get('pair_eligible') for t, m in req.items()},
   169	                 'deltas_ms': deltas, 'reasons': reasons,
   170	                 'pair_headline': 'HEADLINE' if not reasons else 'INCOMPLETE'}
   171	        if not reasons:
   172	            entry['median_delta_ms'] = statistics.median(rec_d[t]['median'] for t in REQUIRED_MATCHED)
   173	            entry['median_delta_pct_of_a'] = statistics.median(rec_d[t]['median_pct_of_a'] for t in REQUIRED_MATCHED)
   174	        pair_summary[key] = entry
   175	        if verbose:
   176	            print(f"  {key}: {entry['pair_headline']} deltas {deltas} "
   177	                  + (f"-> median {entry['median_delta_ms']:+.4f} ms ({entry['median_delta_pct_of_a']:+.2f}% of a)" if not reasons else f"reasons {reasons}"))
   178	    return pair_summary
   179	
   180	
   181	def main():
   182	    ap = argparse.ArgumentParser()
   183	    ap.add_argument('--evidence-dir', default=os.path.join(REPO_ROOT, 'evidence'))
   184	    args = ap.parse_args()
   185	    runs = load(args.evidence_dir)
   186	    cells = {k: cell(v) for k, v in runs.items()}
   187	    print('| arm | chunk | r1/r2/r3 | tier | SDR r1 (mean ΔSDR dB) | headline | ms | restart spread | best thr ms | variant / breaks | reasons |')
   188	    print('|---|---|---|---|---|---|---|---|---|---|---|')
   189	    for chunk in CHUNKS:
   190	        for arm in ARMS:
   191	            c = cells.get((arm, chunk))
   192	            if not c:
   193	                continue
   194	            st = '/'.join(c['statuses'][t][:4] for t in REQUIRED_RESTARTS)
   195	            print(f"| {arm} | {chunk} | {st} | {'/'.join(c['tier'])} | {c['sdr_gate']} "
   196	                  f"({fmt(c['mean_delta_sdr_ref_db'], '+.3f')}) | {c['headline_status']} | "
   197	                  f"{fmt(c['headline_ms'])} | {fmt(c['restart_spread_ms'])} | {fmt(c['throughput_best_ms'])} | "
   198	                  f"{' '.join(c['variants'])} b={'/'.join(c['graph_breaks'])} | {'; '.join(c['reasons'])[:140]} |")
   199	    pair_summary = pair_summaries(args.evidence_dir, cells, runs, verbose=True)
   200	    out = os.path.join(args.evidence_dir, 'summary_full.json')
   201	    with open(out, 'w') as f:
   202	        json.dump({'cells': {f'{a}_{c}': v for (a, c), v in cells.items()},
   203	                   'matched_pairs': pair_summary,
   204	                   'runs': {f'{a}_{c}_{t}': r for (a, c), tr in runs.items() for t, r in tr.items()}},
   205	                  f, indent=1)
   206	    print(f'\nwritten: {out}')
   207	
   208	
   209	if __name__ == '__main__':
   210	    main()

