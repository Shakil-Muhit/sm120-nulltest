    81	def code_hashes():
    82	    """The COMPLETE measuring dependency set: fullmodel/** (incl. c3_fix, attrib),
    83	    arms/*, scripts/*, the root harness files the arms import, the pins."""
    84	    files = []
    85	    for sub in ('fullmodel', os.path.join('fullmodel', 'c3_fix'), os.path.join('fullmodel', 'attrib'),
    86	                'arms', 'scripts', 'configs'):
    87	        d = os.path.join(_ROOT, sub)
    88	        for name in sorted(os.listdir(d)):
    89	            if name.endswith(('.py', '.sh', '.txt', '.json')):
    90	                files.append(os.path.join(sub, name))
    91	    for name in ('frontend.py', 'frontend_rms_fused.py', 'setup.sh', 'prereg_amendments.md'):
    92	        if os.path.exists(os.path.join(_ROOT, name)):
    93	            files.append(name)
    94	    return {f: sha256_file(os.path.join(_ROOT, f)) for f in files}
