    28	def sha256_file(path):
    29	    h = hashlib.sha256()
    30	    with open(path, 'rb') as f:
    31	        for block in iter(lambda: f.read(1 << 20), b''):
    32	            h.update(block)
    33	    return h.hexdigest()
