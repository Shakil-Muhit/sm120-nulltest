   378	
   379	def pair_problems(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   380	    problems = []
   381	    if m is None:
   382	        return ['record missing']
   383	    if m.get('status') != 'VALID':
   384	        problems.append(f"status {m.get('status')}")
   385	    if not m.get('manifest_id'):
   386	        problems.append('not bound to a session manifest')
   387	    if (m.get('iters'), m.get('repeats')) != (iters, repeats):
   388	        problems.append(f"protocol {m.get('repeats')}x{m.get('iters')} is not the registered {repeats}x{iters}")
   389	    js = m.get('joint_settle') or {}
   390	    if js.get('stable') is not True:
   391	        problems.append('joint settle not affirmatively stable')
   392	    if js.get('new_breaks_during_joint_settle'):
   393	        problems.append('new graph breaks during the joint settle')
   394	    # every required phase transition recomputed from the stored snapshots (gate-05 f62)
   395	    sn = m.get('snapshots') or {}
   396	    rounds = int(js.get('rounds') or 0)
   397	    jsn = list(sn.get('joint_settle') or [])
   398	    chain = jsn + [sn.get('before_validation'), sn.get('after_validation')] + list(sn.get('blocks') or [])
   399	    # exact schema (gate-06 f82): rounds+2 joint-settle snapshots, the two validation
   400	    # snapshots, and one snapshot per timed block — every one complete
   401	    if rounds < 1 or len(jsn) != rounds + 2 or len(list(sn.get('blocks') or [])) != repeats * 2 \
   402	            or any(not snapshot_complete(x) for x in chain):
   403	        problems.append('matched recording snapshots incomplete or malformed')
   404	    else:
   405	        verdicts = [recording_stable(a, b) for a, b in zip(chain, chain[1:])]
   406	        if any(v is None for v in verdicts) or not all(verdicts):
   407	            problems.append('recording state changed (or unresolved) across a matched phase transition')
   408	    if m.get('pair_eligible') is False and not problems:
   409	        problems.append(f"stored pair flag says ineligible: {m.get('ineligibility_reasons')}")
   410	    for arm, a in (m.get('arms') or {}).items():
   411	        if a.get('build_status') != 'OK':
   412	            problems.append(f'{arm}: build {a.get("build_status")}')
   413	            continue
   414	        v = a.get('validation') or {}
   415	        if v.get('status') != 'PASS':
   416	            problems.append(f"{arm}: validation {v.get('status', 'NONE')}")
   417	        elif not all(p.get('ref_sha256') for p in v.get('passes') or []):
   418	            problems.append(f'{arm}: references not lineage-checked')
   419	        # each arm reconciles its gate against the snapshot taken right after its own
   420	        # gate (the next arm's build clears the global counters)
   421	        problems += [f'{arm}: {x}' for x in gate_problems(arm, a.get('graph_gate'), a.get('gate_snapshot'))]
   422	        if (a.get('settle') or {}).get('settle_capped'):
   423	            problems.append(f'{arm}: settle capped')
   424	        blocks = sorted((b for b in (m.get('blocks') or []) if b.get('arm') == arm), key=lambda b: b.get('repeat', -1))
   425	        if len(blocks) != repeats or any(len(b.get('latency_ms_per_iter') or []) != iters for b in blocks) \
   426	                or [b.get('repeat') for b in blocks] != list(range(repeats)):
   427	            problems.append(f'{arm}: blocks do not hold the registered {repeats}x{iters} with unique repeat ids')
   428	        elif not all(_finite(b.get('throughput_ms_per_pass')) and b['throughput_ms_per_pass'] > 0 for b in blocks):
   429	            problems.append(f'{arm}: a block throughput is non-finite')
   430	        elif not all(all(_finite(x) and x > 0 for x in b['latency_ms_per_iter']) for b in blocks):
   431	            problems.append(f'{arm}: a latency sample is non-finite or non-positive')
   432	        elif not all(_close(b.get('latency_median_ms'), _median(b['latency_ms_per_iter']), 1e-9, 1e-9) for b in blocks):
   433	            problems.append(f'{arm}: a stored block median differs from its samples')
   434	        if not all(b.get('counters_stable') is True for b in blocks):
   435	            problems.append(f'{arm}: recording not affirmatively stable during a block')
   436	        problems += [f'{arm}: {x}' for x in validation_problems({'arm': arm, 'validation': a.get('validation')})]
   437	    return problems
   438	
   439	
   440	def recomputed_matched_delta(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   441	    """Matched delta (a - b per block, median, % of a) recomputed from samples."""
   442	    a, b = m.get('pair') or (None, None)
   443	    per = {}
   444	    for arm in (a, b):
   445	        blocks = sorted((x for x in (m.get('blocks') or []) if x.get('arm') == arm), key=lambda x: x.get('repeat', 0))
   446	        if len(blocks) != repeats or [x.get('repeat') for x in blocks] != list(range(repeats)):
   447	            return None
   448	        if any(len(x.get('latency_ms_per_iter') or []) != iters or
   449	               not all(_finite(v) and v > 0 for v in x['latency_ms_per_iter']) for x in blocks):
   450	            return None
   451	        per[arm] = [_median(x['latency_ms_per_iter']) for x in blocks]
   452	    diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   453	    return {'a_minus_b_per_block': diffs, 'median': _median(diffs), 'min': min(diffs), 'max': max(diffs),
   454	            'median_pct_of_a': _median(diffs) / _median(per[a]) * 100.0}
