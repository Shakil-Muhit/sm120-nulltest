    94	def audit_references(ev, items, manifest_id, session, runs, matched):
    95	    """Enumerate the required references, re-hash them, and join every recorded
    96	    hash to the corresponding artifact (gate-06 f86)."""
    97	    ref = os.path.join(ev, 'ref')
    98	    marker = os.path.join(ref, 'manifest_id.txt')
    99	    item(items, 'reference directory bound to the session manifest',
   100	         os.path.exists(marker) and open(marker).read().strip() == manifest_id, ['ref/manifest_id.txt missing or foreign'])
   101	    hashes = {}
   102	    bad = []
   103	    for chunk in OPS[session]:
   104	        for seed in qualify.VALIDATION_SEEDS:
   105	            f = os.path.join(ref, f'ref_A_c{chunk}_s{seed}.pt')
   106	            key = ('val', chunk, seed)
   107	            side = load(f + '.lineage.json')
   108	            if not os.path.exists(f) or not side or side.get('manifest_id') != manifest_id:
   109	                bad.append(os.path.basename(f))
   110	                continue
   111	            h = provenance.sha256_file(f)
   112	            if side.get('sha256') != h:
   113	                bad.append(os.path.basename(f) + ' (hash)')
   114	                continue
   115	            hashes[key] = h
   116	        for i in range(qualify.SDR_CLIPS):
   117	            f = os.path.join(ref, f'sdr_A_c{chunk}_clip{i:02d}.pt')
   118	            key = ('clip', chunk, i)
   119	            side = load(f + '.lineage.json')
   120	            if not os.path.exists(f) or not side or side.get('manifest_id') != manifest_id:
   121	                bad.append(os.path.basename(f))
   122	                continue
   123	            h = provenance.sha256_file(f)
   124	            if side.get('sha256') != h:
   125	                bad.append(os.path.basename(f) + ' (hash)')
   126	                continue
   127	            hashes[key] = h
   128	    n_req = len(OPS[session]) * (len(qualify.VALIDATION_SEEDS) + qualify.SDR_CLIPS)
   129	    item(items, f'required reference inventory ({n_req} artifacts, bound and re-hashed)', not bad,
   130	         [f'missing/unbound/changed: {bad[:8]}'])
   131	    # join: every recorded hash must equal the re-hashed artifact of its operating point
   132	    joined = 0
   133	    mismatch = []
   134	    for (arm, chunk), tr in runs.items():
   135	        for tag, r in tr.items():
   136	            for p in (r.get('validation') or {}).get('passes') or []:
   137	                if p.get('ref_sha256'):
   138	                    joined += 1
   139	                    if hashes.get(('val', chunk, p.get('seed'))) != p['ref_sha256']:
   140	                        mismatch.append(f'{arm}@{chunk}/{tag} seed {p.get("seed")}')
   141	            for row in (r.get('sdr_gate') or {}).get('clips') or []:
   142	                if row.get('a_output_sha256'):
   143	                    joined += 1
   144	                    if hashes.get(('clip', chunk, row.get('index'))) != row['a_output_sha256']:
   145	                        mismatch.append(f'{arm}@{chunk}/{tag} clip {row.get("index")}')
   146	    for (pair, chunk, tag), m in matched.items():
   147	        for arm, a in (m.get('arms') or {}).items():
   148	            for p in (a.get('validation') or {}).get('passes') or []:
   149	                if p.get('ref_sha256'):
   150	                    joined += 1
   151	                    if hashes.get(('val', chunk, p.get('seed'))) != p['ref_sha256']:
   152	                        mismatch.append(f'matched {arm}@{chunk}/{tag} seed {p.get("seed")}')
   153	    item(items, f'recorded reference hashes join the audited artifacts ({joined} joins)', joined > 0 and not mismatch,
   154	         [f'{len(mismatch)} mismatches: {mismatch[:6]}'] if mismatch else ['no recorded reference hashes'])
