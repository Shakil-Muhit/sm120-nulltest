   278	def bind_refs(ref_dir, manifest_id, write=False):
   279	    """Directory marker (kept for the session preflight); every reference
   280	    file additionally carries its own lineage sidecar (provenance.bind_artifact)."""
   281	    path = os.path.join(ref_dir, 'manifest_id.txt')
   282	    if write:
   283	        os.makedirs(ref_dir, exist_ok=True)
   284	        with open(path, 'w') as f:
   285	            f.write(manifest_id + '\n')
   286	        return
   287	    if manifest_id is None:
   288	        return
   289	    if not os.path.exists(path) or open(path).read().strip() != manifest_id:
   290	        raise RuntimeError('reference outputs are not bound to this session manifest')
