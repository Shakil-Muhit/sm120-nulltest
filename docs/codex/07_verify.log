   157	def audit_clock(ev, items, session, runs, matched):
   158	    """This session's clock log must cover every timing block that belongs to
   159	    this session (blocks started after the log began), including matched
   160	    blocks; every block needs finite timestamps (gate-06 f87)."""
   161	    clocks = os.path.join(ev, f'clocks_{session}.csv')
   162	    times = []
   163	    bad_lines = 0
   164	    if os.path.exists(clocks):
   165	        for line in open(clocks):
   166	            parts = [x.strip() for x in line.split(',')]
   167	            if len(parts) != 7:
   168	                bad_lines += 1
   169	                continue
   170	            for fmt in ('%Y/%m/%d %H:%M:%S.%f', '%Y/%m/%d %H:%M:%S'):
   171	                try:
   172	                    times.append(_dt.datetime.strptime(parts[0], fmt).timestamp())
   173	                    break
   174	                except ValueError:
   175	                    continue
   176	    times.sort()
   177	    blocks = []
   178	    for rs in runs.values():
   179	        for r in rs.values():
   180	            blocks += [(b.get('unix_start'), b.get('unix_end')) for b in ((r.get('timing') or {}).get('blocks') or [])]
   181	    for m in matched.values():
   182	        blocks += [(b.get('unix_start'), b.get('unix_end')) for b in (m.get('blocks') or [])]
   183	    if not times:
   184	        item(items, 'clock log covers every timing block of this session', False, ['clock log missing or unparsable'])
   185	        return
   186	    t0 = times[0] - 60
   187	    own = [(a, b) for a, b in blocks if not (fin(a) and fin(b)) or a >= t0]
   188	    nonfinite = sum(1 for a, b in own if not (fin(a) and fin(b)))
   189	    uncovered = 0
   190	    for a, b in own:
   191	        if not (fin(a) and fin(b)):
   192	            continue
   193	        i = bisect.bisect_left(times, a - 30)
   194	        if i >= len(times) or times[i] > b + 30:
   195	            uncovered += 1
   196	    ok = bool(own) and nonfinite == 0 and uncovered == 0 and bad_lines == 0
   197	    item(items, f'clock log covers every timing block of this session ({len(own)} blocks)', ok,
   198	         [f'{uncovered} uncovered, {nonfinite} without finite timestamps, {bad_lines} malformed clock lines, blocks={len(own)}'])
   199	
