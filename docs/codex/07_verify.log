   187	
   188	def timed_run(step, x, ctx, iters=50, nvtx_pass=False):
   189	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   190	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   191	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   192	    pass windows for the exports; never inside compiled code)."""
   193	    with torch.no_grad(), ctx():
   194	        torch.cuda.synchronize()
   195	        torch.cuda.profiler.start()
   196	        latency_ms = []
   197	        for i in range(iters):
   198	            if nvtx_pass:
   199	                torch.cuda.nvtx.range_push(f'pass_{i}')
   200	            t0 = time.perf_counter()
   201	            step(x)
   202	            torch.cuda.synchronize()
   203	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   204	            if nvtx_pass:
   205	                torch.cuda.nvtx.range_pop()
   206	        torch.cuda.profiler.stop()
   207	
   208	        torch.cuda.synchronize()
   209	        t0 = time.perf_counter()
   210	        for _ in range(iters):
   211	            step(x)
   212	        torch.cuda.synchronize()
   213	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   214	    return latency_ms, throughput_ms
   215	
   216	
   217	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   218	    """Five repeats of the 5a block; min-of-medians + median spread; every
   219	    per-iteration list preserved; block wall timestamps for the clock log."""
   220	    blocks = []
   221	    for r in range(repeats):
   222	        t_start = time.time()
   223	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   224	        t_end = time.time()
   225	        s = sorted(lat)
   226	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   227	                       'latency_median_ms': median(lat),
   228	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   229	                       'throughput_ms_per_pass': thr,
   230	                       'unix_start': t_start, 'unix_end': t_end})
   231	    meds = [b['latency_median_ms'] for b in blocks]
   232	    return {'blocks': blocks, 'latency_medians_ms': meds,
   233	            'min_of_medians_ms': min(meds),
   234	            'median_spread_ms': max(meds) - min(meds),
   235	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   236	            'serialization_delta_pct': [
   237	                (b['latency_median_ms'] - b['throughput_ms_per_pass'])
   238	                / b['throughput_ms_per_pass'] * 100.0 for b in blocks],
   239	            'iters_per_block': iters, 'repeats': repeats}
