   199	def sdr_recomputed(gate):
   200	    """Recompute the SDR gate from its rows: exactly eight distinct clips,
   201	    every delta finite, mean vs the registered threshold."""
   202	    rows = (gate or {}).get('clips') or []
   203	    idx = sorted(r.get('index') for r in rows)
   204	    if idx != list(range(SDR_CLIPS)):
   205	        return None, f'clip indices {idx} are not the registered 0..{SDR_CLIPS - 1}'
   206	    if gate.get('n_clips') != SDR_CLIPS:
   207	        return None, 'stored n_clips differs from the registered clip count'
   208	    # paired terms recomputed (gate-06 f81): both SDR_ref terms finite, the
   209	    # stored delta equal to their difference
   210	    deltas = []
   211	    for r in rows:
   212	        a, b = r.get('sdr_ref_db'), r.get('sdr_ref_A_db')
   213	        if not (_finite(a) and _finite(b)):
   214	            return None, 'a paired SDR_ref term is missing or non-finite'
   215	        if not _close(r.get('delta_sdr_ref_db'), a - b, 1e-9, 1e-9):
   216	            return None, 'a stored clip delta differs from its paired terms'
   217	        deltas.append(a - b)
   218	    if not all(r.get('a_output_sha256') for r in rows):
   219	        return None, 'eager-A clip outputs not lineage-hashed'
   220	    mean = sum(deltas) / len(deltas)
   221	    status = 'PASS' if mean >= SDR_THRESHOLD_DB else 'FAIL'
   222	    if gate.get('mean_delta_sdr_ref_db') is None or not _close(gate['mean_delta_sdr_ref_db'], mean, 1e-9, 1e-9):
   223	        return None, 'stored mean delta differs from the recomputed one'
   224	    if gate.get('status') != status:
   225	        return None, f"stored SDR status {gate.get('status')} differs from the recomputed {status}"
   226	    return status, None
