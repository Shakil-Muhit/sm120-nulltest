   156	def drift_context(ev):
   157	    """Repeat-scoped clock-drift flags for the session-3 evidence (the audit's rule, shared with
   158	    every publisher: gate-10 f139). Returns (manifest_id, flags) where flags['pairs'] maps
   159	    (pair, chunk, tag) -> {repeat: message}."""
   160	    import completeness
   161	    man = _load(os.path.join(ev, 'session_manifest.json')) or {}
   162	    session = man.get('session') or 'session3'
   163	    runs = completeness.load_runs(ev)
   164	    matched = completeness.load_matched(ev)
   165	    flags = completeness.drift_flags(ev, session, runs, matched, (man.get('env') or {}).get('gpu_uuid'))
   166	    # an unresolved clock comparison (no samples near the block) makes that repeat ineligible, exactly like a flag (gate-11 f151)
   167	    for u in flags.get('unresolved') or []:
   168	        m_ = re.match(r"matched \('([^']+)', '([^']+)'\)@(\d+)/(\w+) rep (\d+)", u)
   169	        if m_:
   170	            key = ((m_.group(1), m_.group(2)), int(m_.group(3)), m_.group(4))
   171	            flags['pairs'].setdefault(key, {})[int(m_.group(5))] = 'clock samples unavailable (unresolved comparison)'
   172	    return man.get('manifest_id'), flags
