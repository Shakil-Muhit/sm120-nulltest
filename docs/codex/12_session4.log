   212	def pair_series(ev, a, b, O, manifest_id=None, flags=None):
   213	    """All eligible restarts of a pair: medians per restart, pooled clean per-repeat differences, walls."""
   214	    meds, pooled, files, wa, wb, excluded, rejected = [], [], [], [], [], {}, {}
   215	    for f in sorted(glob.glob(os.path.join(ev, f'matched_{a}_{b}_c{O}_m*.json'))):
   216	        m = _load(f)
   217	        r, why = pair_reduce(m, manifest_id, flags)
   218	        if r is None:
   219	            rejected[os.path.basename(f)] = why
   220	            continue
   221	        meds.append(r['median']); pooled += r['diffs']; files.append(os.path.basename(f)); wa.append(r['a_wall']); wb.append(r['b_wall'])
   222	        if r['excluded_repeats']:
   223	            excluded[os.path.basename(f)] = r['excluded_repeats']
   224	    if not meds:
   225	        return None, rejected
   226	    return {'median_ms': statistics.median(meds), 'ci95_ms': _boot_ci(pooled), 'restarts': len(meds), 'repeats_used': len(pooled),
   227	            'files': files, 'excluded_repeats': excluded, 'rejected': rejected,
   228	            'a_wall_ms': statistics.median(wa), 'b_wall_ms': statistics.median(wb)}, rejected
   229	
