    43	def signature(c):
    44	    ops = tuple(sorted(set(c.get('ops') or [])))
    45	    args = c.get('args') or []
    46	    reads_params = all(str(x.get('buf', '')).startswith('arg') for x in args if x.get('read')) and any(x.get('read') for x in args)
    47	    return (c['kind'], ops, 'param-only' if ('_to_copy' in c['name'] and reads_params) else '')
