   231	def _boot_ci(diffs, stat=statistics.median):
   232	    rnd = random.Random(BOOT_SEED)
   233	    vals = []
   234	    n = len(diffs)
   235	    for _ in range(BOOT_N):
   236	        vals.append(stat([diffs[rnd.randrange(n)] for _ in range(n)]))
   237	    vals.sort()
   238	    return [vals[int(0.025 * BOOT_N)], vals[int(0.975 * BOOT_N) - 1]]
