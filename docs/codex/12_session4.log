     1	"""Phase 4 §2A: independent verification that the registered E9 variant is affine in the frame
     2	count F = L//441 + 1, reproduction of its stored predictions and in-sample residuals, the
     3	calibration-only affine counterexample from the packaging review, and a plain piecewise-linear
     4	interpolation baseline through the four sweep observations (retrospective comparators; nothing
     5	is fitted to the 4 s / 6 s observations). Reads only the stored registration JSON."""
     6	import json, os, sys
     7	ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..'))
     8	reg = json.load(open(os.path.join(ROOT, 'docs/phase3/e9/e9_cost_model.json')))
     9	inp, var = reg['inputs'], reg['variants'][reg['registered_variant']]
    10	p = var['params']; assert p['TH'] is None and p['TC'] is None, 'tile factors must be 1 for the affine reduction'
    11	B, (nf0, nf1), (mid0, mid1) = inp['B'], inp['NF'], inp['MID']
    12	pad, w = inp['pad_gflop_per_frame'], inp['true_gflop_per_frame']
    13	RH, hH, RC, hC = p['RH'], p['hH'], p['RC'], p['hC']
    14	# D(F) = B - (nf0 + nf1 F) - (mid0 + mid1 F) - pad (F+hH)/RH - w [ (F+hH)/RH - (F+hC)/RC ]
    15	a = B - nf0 - mid0 - pad * hH / RH - w * (hH / RH - hC / RC)
    16	b = -(nf1 + mid1 + pad / RH + w * (1 / RH - 1 / RC))
    17	def D_affine(F): return a + b * F
    18	def F_of(L): return L // inp['hop'] + 1
    19	out = {'affine_form': {'a_ms': a, 'b_ms_per_frame': b, 'note': 'D(F) = a + b*F exactly, because F/(R F/(F+h)) = (F+h)/R when the tile factor is 1'}}
    20	# reproduce stored held-out predictions and in-sample residuals
    21	rep = {}
    22	for L, h in var['held_out_pred'].items():
    23	    rep[L] = {'stored': h['D_C3_minus_H_ms'], 'affine': D_affine(F_of(int(L))), 'diff': h['D_C3_minus_H_ms'] - D_affine(F_of(int(L)))}
    24	obs = {int(k): v for k, v in inp['sweep_obs_C3_minus_H'].items()}
    25	res = {L: {'stored_residual (pred-obs)': var['res'][str(L)], 'affine_pred': D_affine(F_of(L)), 'obs': obs[L], 'recomputed_residual': D_affine(F_of(L)) - obs[L]} for L in sorted(obs)}
    26	out['held_out_reproduction'] = rep; out['in_sample'] = res
    27	out['max_abs_reproduction_error_ms'] = max(abs(v['diff']) for v in rep.values()) if rep else None
    28	# calibration nonmonotonicity and the best affine fit to the four calibration values (least max-abs, by LP on 4 points via brute-force over pairs)
    29	xs = [F_of(L) for L in sorted(obs)]; ys = [obs[L] for L in sorted(obs)]
    30	out['calibration_points'] = dict(zip([str(L) for L in sorted(obs)], ys))
    31	out['calibration_monotone'] = all(ys[i] >= ys[i + 1] for i in range(len(ys) - 1)) or all(ys[i] <= ys[i + 1] for i in range(len(ys) - 1))
    32	# minimax affine fit: the optimum for 4 points is attained where three points have equal |residual| with alternating signs; brute force candidates
    33	import itertools
    34	best = None
    35	for (i, j, k) in itertools.combinations(range(4), 3):
    36	    for s in (1, -1):
    37	        # solve a + b x_i - y_i = s e, a + b x_j - y_j = -s e, a + b x_k - y_k = s e
    38	        import numpy as np
    39	        A = np.array([[1, xs[i], -s], [1, xs[j], s], [1, xs[k], -s]], dtype=float)
    40	        rhs = np.array([ys[i], ys[j], ys[k]], dtype=float)
    41	        try:
    42	            aa, bb, e = np.linalg.solve(A, rhs)
    43	        except np.linalg.LinAlgError:
    44	            continue
    45	        err = max(abs(aa + bb * x - y) for x, y in zip(xs, ys))
    46	        if best is None or err < best[0]:
    47	            best = (err, aa, bb)
    48	out['calibration_only_minimax_affine'] = {'a_ms': best[1], 'b_ms_per_frame': best[2], 'max_abs_error_ms': best[0],
    49	    'review_counterexample': {'a': 1.244551392405063, 'b': -0.001807088607595, 'max_abs_error_ms': 0.288073417721519},
    50	    'note': 'retrospective comparator: a line CAN meet the 0.4 ms tolerance on the four calibration values; it was not the registered fit and is not evaluated at 4 s/6 s here'}
    51	# piecewise-linear interpolation baseline through the sweep (retrospective; its 4 s/6 s values are shown for comparison only, labelled)
    52	def pl(L):
    53	    Ls = sorted(obs)
    54	    for L0, L1 in zip(Ls, Ls[1:]):
    55	        if L0 <= L <= L1:
    56	            t = (L - L0) / (L1 - L0); return obs[L0] + t * (obs[L1] - obs[L0])
    57	    return None
    58	out['piecewise_linear_baseline_retrospective'] = {str(L): pl(L) for L in (176400, 264600)}
    59	out['registered_predictions'] = {L: h['D_C3_minus_H_ms'] for L, h in var['held_out_pred'].items()}
    60	json.dump(out, open(os.path.join(ROOT, 'docs/phase4/e9_affine_check.json'), 'w'), indent=1)
    61	print(json.dumps({k: out[k] for k in ('affine_form', 'max_abs_reproduction_error_ms', 'calibration_monotone', 'calibration_only_minimax_affine', 'piecewise_linear_baseline_retrospective', 'registered_predictions')}, indent=1))
    62	print('in-sample:', {L: round(v['recomputed_residual'], 4) for L, v in res.items()})
     1	"""E9 cost model: wall(C3, L) - wall(H, L) as a function of chunk length L.
     2	
     3	Inputs (ONLY): the two node-level trace decompositions (docs/phase3/padbatch/
     4	decomposition_table.json, from the 8 s and 100 ms traces) and the four existing
     5	sweep points (SESSION_RESULT_v2.md headline walls at 4410, 22050, 88200, 352800).
     6	Frames per chunk F(L) = L/441 + 1 (hop 441; 352800 -> 801, 4410 -> 11).
     7	
     8	Term structure (all in ms, sign: + means H faster than C3):
     9	  D(L) = B                      batching benefit (gap/launch floor removed): fixed, mean of the two traces
    10	       - NF(F)                  non-GEMM front/tail delta (H - C3): linear in F through the two traces
    11	       - MID(F)                 transformer-middle delta (H - C3): linear in F through the two traces
    12	       - PAD(F)                 padded FLOPs (0.16094 GFLOP/frame) at rate_H(F)
    13	       - EFF(F)                 true work (0.4083 GFLOP/frame) x (1/rate_H(F) - 1/rate_C3(F))
    14	  rate_X(F) = R_X * F / (F + h_X) * q_X(F), q = tile-quantization factor F / (T ceil(F/T)) or 1.
    15	Model variants differ in q and in whether (R, h) come from the two traces alone
    16	(variant "traces_only") or are refit on the four sweep walls with the trace
    17	rates as soft constraints (variant "sweep_refit"). Every variant's in-sample
    18	residuals at the four sweep points are printed and stored; the registered
    19	variant is chosen by the smallest max |residual| and the choice is recorded
    20	BEFORE any held-out measurement. Held-out lengths: 176400 (F=401) and 264600
    21	(F=601). Never run those lengths on the shakedown host.
    22	"""
    23	import json, math, sys, itertools
    24	import numpy as np
    25	from scipy.optimize import least_squares
    26	
