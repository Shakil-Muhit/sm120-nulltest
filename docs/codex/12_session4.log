   175	def pair_reduce(m, manifest_id=None, flags=None):
   176	    """The one reducer every publisher uses (gate-10 f143/f144): the record must pass the shared
   177	    validator (qualify.pair_problems) and belong to the session manifest; per-repeat a − b
   178	    differences are recomputed from the samples, joined by repeat identity (not list order);
   179	    repeats the clock rule flagged are excluded. Returns None (with a reason) when nothing
   180	    eligible remains."""
   181	    if m is None:
   182	        return None, ['record missing']
   183	    probs = qualify.pair_problems(m)
   184	    if probs:
   185	        return None, probs
   186	    if manifest_id and m.get('manifest_id') != manifest_id:
   187	        return None, ['foreign manifest']
   188	    a, b = m['pair']
   189	    reps = {}
   190	    for blk in m.get('blocks') or []:
   191	        lat = blk.get('latency_ms_per_iter') or []
   192	        if len(lat) != qualify.REGISTERED_ITERS:
   193	            return None, ['block sample count is not the registered 50']
   194	        reps.setdefault(blk.get('repeat'), {})[blk.get('arm')] = qualify._median(lat)
   195	    key = (tuple(m['pair']), int(m['chunk']), m.get('tag'))
   196	    fl = ((flags or {}).get('pairs') or {}).get(key) or {}
   197	    diffs, walls_a, walls_b, excluded = [], [], [], []
   198	    for rep in sorted(k for k in reps if k is not None):
   199	        pr = reps[rep]
   200	        if a not in pr or b not in pr:
   201	            return None, [f'repeat {rep} lacks both arms']
   202	        if rep in fl:
   203	            excluded.append(rep)
   204	            continue
   205	        diffs.append(pr[a] - pr[b]); walls_a.append(pr[a]); walls_b.append(pr[b])
   206	    if not diffs:
   207	        return None, [f'every repeat clock-drift flagged: {fl}']
   208	    return {'diffs': diffs, 'median': statistics.median(diffs), 'a_wall': min(walls_a), 'b_wall': min(walls_b),
   209	            'excluded_repeats': excluded, 'repeats_used': len(diffs), 'file': f"matched_{a}_{m['pair'][1]}_c{m['chunk']}_{m.get('tag')}.json"}, []
   210	
