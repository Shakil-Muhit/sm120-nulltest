   428	        out['status'] = 'UNRESOLVED: GPU or CUDA-API export has no rows (header-only export)'
   429	        json.dump(out, open(a.out, 'w'), indent=1); print(out['status']); return
   430	    for arm in arms:
   431	        ids = sorted(w[0] for w in windows.get(arm, []))
   432	        if ids != list(range(qualify.REGISTERED_ITERS)):
   433	            out['status'] = f'UNRESOLVED: {arm} host pass windows are not the unique ids 0..49 ({len(ids)} found)'
   434	            json.dump(out, open(a.out, 'w'), indent=1); print(out['status']); return
   435	    gstarts = [g[0] for g in gpu]
   436	    astarts = [x[0] for x in api] if api else []
   437	    for arm, ws in windows.items():
   438	        per = []
   439	        for i, st, en in sorted(ws):
   440	            lo = bisect.bisect_left(gstarts, st); hi = bisect.bisect_right(gstarts, en)
   441	            ks = [g for g in gpu[lo:hi]]
   442	            kern = [g for g in ks if 'memcpy' not in g[2].lower() and 'memset' not in g[2].lower()]
   443	            mem = [g for g in ks if g not in kern]
   444	            wall = en - st
   445	            busy = _union([(g[0], min(g[1], en)) for g in ks])
   446	            span = (max(g[1] for g in ks) - min(g[0] for g in ks)) if ks else 0
   447	            row = {'pass': i, 'wall_us': wall / 1e3, 'gpu_busy_us (union of kernel+memop intervals in window)': busy / 1e3,
   448	                   'gpu_span_us (first start to last end)': span / 1e3, 'gpu_idle_within_window_us': (wall - busy) / 1e3,
   449	                   'kernels': len(kern), 'memops': len(mem)}
   450	            if api is not None:
   451	                alo = bisect.bisect_left(astarts, st); ahi = bisect.bisect_right(astarts, en)
   452	                calls = api[alo:ahi]
   453	                row['api_calls'] = len(calls)
   454	                row['graph_launches'] = sum(1 for c in calls if 'cudaGraphLaunch' in c[2])
   455	                row['memcpy_api_calls'] = sum(1 for c in calls if 'Memcpy' in c[2] or 'memcpy' in c[2])
   456	                row['sync_api_calls'] = sum(1 for c in calls if 'Synchronize' in c[2] or 'StreamWait' in c[2] or 'EventSynchronize' in c[2])
   457	                row['api_union_us (overlapping call intervals unioned)'] = _union([(c[0], min(c[1], en)) for c in calls]) / 1e3
   458	                row['api_sum_us (not additive; for reference)'] = sum(min(c[1], en) - c[0] for c in calls) / 1e3
   459	            per.append(row)
   460	        def med(k):
   461	            v = [p[k] for p in per if k in p]
   462	            return statistics.median(v) if v else None
   463	        out['arms'][arm] = {'passes': len(per), 'median_wall_us': med('wall_us'), 'median_gpu_busy_us': med('gpu_busy_us (union of kernel+memop intervals in window)'),
   464	                            'median_gpu_span_us': med('gpu_span_us (first start to last end)'), 'median_gpu_idle_within_window_us': med('gpu_idle_within_window_us'),
   465	                            'median_kernels': med('kernels'), 'median_memops': med('memops'), 'median_graph_launches': med('graph_launches'),
   466	                            'median_memcpy_api_calls': med('memcpy_api_calls'), 'median_sync_api_calls': med('sync_api_calls'),
   467	                            'median_api_union_us': med('api_union_us (overlapping call intervals unioned)'), 'per_pass': per}
   468	        blk = next((b for b in (rec.get('blocks') or []) if b.get('arm') == arm and b.get('repeat') == prof_rep), None)
   469	        if blk:
   470	            out['arms'][arm]['unprofiled_context_note'] = 'this block ran under the profiler; compare with the same arm\'s other repeats in the record for perturbation'
   471	            others = [b['latency_median_ms'] for b in (rec.get('blocks') or []) if b.get('arm') == arm and b.get('repeat') != prof_rep]
   472	            out['arms'][arm]['profiled_block_median_ms'] = blk.get('latency_median_ms')
   473	            out['arms'][arm]['unprofiled_blocks_median_ms'] = statistics.median(others) if others else None
   474	    out['note'] = ('GPU idle within the CPU pass window is reported as such; it is not labelled host-side. API union is the union of CUDA API call intervals in the window '
   475	                   '(calls can overlap GPU work or wait). Windows come from host NVTX ranges; GPU and API rows use the same nsys clock.')
   476	    json.dump(out, open(a.out, 'w'), indent=1)
   477	    for arm, v in out['arms'].items():
   478	        print(arm, {k: (round(x, 1) if isinstance(x, float) else x) for k, x in v.items() if k != 'per_pass'})
