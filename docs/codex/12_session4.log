    50	def sig_table(calls, rows):
    51	    d = collections.defaultdict(lambda: {'kernels': 0, 'launches': 0, 'time_ms': 0.0})
    52	    seen = set()
    53	    for c in calls:
    54	        if c['kind'] != 'triton' or c['name'] in seen:
    55	            continue
    56	        seen.add(c['name'])
    57	        r = rows.get(c['name']) or {}
    58	        s = signature(c)
    59	        k = f"{s[0]}|{','.join(s[1])}|{s[2]}"
    60	        d[k]['kernels'] += 1
    61	        d[k]['launches'] += r.get('launches_per_pass') or 0
    62	        d[k]['time_ms'] += (r.get('time_us_per_pass') or 0) / 1e3
    63	    return d
