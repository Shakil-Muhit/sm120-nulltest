   265	def block_sm_median(series, a, b, window=3.0):
   266	    # with the 5 Hz session-3 sampler most 100 ms blocks hold their own samples; the window is the fallback
   267	    """Median SM clock over the samples inside [a, b]; a block shorter than the 1 Hz
   268	    sampling interval (50 passes at 100 ms take 0.15 s) uses the nearest samples within
   269	    `window` seconds on either side instead."""
   270	    if not series or not (fin(a) and fin(b)):
   271	        return None
   272	    ts = [t for t, _ in series]
   273	    i = bisect.bisect_left(ts, a); j = bisect.bisect_right(ts, b)
   274	    vals = [v for _, v in series[i:j]]
   275	    if not vals:
   276	        i = bisect.bisect_left(ts, a - window); j = bisect.bisect_right(ts, b + window)
   277	        vals = [v for _, v in series[i:j]]
   278	    return qualify._median(vals) if vals else None
