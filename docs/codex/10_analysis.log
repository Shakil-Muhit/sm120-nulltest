   245	        if len(parts) != 7 or (gpu_uuid and parts[1] != gpu_uuid):
   246	            continue
   247	        try:
   248	            sm = float(parts[2].replace('MHz', '').strip())
   249	        except ValueError:
   250	            continue
   251	        ts = None
   252	        for fmt in ('%Y/%m/%d %H:%M:%S.%f', '%Y/%m/%d %H:%M:%S'):
   253	            try:
   254	                d = _dt.datetime.strptime(parts[0], fmt)
   255	                ts = d.timestamp() if os.environ.get('CLOCK_TZ', 'utc') == 'local' else d.replace(tzinfo=_dt.timezone.utc).timestamp()
   256	                break
   257	            except ValueError:
   258	                continue
   259	        if ts is not None:
   260	            out.append((ts, sm))

