   254	def e5_summary(a):
   255	    out = {'cells': {}, 'checks': {}}
   256	    for path in sorted(glob.glob(os.path.join(a.evidence_dir, 'full_*_v_*.json'))):
   257	        r = _load(path)
   258	        if not r or r.get('status') != 'VALID':
   259	            out['cells'][os.path.basename(path)] = {'status': (r or {}).get('status', 'MISSING')}
   260	            continue
   261	        v = r.get('variant') or {}
   262	        rec = {'arm': r['arm'], 'chunk': r['chunk'], 'tag': r['tag'], 'variant': v.get('variant'),
   263	               'depth': v.get('depth'), 'mlp_expansion_factor': v.get('mlp_expansion_factor'),
   264	               'param_bytes_fp16': r.get('param_bytes_fp16'), 'mask_estimator_bytes_fp16': v.get('mask_estimator_bytes_fp16'),
   265	               'min_of_medians_ms': r.get('min_of_medians_ms'), 'validation': (r.get('validation') or {}).get('status')}
   266	        tag = r['tag'].rsplit('_r', 1)[0] + '_trace'          # the variant's trace tag (4410 only)
   267	        tv = _load(os.path.join(a.evidence_dir, 'traces', f"timing_views_{r['arm']}_{r['chunk']}_{tag}.json"))
   268	        if tv:
   269	            med = tv.get('median_us') or {}
   270	            rec['kernel_sum_ms'] = med['sum_ns'] / 1e3 if 'sum_ns' in med else 'UNRESOLVED'   # median_us values are in us
   271	            rec['span_ms'] = med['span_ns'] / 1e3 if 'span_ns' in med else 'UNRESOLVED'
   272	        cc = _load(os.path.join(a.evidence_dir, 'traces', f"cast_count_{r['arm']}_{r['chunk']}_{tag}.json"))
   273	        if cc:
   274	            rec['cast_time_ms_per_pass'] = cc['cast_time_ms_per_pass']
   275	            rec['cast_kernels_per_pass'] = cc['cast_kernels_per_pass']
   276	        gv = _load(os.path.join(a.evidence_dir, 'traces', f"graph_verify_{r['arm']}_{r['chunk']}_{tag}.json"))
   277	        if gv:
   278	            rec['boundary_count'] = (gv.get('per_pass') or [{}])[0].get('captured_model_kernels', 'UNRESOLVED')
   279	        out['cells'][os.path.basename(path)] = rec
   280	    json.dump(out, open(a.out, 'w'), indent=1)
   281	    print(f"{len(out['cells'])} E5 cells summarised -> {a.out}")
