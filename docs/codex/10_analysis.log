   446	             qualify.pair_problems(m) if m else ['no A/A record'])
   447	    for a in ('C3', 'H', 'A', 'C1'):
   448	        for c in OPS['session3']:
   449	            cell = cells.get(f'{a}_{c}')
   450	            fl = drift['cells'].get((a, c))
   451	            item(items, f'E6 headline {a}@{c} (r1..r{n_restart}, SDR in r1)', bool(cell and cell['headline_status'] == 'HEADLINE'),
   452	                 (cell or {}).get('reasons', ['no runs']), note=(f'clock-drift flagged across restarts (registered 5 % rule): {fl}' if fl else None))
   453	    aa = load(os.path.join(ev, 'aa_stats.json')) or {}
   454	    aa_chunks = {v.get('chunk') for v in (aa.get('pairs') or {}).values() if 'median_ms' in v}
   455	    need_aa = set(OPS['session3']) | (set(HELD_OUT_S3) if (cfg.get('session_pod') and not shakedown) else set())
   456	    item(items, 'E6/E9 A/A statistics (block-level bootstrap intervals) for every A/A operating point', need_aa <= aa_chunks,
   457	         [f'A/A statistics present for {sorted(aa_chunks)}, required {sorted(need_aa)}'])
   458	    # ---- pairs helper
   459	    def pair_items(label, a, b, c, tags):
   460	        clean = 0
