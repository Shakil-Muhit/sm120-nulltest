   559	        scored = [r for r in rs if fin(r.get('realized_ms'))]
   560	        tight = [r['realized_ms'] / r['Y_ms'] for r in scored if r['Y_ms'] > 0]
   561	        L.append(f"- confidence {g}: {len(rs)} rows, {len(scored)} scored; realized/ceiling median {statistics.median(tight):.2f} (min {min(tight):.2f}, max {max(tight):.2f})" if tight else f"- confidence {g}: {len(rs)} rows, none scored yet")
   562	    for n in getattr(E, 'phase3_notes', []):
   563	        L.append(f'- {n}')
   564	    for r in real:
   565	        L.append(f"- realized source {r['X']} @{r['O']}: {r.get('realized_source')} (CI95 {r.get('realized_ci95_ms')})")
   566	    L.append('- notation: f_recoverable is the fraction of T_attributable removed; a class speed-up s gives f = 1 − 1/s; the remaining-time fraction is never written in the f column.')
   567	    L.append('')
   568	    L.append('## Stacking note (mandatory)')
   569	    L.append('- G1 (X2, X6, X6a, X13) share kernels: sum at most the "G1 union of attributable time" row of each O, never the arithmetic sum.')
   570	    L.append('- G2 (X8, X9) are alternatives: never summed; both require an SDR pre-check before any kernel work.')
   571	    L.append('- G3 (X10, X11, X12) model the same launch-bound regime three ways: report the max, not the sum.')
   572	    L.append('- X1 and X5 are measured deltas already inside the C3 wall; they may be summed only with rows attributed from the C3 trace.')
   573	    L.append('- X14 is throughput headroom and is never added to latency rows.')
   574	    L.append('')
