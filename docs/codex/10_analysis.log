    44	def gemm_precision_bounds(sites, gemm_class_ms):
    45	    """Per-shape roofline bounds for the GEMM class (X8/X9). Each extern site (M, N, K, fp16) gets
    46	    t32 = max(2MNK / 209.5 TFLOPS, bytes / BW) and t16 = max(2MNK / 419 TFLOPS, bytes / BW); the class time
    47	    is apportioned to sites by their t32 share; f_site = 1 - t16/t32. FP8: compute term at 419 (COMPUTE_32F
    48	    ceiling) and traffic halved (weights + activations in 1 byte) -> f_fp8_site = 1 - t8/t32."""
    49	    tot32 = sum(max(2 * g['M'] * g['N'] * g['K'] * g.get('batch', 1) / (RATE_FP16_ACC_FP32_TFLOPS * 1e12), g['bytes'] / (BW_GBPS * 1e9)) for g in sites)
    50	    if not tot32 or not gemm_class_ms:
    51	        return None
    52	    y16 = y8 = 0.0
    53	    shapes = {}
    54	    for g in sites:
    55	        fl = 2 * g['M'] * g['N'] * g['K'] * g.get('batch', 1)
    56	        t32 = max(fl / (RATE_FP16_ACC_FP32_TFLOPS * 1e12), g['bytes'] / (BW_GBPS * 1e9))
    57	        t16 = max(fl / (RATE_FP16_ACC_FP16_TFLOPS * 1e12), g['bytes'] / (BW_GBPS * 1e9))
    58	        t8 = max(fl / (RATE_FP8_TFLOPS * 1e12), 0.5 * g['bytes'] / (BW_GBPS * 1e9))
    59	        share = t32 / tot32
    60	        y16 += gemm_class_ms * share * (1 - t16 / t32)
    61	        y8 += gemm_class_ms * share * (1 - t8 / t32)
    62	        key = (g['M'], g['N'], g['K'])
