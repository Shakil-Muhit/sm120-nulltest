   217	def session_blocks(session, runs, matched):
   218	    """Timing blocks that belong to a session by REGISTERED tag/operating point
   219	    (gate-07 f101): session 1 = r1–r3 at 352800/4410 and the matched pairs;
   220	    session 2 = r1–r3 at the sweep points, every trace and perturbation run."""
   221	    out = []
   222	    for (a, c), rs in runs.items():
   223	        for t, r in rs.items():
   224	            blocks = ((r.get('timing') or {}).get('blocks') or [])
   225	            if session == 'session1' and c in (352800, 4410) and t in ('r1', 'r2', 'r3'):
   226	                out += [(b.get('unix_start'), b.get('unix_end'), f'{a}@{c}/{t}') for b in blocks]
   227	            if session == 'session2' and ((c in (22050, 88200) and t in ('r1', 'r2', 'r3')) or t == 'trace' or t.startswith('pert_')):
   228	                out += [(b.get('unix_start'), b.get('unix_end'), f'{a}@{c}/{t}') for b in blocks]
   229	            if session == 'session3' and c in OPS['session3'] + HELD_OUT_S3:
   230	                out += [(b.get('unix_start'), b.get('unix_end'), f'{a}@{c}/{t}') for b in blocks]
   231	    if session in ('session1', 'session3'):
   232	        for (pair, c, t), m in matched.items():
   233	            out += [(b.get('unix_start'), b.get('unix_end'), f'matched {pair}/{t}') for b in (m.get('blocks') or [])]
   234	    return out
