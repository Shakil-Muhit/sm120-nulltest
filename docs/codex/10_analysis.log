   684	def main():
   685	    ap = argparse.ArgumentParser()
   686	    ap.add_argument('--evidence-dir', required=True)
   687	    ap.add_argument('--phase3-dir', default=None, help='session-3 evidence directory (fills realized/ceiling)')
   688	    ap.add_argument('--out', default='LEDGER.md')
   689	    args = ap.parse_args()
   690	    E, rows = build(args.evidence_dir)
   691	    if args.phase3_dir:
   692	        fill_realized(E, rows, args.phase3_dir)
   693	    render(E, rows, args.out)
   694	    n_ok = sum(1 for r in rows if r['status'] == 'ok')
   695	    print(f'[ledger] {n_ok} resolved rows, {len(rows) - n_ok} UNRESOLVED -> {args.out}')
   696	    for r in rows:
   697	        if r['status'] != 'ok':
   698	            print(f"   UNRESOLVED {r['X']} @ {r['O']}: {r['why']}")
   699	
   700	
   701	if __name__ == '__main__':
   702	    main()

