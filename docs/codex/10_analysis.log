   554	    real = [r for r in rows if r['status'] == 'ok' and fin(r.get('realized_ms'))]
   555	    over = [r for r in real if r['realized_ms'] > r['Y_ms'] + 1e-9]
   556	    L.append(f"- realized values filled: {len(real)}; rows whose realized value EXCEEDS its ceiling (falsified attribution): {[(r['X'], r['O']) for r in over] or 'none'}")
   557	    for g in ('A', 'B', 'C'):
