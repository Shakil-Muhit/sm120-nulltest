   237	def clock_series(ev, session, gpu_uuid):
   238	    """(timestamp, SM MHz) samples of this GPU from the session clock log (UTC unless CLOCK_TZ=local)."""
   239	    clocks = os.path.join(ev, f'clocks_{session}.csv')
   240	    out = []
