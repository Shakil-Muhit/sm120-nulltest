   466	                 note=(f'clock-drift flagged (registered 5 % rule): {fl}' if fl else None))
   467	            if ok and not fl:
   468	                clean += 1
   469	        item(items, f'{label} {a} vs {b} @{c}: at least one eligible restart without a clock-drift flag', clean > 0,
   470	             [f'every eligible restart is clock-drift flagged: {[drift["pairs"].get(((a, b), c, t)) for t in tags]}'])
   471	    def trace_items(label, a, c, sfx='', need_graphed=True, optional=False):
   472	        base = os.path.join(ev, 'traces', f'trace_{a}_{c}_' + (sfx or 'trace'))
