   599	def csv_rows(path, required_cols):
   600	    """Parse an export: header must contain the required columns; returns row count."""
   601	    import csv
   602	    try:
   603	        with open(path, newline='') as f:
   604	            rd = csv.reader(f)
   605	            head = [h.strip().strip('"').lower() for h in next(rd)]
   606	            # nsys spells the correlation column 'CorrId' (GPU trace) and 'CorrID' (API trace)
   607	            if not all(any(c.lower() in h for h in head) for c in required_cols):
   608	                return None
   609	            return sum(1 for _ in rd)
   610	    except Exception:
   611	        return None
