   281	def audit_clock_drift(ev, items, session, runs, matched, gpu_uuid, limit=0.05):
   282	    """Registered rule (prereg v0.2, session plan): clocks may not drift more than 5 %
   283	    between COMPARED blocks (gate-09 f132). Matched pairs: the a-block vs the b-block of
   284	    each repeat (blocks shorter than the 1 Hz sampling interval use the nearest samples,
   285	    a proxy the note records). Headline cells: per-block SM medians across r1..rN.
   286	    Returns {'pairs': {(pair, chunk, tag): [violations]}, 'cells': {(arm, chunk): [..]}};
   287	    the caller scopes the consequence to the affected comparison (a pair restart or a
   288	    cell), and a mandatory stage fails only when no clean restart remains."""
   289	    series = clock_series(ev, session, gpu_uuid)
   290	    flagged = {'pairs': {}, 'cells': {}}
   291	    unresolved, checked = [], 0
   292	    for (pair, c, t), m in matched.items():
   293	        if m.get('status') not in ('VALID',):
   294	            continue
   295	        by_rep = {}
   296	        for b in (m.get('blocks') or []):
   297	            by_rep.setdefault(b.get('repeat'), []).append(b)
   298	        for rep, bs in by_rep.items():
   299	            if len(bs) != 2:
   300	                continue
   301	            sa = block_sm_median(series, bs[0].get('unix_start'), bs[0].get('unix_end'))
   302	            sb = block_sm_median(series, bs[1].get('unix_start'), bs[1].get('unix_end'))
   303	            if sa is None or sb is None:
   304	                unresolved.append(f'matched {pair}@{c}/{t} rep {rep}')
   305	                continue
   306	            checked += 1
   307	            drift = abs(sa - sb) / ((sa + sb) / 2)
   308	            if drift > limit:
   309	                flagged['pairs'].setdefault((pair, c, t), []).append(f'rep {rep}: {sa:.0f} vs {sb:.0f} MHz ({drift * 100:.1f} %)')
   310	    for (a, c), rs in runs.items():
   311	        meds = []
   312	        for t, r in rs.items():
   313	            if not t.startswith('r') or not t[1:].isdigit() or r.get('status') != 'VALID':
   314	                continue
   315	            for b in ((r.get('timing') or {}).get('blocks') or []):
   316	                sm = block_sm_median(series, b.get('unix_start'), b.get('unix_end'))
   317	                if sm is None:
   318	                    unresolved.append(f'{a}@{c}/{t} block {b.get("repeat")}')
   319	                else:
   320	                    meds.append(sm)
   321	        if len(meds) >= 2:
   322	            checked += 1
   323	            drift = (max(meds) - min(meds)) / (sum(meds) / len(meds))
   324	            if drift > limit:
   325	                flagged['cells'][(a, c)] = [f'restarts: {min(meds):.0f}–{max(meds):.0f} MHz ({drift * 100:.1f} %)']
   326	    n_bad = len(flagged['pairs']) + len(flagged['cells'])
   327	    item(items, f'clock drift <= {limit * 100:.0f} % between compared blocks: {checked} comparisons, {n_bad} flagged (informational; consequences are scoped per comparison)',
   328	         checked > 0 and not unresolved, [f'unresolved (no samples near block) {unresolved[:4]}'] if unresolved else ['no comparisons'],
   329	         note=(('flagged: ' + '; '.join(f'{k}: {v}' for k, v in list(flagged['pairs'].items())[:8] + list(flagged['cells'].items())[:4])) if n_bad else 'no violations'),
   330	         optional=True)
   331	    return flagged
