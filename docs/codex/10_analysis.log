   591	def _boot_ci(vals, n=10000, seed=20260921):
   592	    import random
   593	    rnd = random.Random(seed)
   594	    out = []
   595	    k = len(vals)
   596	    for _ in range(n):
   597	        out.append(statistics.median([vals[rnd.randrange(k)] for _ in range(k)]))
   598	    out.sort()
   599	    return [out[int(0.025 * n)], out[int(0.975 * n) - 1]]
