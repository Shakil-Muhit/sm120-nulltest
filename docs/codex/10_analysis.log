   602	def matched_realized(p3, a, b, O):
   603	    """median over ELIGIBLE restarts of the matched block-median difference a − b
   604	    (ms), with a block-level bootstrap interval over all eligible blocks."""
   605	    import glob, os
   606	    meds, blocks, files = [], [], []
   607	    for f in sorted(glob.glob(os.path.join(p3, f'matched_{a}_{b}_c{O}_m*.json'))):
   608	        m = _load_json(f)
   609	        if m and m.get('pair_eligible') and m.get('matched_delta_ms'):
   610	            meds.append(m['matched_delta_ms']['median'])
   611	            blocks += m['matched_delta_ms']['a_minus_b_per_block']
   612	            files.append(os.path.basename(f))
   613	    if not meds:
   614	        return None
   615	    return {'realized_ms': statistics.median(meds), 'ci95_ms': _boot_ci(blocks), 'restarts': len(meds), 'files': files}
