   132	def _boot_ci(diffs, stat=statistics.median):
   133	    rnd = random.Random(BOOT_SEED)
   134	    vals = []
   135	    n = len(diffs)
   136	    for _ in range(BOOT_N):
   137	        vals.append(stat([diffs[rnd.randrange(n)] for _ in range(n)]))
   138	    vals.sort()
   139	    return [vals[int(0.025 * BOOT_N)], vals[int(0.975 * BOOT_N) - 1]]
