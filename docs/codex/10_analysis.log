   177	                        hashes[('val', chunk, seed)] = side['sha256']
   178	        for d in sorted(glob.glob(os.path.join(ev, 'ref_variant_*'))):
   179	            v = os.path.basename(d)[len('ref_variant_'):]
   180	            for chunk in OPS[session]:
