   614	def audit_aux(ev, items, session, dynamic):
   615	    required = list(dict.fromkeys(STATIC_AUX[session] + dynamic))      # deduplicated, order kept
   616	    for name in required:
   617	        rec = load(os.path.join(ev, f'aux_{name}.json')) or {}
   618	        item(items, f'auxiliary step {name}', rec.get('status') == 'OK', [f"{rec.get('status', 'MISSING')}: {rec.get('reason')}"])
   619	    for path in sorted(glob.glob(os.path.join(ev, 'aux_*.json'))):
   620	        rec = load(path) or {}
   621	        name = rec.get('item', os.path.basename(path)[4:-5])
   622	        if name in required or name == 'completeness':
   623	            continue
   624	        item(items, f'auxiliary step {name}', rec.get('status') == 'OK', [f"{rec.get('status')}: {rec.get('reason')}"])
