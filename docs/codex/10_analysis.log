   519	                 + " (an INCOMPLETE session keeps every row that cites a missing item UNRESOLVED)")
   520	        L.append('')
   521	        L.append('| X | T_attr (ms) | f | Y (ms) | Z (%) | conf | effort | quality risk | group | label | evidence | would be lower if | caveats | realized (ms) | realized / ceiling |')
   522	        L.append('|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|')
   523	        for r in rows:
   524	            if r['O'] != O:
   525	                continue
