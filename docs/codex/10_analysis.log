    41	    p = v['params']
    42	    inp = reg['inputs']
    43	    def q(T):
    44	        return (lambda f: f / (T * math.ceil(f / T))) if T else (lambda f: 1.0)
    45	    qH, qC = q(p['TH']), q(p['TC'])
    46	    B, NF, MID = inp['B'], inp['NF'], inp['MID']
    47	    rows = []
    48	    for L in range(4410, 352801, 4410):
    49	        f = L // HOP + 1
    50	        rH = p['RH'] * f / (f + p['hH']) * qH(f)
    51	        rC = p['RC'] * f / (f + p['hC']) * qC(f)
    52	        pad = inp['pad_gflop_per_frame'] * f / rH
    53	        eff = inp['true_gflop_per_frame'] * f * (1 / rH - 1 / rC)
    54	        D = B - (NF[0] + NF[1] * f) - (MID[0] + MID[1] * f) - pad - eff
    55	        rows.append([L, f, round(D, 4), 'model', round(B, 4), round(-(NF[0] + NF[1] * f), 4), round(-(MID[0] + MID[1] * f), 4), round(-pad, 4), round(-eff, 4)])
    56	    for L, D in inp['sweep_obs_C3_minus_H'].items():
    57	        rows.append([int(L), int(L) // HOP + 1, round(D, 4), 'observed_sweep (headline C3 − H)', '', '', '', '', ''])
