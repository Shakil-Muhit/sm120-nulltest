   527	                L.append(f"| {r['X']} | UNRESOLVED | — | — | — | {r.get('conf', '—')} | — | — | {r.get('group', '—')} | — | {r.get('evidence', '—')} | {r['why']} | — | | |")
   528	                continue
   529	            f = f"{r['f_recoverable']:.3f}" if fin(r.get('f_recoverable')) else '—'
   530	            Y = f"{r['Y_ms']:.4f}" if fin(r.get('Y_ms')) else '—'
   531	            Z = f"{r['Z_pct']:.2f}" if fin(r.get('Z_pct')) else '—'
   532	            rz = r.get('realized_ms')
   533	            rc = f"{rz / r['Y_ms']:.2f}" if (fin(rz) and fin(r.get('Y_ms')) and r['Y_ms']) else ''
   534	            if fin(rz) and r.get('realized_ci95_ms'):
   535	                rc += f" [{r['realized_ci95_ms'][0] / r['Y_ms']:.2f}, {r['realized_ci95_ms'][1] / r['Y_ms']:.2f}]" if r['Y_ms'] else ''
   536	            L.append(f"| {r['X']} | {r['T_attributable_ms']:.4f} | {f} | {Y} | {Z} | {r['conf']} | {r['effort']} | {r['quality_risk']} | {r['group']} | {r['label']} | "
   537	                     f"{r['evidence']} | {r['would_be_lower_if']} | {'; '.join(r['caveats']) or '—'}{(' · ' + r['note']) if r.get('note') else ''} | {fmt_r(rz)} | {rc} |")
   538	        L.append('')
   539	        # thresholds
   540	        L.append('**Thresholds (plan 3.2, mechanical):**')
   541	        for r in rows:
   542	            if r['O'] != O or r['status'] != 'ok' or not fin(r.get('Z_pct')) or r['X'].startswith('G1') or r['X'].startswith('X14'):
   543	                continue
   544	            if O == 352800:
   545	                need = THRESH['offline_AB'] if r['conf'] in ('A', 'B') else THRESH['offline_C']
   546	                verdict = 'PURSUE' if r['Z_pct'] >= need else 'below threshold'
   547	                L.append(f"- {r['X']}: Z = {r['Z_pct']:.2f} % vs {need} % ({r['conf']}) → {verdict}")
   548	            else:
