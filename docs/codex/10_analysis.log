   618	def fill_realized(E, rows, p3):
   619	    """Phase 3 §6: realized values from the session-3 matched pairs (prereg v0.2).
   620	    Rows filled: X6a (E1: C3 − C3F, or C3 − C3P when the registered branch ran),
   621	    X2a (E4a: control − C3N). Aggregate comparisons that map to no single row
   622	    (E2 → X2a+X2b+X2c, E3 → X1, E9 → X5 crossover, E7 → X12 coefficient) are
   623	    recorded as notes. Every value cites its files."""
   624	    import os
   625	    E.phase3_status = (_load_json(os.path.join(p3, 'session_status.json')) or {})
   626	    E.phase3_notes = []
   627	    branch = _load_json(os.path.join(p3, 'e1_branch.json')) or {}
   628	    dec = _load_json(os.path.join(p3, 'e4a_decision.json')) or {}
   629	    ctrl = dec.get('control') or 'C3'
   630	    for r in rows:
   631	        if r['status'] != 'ok':
   632	            continue
   633	        O = r['O']
   634	        if r['X'].startswith('X6a'):
   635	            rec, src = None, None
   636	            for arm, lab in (('C3F', 'E1 C3 − C3F'), ('C3G', "E1(a') C3 − C3G"), ('C3P', 'E1(b) C3 − C3P')):
   637	                rec2 = matched_realized(p3, 'C3', arm, O)
   638	                if rec2 and (rec is None or rec2['realized_ms'] > rec['realized_ms']):
   639	                    rec, src = rec2, lab
   640	            # every E1 arm's realized value is kept in the note; the row carries the best one
   641	            for arm, lab in (('C3F', 'C3F'), ('C3G', 'C3G'), ('C3P', 'C3P')):
   642	                rec2 = matched_realized(p3, 'C3', arm, O)
   643	                if rec2:
   644	                    E.phase3_notes.append(f"E1 @{O}: C3 − {arm} realized {rec2['realized_ms']:+.4f} ms {rec2['ci95_ms']} ({rec2['restarts']} restarts)")
   645	            if rec:
   646	                r['realized_ms'], r['realized_ci95_ms'], r['realized_source'] = rec['realized_ms'], rec['ci95_ms'], f"{src}: {rec['files']}"
   647	        if r['X'].startswith('X2a'):
   648	            rec = matched_realized(p3, ctrl, 'C3N', O)
   649	            if rec:
   650	                r['realized_ms'], r['realized_ci95_ms'], r['realized_source'] = rec['realized_ms'], rec['ci95_ms'], f"E4a {ctrl} − C3N ({dec.get('mode')}): {rec['files']}"
   651	    for O in OPS:
   652	        x2 = [r for r in rows if r['O'] == O and r['status'] == 'ok' and r['X'][:3] in ('X2a', 'X2b', 'X2c')]
   653	        rec = matched_realized(p3, 'C3', 'C3M', O)
   654	        if rec and x2:
   655	            ceil = sum(r['Y_ms'] for r in x2)
   656	            g1 = next((r for r in rows if r['O'] == O and r['status'] == 'ok' and r['X'].startswith('G1')), None)
   657	            g1_txt = f"; G1 union (X2 ∪ X6 ∪ X6a ∪ X13) attributable time {g1['T_attributable_ms']:.4f} ms" if g1 else ''
   658	            tc = _load_json(os.path.join(p3, 'traces', f'template_count_C3M_{O}.json')) or {}
   659	            tc_txt = (f"; C3M trace: {tc.get('triton_template_kernels_per_pass')} Triton template GEMMs/pass ({(tc.get('triton_template_time_ms_per_pass') or 0):.3f} ms), "
   660	                      f"{tc.get('extern_gemm_kernels_per_pass')} extern GEMMs/pass; template names carry _to_copy (weight cast fused into the template), so E2 also realizes part of X6a"
   661	                      if tc else '')
   662	            E.phase3_notes.append(f"E2 @{O}: C3 − C3M realized {rec['realized_ms']:+.4f} ms {rec['ci95_ms']} ({rec['restarts']} restarts) vs X2a+X2b+X2c ceiling {ceil:.4f} ms "
   663	                                  f"→ {'EXCEEDS the X2 ceiling: max-autotune changes GEMM kernel selection and fuses weight casts, mechanisms outside X2' if rec['realized_ms'] > ceil + 1e-9 else f'{rec['realized_ms'] / ceil:.2f} of ceiling'}"
   664	                                  f"{g1_txt}{tc_txt}; files {rec['files']}")
   665	        if O == 352800:
   666	            rec = matched_realized(p3, 'C1', 'C1P', O)
   667	            x1 = next((r for r in rows if r['O'] == O and r['X'].startswith('X1 ') and r['status'] == 'ok'), None)
   668	            if rec and x1:
   669	                E.phase3_notes.append(f"E3 @{O}: C1 − C1P realized {rec['realized_ms']:+.4f} ms {rec['ci95_ms']} vs X1 (C1 − C3) {x1['Y_ms']:.4f} ms → partition recovers {rec['realized_ms'] / x1['Y_ms']:.2f} of the break tax; files {rec['files']}")
   670	    e9 = _load_json(os.path.join(p3, 'e9_check.json'))
   671	    if e9:
   672	        E.phase3_notes.append(f"E9 (X5 crossover): verdict {e9.get('verdict')}; L* predicted {e9.get('crossover_L_star_pred')}; " + '; '.join(
   673	            f"L={L}: pred {v.get('predicted_C3_minus_H_ms'):+.3f} obs {v.get('observed_C3_minus_H_ms (median over restarts of block medians)')} err {v.get('error_ms')}" for L, v in (e9.get('held_out') or {}).items()) + ' (e9_check.json)')
   674	    bb = _load_json(os.path.join(p3, 'boundary_bench.json'))
   675	    if bb and bb.get('e7_pdl_saving'):
   676	        E.phase3_notes.append('E7 (X12 coefficient): per-node PDL saving ' + ', '.join(f"{k}: {v['pdl_saving_us_per_node']:+.3f} µs" for k, v in bb['e7_pdl_saving'].items())
   677	                              + f"; SASS mnemonics {(bb.get('pdl_sass') or {}).get('griddep_mnemonics_found')} (boundary_bench.json)")
   678	        ta = _load_json(os.path.join(p3, 'boundary_bench_trace_analysis.json')) or {}
   679	        ov = {k: v.get('overlap_observed') for k, v in ta.items() if '/pdl_' in k and isinstance(v, dict) and v.get('status') == 'ok'}
   680	        if ov:
   681	            E.phase3_notes.append(f"E7 trace: overlap observed per PDL segment {ov} (boundary_bench_trace_analysis.json)")
