   198	    writes = [arg_meta(gr, a) for a in call['args'] if a.get('write')]
   199	    mats = [m for m in reads if len(m['shape']) in (2, 3)]
   200	    if len(mats) < 2 or not writes:
   201	        return None
   202	    a, b = mats[-2], mats[-1]
   203	    if any(m['dtype'] is None for m in mats + writes):
   204	        return None
   205	    if len(a['shape']) == 2 and len(b['shape']) == 2:
   206	        M, K = a['shape']; K2, N = b['shape']; batch = 1
