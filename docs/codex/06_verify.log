   599	def split_passes(rows, windows, classify):
   600	    if windows:
   601	        return [[r for r in rows if s <= r['start'] < e]
   602	                for s, e in windows], 'nvtx-windows'
   603	    sdpa_idx = [i for i, r in enumerate(rows) if classify(r['name']) == 'SDPA']
   604	    n_pass = max(1, round(len(sdpa_idx) / 12)) if sdpa_idx else 1
   605	    gaps = [(rows[i + 1]['start'] - (rows[i]['start'] + rows[i]['dur']), i)
   606	            for i in range(len(rows) - 1)]
   607	    cuts = sorted(i for _, i in sorted(gaps, key=lambda g: -g[0])[:n_pass - 1])
   608	    passes, prev = [], 0
   609	    for c in cuts:
   610	        passes.append(rows[prev:c + 1])
    95	    s = (est * ref).sum() / rr * ref
    96	    return _db(float((s ** 2).sum()), float(((est - s) ** 2).sum()))
