    42	def _qualified(run, iters=50):
    43	    """One-block perturbation protocol: VALID, validation PASS, exactly one
    44	    block holding exactly `iters` recorded passes, manifest-bound, effective
    45	    variant recorded, compile arms affirmatively recording-stable."""
    46	    if not run or run.get('status') != 'VALID':
    47	        return 'run missing or not VALID'
    48	    if (run.get('validation') or {}).get('status') != 'PASS':
    49	        return 'validation not PASS'
    50	    t = run.get('timing') or {}
    51	    blocks = t.get('blocks') or []
    52	    if len(blocks) != 1 or t.get('iters_per_block') != iters:
    53	        return f'not a one-block x {iters} run'
    54	    if len(blocks[0].get('latency_ms_per_iter') or []) != iters:
    55	        return 'the block does not hold the registered pass count'
    56	    if run.get('manifest_id') is None:
    57	        return 'not manifest-bound'
    58	    if not run.get('effective_variant'):
    59	        return 'effective variant not recorded'
    60	    if run.get('settle') and run['settle'].get('settle_capped'):
    61	        return 'settle capped'
    62	    if run.get('arm') in COMPILE_ARMS and run.get('counters_stable') is not True:
    63	        return 'recording stability not affirmatively established'
    64	    return None
