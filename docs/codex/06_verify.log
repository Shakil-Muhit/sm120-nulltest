   564	def nvtx_pass_windows(path):
   565	    """pass_<i> projected ranges; require unique ids and non-overlap."""
   566	    try:
   567	        with open(path, newline='') as f:
   568	            rd = csv.reader(f)
   569	            head = next(rd)
   570	            c_name = next(i for i, h in enumerate(head)
   571	                          if h.strip().strip('"') in ('Name', 'Range'))
   572	            c_start = next(i for i, h in enumerate(head) if 'Start' in h)
   573	            c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
   574	            wins = {}
   575	            for r in rd:
   576	                nm = r[c_name].strip().strip('"').split(':')[-1]
   577	                if re.fullmatch(r'pass_\d+', nm):
   578	                    try:
   579	                        s = int(float(r[c_start].replace(',', '')))
   580	                        d = int(float(r[c_dur].replace(',', '')))
   581	                    except ValueError:
   582	                        continue
   583	                    i = int(nm.split('_')[1])
   584	                    if i in wins:
   585	                        return [], f'duplicate nvtx pass id {i}'
   586	                    wins[i] = (s, s + d)
   587	            ids = sorted(wins)
   588	            if ids != list(range(len(ids))):
   589	                return [], f'non-contiguous nvtx pass ids ({len(ids)} found)'
   590	            ordered = [wins[i] for i in ids]
   591	            for a, b in zip(ordered, ordered[1:]):
   592	                if b[0] < a[1]:
   593	                    return [], 'overlapping nvtx pass windows'
   594	            return ordered, None
   595	    except Exception as e:
   596	        return [], f'nvtx parse failed: {e}'
