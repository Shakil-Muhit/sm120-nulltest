   215	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   216	    """Five repeats of the 5a block; min-of-medians + median spread; every
   217	    per-iteration list preserved; block wall timestamps for the clock log."""
   218	    blocks = []
   219	    for r in range(repeats):
   220	        t_start = time.time()
   221	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   222	        t_end = time.time()
   223	        s = sorted(lat)
   224	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   225	                       'latency_median_ms': median(lat),
   226	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   227	                       'throughput_ms_per_pass': thr,
   228	                       'unix_start': t_start, 'unix_end': t_end})
   229	    meds = [b['latency_median_ms'] for b in blocks]
   230	    return {'blocks': blocks, 'latency_medians_ms': meds,
   231	            'min_of_medians_ms': min(meds),
   232	            'median_spread_ms': max(meds) - min(meds),
   233	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   234	            'serialization_delta_pct': [
   235	                (b['latency_median_ms'] - b['throughput_ms_per_pass'])
   236	                / b['throughput_ms_per_pass'] * 100.0 for b in blocks],
   237	            'iters_per_block': iters, 'repeats': repeats}
