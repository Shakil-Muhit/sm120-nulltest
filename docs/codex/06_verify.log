   128	def run_gate(step, ctx, clips, ref_dir, chunk, save_reference=False, manifest_id=None):
   129	    import provenance
   130	    rows = []
   131	    for c in clips:
   132	        est = separate_clip(step, ctx, c['mixture'], chunk)
   133	        vocals = c['vocals']
   134	        row = {'index': c['index'], 'track': c['track'],
   135	               'sdr_ref_db': sdr_db(vocals, est),
   136	               'si_sdr_ref_db': si_sdr_db(vocals, est),
   137	               'finite': bool(torch.isfinite(est).all())}
   138	        path = a_output_path(ref_dir, chunk, c['index'])
   139	        if save_reference:
   140	            os.makedirs(ref_dir, exist_ok=True)
   141	            torch.save(est, path)
   142	            if manifest_id is not None:
   143	                provenance.bind_artifact(path, manifest_id)
   144	                row['a_output_sha256'] = provenance.sha256_file(path)
   145	            row['saved'] = path
   146	        else:
   147	            if not os.path.exists(path):
   148	                raise FileNotFoundError(f'eager-A clip output missing: {path}')
   149	            if manifest_id is not None:
   150	                provenance.check_artifact(path, manifest_id)
   151	                row['a_output_sha256'] = provenance.sha256_file(path)
   152	            a_out = torch.load(path, weights_only=True)
   153	            row['sdr_ref_A_db'] = sdr_db(vocals, a_out)
   154	            d = (row['sdr_ref_db'] - row['sdr_ref_A_db']
   155	                 if isinstance(row['sdr_ref_db'], float) and isinstance(row['sdr_ref_A_db'], float)
   156	                 else None)
   157	            row['delta_sdr_ref_db'] = d
   158	            row['sdr_vs_A_db'] = sdr_db(a_out, est)
   159	            row['si_sdr_vs_A_db'] = si_sdr_db(a_out, est)
   160	            row['max_abs_diff_vs_A'] = float((a_out - est).abs().max())
   161	        rows.append(row)
   162	    rec = {'clips': rows, 'operating_point': chunk,
   163	           'chunks_per_clip': CLIP_SAMPLES // chunk,
   164	           'reconstruction': 'non-overlapping concatenation',
   165	           'threshold_mean_delta_sdr_db': THRESHOLD_DB, 'n_clips': len(rows)}
   166	    rec['sdr_ref_summary'] = _mean_with_inf([r['sdr_ref_db'] for r in rows])
   167	    rec['mean_sdr_ref_db'] = rec['sdr_ref_summary']['mean_finite_db']
   168	    if save_reference:
   169	        rec['status'] = 'REFERENCE_SAVED'
   170	        return rec
   171	    # the gate uses the SDR_ref terms only: both arm and A must be finite
   172	    deltas = [r['delta_sdr_ref_db'] for r in rows]
   173	    if any(d is None for d in deltas):
   174	        rec['status'] = 'FAIL'
   175	        rec['reason'] = ('a paired SDR_ref term is non-finite ("inf" = perfect match to the '
   176	                         'reference stem, "undefined" = zero reference) — not gateable')
   177	        return rec
   178	    rec['mean_delta_sdr_ref_db'] = float(np.mean(deltas))
   179	    rec['min_delta_sdr_ref_db'] = float(np.min(deltas))
   180	    # output fidelity vs A: infinities are expected for A itself and are kept
   181	    rec['sdr_vs_A_summary'] = _mean_with_inf([r['sdr_vs_A_db'] for r in rows])
   182	    rec['all_finite'] = all(r['finite'] for r in rows)
   183	    rec['status'] = ('PASS' if rec['all_finite'] and
   184	                     rec['mean_delta_sdr_ref_db'] >= THRESHOLD_DB else 'FAIL')
   185	    return rec
     1	"""Provenance gate + session manifest (gate-02 finding 23).
     2	
     3	verify(paths) FAILS LOUDLY unless: the msst clone HEAD equals the pinned
     4	commit (configs/msst_commit.txt) and is clean; the checkpoint's sha256 equals
     5	the pinned value (configs/checkpoint.txt); the config path is the registered
     6	one relative to the clone (line 3 of checkpoint.txt); use_amp is an explicit
     7	boolean. Every run calls it before building anything.
     8	
     9	The session manifest (evidence/session_manifest.json) binds a session to one
    10	immutable identity: repo commit + clean tree, sha256 of the registration file,
    11	sha256 of every fullmodel/*.py, fullmodel/c3_fix/*.py, scripts/session*.sh,
    12	the pins above, the clip manifest hash, and the environment fingerprint.
    13	Runs record the manifest id; references are written with a sidecar carrying
    14	it, and validation refuses references from another manifest.
    15	"""
    16	
    17	import hashlib
    18	import json
    19	import os
    20	import subprocess
    21	import uuid
    22	from datetime import datetime, timezone
    23	
    24	_HERE = os.path.dirname(os.path.abspath(__file__))
    25	_ROOT = os.path.dirname(_HERE)
    26	
    27	
    28	def sha256_file(path):
    29	    h = hashlib.sha256()
    30	    with open(path, 'rb') as f:
    31	        for block in iter(lambda: f.read(1 << 20), b''):
    32	            h.update(block)
    33	    return h.hexdigest()
    34	
    35	
    36	def _git(repo, *args):
    37	    return subprocess.check_output(['git', '-C', repo, *args], text=True).strip()
    38	
    39	
    40	def pins():
    41	    lines = [l.strip() for l in open(os.path.join(_ROOT, 'configs', 'msst_commit.txt'))
    42	             if l.strip() and not l.strip().startswith('#')]
    43	    msst_commit = lines[0]
    44	    data = [l.strip() for l in open(os.path.join(_ROOT, 'configs', 'checkpoint.txt'))
    45	            if l.strip() and not l.strip().startswith('#')]
    46	    assert len(data) == 3, 'configs/checkpoint.txt must hold URL / sha256 / config path'
    47	    return {'msst_commit': msst_commit, 'ckpt_url': data[0], 'ckpt_sha256': data[1].lower(),
    48	            'config_rel': data[2]}
    49	
    50	
    51	REGISTERED_TORCH = '2.8.0+cu128'      # prereg version matrix (setup.sh / runbook)
    52	REGISTERED_TRITON = '3.4.0'
    53	
    54	
    55	def verify(paths):
    56	    """Returns the provenance record; raises RuntimeError on any mismatch
    57	    (model pins AND runtime pins)."""
    58	    import torch
    59	    import triton
    60	    if torch.__version__ != REGISTERED_TORCH or triton.__version__ != REGISTERED_TRITON:
    61	        raise RuntimeError(f'runtime pins: torch {torch.__version__} / triton {triton.__version__} '
    62	                           f'!= registered {REGISTERED_TORCH} / {REGISTERED_TRITON}')
    63	    p = pins()
    64	    head = _git(paths['msst'], 'rev-parse', 'HEAD')
    65	    if head != p['msst_commit']:
    66	        raise RuntimeError(f"msst clone HEAD {head} != pinned {p['msst_commit']}")
    67	    dirty = _git(paths['msst'], 'status', '--porcelain')
    68	    if dirty:
    69	        raise RuntimeError('msst clone is not clean:\n' + dirty[:500])
    70	    ck = sha256_file(paths['ckpt'])
    71	    if ck != p['ckpt_sha256']:
    72	        raise RuntimeError(f"checkpoint sha256 {ck} != pinned {p['ckpt_sha256']}")
    73	    expected_cfg = os.path.realpath(os.path.join(paths['msst'], p['config_rel']))
    74	    if os.path.realpath(paths['config']) != expected_cfg:
    75	        raise RuntimeError(f"config {paths['config']} is not the registered {expected_cfg}")
    76	    return {'msst_commit': head, 'msst_clean': True, 'ckpt_sha256': ck,
    77	            'config': expected_cfg, 'config_sha256': sha256_file(expected_cfg),
    78	            'torch': torch.__version__, 'triton': triton.__version__}
