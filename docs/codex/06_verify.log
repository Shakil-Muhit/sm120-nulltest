   282	def validate(step, ctx, tier, chunk, ref_dir, save_reference=False, manifest_id=None):
   283	    """AUDIT-MAP[2] mechanics: two passes, different data (asserted), each
   284	    compared to the SAVED eager-A output for that (chunk, seed). With
   285	    save_reference=True (arm A reference step) the outputs are written
   286	    instead of compared."""
   287	    passes, prev_x = [], None
   288	    for seed in VAL_SEEDS:
   289	        x = make_input(chunk, seed)
   290	        if prev_x is not None:
   291	            assert not torch.equal(x, prev_x), \
   292	                'validation passes must use different input data'
   293	        prev_x = x
   294	        with torch.no_grad(), ctx():
   295	            out = step(x)
   296	            torch.cuda.synchronize()
   297	            out = out.clone()            # borrow discipline (build_spec rule 1)
   298	        path = ref_path(ref_dir, chunk, seed)
   299	        if save_reference:
   300	            os.makedirs(ref_dir, exist_ok=True)
   301	            torch.save(out.float().cpu(), path)
   302	            if manifest_id is not None:
   303	                provenance.bind_artifact(path, manifest_id)
   304	            passes.append({'seed': seed, 'saved': path, 'ref_sha256': provenance.sha256_file(path),
   305	                           'finite': bool(torch.isfinite(out).all())})
   306	            continue
   307	        if not os.path.exists(path):
   308	            raise FileNotFoundError(f'reference output missing: {path} '
   309	                                    '(run the arm-A reference step first)')
   310	        if manifest_id is not None:
   311	            provenance.check_artifact(path, manifest_id)
   312	        ref = torch.load(path, map_location='cuda', weights_only=True)
   313	        rec = compare_outputs(out, ref, tier)
   314	        rec['seed'] = seed
   315	        # persisted, checked reference identity (gate-04 f47): the hash the
   316	        # lineage check saw, so collectors can join restarts on it
   317	        rec['ref_sha256'] = provenance.sha256_file(path) if manifest_id is not None else None
   318	        passes.append(rec)
   319	        del ref
   320	    if save_reference:
   321	        return {'status': 'REFERENCE_SAVED', 'tier': tier, 'passes': passes}
   322	    ok = all(p['ok'] for p in passes)
   323	    return {'status': 'PASS' if ok else 'FAIL', 'tier': tier,
   324	            'rtol': TIERS[tier][0], 'atol': TIERS[tier][1], 'passes': passes}
