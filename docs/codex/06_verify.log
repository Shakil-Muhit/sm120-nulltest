    67	def perturbation(evidence, iters=50):
    68	    out = {}
    69	    for path in glob.glob(os.path.join(evidence, 'full_*_pert_unprofiled.json')):
    70	        base = j(path)
    71	        arm, chunk = base['arm'], base['chunk']
    72	        rec = {'unprofiled_block_ms': block_median(base), 'status': 'ok', 'problems': []}
    73	        q = _qualified(base, iters)
    74	        if q:
    75	            rec['problems'].append(f'unprofiled: {q}')
    76	        for mode in ('graph', 'node'):
    77	            p = os.path.join(evidence, f'full_{arm}_c{chunk}_pert_{mode}.json')
    78	            r = j(p) if os.path.exists(p) else None
    79	            q = _qualified(r, iters)
    80	            rec[f'{mode}_block_ms'] = block_median(r) if r else None
    81	            rec[f'{mode}_over_unprofiled'] = None
    82	            if q:
    83	                rec['problems'].append(f'{mode}: {q}')
    84	                continue
    85	            if r.get('manifest_id') != base.get('manifest_id') or r.get('effective_variant') != base.get('effective_variant'):
    86	                rec['problems'].append(f'{mode}: manifest/variant differs from the unprofiled run')
    87	                continue
    88	            m = block_median(r)
    89	            rec[f'{mode}_over_unprofiled'] = m / rec['unprofiled_block_ms'] if (m and rec['unprofiled_block_ms']) else None
    90	        if rec['problems'] or rec.get('node_over_unprofiled') is None or rec.get('graph_over_unprofiled') is None:
    91	            # every prerequisite failure clears ALL derived ratios (gate-04 f55)
    92	            rec['status'] = 'UNRESOLVED'
    93	            rec['caveat_required'] = 'UNRESOLVED'
    94	            rec['graph_over_unprofiled'] = None
    95	            rec['node_over_unprofiled'] = None
    96	            rec['inflation_factor_node'] = None
    97	        else:
    98	            rec['caveat_required'] = rec['node_over_unprofiled'] > 1.05
    99	            rec['inflation_factor_node'] = rec['node_over_unprofiled']
   100	        out[f'{arm}_{chunk}'] = rec
   101	    return out
