   177	    echo "--- $name $(date -Is) cap=${cap}s ---" >&2
   178	    timeout -k 30 "$cap" "$@"; local rc=$?
   179	    if [ "$rc" = "0" ]; then aux_json "$name" OK ""; else
   180	        echo "    $name exit $rc" >&2
   181	        aux_json "$name" $([ "$rc" = "124" ] && echo UNTESTED || echo FAILED) "exit $rc"
   182	    fi
