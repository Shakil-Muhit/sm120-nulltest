    43	def col(head, *names, contains=None):
    44	    for name in names:
    45	        for i, h in enumerate(head):
    46	            if h.strip().strip('"') == name:
    47	                return i
    48	    if contains:
    49	        for i, h in enumerate(head):
    50	            if contains in h:
    51	                return i
    52	    return None
