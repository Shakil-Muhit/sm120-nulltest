    55	def pass_windows(nvtx_csv):
    56	    head, rows = read_csv(nvtx_csv)
    57	    c_name = col(head, 'Name', 'Range', contains='Name')
    58	    c_ps, c_pd = col(head, 'Projected Start (ns)', contains='Projected Start'), col(head, 'Projected Duration (ns)', contains='Projected Duration')
    59	    c_os, c_od = col(head, 'Orig Start (ns)', contains='Orig Start'), col(head, 'Orig Duration (ns)', contains='Orig Duration')
    60	    if c_ps is None:
    61	        c_ps, c_pd = col(head, contains='Start'), col(head, contains='Duration')
    62	    wins = {}
    63	    for r in rows:
    64	        m = re.fullmatch(r'pass_(\d+)', r[c_name].strip().strip('"').split(':')[-1])
    65	        if not m:
    66	            continue
    67	        if int(m.group(1)) in wins:
    68	            raise SystemExit(f'duplicate NVTX pass id {m.group(1)}')
    69	        try:
    70	            gs, gd = int(float(r[c_ps].replace(',', ''))), int(float(r[c_pd].replace(',', '')))
    71	            if c_os is not None:
    72	                cs, cd = int(float(r[c_os].replace(',', ''))), int(float(r[c_od].replace(',', '')))
    73	            else:
    74	                cs, cd = gs, gd
    75	        except ValueError:
    76	            continue
    77	        wins[int(m.group(1))] = {'gpu': (gs, gs + gd), 'cpu': (cs, cs + cd)}
    78	    ids = sorted(wins)
    79	    if ids != list(range(len(ids))):
    80	        raise SystemExit(f'NVTX pass ids are not contiguous from 0: {ids[:5]}...')
    81	    return [wins[i] for i in ids]
