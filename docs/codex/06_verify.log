   240	def compare_outputs(out, ref, tier):
   241	    rtol, atol = TIERS[tier]
   242	    out = out.float()
   243	    ref = ref.float()
   244	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   245	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   246	    if out.shape != ref.shape:
   247	        rec['reason'] = 'shape mismatch'
   248	        rec['max_abs_diff'] = None
   249	        return rec
   250	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   251	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   252	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   253	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   254	    if not (fin_out and fin_ref):
   255	        rec['reason'] = 'non-finite values present'
   256	        return rec
   257	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   258	    if not rec['ok']:
   259	        rec['reason'] = 'tolerance exceeded'
   260	    return rec
