   170	run_aux() {
   171	    local name="$1" want="$2"; shift 2; [ "$1" = "--" ] && shift
   172	    local cap; cap=$(cap_for "$want")
   173	    if [ "$cap" -lt 60 ]; then
   174	        echo "--- $name: DEADLINE -> skipped (UNTESTED) ---" >&2
   175	        aux_json "$name" UNTESTED "session deadline"; return 1
