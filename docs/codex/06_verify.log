    84	def main():
    85	    ap = argparse.ArgumentParser()
    86	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
    87	    ap.add_argument('--out', required=True)
    88	    ap.add_argument('--arm', default='')
    89	    ap.add_argument('--expected-passes', type=int, default=None)
    90	    args = ap.parse_args()
    91	    wins = pass_windows(args.base + '_nvtx_gpu_proj_trace.csv')
    92	    assert wins, 'no pass_<i> NVTX windows in the projection export'
    93	
    94	    head, rows = read_csv(args.base + '_cuda_api_trace.csv')
    95	    c_start, c_name = col(head, 'Start (ns)', contains='Start'), col(head, 'Name')
    96	    c_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
    97	    api = []
    98	    for r in rows:
    99	        try:
   100	            api.append({'start': int(float(r[c_start].replace(',', ''))), 'name': r[c_name],
   101	                        'corr': r[c_corr].strip() if c_corr is not None else ''})
   102	        except (ValueError, IndexError):
   103	            continue
   104	    graph_corrs = {a['corr'] for a in api if 'GraphLaunch' in a['name'] and a['corr']}
   105	    launch_corrs = {a['corr'] for a in api if 'LaunchKernel' in a['name'] and a['corr']}
   106	
   107	    head, rows = read_csv(args.base + '_cuda_gpu_trace.csv')
   108	    g_start, g_name = col(head, 'Start (ns)', contains='Start'), col(head, 'Name')
   109	    g_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
   110	    kern = []
   111	    for r in rows:
   112	        try:
   113	            kern.append({'start': int(float(r[g_start].replace(',', ''))), 'name': r[g_name],
   114	                         'corr': r[g_corr].strip() if g_corr is not None else ''})
   115	        except (ValueError, IndexError):
   116	            continue
   117	
   118	    per_pass = []
   119	    for w in wins:
   120	        cs, ce = w['cpu']
   121	        gs, ge = w['gpu']
   122	        a_in = [a for a in api if cs <= a['start'] < ce]
   123	        k_in = [k for k in kern if gs <= k['start'] < ge]
   124	        graph_launches = [a for a in a_in if 'GraphLaunch' in a['name']]
   125	        eager_launch = sum(1 for a in a_in if 'LaunchKernel' in a['name'])
   126	        memcpy_api = sum(1 for a in a_in if 'Memcpy' in a['name'] or 'Memset' in a['name'])
   127	        # nsys lists memcpy/memset operations as GPU-trace rows ('[CUDA memcpy ...]',
   128	        # '[CUDA memset]'); they correlate to cudaMemcpyAsync/cudaMemsetAsync, are
   129	        # not kernels, and are reported in their own category (never 'unresolved')
   130	        memops = [k for k in k_in if k['name'].startswith('[CUDA mem')]
   131	        kernels_only = [k for k in k_in if not k['name'].startswith('[CUDA mem')]
   132	        memops_in_graph = [k for k in memops if k['corr'] in graph_corrs]
   133	        captured = [k for k in kernels_only if k['corr'] in graph_corrs]
   134	        eager = [k for k in kernels_only if k['corr'] in launch_corrs and k['corr'] not in graph_corrs]
   135	        unresolved = [k for k in kernels_only if k['corr'] not in graph_corrs and k['corr'] not in launch_corrs]
   136	        staging = [k for k in eager if is_staging(k['name'])]
   137	        uncaptured = [k for k in eager if k not in staging]
   138	        per_pass.append({'graph_launch_calls': len(graph_launches),
   139	                         'graph_launch_instances': len({a['corr'] for a in graph_launches}),
   140	                         'eager_kernel_launch_calls': eager_launch,
   141	                         'memcpy_memset_api_calls': memcpy_api,
   142	                         'kernels_total': len(kernels_only),
   143	                         'memops_total': len(memops),
   144	                         'memops_inside_replay': len(memops_in_graph),
   145	                         'memops_eager': len(memops) - len(memops_in_graph),
   146	                         'memop_names': sorted({k['name'] for k in memops}),
   147	                         'captured_model_kernels': len(captured),
   148	                         'input_staging_kernels': len(staging),
   149	                         'uncaptured_model_kernels': len(uncaptured),
   150	                         'unresolved_kernels': len(unresolved),
   151	                         'uncaptured_names': sorted({k['name'][:90] for k in uncaptured}),
   152	                         'unresolved_names': sorted({k['name'][:90] for k in unresolved})})
   153	    keys = ('graph_launch_calls', 'graph_launch_instances', 'eager_kernel_launch_calls',
   154	            'memcpy_memset_api_calls', 'kernels_total', 'memops_total', 'memops_inside_replay',
   155	            'memops_eager', 'captured_model_kernels', 'input_staging_kernels',
   156	            'uncaptured_model_kernels', 'unresolved_kernels')
   157	    summary = {'arm': args.arm, 'passes': len(per_pass), 'expected_passes': args.expected_passes,
   158	               'method': 'CorrId correlation: kernel captured iff its CorrId belongs to a '
   159	                         'cudaGraphLaunch/cuGraphLaunch API call; CPU NVTX windows for API rows, '
   160	                         'GPU-projected windows for kernels',
   161	               'median': {k: statistics.median(p[k] for p in per_pass) for k in keys},
   162	               'max_uncaptured_in_any_pass': max(p['uncaptured_model_kernels'] for p in per_pass),
   163	               'max_unresolved_in_any_pass': max(p['unresolved_kernels'] for p in per_pass),
   164	               'min_graph_launches_in_any_pass': min(p['graph_launch_calls'] for p in per_pass),
   165	               'uncaptured_names_union': sorted({n for p in per_pass for n in p['uncaptured_names']}),
   166	               'unresolved_names_union': sorted({n for p in per_pass for n in p['unresolved_names']}),
   167	               'per_pass': per_pass}
   168	    # affirmative qualification required (gate-04 f49): the registered pass
   169	    # count must be given and met, and the node-level export record must
   170	    # state completeness; anything less is UNRESOLVED, never FULLY_GRAPHED
   171	    # the registered protocol is 50 passes (gate-05 f70): a different expected
   172	    # count is a shakedown and can never yield a registered verdict
   173	    registered = args.expected_passes == REGISTERED_PASSES
   174	    complete = registered and len(per_pass) == args.expected_passes
   175	    exports = args.base + '_exports.json'
   176	    exports_ok = False
   177	    if os.path.exists(exports):
   178	        try:
   179	            ex = json.load(open(exports))
   180	            exports_ok = ex.get('complete') is True and ex.get('graph_trace_mode') == 'node'
   181	        except Exception:
   182	            exports_ok = False
   183	    summary['pass_count_complete'] = complete
   184	    summary['exports_complete'] = exports_ok
   185	    summary['registered_protocol'] = registered
   186	    summary['qualified'] = bool(complete and exports_ok)
   187	    summary['min_captured_in_any_pass'] = min(p['captured_model_kernels'] for p in per_pass)
   188	    summary['fully_graphed'] = bool(summary['qualified']
   189	                                    and summary['min_graph_launches_in_any_pass'] >= 1
   190	                                    and summary['min_captured_in_any_pass'] > 0
   191	                                    and summary['max_uncaptured_in_any_pass'] == 0
   192	                                    and summary['max_unresolved_in_any_pass'] == 0)
   193	    summary['note'] = ('graph_launch_instances counts launch API instances by CorrId, not '
   194	                       'distinct graph identities (not exported by nsys)')
   195	    summary['eager_memop_names_union'] = sorted({n for p in per_pass for n in p['memop_names']})
   196	    summary['verdict'] = ('UNREGISTERED_PROTOCOL' if not registered else
   197	                          'UNRESOLVED' if not summary['qualified'] else
   198	                          'FULLY_GRAPHED' if summary['fully_graphed'] else
   199	                          'NOT_FULLY_GRAPHED' if summary['min_graph_launches_in_any_pass'] >= 1 else
   200	                          'NO_REPLAY_EVIDENCE')
   201	    with open(args.out, 'w') as f:
   202	        json.dump(summary, f, indent=1)
   203	    m = summary['median']
   204	    print(f"[graph_verify] {args.arm}: {summary['verdict']} | graph launches/pass {m['graph_launch_calls']} "
   205	          f"(launch instances {m['graph_launch_instances']}) | captured {m['captured_model_kernels']} staging "
   206	          f"{m['input_staging_kernels']} uncaptured {m['uncaptured_model_kernels']} unresolved "
   207	          f"{m['unresolved_kernels']} (max uncaptured {summary['max_uncaptured_in_any_pass']})")
