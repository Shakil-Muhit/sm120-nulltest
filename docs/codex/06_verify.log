    99	def _mean_with_inf(values):
   100	    finite = [v for v in values if isinstance(v, float)]
   101	    n_inf = sum(1 for v in values if v == 'inf')
   102	    n_undef = sum(1 for v in values if v == 'undefined')
   103	    return {'mean_finite_db': float(np.mean(finite)) if finite else None,
   104	            'n_finite': len(finite), 'n_inf': n_inf, 'n_undefined': n_undef}
