   186	def timed_run(step, x, ctx, iters=50, nvtx_pass=False):
   187	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   188	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   189	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   190	    pass windows for the exports; never inside compiled code)."""
   191	    with torch.no_grad(), ctx():
   192	        torch.cuda.synchronize()
   193	        torch.cuda.profiler.start()
   194	        latency_ms = []
   195	        for i in range(iters):
   196	            if nvtx_pass:
   197	                torch.cuda.nvtx.range_push(f'pass_{i}')
   198	            t0 = time.perf_counter()
   199	            step(x)
   200	            torch.cuda.synchronize()
   201	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   202	            if nvtx_pass:
   203	                torch.cuda.nvtx.range_pop()
   204	        torch.cuda.profiler.stop()
   205	
   206	        torch.cuda.synchronize()
   207	        t0 = time.perf_counter()
   208	        for _ in range(iters):
   209	            step(x)
   210	        torch.cuda.synchronize()
   211	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   212	    return latency_ms, throughput_ms
