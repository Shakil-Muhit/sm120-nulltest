   164	                pass                      # LAST comment before this assignment
   165	            k = {'inner_name': inner, 'inner_mismatch': inner != lhs}
   166	            if cm:
   167	                k['ops'] = [o.strip() for o in cm.group(1).split(',') if o.strip()]
   168	                k['ops_source'] = 'aten_comment'
   169	            else:
   170	                raw = ops_from_name(lhs)
   171	                k['ops'] = []
   172	                k['ops_source'] = 'name' if raw else 'unknown'
   173	                k['ops_raw_name'] = raw
   174	            body = src[am.end():hi]       # this kernel's own source slice
   175	            pm = re.search(r'def\s+' + re.escape(inner) + r'\s*\(([^)]*)\)', body)
   176	            params, numeric = [], []
   177	            if pm:
   178	                for tok in pm.group(1).split(','):
   179	                    name_only = tok.split(':')[0].split('=')[0].strip()
   180	                    if not name_only:
   181	                        continue
   182	                    if name_only.startswith(('in_ptr', 'out_ptr', 'in_out_ptr')):
   183	                        params.append(name_only)
   184	                    elif 'constexpr' in tok:
   185	                        continue
   186	                    else:
   187	                        numeric.append(name_only)      # xnumel / rnumel / ks* ...
   188	            k['params'] = params
   189	            k['numeric_params'] = numeric
   190	            k['load_exprs'] = {}
   191	            k['store_exprs'] = {}
   192	            k['loads_present'] = []
   193	            k['stores_present'] = []
   194	            k['load_sites'] = {}
   195	            k['store_sites'] = {}
   196	            for p in params:
   197	                nl = len(re.findall(r'tl\.load\(\s*' + re.escape(p) + r'\b', body))
   198	                ns = len(re.findall(r'tl\.store\(\s*' + re.escape(p) + r'\b', body))
   199	                k['load_sites'][p] = nl
   200	                k['store_sites'][p] = ns
   201	                if nl:
   202	                    k['loads_present'].append(p)
   203	                if ns:
   204	                    k['stores_present'].append(p)
   205	                lm = re.search(r'tl\.load\(' + re.escape(p) + r'\s*\+\s*\(([^)]*)\)', body)
   206	                sm2 = re.search(r'tl\.store\(' + re.escape(p) + r'\s*\+\s*\(([^)]*)\)', body)
   207	                if lm:
   208	                    k['load_exprs'][p] = _canon_expr(lm.group(1))
   209	                if sm2:
   210	                    k['store_exprs'][p] = _canon_expr(sm2.group(1))
   211	            if lhs in source_literals:
   212	                k.update(access_expressions(source_literals[lhs], params))
   213	            # pointer element types from the kernel's own triton_meta signature
   214	            # (authoritative: the compiled kernel's ABI), e.g. 'in_ptr0': '*fp16'
   215	            sg = SIGNATURE_RE.search(body)
   216	            k['ptr_dtypes'] = dict(SIG_ITEM_RE.findall(sg.group(1))) if sg else {}
   217	            src_text = source_literals.get(lhs) or body
   218	            k['source_sha256'] = hashlib.sha256(src_text.encode()).hexdigest()
   219	            kernels[lhs] = k
   220	        # graph-input dtypes from the benchmark section (rand_strided(...))
   221	        input_dtypes = {m.group(1): m.group(4) for m in RAND_STRIDED_RE.finditer(src)}
   222	
   223	        try:
   224	            body = src.split('def call(')[1]
   225	        except IndexError:
   226	            continue
   227	        allocs, aliases, calls = {}, {}, []
   228	        body_start = src[:src.index('def call(')].count('\n') + 1
   229	        for body_line, line in enumerate(body.splitlines(), body_start):
   230	            am = ALLOC_RE.match(line)
   231	            if am:
   232	                allocs[am.group(1)] = {'shape': _ints(am.group(2)),
   233	                                       'stride': _ints(am.group(3)),
   234	                                       'dtype': am.group(4)}
   235	                continue
   236	            xm = ALIAS_RE.match(line)
   237	            if xm:
   238	                aliases[xm.group(1)] = {'base': xm.group(2),
   239	                                        'shape': _ints(xm.group(3)),
   240	                                        'stride': _ints(xm.group(4))}
   241	                continue
   242	            rm = RENAME_RE.match(line)
   243	            if rm and rm.group(1) != rm.group(2):
   244	                aliases[rm.group(1)] = {'base': rm.group(2)}   # plain reuse
   245	                continue
   246	            gm = GETITEM_RE.match(line)
   247	            if gm:
   248	                aliases[gm.group(1)] = {'base': gm.group(2),
   249	                                        'item': int(gm.group(3))}
   250	                continue
   251	            sm = ASSERT_RE.match(line)
   252	            if sm:
   253	                allocs.setdefault(sm.group(1), {'shape': _ints(sm.group(2)),
   254	                                                'stride': _ints(sm.group(3)),
   255	                                                'dtype': input_dtypes.get(sm.group(1))})
   256	                continue
   257	            tm = TRITON_CALL_RE.match(line)
   258	            em = EXTERN_CALL_RE.match(line)
   259	            fm = FALLBACK_RE.match(line)
   260	            if not (tm or em or fm):
   261	                continue
   262	            if tm:
   263	                kind, name, argstr, assigned = 'triton', tm.group(1), tm.group(2), None
   264	            elif em:
   265	                kind, name, argstr, assigned = ('extern', f'extern.{em.group(2)}',
   266	                                                em.group(3), em.group(1))
   267	            else:
   268	                kind, name, argstr, assigned = ('fallback', f'{fm.group(2)}.{fm.group(3)}',
   269	                                                fm.group(4), fm.group(1))
   270	            out_kw = re.search(r'\bout\s*=', argstr)
   271	            args = []
   272	            for mt in ARG_TOKEN_RE.finditer(argstr):
   273	                if mt.group(1):
   274	                    a = {'buf': mt.group(1), 'shape': _ints(mt.group(2)),
   275	                         'stride': _ints(mt.group(3)), 'reinterpret': True}
   276	                else:
   277	                    a = {'buf': mt.group(4), 'shape': None, 'stride': None,
   278	                         'reinterpret': False}
   279	                a['in_out_kw'] = bool(out_kw and mt.start() > out_kw.start())
   280	                args.append(a)
   281	            if kind == 'triton':
   282	                params = kernels.get(name, {}).get('params', [])
   283	                align_ok = len(params) == len(args)
   284	                # positional literals after the pointer arguments, bound later to
   285	                # the kernel's numeric params (gate-04 f52); keyword args excluded
   286	                inner = argstr
   287	                depth, pos_args, cur = 0, [], ''
   288	                for ch in inner:
   289	                    if ch in '([':
   290	                        depth += 1
   291	                    elif ch in ')]':
   292	                        depth -= 1
   293	                    if ch == ',' and depth == 0:
   294	                        pos_args.append(cur.strip())
   295	                        cur = ''
   296	                    else:
   297	                        cur += ch
   298	                if cur.strip():
   299	                    pos_args.append(cur.strip())
   300	                pos_args = [x for x in pos_args if '=' not in x.split('(')[0]]
   301	                numeric_literals = pos_args[len(args):]
   302	                for i, a in enumerate(args):
   303	                    role = params[i] if i < len(params) else ''
   304	                    a['read'] = role.startswith(('in_ptr', 'in_out_ptr'))
   305	                    a['write'] = role.startswith(('out_ptr', 'in_out_ptr'))
   306	                    a['role'] = role or 'unaligned'
   307	                    a['read'], a['write'], a['access_unresolved'] = refined_access(
   308	                        kernels.get(name, {}), a['role'])
   309	                calls.append({'kind': kind, 'name': name, 'args': args,
   310	                              'align_ok': align_ok, 'assigned': None,
   311	                              'numeric_literals': numeric_literals,
   312	                              'line': line.strip()})
   313	            elif kind == 'extern':
   314	                for a in args:
   315	                    a['write'] = a['in_out_kw']
   316	                    a['read'] = not a['in_out_kw']
   317	                    a['role'] = 'out' if a['write'] else 'in'
   318	                calls.append({'kind': kind, 'name': name, 'args': args,
   319	                              'align_ok': True, 'assigned': assigned,
   320	                              'line': line.strip()})
   321	            else:
   322	                for a in args:
   323	                    a['read'], a['write'], a['role'] = True, False, 'in'
   324	                calls.append({'kind': kind, 'name': name, 'args': args,
   325	                              'align_ok': True, 'assigned': assigned,
   326	                              'line': line.strip()})
   327	            calls[-1]['source_line'] = body_line
   328	        graphs.append({'path': path, 'calls': calls, 'allocs': allocs,
   329	                       'aliases': aliases, 'kernels': kernels})
   330	    return graphs
