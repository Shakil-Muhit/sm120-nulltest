   153	def sdr_recomputed(gate):
   154	    """Recompute the SDR gate from its rows: exactly eight distinct clips,
   155	    every delta finite, mean vs the registered threshold."""
   156	    rows = (gate or {}).get('clips') or []
   157	    idx = sorted(r.get('index') for r in rows)
   158	    if len(rows) != SDR_CLIPS or len(set(idx)) != SDR_CLIPS:
   159	        return None, f'{len(rows)} clip rows ({len(set(idx))} distinct); registered {SDR_CLIPS}'
   160	    deltas = [r.get('delta_sdr_ref_db') for r in rows]
   161	    if not all(_finite(d) for d in deltas):
   162	        return None, 'a clip delta is missing or non-finite'
   163	    if not all(r.get('a_output_sha256') for r in rows):
   164	        return None, 'eager-A clip outputs not lineage-hashed'
   165	    mean = sum(deltas) / len(deltas)
   166	    status = 'PASS' if mean >= SDR_THRESHOLD_DB else 'FAIL'
   167	    if gate.get('mean_delta_sdr_ref_db') is None or not _close(gate['mean_delta_sdr_ref_db'], mean, 1e-9, 1e-9):
   168	        return None, 'stored mean delta differs from the recomputed one'
   169	    if gate.get('status') != status:
   170	        return None, f"stored SDR status {gate.get('status')} differs from the recomputed {status}"
   171	    return status, None
