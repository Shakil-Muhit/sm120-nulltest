   104	def access_expressions(source, params):
   105	    """Parse complete pointer expressions, including multiple accesses.
   106	    A regex ending at the first ')' loses nested arithmetic and later loads.
   107	    """
   108	    exprs = {'load': {}, 'store': {}}
   109	    present = {'load': set(), 'store': set()}
   110	    for node in ast.walk(ast.parse(source)):
   111	        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Attribute):
   112	            continue
   113	        op = node.func.attr
   114	        if op not in exprs or not node.args:
   115	            continue
   116	        pointer = node.args[0]
   117	        names = {n.id for n in ast.walk(pointer) if isinstance(n, ast.Name)}
   118	        for p in set(params) & names:
   119	            present[op].add(p)
   120	            offset = None
   121	            if isinstance(pointer, ast.Name) and pointer.id == p:
   122	                offset = '0'
   123	            elif isinstance(pointer, ast.BinOp) and isinstance(pointer.op, ast.Add):
   124	                if isinstance(pointer.left, ast.Name) and pointer.left.id == p:
   125	                    offset = _canon_expr(ast.unparse(pointer.right))
   126	            exprs[op].setdefault(p, set()).add(offset)
   127	    result = {}
   128	    for op in exprs:
   129	        result[op + '_exprs'] = {p: next(iter(values)) for p, values in exprs[op].items()
   130	                                if len(values) == 1 and None not in values}
   131	        result[op + 's_present'] = sorted(present[op])
   132	    return result
