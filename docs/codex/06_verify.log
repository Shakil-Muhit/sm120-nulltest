   315	def recomputed_matched_delta(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   316	    """Matched delta (a - b per block, median, % of a) recomputed from samples."""
   317	    a, b = m.get('pair') or (None, None)
