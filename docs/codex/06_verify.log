   514	def read_gpu_trace(path):
   515	    with open(path, newline='') as f:
   516	        rd = csv.reader(f)
   517	        head = next(rd)
   518	        def col(*names):
   519	            for name in names:
   520	                for i, h in enumerate(head):
   521	                    if h.strip().strip('"') == name:
   522	                        return i
   523	            return next(i for i, h in enumerate(head)
   524	                        if names[0].split(' ')[0] in h)
   525	        c_start = col('Start (ns)', 'Start(ns)', 'Start')
   526	        c_dur = col('Duration (ns)', 'Duration(ns)', 'Duration')
   527	        c_name = col('Name')
   528	        rows = []
   529	        for r in rd:
   530	            if len(r) <= max(c_start, c_dur, c_name) or not r[c_dur].strip():
   531	                continue
   532	            try:
   533	                rows.append({'start': int(float(r[c_start].replace(',', ''))),
   534	                             'dur': int(float(r[c_dur].replace(',', ''))),
   535	                             'name': r[c_name]})
   536	            except ValueError:
   537	                continue
   538	    rows.sort(key=lambda x: x['start'])
   539	    return rows
