   209	    else:
   210	        return None
   211	    if K != K2:
   212	        return None
   213	    by = sum(nbytes(m['shape'], m['dtype']) for m in mats) + sum(nbytes(m['shape'], m['dtype']) for m in writes)
   214	    return {'M': M, 'N': N, 'K': K, 'batch': batch, 'dtype': a['dtype'],
   215	            'flops': 2.0 * batch * M * N * K, 'bytes': by}
