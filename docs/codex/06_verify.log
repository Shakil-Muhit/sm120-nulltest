   333	# ------------------------------------------------------------- resolution ---
   334	
   335	def resolve(gr, buf):
   336	    """Follow alias chain to the base buffer; return (base, view_meta|None)."""
   337	    meta = None
   338	    seen = set()
   339	    while buf in gr['aliases'] and buf not in seen:
   340	        seen.add(buf)
   341	        a = gr['aliases'][buf]
   342	        if meta is None and 'shape' in a:
   343	            meta = {'shape': a['shape'], 'stride': a['stride']}
   344	        buf = a['base']
   345	    return buf, meta
   346	
   347	
   348	def arg_meta(gr, a):
   349	    """Effective (shape, stride, dtype, base) the kernel sees for arg a.
   350	    Shape precedence: reinterpret literal > alias view meta > an
   351	    assert_size_stride/alloc on the arg's OWN name (fallback outputs and
   352	    getitem results are asserted by name) > the base allocation."""
   353	    base, alias_meta = resolve(gr, a['buf'])
   354	    alloc = gr['allocs'].get(base, {})
   355	    own = gr['allocs'].get(a['buf'], {})
   356	    if a.get('reinterpret') and a.get('shape'):
   357	        shape, stride = a['shape'], a['stride']
   358	    elif alias_meta:
   359	        shape, stride = alias_meta['shape'], alias_meta['stride']
   360	    elif own.get('shape'):
   361	        shape, stride = own['shape'], own.get('stride', ())
   362	    else:
   363	        shape, stride = alloc.get('shape', ()), alloc.get('stride', ())
   364	    return {'shape': shape or (), 'stride': stride or (),
   365	            'dtype': alloc.get('dtype') or own.get('dtype'), 'base': base}
   366	
   367	
   368	def refined_access(k, role):
   369	    """(reads, writes, unresolved) for a param role, derived from the kernel
   370	    SOURCE (gate-04 f32): in_out_ptr reads iff a tl.load on it exists and
   371	    writes iff a tl.store exists; neither found -> unresolved (charged
   372	    conservatively as read+write, and the site is flagged)."""
   373	    if role.startswith('in_out_ptr'):
   374	        r = role in k.get('loads_present', k.get('load_exprs', {}))
   375	        w = role in k.get('stores_present', k.get('store_exprs', {}))
   376	        return (r, w, not (r or w))
   377	    if role.startswith('in_ptr'):
   378	        return (True, False, role not in k.get('loads_present', k.get('load_exprs', {})))
   379	    if role.startswith('out_ptr'):
   380	        return (False, True, role not in k.get('stores_present', k.get('store_exprs', {})))
   381	    return (False, False, True)
   382	
   383	
   384	def read_permuted_state(k, role, meta):
   385	    """Tri-state permuted classification for one READING param (gate-04 f32):
   386	    'yes'  — view meta is permuted, or the load index expr differs from the
   387	             kernel's single store expr;
   388	    'no'   — load expr equals the single store expr;
   389	    'unresolved' — load expr missing, or zero / multiple distinct store exprs
   390	             (an unrelated output with the same expr could hide a permuted
   391	             read feeding another output)."""
   392	    stores = set(k.get('store_exprs', {}).values())
   393	    le = k.get('load_exprs', {}).get(role)
   394	    expected_stores = set(k.get('stores_present', k.get('store_exprs', {})))
   395	    if le is None or expected_stores != set(k.get('store_exprs', {})):
   396	        return 'unresolved'
   397	    if is_permuted(meta['shape'], meta['stride']):
   398	        return 'yes'
   399	    if len(stores) == 1:
   400	        return 'yes' if le not in stores else 'no'
   401	    return 'unresolved'
   402	
   403	
   404	def is_permuted(shape, stride):
   405	    """Permuted = the stride ORDER differs from row-major: fastest dim not
   406	    unit-stride OR strides (over size>1 dims) not non-increasing."""
   407	    if not shape or len(stride) != len(shape):
   408	        return False
   409	    nt = [(s, x) for s, x in zip(shape, stride) if s > 1]
   410	    if not nt:
   411	        return False
   412	    if nt[-1][1] != 1:
   413	        return True
   414	    return any(nt[i][1] < nt[i + 1][1] for i in range(len(nt) - 1))
   415	
   416	
   417	def accessed_elems(shape, stride):
   418	    """Distinct elements a strided view can touch: broadcast dims (stride 0)
   419	    contribute 1, overlapping windows (unfold-style strides) are bounded by
   420	    the address extent 1 + sum((size-1)*|stride|); never more than numel."""
   421	    if not shape:
   422	        return 0
   423	    numel = 1
   424	    for d in shape:
   425	        numel *= int(d)
   426	    if not stride or len(stride) != len(shape):
   427	        return numel
   428	    nz = 1
   429	    extent = 1
   430	    for d, st in zip(shape, stride):
   431	        d, st = int(d), abs(int(st))
   432	        if d == 0:
   433	            return 0
   434	        if st != 0:
   435	            nz *= d
   436	            extent += (d - 1) * st
   437	    return min(numel, nz, extent)
   438	
   439	
   440	def nbytes(shape, dtype):
   441	    n = 1
   442	    for s in shape or ():
   443	        n *= s
   444	    return n * DTYPE_BYTES.get(dtype or 'torch.float16', 2)
