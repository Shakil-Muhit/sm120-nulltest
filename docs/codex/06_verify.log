   119	def source_map(evidence, iters):
   120	    out = {}
   121	    for path in glob.glob(os.path.join(evidence, 'traces', 'ideal_costs_*_*.json')):
   122	        ic = j(path)
   123	        arm, chunk = ic['arm'], ic['chunk']
   124	        sel = ic.get('variant_selection') or {}
   125	        dump = os.path.join(evidence, 'traces', f'dump_{arm}_{chunk}_trace')
   126	        rec = {'variant_selection': sel.get('status'), 'kernels': {}, 'coverage': None}
   127	        if sel.get('status') == 'ok' and os.path.isdir(dump):
   128	            wanted = set(sel.get('selected') or [])
   129	            for g in parse_output_code(dump):
   130	                rel = os.path.relpath(g['path'], dump)
   131	                if rel not in wanted:
   132	                    continue
   133	                for name, k in g['kernels'].items():
   134	                    entry = {'fused_ops': k.get('ops') or [], 'ops_source': k.get('ops_source'),
   135	                             'source_file': rel, 'source_sha256': k.get('source_sha256')}
   136	                    prev = rec['kernels'].get(name)
   137	                    if prev is not None and prev.get('source_sha256') != entry['source_sha256']:
   138	                        # the same kernel name denotes different programs in two selected
   139	                        # graphs (gate-04 f50): the mapping is ambiguous, not overwritten
   140	                        rec['kernels'][name] = {'fused_ops': [], 'ops_source': 'AMBIGUOUS',
   141	                                                'source_file': f"{prev['source_file']};{rel}",
   142	                                                'source_sha256': None}
   143	                    elif prev is None:
   144	                        rec['kernels'][name] = entry
   145	            fused_rows = [r for r in ic['rows'] if r['class'] == 'INDUCTOR_FUSED']
   146	            tot = sum(r['time_us_per_pass'] for r in fused_rows)
   147	            def _mapped(r):
   148	                k = rec['kernels'].get(r.get('kernel_full') or r['kernel'])
   149	                return bool(k) and k.get('ops_source') != 'AMBIGUOUS' and bool(k.get('fused_ops'))
   150	            mapped = sum(r['time_us_per_pass'] for r in fused_rows if _mapped(r))
   151	            rec['coverage'] = {'fused_time_us_per_pass': tot, 'mapped_time_us_per_pass': mapped,
   152	                               'share': (mapped / tot) if tot else None}
   153	        out[f'{arm}_{chunk}'] = rec
   154	        csv_path = os.path.join(evidence, 'traces', f'kernel_source_map_{arm}_{chunk}.csv')
   155	        with open(csv_path, 'w', newline='') as f:
   156	            w = csv.writer(f)
   157	            w.writerow(['kernel', 'fused_ops', 'ops_source', 'source_file', 'source_sha256'])
   158	            for name, k in sorted(rec['kernels'].items()):
   159	                w.writerow([name, ';'.join(k['fused_ops']), k['ops_source'], k['source_file'], k.get('source_sha256')])
   160	    return out
   161	
   162	
   163	def main():
   164	    ap = argparse.ArgumentParser()
   165	    ap.add_argument('--evidence-dir', required=True)
   166	    ap.add_argument('--iters', type=int, default=50)
   167	    ap.add_argument('--out', required=True)
   168	    args = ap.parse_args()
   169	    res = {'perturbation': perturbation(args.evidence_dir, args.iters),
   170	           'boundary_perturbation': boundary_perturbation(args.evidence_dir),
   171	           'source_map': source_map(args.evidence_dir, args.iters)}
   172	    with open(args.out, 'w') as f:
   173	        json.dump(res, f, indent=1)
   174	    for k, v in res['perturbation'].items():
   175	        print(f"[perturbation] {k}: {v['status']} graph x{v.get('graph_over_unprofiled') or 0:.3f} node x"
   176	              f"{v.get('node_over_unprofiled') or 0:.3f} caveat={v['caveat_required']} {v['problems']}")
   177	    for k, v in res['source_map'].items():
   178	        cov = v.get('coverage') or {}
   179	        print(f"[source_map] {k}: variants={v['variant_selection']} coverage={cov.get('share')}")
   180	    print(f'-> {args.out}')
   181	
   182	
   183	if __name__ == '__main__':
   184	    main()

