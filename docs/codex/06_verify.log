   447	def merge_path(wrapper, pos, producer_before):
   448	    """Follow the SDPA output through gating to its projection, not just its
   449	    first consumer. Unknown ops/accesses keep the verdict unresolved.
   450	    Storage reuse is qualified by the reaching writer's position.

exec
/usr/bin/bash -lc "nl -ba fullmodel/attrib/kernel_map.py | sed -n '450,610p'; nl -ba fullmodel/sdr_gate.py | sed -n '95,250p'; nl -ba fullmodel/provenance.py | sed -n '1,245p'; rg --files --hidden evidence_smoke | tail -50" in /home/muhit/ms/sm120-nulltest
 succeeded in 0ms:
   450	    Storage reuse is qualified by the reaching writer's position.
   451	    """
   452	    start = wrapper[pos]
   453	    if not start.get('assigned'):
   454	        return 'unresolved', ['missing SDPA output']
   455	    live = {start['assigned']: pos}
   456	    path = []
   457	    for i in range(pos + 1, len(wrapper)):
   458	        c = wrapper[i]
   459	        if c['g'] != start['g'] or 'scaled_dot_product' in c['name']:
   460	            break
   461	        hits = []
   462	        for a in c['args']:
   463	            base, _ = resolve(c['gr'], a['buf'])
   464	            if (a.get('read') and base in live and
   465	                    producer_before(c['g'], base, i) == live[base]):
   466	                hits.append(a)
   467	        if not hits:
   468	            continue
   469	        path.append(c['name'])
   470	        if c['kind'] == 'extern' and c['name'] in ('extern.mm', 'extern.addmm', 'extern.bmm'):
   471	            return 'true', path
   472	        k = c['gr']['kernels'].get(c['name'], {})
   473	        ops = k.get('ops', [])
   474	        if any(o in ('aten.clone', 'aten.copy', 'aten.copy_', 'aten.contiguous') for o in ops):
   475	            return 'false', path
   476	        if c['kind'] != 'triton' or not ops or not c.get('align_ok', False):
   477	            return 'unresolved', path
   478	        # Gating is arithmetic, but it must not conceal a fused layout copy.
   479	        if any(o not in ('aten.mul', 'aten.sigmoid', 'aten._to_copy',
   480	                         'prims.convert_element_type') for o in ops):
   481	            return 'unresolved', path
   482	        for a in hits:
   483	            state = read_permuted_state(k, a.get('role', ''), arg_meta(c['gr'], a))
   484	            if state != 'no':
   485	                return ('false' if state == 'yes' else 'unresolved'), path
   486	        outputs = [a for a in c['args'] if a.get('write')]
   487	        if not outputs:
   488	            return 'unresolved', path
   489	        for a in outputs:
   490	            live[resolve(c['gr'], a['buf'])[0]] = i
   491	    return 'unresolved', path
