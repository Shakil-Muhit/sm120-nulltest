    96	
    97	def identity(paths, env):
    98	    """Every field the manifest binds; compared verbatim by load_manifest."""
    99	    return {'repo_commit': _git(_ROOT, 'rev-parse', 'HEAD'),
   100	            'registration_sha256': sha256_file(os.path.join(_ROOT, 'prereg_amendments.md')),
   101	            'clips_manifest_sha256': sha256_file(os.path.join(_ROOT, 'configs', 'sdr_clips.json')),
   102	            'code': code_hashes(), 'provenance': verify(paths),
   103	            'runtime': {k: env.get(k) for k in ('torch', 'triton', 'cuda_build', 'driver', 'gpu', 'gpu_uuid')}}
   104	
   105	
   106	def create_manifest(evidence_dir, paths, env, session):
   107	    if _git(_ROOT, 'status', '--porcelain'):
   108	        raise RuntimeError('session requires a committed, clean tree')
   109	    rec = {'manifest_id': str(uuid.uuid4()), 'session': session,
   110	           'created_utc': datetime.now(timezone.utc).isoformat(), 'env': env,
   111	           **identity(paths, env)}
   112	    path = os.path.join(evidence_dir, 'session_manifest.json')
   113	    if os.path.exists(path):
   114	        raise RuntimeError(f'{path} exists — one manifest per evidence directory')
   115	    with open(path, 'w') as f:
   116	        json.dump(rec, f, indent=1)
   117	    return rec
   118	
   119	
   120	def load_manifest(evidence_dir, paths, env):
   121	    """Re-derives the complete identity and compares EVERY field."""
   122	    path = os.path.join(evidence_dir, 'session_manifest.json')
   123	    if not os.path.exists(path):
   124	        raise RuntimeError('session_manifest.json missing — run the session preflight')
   125	    with open(path) as f:
   126	        rec = json.load(f)
   127	    if _git(_ROOT, 'status', '--porcelain'):
   128	        raise RuntimeError('tree is not clean; the session manifest binds a committed tree')
   129	    cur = identity(paths, env)
   130	    for key, val in cur.items():
   131	        if rec.get(key) != val:
   132	            raise RuntimeError(f'session manifest mismatch in {key}')
   133	    return rec
   134	
   135	
   136	def bind_artifact(path, manifest_id):
   137	    """Per-artifact lineage sidecar: <path>.lineage.json = {manifest_id, sha256}."""
   138	    with open(path + '.lineage.json', 'w') as f:
   139	        json.dump({'manifest_id': manifest_id, 'sha256': sha256_file(path)}, f)
   140	
   141	
   142	def check_artifact(path, manifest_id):
   143	    side = path + '.lineage.json'
   144	    if not os.path.exists(side):
   145	        raise RuntimeError(f'artifact without lineage: {path}')
   146	    with open(side) as f:
   147	        rec = json.load(f)
   148	    if manifest_id is not None and rec.get('manifest_id') != manifest_id:
   149	        raise RuntimeError(f'artifact belongs to another session manifest: {path}')
   150	    if rec.get('sha256') != sha256_file(path):
   151	        raise RuntimeError(f'artifact changed since it was bound: {path}')
