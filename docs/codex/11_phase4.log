   155	def drift_context(ev):
   156	    """Repeat-scoped clock-drift flags for the session-3 evidence (the audit's rule, shared with
   157	    every publisher: gate-10 f139). Returns (manifest_id, flags) where flags['pairs'] maps
   158	    (pair, chunk, tag) -> {repeat: message}."""
   159	    import completeness
   160	    man = _load(os.path.join(ev, 'session_manifest.json')) or {}
   161	    runs = completeness.load_runs(ev)
   162	    matched = completeness.load_matched(ev)
   163	    flags = completeness.drift_flags(ev, 'session3', runs, matched, (man.get('env') or {}).get('gpu_uuid'))
   164	    return man.get('manifest_id'), flags
