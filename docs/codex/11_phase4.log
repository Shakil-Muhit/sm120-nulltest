   343	def audit_clock(ev, items, session, runs, matched, gpu_uuid):
   344	    """This session's clock log (samples of THIS GPU, numeric fields, 1 Hz) must
   345	    cover every block of this session with bounded gaps (gate-07 f101)."""
   346	    clocks = os.path.join(ev, f'clocks_{session}.csv')
   347	    times, bad_lines, other_gpu = [], 0, 0
   348	    if os.path.exists(clocks):
   349	        for line in open(clocks):
   350	            parts = [x.strip() for x in line.split(',')]
   351	            if len(parts) != 7:
   352	                bad_lines += 1
   353	                continue
   354	            if gpu_uuid and parts[1] != gpu_uuid:
   355	                other_gpu += 1
   356	                continue
   357	            try:
   358	                for tok, unit in ((parts[2], 'MHz'), (parts[3], 'MHz'), (parts[4], 'W'), (parts[6], '%')):
   359	                    float(tok.replace(unit, '').strip())
   360	                int(parts[5])
   361	            except ValueError:
   362	                bad_lines += 1
   363	                continue
   364	            ts = None
   365	            for fmt in ('%Y/%m/%d %H:%M:%S.%f', '%Y/%m/%d %H:%M:%S'):
   366	                try:
   367	                    # the clock log carries the measuring host's local time; the pod runs UTC. CLOCK_TZ=local keeps
   368	                    # the old behaviour for logs written by a host in this machine's zone (ml-beast smokes)
   369	                    d = _dt.datetime.strptime(parts[0], fmt)
   370	                    ts = d.timestamp() if os.environ.get('CLOCK_TZ', 'utc') == 'local' else d.replace(tzinfo=_dt.timezone.utc).timestamp()
   371	                    break
   372	                except ValueError:
   373	                    continue
   374	            if ts is None:
   375	                bad_lines += 1
   376	            else:
   377	                times.append(ts)
   378	    times.sort()
   379	    blocks = session_blocks(session, runs, matched)
   380	    if not times:
   381	        item(items, f'clock log covers every timing block of this session ({len(blocks)} blocks)', False,
   382	             ['clock log missing, unparsable, or without samples of this GPU'])
   383	        return
   384	    nonfinite = [n for a, b, n in blocks if not (fin(a) and fin(b) and b >= a)]
   385	    uncovered = []
   386	    for a, b, n in blocks:
   387	        if not (fin(a) and fin(b) and b >= a):
   388	            continue
   389	        i = bisect.bisect_left(times, a - 5)
   390	        j = bisect.bisect_right(times, b + 5)
   391	        seg = times[i:j]
   392	        if not seg or seg[0] > a + 5 or seg[-1] < b - 5 or any(seg[k + 1] - seg[k] > 5 for k in range(len(seg) - 1)):
   393	            uncovered.append(n)
   394	    ok = bool(blocks) and not nonfinite and not uncovered and bad_lines == 0
   395	    item(items, f'clock log covers every timing block of this session ({len(blocks)} blocks, gaps <= 5 s)', ok,
   396	         [f'uncovered {uncovered[:5]}, non-finite {nonfinite[:3]}, malformed lines {bad_lines}, blocks {len(blocks)}'])
   397	
