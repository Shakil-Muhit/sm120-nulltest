   437	                row['api_calls'] = len(calls)
   438	                row['graph_launches'] = sum(1 for c in calls if 'cudaGraphLaunch' in c[2])
   439	                row['memcpy_api_calls'] = sum(1 for c in calls if 'Memcpy' in c[2] or 'memcpy' in c[2])
   440	                row['sync_api_calls'] = sum(1 for c in calls if 'Synchronize' in c[2] or 'StreamWait' in c[2] or 'EventSynchronize' in c[2])
