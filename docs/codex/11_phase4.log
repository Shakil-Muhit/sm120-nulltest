   283	def bind_refs(ref_dir, manifest_id, write=False):
   284	    """Directory marker (kept for the session preflight); every reference
   285	    file additionally carries its own lineage sidecar (provenance.bind_artifact)."""
   286	    path = os.path.join(ref_dir, 'manifest_id.txt')
   287	    if write:
   288	        os.makedirs(ref_dir, exist_ok=True)
   289	        with open(path, 'w') as f:
   290	            f.write(manifest_id + '\n')
   291	        return
   292	    if manifest_id is None:
   293	        return
   294	    if not os.path.exists(path) or open(path).read().strip() != manifest_id:
   295	        raise RuntimeError('reference outputs are not bound to this session manifest')
   296	
   297	
   298	def validate(step, ctx, tier, chunk, ref_dir, save_reference=False, manifest_id=None):
   299	    """AUDIT-MAP[2] mechanics: two passes, different data (asserted), each
   300	    compared to the SAVED eager-A output for that (chunk, seed). With
   301	    save_reference=True (arm A reference step) the outputs are written
   302	    instead of compared."""
   303	    passes, prev_x = [], None
   304	    for seed in VAL_SEEDS:
   305	        x = make_input(chunk, seed)
   306	        if prev_x is not None:
   307	            assert not torch.equal(x, prev_x), \
   308	                'validation passes must use different input data'
   309	        prev_x = x
   310	        with torch.no_grad(), ctx():
   311	            out = step(x)
   312	            torch.cuda.synchronize()
   313	            out = out.clone()            # borrow discipline (build_spec rule 1)
   314	        path = ref_path(ref_dir, chunk, seed)
   315	        if save_reference:
   316	            os.makedirs(ref_dir, exist_ok=True)
   317	            torch.save(out.float().cpu(), path)
   318	            if manifest_id is not None:
   319	                provenance.bind_artifact(path, manifest_id)
   320	            passes.append({'seed': seed, 'saved': path, 'ref_sha256': provenance.sha256_file(path),
   321	                           'finite': bool(torch.isfinite(out).all())})
   322	            continue
   323	        if not os.path.exists(path):
   324	            raise FileNotFoundError(f'reference output missing: {path} '
   325	                                    '(run the arm-A reference step first)')
   326	        if manifest_id is not None:
   327	            provenance.check_artifact(path, manifest_id)
   328	        ref = torch.load(path, map_location='cuda', weights_only=True)
   329	        rec = compare_outputs(out, ref, tier)
   330	        rec['seed'] = seed
   331	        # persisted, checked reference identity (gate-04 f47): the hash the
   332	        # lineage check saw, so collectors can join restarts on it
   333	        rec['ref_sha256'] = provenance.sha256_file(path) if manifest_id is not None else None
   334	        passes.append(rec)
   335	        del ref
   336	    if save_reference:
   337	        return {'status': 'REFERENCE_SAVED', 'tier': tier, 'passes': passes}
   338	    ok = all(p['ok'] for p in passes)
   339	    return {'status': 'PASS' if ok else 'FAIL', 'tier': tier,
   340	            'rtol': TIERS[tier][0], 'atol': TIERS[tier][1], 'passes': passes}
