   247	def compare_outputs(out, ref, tier):
   248	    rtol, atol = TIERS[tier]
   249	    out = out.float()
   250	    ref = ref.float()
   251	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   252	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   253	    if out.shape != ref.shape:
   254	        rec['reason'] = 'shape mismatch'
   255	        rec['max_abs_diff'] = None
   256	        return rec
   257	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   258	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   259	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   260	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   261	    if not (fin_out and fin_ref):
   262	        rec['reason'] = 'non-finite values present'
   263	        return rec
   264	    # the tolerance verdict is persisted in a form a validator can re-derive:
   265	    # the number of elements violating |out-ref| <= atol + rtol*|ref| (gate-06 f80)
   266	    viol = int(((out - ref).abs() > (atol + rtol * ref.abs())).sum().item())
   267	    rec['violations'] = viol
   268	    rec['n_elements'] = int(out.numel())
   269	    rec['max_abs_ref'] = float(ref.abs().max().item())
   270	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   271	    if rec['ok'] != (viol == 0):
   272	        rec['ok'] = False
   273	        rec['reason'] = 'allclose and element count disagree'
   274	    elif not rec['ok']:
   275	        rec['reason'] = 'tolerance exceeded'
   276	    return rec
