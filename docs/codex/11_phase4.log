    47	def settle_compile(step, x, ctx, max_iters=60, consecutive=5):
    48	    """Run until torch._dynamo counters are unchanged for `consecutive`
    49	    passes (sm120 settle_compile; str-keyed snapshot)."""
    50	    import torch._dynamo.utils as dynamo_utils
    51	
    52	    def snap():
    53	        return {str(k): {str(kk): int(vv) for kk, vv in v.items()}
    54	                for k, v in dynamo_utils.counters.items()}
    55	
    56	    t0 = time.perf_counter()
    57	    prev, stable, it = snap(), 0, 0
    58	    with torch.no_grad(), ctx():
    59	        while stable < consecutive and it < max_iters:
    60	            step(x)
    61	            it += 1
    62	            cur = snap()
    63	            stable = stable + 1 if cur == prev else 0
    64	            prev = cur
    65	    torch.cuda.synchronize()
    66	    return {'settle_iters': it, 'settle_stable_tail': stable,
    67	            'settle_capped': stable < consecutive,
    68	            'settle_wall_s': round(time.perf_counter() - t0, 3),
    69	            'dynamo_counters': prev}
