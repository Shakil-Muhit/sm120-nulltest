   187	
   188	def timed_run(step, x, ctx, iters=50, nvtx_pass=False, profiler=True, nvtx_prefix='pass'):
   189	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   190	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   191	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   192	    pass windows for the exports; never inside compiled code).
   193	    profiler=False (Phase 4, matched-process profiling): the caller owns the
   194	    cudaProfilerApi start/stop so that one capture can span both arms of a repeat;
   195	    nvtx_prefix names the pass ranges per arm ('<arm>_pass_<i>')."""
   196	    with torch.no_grad(), ctx():
   197	        torch.cuda.synchronize()
   198	        if profiler:
   199	            torch.cuda.profiler.start()
   200	        latency_ms = []
   201	        for i in range(iters):
   202	            if nvtx_pass:
   203	                torch.cuda.nvtx.range_push(f'{nvtx_prefix}_{i}')
   204	            t0 = time.perf_counter()
   205	            step(x)
   206	            torch.cuda.synchronize()
   207	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   208	            if nvtx_pass:
   209	                torch.cuda.nvtx.range_pop()
   210	        if profiler:
   211	            torch.cuda.profiler.stop()
   212	
   213	        torch.cuda.synchronize()
   214	        t0 = time.perf_counter()
   215	        for _ in range(iters):
   216	            step(x)
   217	        torch.cuda.synchronize()
   218	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   219	    return latency_ms, throughput_ms
   220	
   221	
   222	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   223	    """Five repeats of the 5a block; min-of-medians + median spread; every
   224	    per-iteration list preserved; block wall timestamps for the clock log."""
   225	    blocks = []
   226	    for r in range(repeats):
   227	        t_start = time.time()
   228	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   229	        t_end = time.time()
   230	        s = sorted(lat)
   231	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   232	                       'latency_median_ms': median(lat),
   233	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   234	                       'throughput_ms_per_pass': thr,
