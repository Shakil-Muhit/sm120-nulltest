   104	def verify_operator(frames=FRAMES):
   105	    """Per registered T: schema/fake checks, bitwise native equality,
   106	    CUDA-graph capture/replay, isolated full-graph compile."""
   107	    out = {}
   108	    for T in frames:
   109	        gen = torch.Generator(device='cpu').manual_seed(4242)
   110	        x = torch.randn((1025, 2, T), generator=gen, dtype=torch.complex64).to('cuda')
   111	        x = x.permute(1, 0, 2)
   112	        index = torch.tensor(0, device='cuda')
   113	        with torch.no_grad(), torch.autocast('cuda', enabled=True):
   114	            checks = torch.library.opcheck(native_dc_fill, (x, index),
   115	                                          test_utils=('test_schema', 'test_faketensor'))
   116	            reference = x.index_fill(1, index, 0.)
   117	            actual = native_dc_fill(x, index)
   118	            assert torch.equal(actual, reference)
   119	            graph = torch.cuda.CUDAGraph()
   120	            with torch.cuda.graph(graph):
   121	                captured = native_dc_fill(x, index)
   122	            graph.replay()
   123	            torch.cuda.synchronize()
   124	            assert torch.equal(captured, reference)
   125	            torch._dynamo.reset()
   126	            compiled = torch.compile(native_dc_fill, mode='reduce-overhead',
   127	                                     dynamic=False, fullgraph=True)
