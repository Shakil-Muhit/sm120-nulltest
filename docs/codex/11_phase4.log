    86	import weakref
    87	
    88	_NODE_REGISTRY = weakref.WeakKeyDictionary()
    89	_MGR_REGISTRY = weakref.WeakKeyDictionary()
    90	_REGISTRY_BASE = [1]
    91	
    92	
    93	def cudagraph_tree_state():
    94	    """Recording observer (gate-03 f36): the cudagraph-trees manager's recorded
    95	    graph NODES (roots and all descendants) — the identity set that must not
    96	    change between measured phases. torch 2.8: TreeManager.roots is
    97	    {FunctionID: [CUDAGraphNode]}, each node has .children of the same shape.
    98	    'available': False -> the observer is missing and a compiled run cannot
    99	    be accepted (unresolved recording state)."""
   100	    try:
   101	        from torch._inductor import cudagraph_trees
   102	        container = cudagraph_trees.get_container(0)
   103	        mgr = getattr(container, 'tree_manager', None)
   104	        if mgr is None:
   105	            return {'available': False, 'reason': 'no tree manager on device 0'}
   106	        roots = getattr(mgr, 'roots', None)
   107	        if not isinstance(roots, dict):
   108	            return {'available': False, 'reason': 'roots not a dict'}
   109	        n_roots, stack, node_ids = 0, [], []
   110	        for lst in roots.values():
   111	            for node in lst:
   112	                n_roots += 1
   113	                stack.append(node)
   114	        seen = set()
   115	        mode = 'registry'
   116	        while stack:
   117	            node = stack.pop()
   118	            if id(node) in seen:
   119	                continue
   120	            seen.add(id(node))
   121	            # lifetime-safe identity (gate-05 f67): a weak registry assigns a
   122	            # monotonically increasing id on first sight; a freed node can never
   123	            # hand its id to a successor at the same address
   124	            try:
   125	                nid = _NODE_REGISTRY.get(node)
   126	                if nid is None:
   127	                    # monotonic counter only (gate-06 f84): never derived from the
   128	                    # registry's length, which shrinks when weak references expire
   129	                    nid = _REGISTRY_BASE[0]
   130	                    _NODE_REGISTRY[node] = nid
   131	                    _REGISTRY_BASE[0] += 1
   132	            except TypeError:                # not weak-referenceable
   133	                nid, mode = id(node), 'address'
   134	            node_ids.append(nid)
   135	            ch = getattr(node, 'children', None)
   136	            if isinstance(ch, dict):
   137	                for lst in ch.values():
   138	                    stack.extend(lst)
   139	        try:
   140	            mgr_id = _MGR_REGISTRY.get(mgr)
   141	            if mgr_id is None:
   142	                mgr_id = _REGISTRY_BASE[0]
   143	                _MGR_REGISTRY[mgr] = mgr_id
   144	                _REGISTRY_BASE[0] += 1
   145	        except TypeError:
   146	            mgr_id, mode = id(mgr), 'address'
   147	        ids = getattr(mgr, 'ids_to_funcs', None) or getattr(mgr, 'ids_to_stack', None)
   148	        return {'available': True, 'roots': n_roots, 'nodes': len(node_ids),
   149	                'manager_id': mgr_id, 'node_ids': sorted(node_ids), 'identity_mode': mode,
   150	                'function_ids': sorted(str(k) for k in ids) if isinstance(ids, dict) else None,
   151	                'functions': len(ids) if ids is not None else None,
   152	                'current_gen': getattr(mgr, 'current_gen', None)}
   153	    except Exception as e:
   154	        return {'available': False, 'reason': f'{type(e).__name__}: {e}'[:120]}
   155	
