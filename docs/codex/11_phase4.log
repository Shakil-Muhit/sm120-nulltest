   228	                out += [(b.get('unix_start'), b.get('unix_end'), f'{a}@{c}/{t}') for b in blocks]
   229	            if session == 'session2' and ((c in (22050, 88200) and t in ('r1', 'r2', 'r3')) or t == 'trace' or t.startswith('pert_')):
   230	                out += [(b.get('unix_start'), b.get('unix_end'), f'{a}@{c}/{t}') for b in blocks]
   231	            if session == 'session3' and c in OPS['session3'] + HELD_OUT_S3:
   232	                out += [(b.get('unix_start'), b.get('unix_end'), f'{a}@{c}/{t}') for b in blocks]
   233	            if session == 'session4' and c in OPS['session4']:
