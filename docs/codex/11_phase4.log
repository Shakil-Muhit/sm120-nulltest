    29	def _check_meta(t):
    30	    assert t.dim() == 3 and t.shape[0] == 2 and t.shape[1] == 1025, tuple(t.shape)
    31	    T = int(t.shape[-1])
    32	    assert T in FRAMES, T
    33	    assert t.dtype == torch.complex64, t.dtype
    34	    assert t.stride() in ((T, 2 * T, 1), (1025 * T, T, 1)), (t.stride(), T)
    35	    return T
    36	
    37	
    38	@torch.library.custom_op('fullmodel_c3::native_dc_fill_t', mutates_args=())
    39	def native_dc_fill(input: torch.Tensor, index: torch.Tensor) -> torch.Tensor:
    40	    _check_meta(input)
    41	    result = input.index_fill(1, index, 0.)
    42	    assert result.shape == input.shape
    43	    assert result.stride() == input.stride() and result.storage_offset() == 0
    44	    assert result.dtype == input.dtype == torch.complex64
    45	    return result
    46	
    47	
    48	@native_dc_fill.register_fake
    49	def native_dc_fill_fake(input, index):
    50	    _check_meta(input)
    51	    assert index.shape == () and index.dtype == torch.int64
    52	    return torch.empty_strided(input.shape, input.stride(),
    53	                               device=input.device, dtype=input.dtype)
    54	
    55	
    56	def call_native_dc_fill(input, dim, index, value):
    57	    assert dim == 1 and value == 0.
    58	    return native_dc_fill(input, index)
