stub.instantiate_non_scriptable_remote_module_template=lambda: types.SimpleNamespace()
sys.modules[stub.__name__]=stub
import torch._dynamo
print('torch',torch.__version__)
class M(torch.nn.Module):
 def __init__(self):
  super().__init__(); self.lin=torch.nn.Linear(2,2)
 def forward(self,x): return self.lin(x).sin()
seen=[]
def backend(gm, xs):
 seen.append((bool(torch._dynamo.config.inline_inbuilt_nn_modules),[n.op for n in gm.graph.nodes]))
 return gm.forward
x=torch.ones(1,2)
for fresh_code in (False,True):
 torch._dynamo.reset(); seen.clear()
 def model(label):
  m=M().eval()
  if fresh_code:
   ns={}; exec(compile('def forward(self,x):\\n return self.lin(x).sin()\\n','generated_'+label+'.py','exec'),ns)
   m.forward=types.MethodType(ns['forward'],m)
  return m
 m1=model('control'); c1=torch._dynamo.optimize(backend,dynamic=False)(m1)
 with torch.no_grad(): c1(x)
 m2=model('noinline')
 with torch._dynamo.config.patch(inline_inbuilt_nn_modules=False):
  c2=torch._dynamo.optimize(backend,dynamic=False)(m2)
  with torch.no_grad(): c2(x)
 with torch.no_grad(): c1(x)
 print('fresh_code',fresh_code,'compiled graphs',seen,'restored',torch._dynamo.config.inline_inbuilt_nn_modules)
