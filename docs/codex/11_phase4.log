   235	    out = {'pairs': {}, 'bootstrap': {'resamples': BOOT_N, 'seed': BOOT_SEED, 'level': 'per-repeat a-b differences recomputed from samples, joined by repeat; clock-flagged repeats excluded'}}
   236	    for path in sorted(glob.glob(os.path.join(a.evidence_dir, 'matched_*.json'))):
   237	        m = _load(path)
   238	        if not m or not m.get('aa_pair'):
   239	            continue
   240	        r, why = pair_reduce(m, manifest_id, flags)
   241	        if r is None:
   242	            out['pairs'][os.path.basename(path)] = {'status': 'UNRESOLVED: ' + '; '.join(why), 'chunk': m.get('chunk'), 'tag': m.get('tag')}
   243	            continue
   244	        diffs = r['diffs']
   245	        out['pairs'][os.path.basename(path)] = {
   246	            'chunk': m['chunk'], 'tag': m['tag'], 'repeats_used': r['repeats_used'], 'excluded_repeats': r['excluded_repeats'],
   247	            'a_minus_b_per_block_ms': diffs, 'median_ms': statistics.median(diffs),
   248	            'ci95_median_ms': _boot_ci(diffs), 'mean_ms': statistics.mean(diffs),
   249	            'abs_max_ms': max(abs(d) for d in diffs), 'median_pct_of_a': statistics.median(diffs) / r['a_wall'] * 100}
   250	    out['pairs_by_chunk'] = sorted({v.get('chunk') for v in out['pairs'].values() if 'median_ms' in v})
   251	    json.dump(out, open(a.out, 'w'), indent=1)
   252	    for k, v in out['pairs'].items():
   253	        print(k, v.get('median_ms'), v.get('ci95_median_ms'))
