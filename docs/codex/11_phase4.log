   399	def audit_prerequisites(ev, items, manifest_id, run_map):
   400	    """Planted-fault validator checks and the C3 operator qualification, bound to
   401	    THIS manifest, are prerequisites of BOTH sessions (gate-07 f98/f99)."""
   402	    for tier, const in (('tight', 0.001), ('loose', 0.05)):
   403	        r = (run_map.get(('A', 4410)) or {}).get(f'planted_{tier}')
   404	        v = (r or {}).get('validation') or {}
   405	        passes = v.get('passes') or []
   406	        ok = bool(r and r.get('status') == 'INVALID' and r.get('planted_fault_const') is not None
   407	                  and abs(r['planted_fault_const'] - const) < 1e-9 and r.get('tier') == tier
   408	                  and v.get('status') == 'FAIL' and r.get('manifest_id') == manifest_id
   409	                  and sorted(p.get('seed') for p in passes) == sorted(qualify.VALIDATION_SEEDS)
   410	                  and all(p.get('ok') is False and fin(p.get('max_abs_diff')) and abs(p['max_abs_diff'] - const) < 1e-6
   411	                          and (p.get('violations') or 0) > 0 for p in passes))
   412	        item(items, f'planted fault {tier} caught ({const})', ok,
   413	             ['planted-fault record missing, foreign, or not a per-pass FAIL at the planted magnitude'])
   414	    q = load(os.path.join(ev, 'c3_operator_qualification.json')) or {}
   415	    probs = []
   416	    cfg3 = load(os.path.join(ev, 'session3_config.json')) or {}
   417	    want = set(C3_FRAMES)
   418	    if cfg3 and cfg3.get('session_pod') and not cfg3.get('shakedown'):
   419	        want = want | {'401', '601'}                     # E9 held-out frame counts, pod only
   420	    if os.path.exists(os.path.join(ev, 'session4_config.json')):
   421	        want = {'11', '51', '201', '801', '401', '601', '101'}
   422	    if set(q) != want:
   423	        probs.append(f'frame set {sorted(q)} != registered {sorted(want)}')
   424	    for T, v in q.items():
   425	        oc = v.get('opcheck')
   426	        oc_ok = isinstance(oc, dict) and bool(oc) and all(x == 'SUCCESS' for x in oc.values())
   427	        if not (v.get('status') == 'PASS' and v.get('native_bitwise_equal') is True and oc_ok
   428	                and v.get('cuda_graph_capture_and_replay') == 'PASS' and v.get('compiled_fullgraph') == 'PASS'
   429	                and v.get('output_shape') == [2, 1025, int(T)]):
   430	            probs.append(f'frame {T}: component results not all successful')
   431	    item(items, 'C3 operator qualification (every registered component per frame)', not probs, probs)
   432	
