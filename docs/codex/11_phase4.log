   223	def _boot_ci(diffs, stat=statistics.median):
   224	    rnd = random.Random(BOOT_SEED)
   225	    vals = []
   226	    n = len(diffs)
   227	    for _ in range(BOOT_N):
   228	        vals.append(stat([diffs[rnd.randrange(n)] for _ in range(n)]))
   229	    vals.sort()
   230	    return [vals[int(0.025 * BOOT_N)], vals[int(0.975 * BOOT_N) - 1]]
