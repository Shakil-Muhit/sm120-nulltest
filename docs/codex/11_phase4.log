   241	def clock_series(ev, session, gpu_uuid):
   242	    """(timestamp, SM MHz) samples of this GPU from the session clock log (UTC unless CLOCK_TZ=local)."""
   243	    clocks = os.path.join(ev, f'clocks_{session}.csv')
   244	    out = []
   245	    if not os.path.exists(clocks):
   246	        return out
   247	    for line in open(clocks):
   248	        parts = [x.strip() for x in line.split(',')]
   249	        if len(parts) != 7 or (gpu_uuid and parts[1] != gpu_uuid):
   250	            continue
   251	        try:
   252	            sm = float(parts[2].replace('MHz', '').strip())
   253	        except ValueError:
   254	            continue
   255	        ts = None
   256	        for fmt in ('%Y/%m/%d %H:%M:%S.%f', '%Y/%m/%d %H:%M:%S'):
   257	            try:
   258	                d = _dt.datetime.strptime(parts[0], fmt)
   259	                ts = d.timestamp() if os.environ.get('CLOCK_TZ', 'utc') == 'local' else d.replace(tzinfo=_dt.timezone.utc).timestamp()
   260	                break
   261	            except ValueError:
   262	                continue
   263	        if ts is not None:
   264	            out.append((ts, sm))
   265	    out.sort()
   266	    return out
