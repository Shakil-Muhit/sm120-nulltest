   104	def main():
   105	    ap = argparse.ArgumentParser()
   106	    ap.add_argument('--pair', nargs=2, required=True, metavar=('ARM_A', 'ARM_B'))
   107	    ap.add_argument('--chunk', type=int, required=True, choices=list(arms_mod.CHUNKS))
   108	    ap.add_argument('--tag', default='m1')
   109	    ap.add_argument('--iters', type=int, default=50)
   110	    ap.add_argument('--repeats', type=int, default=5)
   111	    ap.add_argument('--streams', type=int, default=arms_mod.DEFAULT_STREAMS)
   112	    ap.add_argument('--settle-max', type=int, default=60)
   113	    ap.add_argument('--evidence-dir', '--out-dir', dest='evidence_dir',
   114	                    default=os.path.join(_ROOT, 'evidence'))
   115	    ap.add_argument('--ref-dir', default=None)
   116	    ap.add_argument('--no-manifest', action='store_true')
   117	    ap.add_argument('--variant', default=None, help='E5 structural variant (both arms); never a headline')
   118	    ap.add_argument('--profile-repeat', type=int, default=None,
   119	                    help='Phase 4 (PB): wrap this repeat (a-block then b-block) in ONE cudaProfilerApi capture with per-arm NVTX pass ranges; the record is a trace record, never a headline')
   120	    args = ap.parse_args()
   121	    arms_mod.held_out_guard(args.chunk)                 # E9: held-out lengths run only in the pod session
   122	    if (args.iters, args.repeats) != (50, 5):
   123	        print('[matched] WARNING: not the registered 5 x 50 protocol — pair ineligible')
   124	    assert torch.cuda.is_available()
   125	    os.makedirs(args.evidence_dir, exist_ok=True)
   126	    ref_dir = args.ref_dir or os.path.join(args.evidence_dir, 'ref')
   127	    a, b = args.pair
   128	    out_path = os.path.join(args.evidence_dir, f'matched_{a}_{b}_c{args.chunk}_{args.tag}.json')
   129	    if b == a:                                          # E6 A/A: the same arm built twice in one process
   130	        b = f'{a}#2'
   131	    result = {'pair': [a, b], 'chunk': args.chunk, 'tag': args.tag, 'status': 'VALID',
   132	              'aa_pair': (arms_mod.base_arm(a) == arms_mod.base_arm(b)), 'variant': args.variant,
   133	              'error': None, 'env': tm.env_fingerprint(), 'arms': {}, 'blocks': [],
   134	              'iters': args.iters, 'repeats': args.repeats,
   135	              'torch_logs_env': os.environ.get('TORCH_LOGS'), 'manifest_id': None,
   136	              'pair_eligible': None, 'ineligibility_reasons': []}
   137	    reasons = result['ineligibility_reasons']
   138	    try:
   139	        paths = loader.paths_from_env()
   140	        result['provenance'] = provenance.verify(paths)
   141	        if not args.no_manifest:
   142	            result['manifest_id'] = provenance.load_manifest(
   143	                args.evidence_dir, paths, tm.env_fingerprint())['manifest_id']
   144	            tm.bind_refs(ref_dir, result['manifest_id'])
   145	        else:
   146	            reasons.append('not bound to a session manifest')
   147	        if (args.iters, args.repeats) != (50, 5):
   148	            reasons.append(f'protocol {args.repeats}x{args.iters} is not the registered 5x50')
   149	        if args.variant:
   150	            reasons.append(f'structural variant {args.variant} (E5): never a headline')
   151	            ref_dir = args.ref_dir or os.path.join(args.evidence_dir, f'ref_variant_{args.variant}')
   152	        built = {}
   153	        for arm in (a, b):
   154	            gen_dir = os.path.join(args.evidence_dir, 'generated', f'matched_{arm}_c{args.chunk}_{args.tag}')
   155	            try:
   156	                built[arm] = build_one(arm, args.chunk, args.streams, gen_dir, paths, args.settle_max, args.variant)
   157	                bi = built[arm]
   158	                result['arms'][arm] = {'build_status': 'OK', 'settle': bi['settle'], 'graph_gate': bi['gate'],
   159	                                       'gate_snapshot': bi.get('gate_snapshot'),
   160	                                       'capture_scope': bi['info'].get('capture_scope'),
   161	                                       'capture_adapter_active': bi['info'].get('capture_adapter_active'),
   162	                                       'compile_mode': bi['info'].get('compile_mode'),
   163	                                       'stream_count': bi['info'].get('stream_count')}
   164	                if bi['settle'] and bi['settle']['settle_capped']:
   165	                    reasons.append(f'{arm}: settle capped')
   166	                if bi['gate'] and bi['gate']['status'] != 'PASS':
   167	                    reasons.append(f'{arm}: graph gate FAIL')
   168	                print(f'[matched] {arm}: built (scope {bi["info"].get("capture_scope")}, gate '
   169	                      f'{(bi["gate"] or {}).get("status")})')
   170	            except Exception:
   171	                result['arms'][arm] = {'build_status': 'FAILED', 'error': traceback.format_exc()}
   172	                reasons.append(f'{arm}: build failed')
   173	                print(f'[matched] {arm}: BUILD FAILED (recorded)', file=sys.stderr)
   174	        if not all(result['arms'][x]['build_status'] == 'OK' for x in (a, b)):
   175	            result['status'] = 'INVALID'
   176	        else:
   177	            js = joint_settle(built, (a, b))
   178	            result['joint_settle'] = js
   179	            if js['stable'] is None:
   180	                reasons.append('joint settle: recording observer unavailable (UNRESOLVED)')
   181	            elif not js['stable']:
   182	                reasons.append('joint alternation did not settle (recording state changed)')
   183	            if js['new_breaks_during_joint_settle']:
   184	                reasons.append(f"{js['new_breaks_during_joint_settle']} new graph breaks/unimplemented "
   185	                               'during the joint settle')
   186	            # per-arm zero-break requalification after the joint settle (global delta)
   187	            before_val = tm.recording_state()
   188	            for arm in (a, b):
   189	                v = tm.validate(built[arm]['step'], built[arm]['ctx'], arms_mod.TIER[arms_mod.base_arm(arm)],
   190	                                args.chunk, ref_dir, manifest_id=result['manifest_id'])
   191	                result['arms'][arm]['validation'] = v
   192	                if v['status'] != 'PASS':
   193	                    reasons.append(f'{arm}: validation {v["status"]}')
   194	                print(f'[matched] {arm}: validation {v["status"]} '
   195	                      f'{[p.get("max_abs_diff") for p in v["passes"]]}')
   196	            after_val = tm.recording_state()
   197	            result['snapshots'] = {'joint_settle': js['snapshots'], 'before_validation': before_val,
   198	                                   'after_validation': after_val, 'blocks': []}
   199	            sv = tm.recording_stable(before_val, after_val)
   200	            if sv is None:
   201	                reasons.append('validation: recording observer unavailable')
   202	            elif not sv:
   203	                reasons.append('recording state changed during validation')
   204	            per = {a: [], b: []}
   205	            prev = after_val
   206	            block_stable = True
   207	            for r in range(args.repeats):
   208	                profiled = (args.profile_repeat is not None and r == args.profile_repeat)
   209	                if profiled:
   210	                    torch.cuda.synchronize()
   211	                    torch.cuda.profiler.start()
   212	                for arm in (a, b):
   213	                    t0 = time.time()
   214	                    if profiled:
   215	                        torch.cuda.nvtx.range_push(f'matched_{arm}_rep{r}')
   216	                        lat, thr = tm.timed_run(built[arm]['step'], built[arm]['x'], built[arm]['ctx'], args.iters,
   217	                                                nvtx_pass=True, profiler=False, nvtx_prefix=f'{arm}_pass')
   218	                        torch.cuda.nvtx.range_pop()
   219	                    else:
   220	                        lat, thr = tm.timed_run(built[arm]['step'], built[arm]['x'],
   221	                                                built[arm]['ctx'], args.iters)
   222	                    t1 = time.time()
   223	                    cur = tm.recording_state()
   224	                    stable = tm.recording_stable(prev, cur)
   225	                    block_stable = block_stable and bool(stable)
   226	                    result['snapshots']['blocks'].append(cur)
   227	                    prev = cur
   228	                    blk = {'repeat': r, 'arm': arm, 'latency_median_ms': tm.median(lat),
   229	                           'throughput_ms_per_pass': thr, 'latency_ms_per_iter': lat,
   230	                           'unix_start': t0, 'unix_end': t1, 'counters_stable': stable}
   231	                    result['blocks'].append(blk)
   232	                    per[arm].append(blk['latency_median_ms'])
   233	                    print(f'  block {r} {arm}: median {blk["latency_median_ms"]:.4f} ms')
   234	                if profiled:
   235	                    torch.cuda.synchronize()
   236	                    torch.cuda.profiler.stop()
   237	            if args.profile_repeat is not None:
   238	                result['profiled_repeat'] = args.profile_repeat
   239	                reasons.append('profiled matched run (trace record; never a headline)')
   240	            if not block_stable:
   241	                reasons.append('compile/recording counters changed during the blocks')
   242	            for arm in (a, b):
   243	                result['arms'][arm].update({
   244	                    'latency_medians_ms': per[arm], 'min_of_medians_ms': min(per[arm]),
   245	                    'median_spread_ms': max(per[arm]) - min(per[arm])})
   246	            diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   247	            result['matched_delta_ms'] = {'a_minus_b_per_block': diffs,
   248	                                          'median': statistics.median(diffs),
   249	                                          'min': min(diffs), 'max': max(diffs),
   250	                                          'median_pct_of_a': statistics.median(diffs) /
   251	                                          statistics.median(per[a]) * 100.0}
   252	            print(f'[matched] {a} - {b}: median {statistics.median(diffs):+.4f} ms')
   253	    except Exception:
   254	        result['status'], result['error'] = 'INVALID', traceback.format_exc()
   255	        reasons.append('exception')
   256	        print(result['error'], file=sys.stderr)
   257	    result['effective_variants'] = {k: qualify.variant(v) for k, v in result['arms'].items()}
   258	    result['qualify_version'] = qualify.QUALIFY_VERSION
   259	    # independent re-derivation from the record itself (gate-04 f47)
   260	    for prob in qualify.pair_problems(result, args.iters, args.repeats):
   261	        if prob not in reasons:
   262	            reasons.append(prob)
   263	    if (args.iters, args.repeats) != (qualify.REGISTERED_ITERS, qualify.REGISTERED_REPEATS):
   264	        reasons.append(f'protocol {args.repeats}x{args.iters} is not the registered 5x50') if \
   265	            f'protocol {args.repeats}x{args.iters} is not the registered 5x50' not in reasons else None
   266	    result['pair_eligible'] = result['status'] == 'VALID' and not reasons
   267	    with open(out_path, 'w') as f:
   268	        json.dump(result, f, indent=1)
   269	    print(f'[matched] status={result["status"]} pair_eligible={result["pair_eligible"]} {reasons} -> {out_path}')
   270	
   271	
   272	if __name__ == '__main__':
   273	    main()

