    61	def install(model, out_dir):
    62	    from models.bs_roformer.mel_band_roformer import MelBandRoformer
    63	    assert type(model) is MelBandRoformer
    64	    assert model.forward.__func__ is MelBandRoformer.forward
    65	    assert 'forward' not in model.__dict__
    66	    original = textwrap.dedent(inspect.getsource(MelBandRoformer.forward))
    67	    tree = ast.parse(original)
    68	    replacements = 0
    69	    for node in ast.walk(tree):
    70	        if (isinstance(node, ast.Call) and
    71	                ast.unparse(node.func) == 'stft_repr.index_fill'):
    72	            assert len(node.args) == 3 and not node.keywords
    73	            assert ast.unparse(node.args[0]) == '1'
    74	            assert ast.unparse(node.args[1]) == 'tensor(0, device=device)'
    75	            assert isinstance(node.args[2], ast.Constant) and node.args[2].value == 0.
    76	            node.func = ast.Name(id='c3_native_dc_fill', ctx=ast.Load())
    77	            node.args.insert(0, ast.Name(id='stft_repr', ctx=ast.Load()))
    78	            replacements += 1
    79	    assert replacements == 1, 'expected the single public DC-filter call'
    80	    source = ast.unparse(ast.fix_missing_locations(tree)) + '\n'
    81	    restored = ast.parse(source)
    82	    for node in ast.walk(restored):
    83	        if isinstance(node, ast.Call) and ast.unparse(node.func) == 'c3_native_dc_fill':
    84	            base = node.args.pop(0)
    85	            node.func = ast.Attribute(value=base, attr='index_fill', ctx=ast.Load())
    86	    assert ast.dump(restored) == ast.dump(ast.parse(original))
    87	    Path(out_dir).mkdir(parents=True, exist_ok=True)
    88	    dest = Path(out_dir) / 'generated_public_forward.py'
    89	    dest.write_text(source)
    90	    namespace = dict(MelBandRoformer.forward.__globals__)
    91	    namespace['c3_native_dc_fill'] = call_native_dc_fill
    92	    exec(compile(source, str(dest), 'exec'), namespace)
    93	    model.forward = types.MethodType(namespace['forward'], model)
    94	    return {'status': 'PASS', 'replacements': replacements,
