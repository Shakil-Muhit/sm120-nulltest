    67	def joint_settle(built, arms, min_rounds=2, passes=3, max_rounds=6):
    68	    """Alternate the two steps (plan 1.2: "until the compile/recording counters are
    69	    stable across two full alternation rounds"). The recording state is snapshotted
    70	    BEFORE the first round and after every round. Rounds continue until the last two
    71	    transitions are affirmatively stable (or max_rounds is reached); leading unstable
    72	    transitions are recorded as warm-up rounds (cudagraph trees may record additional
    73	    paths the first time two compiled models alternate — observed for C1P, Phase 3).
    74	    'stable' is None when the observer is unavailable; new graph breaks or
    75	    unimplemented ops at ANY point are reported separately."""
    76	    snaps = [tm.recording_state()]
    77	    verdicts = []
    78	    for r in range(max_rounds):
    79	        for arm in arms:
    80	            b = built[arm]
    81	            with torch.no_grad(), b['ctx']():
    82	                for _ in range(passes):
    83	                    b['step'](b['x'])
    84	        torch.cuda.synchronize()
    85	        snaps.append(tm.recording_state())
    86	        verdicts.append(tm.recording_stable(snaps[-2], snaps[-1]))
    87	        if len(verdicts) >= min_rounds and verdicts[-1] is True and verdicts[-2] is True:
    88	            break
    89	    last2 = verdicts[-2:]
    90	    stable = None if (len(last2) < 2 or any(v is None for v in last2)) else all(last2)
    91	    breaks = [sum(x['counters'].get('graph_break', {}).values()) +
    92	              sum(x['counters'].get('unimplemented', {}).values()) for x in snaps]
    93	    warm = 0
    94	    for v in verdicts:
    95	        if v is True:
    96	            break
    97	        warm += 1
    98	    return {'stable': stable, 'new_breaks_during_joint_settle': breaks[-1] - breaks[0],
    99	            'rounds': len(verdicts) - 1, 'rounds_executed': len(verdicts), 'warmup_rounds': warm,
   100	            'policy': f'until two consecutive stable rounds (min {min_rounds}, max {max_rounds}); leading unstable rounds are warm-up',
   101	            'transition_verdicts': verdicts, 'snapshots': snaps}
