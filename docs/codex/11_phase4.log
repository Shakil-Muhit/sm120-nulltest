   285	def drift_flags(ev, session, runs, matched, gpu_uuid, limit=0.05):
   286	    """Registered rule (prereg v0.2): clocks may not drift more than 5 % between COMPARED
   287	    blocks. Matched pairs: the a-block vs the b-block of each repeat; the flag is
   288	    REPEAT-scoped ({(pair, chunk, tag): {repeat: message}}). Headline cells: the per-block
   289	    SM medians across r1..rN ({(arm, chunk): message}). Blocks shorter than the sampling
   290	    interval use the nearest samples (block_sm_median). Shared by the audit and by every
   291	    publisher (gate-10 f139/f140), so published aggregates exclude exactly what the audit flags."""
   292	    series = clock_series(ev, session, gpu_uuid)
   293	    flagged = {'pairs': {}, 'cells': {}, 'unresolved': [], 'checked': 0}
   294	    for (pair, c, t), m in matched.items():
   295	        if m.get('status') not in ('VALID',):
   296	            continue
   297	        by_rep = {}
   298	        for b in (m.get('blocks') or []):
   299	            by_rep.setdefault(b.get('repeat'), []).append(b)
   300	        for rep, bs in sorted(by_rep.items(), key=lambda kv: (kv[0] is None, kv[0])):
   301	            if len(bs) != 2:
   302	                continue
   303	            sa = block_sm_median(series, bs[0].get('unix_start'), bs[0].get('unix_end'))
   304	            sb = block_sm_median(series, bs[1].get('unix_start'), bs[1].get('unix_end'))
   305	            if sa is None or sb is None:
   306	                flagged['unresolved'].append(f'matched {pair}@{c}/{t} rep {rep}')
   307	                continue
   308	            flagged['checked'] += 1
   309	            drift = abs(sa - sb) / ((sa + sb) / 2)
   310	            if drift > limit:
   311	                flagged['pairs'].setdefault((pair, c, t), {})[rep] = f'{sa:.0f} vs {sb:.0f} MHz ({drift * 100:.1f} %)'
   312	    for (a, c), rs in runs.items():
   313	        meds = []
   314	        for t, r in rs.items():
   315	            if not t.startswith('r') or not t[1:].isdigit() or r.get('status') != 'VALID':
   316	                continue
   317	            for b in ((r.get('timing') or {}).get('blocks') or []):
   318	                sm = block_sm_median(series, b.get('unix_start'), b.get('unix_end'))
   319	                if sm is None:
   320	                    flagged['unresolved'].append(f'{a}@{c}/{t} block {b.get("repeat")}')
   321	                else:
   322	                    meds.append(sm)
   323	        if len(meds) >= 2:
   324	            flagged['checked'] += 1
   325	            drift = (max(meds) - min(meds)) / (sum(meds) / len(meds))
   326	            if drift > limit:
   327	                flagged['cells'][(a, c)] = f'restarts: {min(meds):.0f}–{max(meds):.0f} MHz ({drift * 100:.1f} %)'
   328	    return flagged
   329	
