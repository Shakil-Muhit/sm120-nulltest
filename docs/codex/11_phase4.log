     3	"""External, mechanically checked _asdict repair for the bounded C3 arm.
     4	
     5	Attend.flash_attn is copied from ZFTurbo/Music-Source-Separation-Training
     6	@ea7eb9c20ea0e3f94368a30fc1654b51cdd55789, models/bs_roformer/attend.py:76.
     7	Only backend context construction differs: precomputed enum lists replace
     8	_asdict() and the unsupported legacy generator context. The enum order and
     9	implicit cuDNN enablement match the installed torch 2.8 legacy wrapper.
    10	The public source and every tensor operation remain unchanged.
    11	"""
    12	import ast
    13	import hashlib
    14	import inspect
    15	import textwrap
    16	import types
    17	
    18	import torch
    19	import torch.nn.functional as F
    20	
    21	
    22	def exists(val):
    23	    return val is not None
    24	
    25	
    26	def flash_attn(self, q, k, v):
    27	    _, heads, q_len, _, k_len, is_cuda, device = *q.shape, k.shape[-2], q.is_cuda, q.device
    28	
    29	    if exists(self.scale):
    30	        default_scale = q.shape[-1] ** -0.5
    31	        q = q * (self.scale / default_scale)
    32	
    33	    # Check if there is a compatible device for flash attention
    34	
    35	    config = self._c3_cuda_backends if is_cuda else self._c3_cpu_backends
    36	
    37	    # pytorch 2.0 flash attn: q, k, v, mask, dropout, softmax_scale
    38	
    39	    with torch.nn.attention.sdpa_kernel(config):
    40	        out = F.scaled_dot_product_attention(
    41	            q, k, v,
    42	            dropout_p = self.dropout if self.training else 0.
    43	        )
    44	
    45	    return out
    46	
    47	
    48	def verify_source(original):
    49	    source = textwrap.dedent(inspect.getsource(original))
    50	    tree = ast.parse(source)
    51	    replacements = 0
    52	    config_replacements = 0
    53	    for node in ast.walk(tree):
    54	        if (isinstance(node, ast.Assign) and len(node.targets) == 1 and
    55	                ast.unparse(node.targets[0]) == 'config'):
    56	            assert ast.unparse(node.value) == 'self.cuda_config if is_cuda else self.cpu_config'
    57	            node.value = ast.parse('self._c3_cuda_backends if is_cuda else self._c3_cpu_backends',
    58	                                   mode='eval').body
    59	            config_replacements += 1
    60	        if not isinstance(node, ast.Call):
    61	            continue
    62	        if ast.unparse(node.func) != 'torch.backends.cuda.sdp_kernel':
    63	            continue
    64	        assert not node.args and len(node.keywords) == 1
    65	        kw = node.keywords[0]
    66	        assert kw.arg is None and ast.unparse(kw.value) == 'config._asdict()'
    67	        node.func = ast.parse('torch.nn.attention.sdpa_kernel', mode='eval').body
    68	        node.args = [ast.Name(id='config', ctx=ast.Load())]
    69	        node.keywords = []
    70	        replacements += 1
    71	    assert replacements == config_replacements == 1
    72	    fixed_source = textwrap.dedent(inspect.getsource(flash_attn))
    73	    assert ast.dump(tree) == ast.dump(ast.parse(fixed_source)), \
    74	        'external method differs beyond the backend-context repair'
    75	    return {'status': 'PASS', 'replacements': replacements,
    76	            'original_source_sha256': hashlib.sha256(source.encode()).hexdigest(),
    77	            'replacement_source_sha256': hashlib.sha256(fixed_source.encode()).hexdigest()}
    78	
    79	
    80	def backend_list(config):
    81	    # Exact ordering/default from torch 2.8.0 torch/backends/cuda/__init__.py
    82	    # sdp_kernel. The old API's unmentioned enable_cudnn parameter is True.
    83	    backend = torch.nn.attention.SDPBackend
    84	    result = []
    85	    if config.enable_flash:
    86	        result.append(backend.FLASH_ATTENTION)
    87	    if config.enable_mem_efficient:
    88	        result.append(backend.EFFICIENT_ATTENTION)
    89	    if config.enable_math:
    90	        result.append(backend.MATH)
    91	    result.append(backend.CUDNN_ATTENTION)
    92	    return result
    93	
