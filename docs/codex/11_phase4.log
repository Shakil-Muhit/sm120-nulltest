    13	               out [a-half | b-half], each half zero-padded to K_max, so
    14	               GLU(dim=-1) over the padded width equals the per-band GLU
    15	               (pad columns: 0 * sigmoid(0) = 0); valid columns are gathered
    16	               back in band order == torch.cat(dim=-1).
    17	Claim: ALGEBRAIC equivalence. Numerically the padded/batched program changes
    18	reduction trees (and the compiler changes fusion), so agreement is verified
    19	at the loose tier (the classification rule; H is compiled), never bitwise.
    20	"""
    21	
    22	import torch
    23	import torch.nn as nn
    24	import torch.nn.functional as F
    25	
    26	
    27	def _band_split_parts(orig):
    28	    dims = tuple(int(d) for d in orig.dim_inputs)
    29	    parts = []
    30	    for seq in orig.to_features:
    31	        assert isinstance(seq, nn.Sequential) and len(seq) == 2
    32	        rms, lin = seq[0], seq[1]
    33	        assert isinstance(lin, nn.Linear) and lin.bias is not None
    34	        assert hasattr(rms, 'gamma') and hasattr(rms, 'scale')
    35	        parts.append((rms, lin))
    36	    assert len(parts) == len(dims)
    37	    return dims, parts
    38	
    39	
    40	class PadBatchBandSplit(nn.Module):
    41	    """Drop-in for the public BandSplit: (1, T, sum K_i) -> (1, T, 60, dim)."""
    42	
    43	    def __init__(self, orig):
    44	        super().__init__()
    45	        self.orig = orig                       # parameters stay registered
    46	        dims, parts = _band_split_parts(orig)
    47	        n, kmax = len(dims), max(dims)
    48	        dim_out = parts[0][1].out_features
    49	        total = sum(dims)
    50	        dev = parts[0][1].weight.device
    51	        idx = torch.full((n, kmax), total, dtype=torch.long)   # -> zero column
    52	        gamma = torch.zeros(n, kmax, dtype=torch.float32)
    53	        w = torch.zeros(n, kmax, dim_out, dtype=torch.float32)
    54	        b = torch.zeros(n, 1, dim_out, dtype=torch.float32)
    55	        scale = torch.zeros(n, 1, 1, dtype=torch.float32)
    56	        off = 0
    57	        for i, ((rms, lin), k) in enumerate(zip(parts, dims)):
    58	            assert lin.in_features == k and lin.out_features == dim_out
    59	            assert rms.gamma.shape == (k,)
    60	            idx[i, :k] = torch.arange(off, off + k)
    61	            gamma[i, :k] = rms.gamma.detach().float().cpu()
    62	            w[i, :k, :] = lin.weight.detach().float().cpu().t()
    63	            b[i, 0, :] = lin.bias.detach().float().cpu()
    64	            scale[i] = float(rms.scale)
    65	            off += k
    66	        assert off == total
    67	        self.n, self.kmax, self.total = n, kmax, total
    68	        self.register_buffer('idx', idx.to(dev), persistent=False)
    69	        self.register_buffer('gamma_pad', gamma.to(dev), persistent=False)
    70	        self.register_buffer('w_pad', w.to(dev), persistent=False)
    71	        self.register_buffer('b_pad', b.to(dev), persistent=False)
    72	        self.register_buffer('scale', scale.to(dev), persistent=False)
    73	
    74	    def forward(self, x):                      # (1, T, total)
    75	        assert x.shape[0] == 1 and x.shape[-1] == self.total
    76	        t = x.shape[1]
    77	        x_ext = torch.cat([x[0], x.new_zeros(t, 1)], dim=-1)   # (T, total+1)
    78	        xp = x_ext[:, self.idx]                                 # (T, n, kmax)
    79	        xp = xp.transpose(0, 1)                                 # (n, T, kmax)
    80	        xn = F.normalize(xp, dim=-1) * self.scale * self.gamma_pad[:, None, :]
    81	        y = torch.baddbmm(self.b_pad, xn, self.w_pad)           # (n, T, dim)
    82	        return y.transpose(0, 1).unsqueeze(0)                   # (1, T, n, dim)
    83	
    84	
    85	class PadBatchMaskEstimator(nn.Module):
    86	    """Drop-in for the public MaskEstimator: (1, T, 60, dim) -> (1, T, sum K_i)."""
    87	
    88	    def __init__(self, orig):
    89	        super().__init__()
    90	        self.orig = orig
    91	        dims = tuple(int(d) for d in orig.dim_inputs)
    92	        n, kmax = len(dims), max(dims)
    93	        chains = []
    94	        for mlp in orig.to_freqs:
    95	            assert isinstance(mlp, nn.Sequential) and len(mlp) == 2
    96	            inner, glu = mlp[0], mlp[1]
    97	            assert isinstance(glu, nn.GLU) and glu.dim == -1
    98	            layers = list(inner)
    99	            lins = [m for m in layers if isinstance(m, nn.Linear)]
   100	            others = [m for m in layers if not isinstance(m, nn.Linear)]
   101	            assert all(isinstance(m, nn.Tanh) for m in others), others
   102	            # public MLP: Linear (Tanh Linear)* — activation after all but last
   103	            assert len(others) == len(lins) - 1
   104	            assert [type(m) for m in layers] == \
   105	                [nn.Linear if i % 2 == 0 else nn.Tanh for i in range(len(layers))]
   106	            chains.append(lins)
   107	        depth = len(chains[0])
   108	        assert all(len(c) == depth for c in chains)
   109	        dev = chains[0][0].weight.device
   110	        self.n, self.kmax, self.depth = n, kmax, depth
   111	        self.total = sum(dims)
   112	        for j in range(depth - 1):             # batched hidden layers
   113	            din, dout = chains[0][j].in_features, chains[0][j].out_features
   114	            w = torch.zeros(n, din, dout)
   115	            b = torch.zeros(n, 1, dout)
   116	            for i, lins in enumerate(chains):
   117	                assert lins[j].in_features == din and lins[j].out_features == dout
   118	                w[i] = lins[j].weight.detach().float().cpu().t()
   119	                b[i, 0] = lins[j].bias.detach().float().cpu()
   120	            self.register_buffer(f'w{j}', w.to(dev), persistent=False)
   121	            self.register_buffer(f'b{j}', b.to(dev), persistent=False)
   122	        # last layer: out = 2*K_i, laid out [a | b] halves each padded to kmax
   123	        din = chains[0][-1].in_features
   124	        w = torch.zeros(n, din, 2 * kmax)
   125	        b = torch.zeros(n, 1, 2 * kmax)
   126	        out_idx = torch.zeros(self.total, dtype=torch.long)
   127	        off = 0
   128	        for i, (lins, k) in enumerate(zip(chains, dims)):
   129	            last = lins[-1]
   130	            assert last.in_features == din and last.out_features == 2 * k
   131	            wt = last.weight.detach().float().cpu().t()         # (din, 2k)
   132	            bb = last.bias.detach().float().cpu()
   133	            w[i, :, :k] = wt[:, :k]
   134	            w[i, :, kmax:kmax + k] = wt[:, k:2 * k]
   135	            b[i, 0, :k] = bb[:k]
   136	            b[i, 0, kmax:kmax + k] = bb[k:2 * k]
   137	            out_idx[off:off + k] = i * kmax + torch.arange(k)
   138	            off += k
   139	        assert off == self.total
   140	        self.register_buffer('w_last', w.to(dev), persistent=False)
   141	        self.register_buffer('b_last', b.to(dev), persistent=False)
   142	        self.register_buffer('out_idx', out_idx.to(dev), persistent=False)
   143	
   144	    def forward(self, x):                      # (1, T, n, dim)
   145	        assert x.shape[0] == 1 and x.shape[2] == self.n
   146	        t = x.shape[1]
   147	        h = x[0].transpose(0, 1)                                # (n, T, dim)
   148	        for j in range(self.depth - 1):
   149	            h = torch.tanh(torch.baddbmm(getattr(self, f'b{j}'), h,
   150	                                         getattr(self, f'w{j}')))
   151	        o = torch.baddbmm(self.b_last, h, self.w_last)           # (n, T, 2kmax)
   152	        o = F.glu(o, dim=-1)                                     # (n, T, kmax)
   153	        flat = o.transpose(0, 1).reshape(t, self.n * self.kmax)
   154	        return flat[:, self.out_idx].unsqueeze(0)                # (1, T, total)
   155	
   156	
   157	def install(model):
   158	    """Swap band_split and every mask estimator; returns a record."""
   159	    from models.bs_roformer.mel_band_roformer import BandSplit, MaskEstimator
   160	    assert type(model.band_split) is BandSplit
   161	    model.band_split = PadBatchBandSplit(model.band_split)
   162	    names = []
   163	    for i, me in enumerate(model.mask_estimators):
   164	        assert type(me) is MaskEstimator
   165	        model.mask_estimators[i] = PadBatchMaskEstimator(me)
   166	        names.append(f'mask_estimators.{i}')
   167	    return {'status': 'PASS', 'band_split': 'PadBatchBandSplit',
   168	            'mask_estimators': names, 'kmax_band_split': model.band_split.kmax,
   169	            'kmax_mask': model.mask_estimators[0].kmax,
   170	            'mask_depth': model.mask_estimators[0].depth,
   171	            'production_code_used': False}
     1	"""DOCUMENTED ADAPTATION of axial-layout-scoping@a6f3e6f extensions/c3/native_tail.py
     2	(the verbatim original is kept beside this file as native_tail.py and is NOT
     3	imported by the harness). Registered in prereg_amendments.md §1 (arm C3).
     4	
     5	The original registers the DC-filter custom op for the single 8-s shape
     6	(2, 1025, 801) with hard-coded strides. This session runs C3/H at frame
     7	counts T ∈ {11, 51, 201, 801} (chunks 4410, 22050, 88200, 352800) and, for the
     8	Phase-3 E9 held-out lengths, T ∈ {401, 601} (176400, 264600; qualified on the pod only). The ONLY
     9	changes: (1) the op name (both modules would otherwise register the same
    10	name); (2) the shape/stride checks are parametrised by T = input.shape[-1]
    11	and accept exactly the registered set; (3) verify_operator() checks every
    12	registered T. The public-forward AST substitution, the native
    13	Tensor.index_fill call, and the no-new-kernel / no-arithmetic properties are
    14	unchanged. Native output metadata, fake metadata, bitwise eager equivalence,
    15	CUDA-graph capture/replay and isolated compilation are verified per shape.
    16	"""
    17	import ast
    18	import hashlib
    19	import inspect
    20	from pathlib import Path
    21	import textwrap
    22	import types
    23	
    24	import torch
    25	
    26	FRAMES = (11, 51, 201, 801, 401, 601, 101)      # registered operating points + sweep + Phase-3 E9 held-out (401, 601) + Phase-4 1 s (101)
    27	
    28	
    29	def _check_meta(t):
    30	    assert t.dim() == 3 and t.shape[0] == 2 and t.shape[1] == 1025, tuple(t.shape)
    31	    T = int(t.shape[-1])
    32	    assert T in FRAMES, T
    33	    assert t.dtype == torch.complex64, t.dtype
    34	    assert t.stride() in ((T, 2 * T, 1), (1025 * T, T, 1)), (t.stride(), T)
    35	    return T
    36	
    37	
    38	@torch.library.custom_op('fullmodel_c3::native_dc_fill_t', mutates_args=())
    39	def native_dc_fill(input: torch.Tensor, index: torch.Tensor) -> torch.Tensor:
    40	    _check_meta(input)
    41	    result = input.index_fill(1, index, 0.)
    42	    assert result.shape == input.shape
    43	    assert result.stride() == input.stride() and result.storage_offset() == 0
    44	    assert result.dtype == input.dtype == torch.complex64
    45	    return result
    46	
    47	
    48	@native_dc_fill.register_fake
    49	def native_dc_fill_fake(input, index):
    50	    _check_meta(input)
    51	    assert index.shape == () and index.dtype == torch.int64
    52	    return torch.empty_strided(input.shape, input.stride(),
    53	                               device=input.device, dtype=input.dtype)
    54	
    55	
    56	def call_native_dc_fill(input, dim, index, value):
    57	    assert dim == 1 and value == 0.
    58	    return native_dc_fill(input, index)
    59	
    60	
    61	def install(model, out_dir):
    62	    from models.bs_roformer.mel_band_roformer import MelBandRoformer
    63	    assert type(model) is MelBandRoformer
    64	    assert model.forward.__func__ is MelBandRoformer.forward
    65	    assert 'forward' not in model.__dict__
    66	    original = textwrap.dedent(inspect.getsource(MelBandRoformer.forward))
    67	    tree = ast.parse(original)
    68	    replacements = 0
    69	    for node in ast.walk(tree):
    70	        if (isinstance(node, ast.Call) and
    71	                ast.unparse(node.func) == 'stft_repr.index_fill'):
    72	            assert len(node.args) == 3 and not node.keywords
    73	            assert ast.unparse(node.args[0]) == '1'
    74	            assert ast.unparse(node.args[1]) == 'tensor(0, device=device)'
    75	            assert isinstance(node.args[2], ast.Constant) and node.args[2].value == 0.
    76	            node.func = ast.Name(id='c3_native_dc_fill', ctx=ast.Load())
    77	            node.args.insert(0, ast.Name(id='stft_repr', ctx=ast.Load()))
    78	            replacements += 1
    79	    assert replacements == 1, 'expected the single public DC-filter call'
    80	    source = ast.unparse(ast.fix_missing_locations(tree)) + '\n'
    81	    restored = ast.parse(source)
    82	    for node in ast.walk(restored):
    83	        if isinstance(node, ast.Call) and ast.unparse(node.func) == 'c3_native_dc_fill':
    84	            base = node.args.pop(0)
    85	            node.func = ast.Attribute(value=base, attr='index_fill', ctx=ast.Load())
    86	    assert ast.dump(restored) == ast.dump(ast.parse(original))
    87	    Path(out_dir).mkdir(parents=True, exist_ok=True)
    88	    dest = Path(out_dir) / 'generated_public_forward.py'
    89	    dest.write_text(source)
    90	    namespace = dict(MelBandRoformer.forward.__globals__)
    91	    namespace['c3_native_dc_fill'] = call_native_dc_fill
    92	    exec(compile(source, str(dest), 'exec'), namespace)
    93	    model.forward = types.MethodType(namespace['forward'], model)
    94	    return {'status': 'PASS', 'replacements': replacements,
    95	            'original_forward_sha256': hashlib.sha256(original.encode()).hexdigest(),
    96	            'external_forward_sha256': hashlib.sha256(source.encode()).hexdigest(),
    97	            'generated_source': str(dest), 'native_call': 'Tensor.index_fill',
    98	            'custom_op': 'fullmodel_c3::native_dc_fill_t', 'new_gpu_kernel': False,
    99	            'cudagraph_unsafe_tag': False, 'frames_supported': list(FRAMES),
   100	            'adaptation_of': 'axial-layout-scoping@a6f3e6f extensions/c3/native_tail.py',
   101	            'scope': 'public forward differs only in DC-filter callee; op checks parametrised by frames'}
   102	
   103	
   104	def verify_operator(frames=FRAMES):
   105	    """Per registered T: schema/fake checks, bitwise native equality,
   106	    CUDA-graph capture/replay, isolated full-graph compile."""
   107	    out = {}
   108	    for T in frames:
   109	        gen = torch.Generator(device='cpu').manual_seed(4242)
   110	        x = torch.randn((1025, 2, T), generator=gen, dtype=torch.complex64).to('cuda')
   111	        x = x.permute(1, 0, 2)
   112	        index = torch.tensor(0, device='cuda')
   113	        with torch.no_grad(), torch.autocast('cuda', enabled=True):
   114	            checks = torch.library.opcheck(native_dc_fill, (x, index),
   115	                                          test_utils=('test_schema', 'test_faketensor'))
   116	            reference = x.index_fill(1, index, 0.)
   117	            actual = native_dc_fill(x, index)
   118	            assert torch.equal(actual, reference)
   119	            graph = torch.cuda.CUDAGraph()
   120	            with torch.cuda.graph(graph):
   121	                captured = native_dc_fill(x, index)
   122	            graph.replay()
   123	            torch.cuda.synchronize()
   124	            assert torch.equal(captured, reference)
   125	            torch._dynamo.reset()
   126	            compiled = torch.compile(native_dc_fill, mode='reduce-overhead',
   127	                                     dynamic=False, fullgraph=True)
   128	            for _ in range(6):
   129	                result = compiled(x, index).clone()
   130	            torch.cuda.synchronize()
   131	            assert torch.equal(result, reference)
   132	        out[str(T)] = {'status': 'PASS', 'opcheck': checks, 'native_bitwise_equal': True,
   133	                       'cuda_graph_capture_and_replay': 'PASS', 'compiled_fullgraph': 'PASS',
   134	                       'output_shape': list(actual.shape), 'output_stride': list(actual.stride())}
   135	    torch._dynamo.reset()
   136	    return out
