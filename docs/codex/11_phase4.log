     1	"""Phase 4 §2B — analysis revision of the matched-pair statistics (historical outputs preserved).
     2	
     3	Estimand: for a matched pair (a, b) at one operating point, the per-repeat paired difference
     4	d = median(latency_a over 50 passes) − median(latency_b over 50 passes), where a and b blocks
     5	alternate within one process (repeat = one a-block and the following b-block). Experimental
     6	unit for inference: the process restart (each restart is an independent compile + settle +
     7	5 repeats); repeats within a restart are treated as clustered, not independent.
     8	
     9	Point estimate (unchanged from the historical report): median over restarts of the per-restart
    10	median of d ("median of restart medians").
    11	Interval (revised): a two-level (cluster) bootstrap that resamples restarts with replacement and,
    12	within each drawn restart, repeats with replacement, recomputing the same statistic; 10,000
    13	draws, seed 20260921, percentile 2.5/97.5. With three restarts this interval is coarse and
    14	cannot be narrower than the spread of the three restart medians; the restart medians and their
    15	range are reported beside it. The historical interval (pooled-repeat median bootstrap) is kept
    16	for comparison and labelled as estimating a different statistic.
    17	Clock-flagged repeats are excluded exactly as the audit flags them (e_tools.drift_context).
    18	"""
    19	import argparse
    20	import glob
    21	import json
    22	import os
    23	import random
    24	import statistics
    25	import sys
    26	
    27	_HERE = os.path.dirname(os.path.abspath(__file__))
    28	if _HERE not in sys.path:
    29	    sys.path.insert(0, _HERE)
    30	import e_tools  # noqa: E402
    31	
    32	BOOT_N, BOOT_SEED = 10000, 20260921
    33	
    34	
    35	def cluster_bootstrap(restart_diffs, n=BOOT_N, seed=BOOT_SEED):
    36	    """restart_diffs: list (restarts) of lists (per-repeat differences). Returns (lo, hi) of the
    37	    median-of-restart-medians under a two-level bootstrap."""
    38	    rnd = random.Random(seed)
    39	    k = len(restart_diffs)
    40	    vals = []
    41	    for _ in range(n):
    42	        meds = []
    43	        for _ in range(k):
    44	            r = restart_diffs[rnd.randrange(k)]
    45	            meds.append(statistics.median([r[rnd.randrange(len(r))] for _ in range(len(r))]))
    46	        vals.append(statistics.median(meds))
    47	    vals.sort()
    48	    return vals[int(0.025 * n)], vals[int(0.975 * n) - 1]
    49	
    50	
    51	def pair_stats(ev, a, b, O, manifest_id, flags):
    52	    per = []
    53	    files = []
    54	    for f in sorted(glob.glob(os.path.join(ev, f'matched_{a}_{b}_c{O}_m*.json'))):
    55	        m = e_tools._load(f)
    56	        r, why = e_tools.pair_reduce(m, manifest_id, flags)
    57	        if r is None:
    58	            continue
    59	        per.append(r['diffs']); files.append(os.path.basename(f))
    60	    if not per:
    61	        return None
    62	    rmeds = [statistics.median(d) for d in per]
    63	    pooled = [x for d in per for x in d]
    64	    lo, hi = cluster_bootstrap(per)
    65	    plo, phi = e_tools._boot_ci(pooled)
    66	    return {'files': files, 'restarts': len(per), 'repeats_used': len(pooled),
    67	            'restart_medians_ms': rmeds, 'restart_median_range_ms': [min(rmeds), max(rmeds)],
    68	            'point_estimate_ms (median of restart medians)': statistics.median(rmeds),
    69	            'ci95_cluster_bootstrap_ms (revised; same statistic)': [lo, hi],
    70	            'historical': {'pooled_repeat_median_ms': statistics.median(pooled), 'ci95_pooled_repeat_bootstrap_ms': [plo, phi],
    71	                           'note': 'the historical interval resampled pooled repeats (a different statistic from the reported point estimate)'},
    72	            'inference_scope': 'this pod, this session, this software configuration; three restarts limit the interval to the restart-median spread'}
    73	
    74	
    75	def main():
    76	    ap = argparse.ArgumentParser()
    77	    ap.add_argument('--evidence-dir', required=True)
    78	    ap.add_argument('--pairs', nargs='+', default=['C3:H:176400', 'C3:H:264600', 'C3:C3M:352800', 'C3:C3M:4410', 'C3:C3G:352800', 'C3:C3G:4410', 'C3:C3P:352800', 'C3:C3P:4410',
    79	                                                  'C3:C3F:352800', 'C3:C3F:4410', 'C1:C1P:352800', 'C3M:C3N:352800', 'C3M:C3N:4410', 'C3:C3:352800', 'C3:C3:4410', 'C3:C3:176400', 'C3:C3:264600'])
    80	    ap.add_argument('--out', required=True)
    81	    a = ap.parse_args()
    82	    manifest_id, flags = e_tools.drift_context(a.evidence_dir)
    83	    out = {'estimand_and_method': __doc__, 'pairs': {}}
    84	    for spec in a.pairs:
    85	        x, y, O = spec.split(':')
    86	        r = pair_stats(a.evidence_dir, x, y, int(O), manifest_id, flags)
    87	        out['pairs'][spec] = r or {'status': 'UNRESOLVED: no eligible pair'}
    88	        if r:
    89	            print(f"{spec:18s} point {r['point_estimate_ms (median of restart medians)']:+.4f}  cluster CI {r['ci95_cluster_bootstrap_ms (revised; same statistic)'][0]:+.4f}..{r['ci95_cluster_bootstrap_ms (revised; same statistic)'][1]:+.4f}  restart medians {[round(v, 3) for v in r['restart_medians_ms']]}  | historical pooled {r['historical']['pooled_repeat_median_ms']:+.4f} CI {r['historical']['ci95_pooled_repeat_bootstrap_ms'][0]:+.4f}..{r['historical']['ci95_pooled_repeat_bootstrap_ms'][1]:+.4f}")
    90	    json.dump(out, open(a.out, 'w'), indent=1)
    91	
    92	
