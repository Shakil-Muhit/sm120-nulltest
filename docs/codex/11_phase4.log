   167	def pair_reduce(m, manifest_id=None, flags=None):
   168	    """The one reducer every publisher uses (gate-10 f143/f144): the record must pass the shared
   169	    validator (qualify.pair_problems) and belong to the session manifest; per-repeat a − b
   170	    differences are recomputed from the samples, joined by repeat identity (not list order);
   171	    repeats the clock rule flagged are excluded. Returns None (with a reason) when nothing
   172	    eligible remains."""
   173	    if m is None:
   174	        return None, ['record missing']
   175	    probs = qualify.pair_problems(m)
   176	    if probs:
   177	        return None, probs
   178	    if manifest_id and m.get('manifest_id') != manifest_id:
   179	        return None, ['foreign manifest']
   180	    a, b = m['pair']
   181	    reps = {}
   182	    for blk in m.get('blocks') or []:
   183	        lat = blk.get('latency_ms_per_iter') or []
   184	        if len(lat) != qualify.REGISTERED_ITERS:
   185	            return None, ['block sample count is not the registered 50']
   186	        reps.setdefault(blk.get('repeat'), {})[blk.get('arm')] = qualify._median(lat)
   187	    key = (tuple(m['pair']), int(m['chunk']), m.get('tag'))
   188	    fl = ((flags or {}).get('pairs') or {}).get(key) or {}
   189	    diffs, walls_a, walls_b, excluded = [], [], [], []
   190	    for rep in sorted(k for k in reps if k is not None):
   191	        pr = reps[rep]
   192	        if a not in pr or b not in pr:
   193	            return None, [f'repeat {rep} lacks both arms']
   194	        if rep in fl:
   195	            excluded.append(rep)
   196	            continue
   197	        diffs.append(pr[a] - pr[b]); walls_a.append(pr[a]); walls_b.append(pr[b])
   198	    if not diffs:
   199	        return None, [f'every repeat clock-drift flagged: {fl}']
   200	    return {'diffs': diffs, 'median': statistics.median(diffs), 'a_wall': min(walls_a), 'b_wall': min(walls_b),
   201	            'excluded_repeats': excluded, 'repeats_used': len(diffs), 'file': f"matched_{a}_{m['pair'][1]}_c{m['chunk']}_{m.get('tag')}.json"}, []
   202	
   203	
   204	def pair_series(ev, a, b, O, manifest_id=None, flags=None):
   205	    """All eligible restarts of a pair: medians per restart, pooled clean per-repeat differences, walls."""
   206	    meds, pooled, files, wa, wb, excluded, rejected = [], [], [], [], [], {}, {}
   207	    for f in sorted(glob.glob(os.path.join(ev, f'matched_{a}_{b}_c{O}_m*.json'))):
   208	        m = _load(f)
   209	        r, why = pair_reduce(m, manifest_id, flags)
   210	        if r is None:
   211	            rejected[os.path.basename(f)] = why
   212	            continue
   213	        meds.append(r['median']); pooled += r['diffs']; files.append(os.path.basename(f)); wa.append(r['a_wall']); wb.append(r['b_wall'])
   214	        if r['excluded_repeats']:
   215	            excluded[os.path.basename(f)] = r['excluded_repeats']
   216	    if not meds:
   217	        return None, rejected
   218	    return {'median_ms': statistics.median(meds), 'ci95_ms': _boot_ci(pooled), 'restarts': len(meds), 'repeats_used': len(pooled),
   219	            'files': files, 'excluded_repeats': excluded, 'rejected': rejected,
   220	            'a_wall_ms': statistics.median(wa), 'b_wall_ms': statistics.median(wb)}, rejected
   221	
