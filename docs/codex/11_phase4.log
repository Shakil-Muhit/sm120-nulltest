   331	def audit_clock_drift(ev, items, session, runs, matched, gpu_uuid, limit=0.05):
   332	    """Adds the informational drift item; the consequences are scoped per comparison by the callers."""
   333	    flagged = drift_flags(ev, session, runs, matched, gpu_uuid, limit)
   334	    n_bad = len(flagged['pairs']) + len(flagged['cells'])
   335	    unresolved, checked = flagged['unresolved'], flagged['checked']
   336	    item(items, f'clock drift <= {limit * 100:.0f} % between compared blocks: {checked} comparisons, {n_bad} flagged (informational; consequences are scoped per comparison)',
   337	         checked > 0 and not unresolved, [f'unresolved (no samples near block) {unresolved[:4]}'] if unresolved else ['no comparisons'],
   338	         note=(('flagged: ' + '; '.join(f'{k}: {v}' for k, v in list(flagged['pairs'].items())[:8] + list(flagged['cells'].items())[:4])) if n_bad else 'no violations'),
   339	         optional=True)
   340	    return flagged
