   442	                row['api_sum_us (not additive; for reference)'] = sum(min(c[1], en) - c[0] for c in calls) / 1e3
   443	            per.append(row)
   444	        def med(k):
   445	            v = [p[k] for p in per if k in p]
   446	            return statistics.median(v) if v else None
