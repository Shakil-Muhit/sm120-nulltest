   235	    if session in ('session1', 'session3', 'session4'):
   236	        for (pair, c, t), m in matched.items():
   237	            out += [(b.get('unix_start'), b.get('unix_end'), f'matched {pair}/{t}') for b in (m.get('blocks') or [])]
   238	    return out
