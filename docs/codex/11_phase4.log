   269	def block_sm_median(series, a, b, window=3.0):
   270	    # with the 5 Hz session-3 sampler most 100 ms blocks hold their own samples; the window is the fallback
   271	    """Median SM clock over the samples inside [a, b]; a block shorter than the 1 Hz
   272	    sampling interval (50 passes at 100 ms take 0.15 s) uses the nearest samples within
   273	    `window` seconds on either side instead."""
   274	    if not series or not (fin(a) and fin(b)):
   275	        return None
   276	    ts = [t for t, _ in series]
   277	    i = bisect.bisect_left(ts, a); j = bisect.bisect_right(ts, b)
   278	    vals = [v for _, v in series[i:j]]
   279	    if not vals:
   280	        i = bisect.bisect_left(ts, a - window); j = bisect.bisect_right(ts, b + window)
   281	        vals = [v for _, v in series[i:j]]
   282	    return qualify._median(vals) if vals else None
