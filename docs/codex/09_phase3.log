   153	# finalize_session SESSION: collection and audit are supervised; a failure of
   154	# either leaves an explicit INCOMPLETE session record (gate-04 f57)
   155	finalize_session() {
   156	    local sess="$1" verdict
   157	    # a previous verdict never survives a new finalisation (gate-05 f74)
   158	    rm -f "$EVID/session_status.json" "$EVID/summary_full.json" "$EVID/aux_collect.json" "$EVID/aux_completeness.json"
   159	    if ! run_aux collect 600 -- python "$REPO_DIR/fullmodel/collect_full.py" --evidence-dir "$EVID"; then
   160	        python3 -c "import json;json.dump({'session':'$sess','verdict':'INCOMPLETE','reason':'collection failed'},open('$EVID/session_status.json','w'))"
   161	    fi
   162	    if ! run_aux completeness 300 -- python "$REPO_DIR/fullmodel/completeness.py" --evidence-dir "$EVID" --session "$sess"; then
   163	        python3 -c "import json;json.dump({'session':'$sess','verdict':'INCOMPLETE','reason':'completeness audit failed or timed out'},open('$EVID/session_status.json','w'))"
   164	    fi
   165	    [ -s "$EVID/session_status.json" ] || python3 -c "import json;json.dump({'session':'$sess','verdict':'INCOMPLETE','reason':'no audit record'},open('$EVID/session_status.json','w'))"
   166	    verdict=$(python3 -c "import json;print(json.load(open('$EVID/session_status.json')).get('verdict','INCOMPLETE'))" 2>/dev/null || echo INCOMPLETE)
   167	    echo "SESSION VERDICT ($sess): $verdict"
   168	}
   169	
   170	# bounded auxiliary command: run_aux NAME CAP -- cmd...   (supervisor messages
   171	# go to STDERR so a redirected stdout stays clean; a terminal JSON records
   172	# the outcome either way)
   173	aux_json() {   # name status reason
   174	    python3 -c "import json,sys;json.dump({'item':sys.argv[1],'status':sys.argv[2],'reason':sys.argv[3]},open('$EVID/aux_'+sys.argv[1]+'.json','w'))" "$1" "$2" "$3"
   175	}
   176	run_aux() {
   177	    local name="$1" want="$2"; shift 2; [ "$1" = "--" ] && shift
   178	    local cap; cap=$(cap_for "$want")
   179	    if [ "$cap" -lt 60 ]; then
   180	        echo "--- $name: DEADLINE -> skipped (UNTESTED) ---" >&2
   181	        aux_json "$name" UNTESTED "session deadline"; return 1
   182	    fi
   183	    echo "--- $name $(date -Is) cap=${cap}s ---" >&2
   184	    timeout -k 30 "$cap" "$@"; local rc=$?
   185	    if [ "$rc" = "0" ]; then aux_json "$name" OK ""; else
   186	        echo "    $name exit $rc" >&2
   187	        aux_json "$name" $([ "$rc" = "124" ] && echo UNTESTED || echo FAILED) "exit $rc"
   188	    fi
   189	    return $rc
   190	}
   191	
   192	clocks_start() {   # file
   193	    nvidia-smi --query-gpu=timestamp,uuid,clocks.sm,clocks.mem,power.draw,temperature.gpu,utilization.gpu \
   194	        --format=csv,noheader -l 1 > "$1" 2>/dev/null &
   195	    CLK_PID=$!
   196	    trap 'kill $CLK_PID 2>/dev/null' EXIT
   197	}
     1	#!/bin/bash
     2	# SESSION 3 (prereg_amendments.md v0.2 — Phase 3 experiment registrations E1–E9).
     3	# Order (handoff §4): E6 → E3 → E2 → E1 → E9 → E4a → E5 → E7, then post-processing,
     4	# collection and the completeness verdict. Same deadline / reserve / terminal-record
     5	# rules as sessions 1–2 (scripts/session_lib.sh). E5 and E7 are optional under the
     6	# deadline (registered: skipping them is not a failure). SHAKEDOWN=1 (engineering
     7	# host): the E9 held-out lengths are recorded UNTESTED with the registered reason and
     8	# are never run; the audit verdict then carries shakedown=true and is never evidence.
     9	set -u
    10	. "$(dirname "${BASH_SOURCE[0]}")/session_lib.sh"
    11	HEADLINE_ARMS="${HEADLINE_ARMS:-C3 H A C1}"
    12	HEADLINE_RESTARTS="${HEADLINE_RESTARTS:-5}"
    13	E5_BUDGET_S="${E5_BUDGET_S:-3600}"
    14	E5_VARIANTS="${E5_VARIANTS:-d1_mfull d1_mquarter d6_mfull d6_mquarter}"
    15	E5_RESTARTS="${E5_RESTARTS:-2}"
    16	SHAKEDOWN="${SHAKEDOWN:-0}"
    17	HELD_OUT="176400 264600"
    18	export REQUIRED_RESTARTS="$HEADLINE_RESTARTS"
    19	REG="$REPO_DIR/docs/phase3/e9/e9_cost_model.json"
    20	mkdir -p "$EVID" "$REF" "$EVID/traces"
    21	cd "$REPO_DIR"
    22	exec > >(tee -a "$EVID/session3_console.log") 2>&1
    23	echo "SESSION3 START $(date -Is) iters=$ITERS repeats=$REPEATS restarts=$RESTARTS headline_restarts=$HEADLINE_RESTARTS budget=${SESSION_BUDGET_S}s reserve=${EXTRACT_RESERVE_S}s shakedown=$SHAKEDOWN pod=${SESSION_POD:-0}"
    24	[ -z "${TMUX:-}" ] && echo "WARNING: not inside tmux"
    25	python3 -c "import json;json.dump({'shakedown': '$SHAKEDOWN'=='1', 'session_pod': '${SESSION_POD:-0}'=='1', 'headline_restarts': $HEADLINE_RESTARTS, 'pair_restarts': $RESTARTS, 'e5_variants': '$E5_VARIANTS'.split(), 'e5_restarts': $E5_RESTARTS, 'e9_registration': '$REG', 'e9_registration_sha256': __import__('hashlib').sha256(open('$REG','rb').read()).hexdigest()}, open('$EVID/session3_config.json','w'), indent=1)"
    26	
     1	"""Merge full_*.json / matched_*.json into the arms x chunks table.
     2	
     3	Headline rule (registered): a cell publishes a HEADLINE only if restarts
     4	r1, r2 AND r3 (exactly the registered set) all exist, are headline_eligible,
     5	share ONE session manifest and ONE effective variant (capture scope /
     6	adapter / compile mode / stream count), and the cell's SDR qualification —
     7	taken ONLY from the r1 record (the registered lifecycle: gate in r1), same
     8	manifest and variant — is PASS. A failed required restart is never replaced
     9	by a later tag. Otherwise INCOMPLETE with reasons.
    10	Matched pairs: a pair headline requires m1, m2 AND m3 all pair_eligible with
    11	one manifest and one variant pair, and SDR PASS (r1 records, same manifest
    12	and variant) for both arms' cells at that operating point.
    13	The completeness audit (session status) lives in completeness.py.
    14	"""
    15	
    16	import argparse
    17	import glob
    18	import json
    19	import os
    20	import statistics
    21	import sys
    22	
    23	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    24	import qualify  # noqa: E402
    25	
    26	REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    27	ARMS = ('A', 'B', 'C1', 'C2', 'C3', 'C1A', 'C1D', 'D', 'E', 'F', 'G', 'H', 'ANVTX')
    28	CHUNKS = (352800, 4410, 22050, 88200)
    29	import os as _os
    30	REQUIRED_RESTARTS = tuple(f'r{i}' for i in range(1, int(_os.environ.get('REQUIRED_RESTARTS', '3')) + 1))
    31	REQUIRED_MATCHED = ('m1', 'm2', 'm3')
    32	
    33	
    34	def load(evidence_dir):
    35	    runs = {}
    36	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'full_*.json'))):
    37	        with open(path) as f:
    38	            r = json.load(f)
    39	        runs.setdefault((r['arm'], r['chunk']), {})[r['tag']] = r
    40	    return runs
    41	
    42	
    43	def variant(r):
    44	    """Canonical variant re-derived from the record's fields (never the stored string)."""
    45	    return qualify.variant(r)
    46	
    47	
    48	def sdr_from_r1(tag_runs, chunk, manifest_id, var):
    49	    """The registered qualification record: r1, same manifest, same variant,
    50	    gate PASS at this operating point, clip outputs lineage-hashed."""
    51	    r1 = tag_runs.get('r1')
    52	    probs = qualify.sdr_problems(r1, chunk, manifest_id, var)
    53	    g = (r1 or {}).get('sdr_gate') or {}
    54	    return (g.get('status', 'NONE') if not probs else 'NONE'), g.get('mean_delta_sdr_ref_db'), ('; '.join(probs) or None)
    55	
    56	
    57	def cell(tag_runs):
    58	    req = {t: tag_runs.get(t) for t in REQUIRED_RESTARTS}
    59	    present = [r for r in req.values() if r]
    60	    chunk = present[0]['chunk'] if present else None
    61	    manifests = sorted({str(r.get('manifest_id')) for r in present})
    62	    variants = sorted({variant(r) for r in present})
    63	    ref_hashes = sorted({json.dumps(qualify.reference_hashes(r), sort_keys=True) for r in present})
    64	    manifest_id = manifests[0] if len(manifests) == 1 else None
    65	    var = variants[0] if len(variants) == 1 else None
    66	    sdr, sdr_delta, sdr_note = sdr_from_r1(tag_runs, chunk, manifest_id, var)
    67	    c = {'restarts_found': sorted(t for t in tag_runs if t.startswith('r')),
    68	         'statuses': {t: (r or {}).get('status', 'MISSING') for t, r in req.items()},
    69	         'tier': sorted({r.get('registered_tier') or r.get('tier') for r in present if r.get('tier')}),
    70	         'validation': {t: ((r or {}).get('validation') or {}).get('status', 'NONE') for t, r in req.items()},
    71	         'sdr_gate': sdr, 'mean_delta_sdr_ref_db': sdr_delta, 'sdr_note': sdr_note,
    72	         'manifests': manifests, 'variants': variants,
    73	         'graph_breaks': sorted({str(((r or {}).get('graph_gate') or {}).get('graph_break_count')) for r in present}),
    74	         'per_restart_min_of_medians_ms': {t: (r or {}).get('min_of_medians_ms') for t, r in req.items()},
    75	         'per_restart_spread_ms': {t: (r or {}).get('median_spread_ms') for t, r in req.items()},
    76	         'headline_status': 'INCOMPLETE', 'headline_ms': None, 'restart_spread_ms': None,
    77	         'throughput_best_ms': None, 'reasons': []}
    78	    for t, r in req.items():
    79	        if r is None:
    80	            c['reasons'].append(f'{t} missing')
    81	            continue
    82	        probs = qualify.run_problems(r)          # independent of stored flags (gate-04 f47)
    83	        if probs:
    84	            c['reasons'].append(f"{t}: {'; '.join(probs)}")
    85	        if r.get('headline_eligible') and probs:
    86	            c['reasons'].append(f'{t}: stored eligibility flag contradicts the record')
    87	    if len(manifests) != 1 or manifests == ['None']:
    88	        c['reasons'].append(f'restarts do not share one session manifest: {manifests}')
    89	    if len(variants) != 1:
    90	        c['reasons'].append(f'effective variants differ: {variants}')
    91	    if len(ref_hashes) != 1 or ref_hashes == ['{}']:
    92	        c['reasons'].append('restarts were not validated against one lineage-hashed reference set')
    93	    c['reference_hashes'] = json.loads(ref_hashes[0]) if len(ref_hashes) == 1 else None
    94	    c['clip_output_hashes'] = qualify.reference_hashes(tag_runs['r1'], include_clips=True) if tag_runs.get('r1') else None
    95	    if sdr != 'PASS':
    96	        c['reasons'].append(f'SDR qualification (r1) at this operating point: {sdr}' + (f' ({sdr_note})' if sdr_note else ''))
    97	    if not c['reasons']:
    98	        # published statistics recomputed from the samples (gate-05 f64), never
    99	        # copied from stored summaries (which the validator already cross-checked)
   100	        rts = {t: qualify.recomputed_timing(req[t]['timing'], qualify.REGISTERED_ITERS, qualify.REGISTERED_REPEATS)
   101	               for t in REQUIRED_RESTARTS}
   102	        if any(r is None for r in rts.values()):
   103	            c['reasons'].append('timing samples could not be recomputed')
   104	        else:
   105	            vals = [rts[t]['min_of_medians_ms'] for t in REQUIRED_RESTARTS]
   106	            c['headline_status'] = 'HEADLINE'
   107	            c['headline_ms'] = statistics.median(vals)
   108	            c['restart_spread_ms'] = max(vals) - min(vals)
   109	            c['throughput_best_ms'] = min(rts[t]['throughput_best_ms'] for t in REQUIRED_RESTARTS)
   110	            c['per_restart_min_of_medians_ms'] = {t: rts[t]['min_of_medians_ms'] for t in REQUIRED_RESTARTS}
   111	            c['per_restart_spread_ms'] = {t: rts[t]['median_spread_ms'] for t in REQUIRED_RESTARTS}
   112	    vals = [v for v in c['per_restart_min_of_medians_ms'].values() if v]
   113	    c['diagnostic_median_ms'] = statistics.median(vals) if vals else None
   114	    return c
   115	
   116	
   117	def fmt(v, spec='.4f'):
   118	    return format(v, spec) if isinstance(v, (int, float)) else '-'
   119	
   120	
   121	def pair_summaries(evidence_dir, cells, runs, verbose=False):
   122	    pairs = {}
   123	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'matched_*.json'))):
   124	        with open(path) as f:
   125	            m = json.load(f)
   126	        a, b = m['pair']
   127	        key = f"{a}_vs_{b}_c{m['chunk']}"
   128	        pairs.setdefault(key, {})[m['tag']] = m
   129	    pair_summary = {}
   130	    if pairs and verbose:
   131	        print('\nmatched pairs (median over alternating blocks of a - b, ms):')
   132	    for key, by_tag in sorted(pairs.items()):
   133	        a, b = key.split('_vs_')[0], key.split('_vs_')[1].rsplit('_c', 1)[0]
   134	        chunk = int(key.rsplit('_c', 1)[1])
   135	        reasons = []
   136	        req = {t: by_tag.get(t) for t in REQUIRED_MATCHED}
   137	        for t, m in req.items():
   138	            if m is None:
   139	                reasons.append(f'{t} missing')
   140	                continue
   141	            probs = qualify.pair_problems(m)     # independent of stored flags
   142	            if probs:
   143	                reasons.append(f"{t}: {'; '.join(probs)}")
   144	        present = [m for m in req.values() if m]
   145	        mans = sorted({str(m.get('manifest_id')) for m in present})
   146	        vars_ = sorted({json.dumps({k: qualify.variant(v) for k, v in (m.get('arms') or {}).items()}, sort_keys=True)
   147	                        for m in present})
   148	        if len(mans) != 1 or mans == ['None']:
   149	            reasons.append(f'matched restarts do not share one manifest: {mans}')
   150	        if len(vars_) != 1:
   151	            reasons.append('matched restarts differ in effective variants')
   152	        for arm in (a, b):
   153	            ca = cells.get((arm, chunk)) if isinstance(next(iter(cells), None), tuple) else cells.get(f'{arm}_{chunk}')
   154	            r1 = (runs.get((arm, chunk)) or {}).get('r1')
   155	            if not ca or ca['sdr_gate'] != 'PASS':
   156	                reasons.append(f'{arm}: SDR qualification at {chunk} is {(ca or {}).get("sdr_gate", "NONE")}')
   157	                continue
   158	            if mans and ca['manifests'] != mans:
   159	                reasons.append(f'{arm}: SDR qualification from another manifest')
   160	            mv = {qualify.variant((m.get('arms') or {}).get(arm) or {}) for m in present}
   161	            if len(mv) != 1 or (r1 and qualify.variant(r1) not in mv):
   162	                reasons.append(f'{arm}: matched variant differs from its r1 SDR-qualified variant')
   163	        rec_d = {t: (qualify.recomputed_matched_delta(m) if m else None) for t, m in by_tag.items()}
   164	        for t, m in req.items():
   165	            if m and rec_d.get(t) and (m.get('matched_delta_ms') or {}).get('median') is not None:
   166	                if abs(rec_d[t]['median'] - m['matched_delta_ms']['median']) > 1e-9:
   167	                    reasons.append(f'{t}: stored matched delta differs from the value recomputed from samples')
   168	        deltas = {t: (d['median'] if d else None) for t, d in rec_d.items()}
   169	        entry = {'required': {t: (m or {}).get('pair_eligible') for t, m in req.items()},
   170	                 'deltas_ms': deltas, 'reasons': reasons,
   171	                 'pair_headline': 'HEADLINE' if not reasons else 'INCOMPLETE'}
   172	        if not reasons:
   173	            entry['median_delta_ms'] = statistics.median(rec_d[t]['median'] for t in REQUIRED_MATCHED)
   174	            entry['median_delta_pct_of_a'] = statistics.median(rec_d[t]['median_pct_of_a'] for t in REQUIRED_MATCHED)
   175	        pair_summary[key] = entry
   176	        if verbose:
   177	            print(f"  {key}: {entry['pair_headline']} deltas {deltas} "
   178	                  + (f"-> median {entry['median_delta_ms']:+.4f} ms ({entry['median_delta_pct_of_a']:+.2f}% of a)" if not reasons else f"reasons {reasons}"))
   179	    return pair_summary
   180	
   181	
   182	def main():
   183	    ap = argparse.ArgumentParser()
   184	    ap.add_argument('--evidence-dir', default=os.path.join(REPO_ROOT, 'evidence'))
   185	    args = ap.parse_args()
   186	    runs = load(args.evidence_dir)
   187	    cells = {k: cell(v) for k, v in runs.items()}
   188	    print('| arm | chunk | r1/r2/r3 | tier | SDR r1 (mean ΔSDR dB) | headline | ms | restart spread | best thr ms | variant / breaks | reasons |')
   189	    print('|---|---|---|---|---|---|---|---|---|---|---|')
   190	    for chunk in CHUNKS:
   191	        for arm in ARMS:
   192	            c = cells.get((arm, chunk))
   193	            if not c:
   194	                continue
   195	            st = '/'.join(c['statuses'][t][:4] for t in REQUIRED_RESTARTS)
   196	            print(f"| {arm} | {chunk} | {st} | {'/'.join(c['tier'])} | {c['sdr_gate']} "
   197	                  f"({fmt(c['mean_delta_sdr_ref_db'], '+.3f')}) | {c['headline_status']} | "
   198	                  f"{fmt(c['headline_ms'])} | {fmt(c['restart_spread_ms'])} | {fmt(c['throughput_best_ms'])} | "
   199	                  f"{' '.join(c['variants'])} b={'/'.join(c['graph_breaks'])} | {'; '.join(c['reasons'])[:140]} |")
   200	    pair_summary = pair_summaries(args.evidence_dir, cells, runs, verbose=True)
   201	    out = os.path.join(args.evidence_dir, 'summary_full.json')
   202	    with open(out, 'w') as f:
   203	        json.dump({'cells': {f'{a}_{c}': v for (a, c), v in cells.items()},
   204	                   'matched_pairs': pair_summary,
   205	                   'runs': {f'{a}_{c}_{t}': r for (a, c), tr in runs.items() for t, r in tr.items()}},
   206	                  f, indent=1)
   207	    print(f'\nwritten: {out}')
   208	
   209	
   210	if __name__ == '__main__':
   211	    main()

