     3	checkpoint. Timing only; validation = self-consistency against the variant's
     4	own eager-A reference (ref_variant_<name>/). Never headline-eligible."""
     5	
     6	import hashlib
     7	import os
     8	import re
     9	import sys
    10	
    11	import torch
    12	
    13	VARIANTS = {          # name: (depth, mlp_expansion_factor)
    14	    'd1_mfull': (1, 4), 'd1_mquarter': (1, 1), 'd6_mfull': (6, 4), 'd6_mquarter': (6, 1)}
    15	SEED = 20260921
    16	
    17	
    18	def variant_config(public_config_path, name, out_dir):
    19	    depth, mlp = VARIANTS[name]
    20	    txt = open(public_config_path).read()
    21	    assert re.search(r'^  depth: \d+\s*$', txt, flags=re.M), 'public config has no model.depth line'
    22	    txt = re.sub(r'^  depth: \d+\s*$', f'  depth: {depth}', txt, count=1, flags=re.M)
    23	    if re.search(r'^  mlp_expansion_factor: ', txt, flags=re.M):
    24	        txt = re.sub(r'^  mlp_expansion_factor: .*$', f'  mlp_expansion_factor: {mlp}', txt, count=1, flags=re.M)
    25	    else:
    26	        txt = re.sub(r'^(  mask_estimator_depth: .*)$', rf'\1\n  mlp_expansion_factor: {mlp}', txt, count=1, flags=re.M)
    27	    assert f'  mlp_expansion_factor: {mlp}' in txt
    28	    os.makedirs(out_dir, exist_ok=True)
    29	    path = os.path.join(out_dir, f'variant_{name}.yaml')
    30	    with open(path, 'w') as f:
    31	        f.write(txt)
    32	    return path
    33	
    34	
    35	def load_variant_model(msst_dir, public_config_path, name, out_dir, device='cuda'):
    36	    import functools
    37	    if msst_dir not in sys.path:
    38	        sys.path.insert(0, msst_dir)
    39	    from utils.settings import get_model_from_config
    40	    vpath = variant_config(public_config_path, name, out_dir)
    41	    torch.manual_seed(SEED)
    42	    model, config = get_model_from_config('mel_band_roformer', vpath)
    43	    model = model.to(device).eval()
    44	    use_amp = config.training.use_amp
    45	    assert isinstance(use_amp, bool)
    46	    ctx = functools.partial(torch.autocast, 'cuda', enabled=use_amp)
    47	    ctx_nocache = functools.partial(torch.autocast, 'cuda', enabled=use_amp, cache_enabled=False)
    48	    n = sum(p.numel() for p in model.parameters())
    49	    me = sum(p.numel() for p in model.mask_estimators.parameters())
    50	    depth, mlp = VARIANTS[name]
    51	    rec = {'variant': name, 'depth': depth, 'mlp_expansion_factor': mlp, 'seed': SEED,
    52	           'param_count': n, 'param_bytes_fp16': n * 2,
    53	           'mask_estimator_param_count': me, 'mask_estimator_bytes_fp16': me * 2,
    54	           'variant_config': vpath, 'variant_config_sha256': hashlib.sha256(open(vpath, 'rb').read()).hexdigest(),
    55	           'public_config_sha256': hashlib.sha256(open(public_config_path, 'rb').read()).hexdigest()}
    56	    return model, config, use_amp, ctx, ctx_nocache, rec

