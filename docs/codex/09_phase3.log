    43	def snapshot_complete(x):
    44	    """A recording snapshot must carry complete counters and observer fields."""
    45	    if not isinstance(x, dict):
    46	        return False
    47	    c, t = x.get('counters'), x.get('tree')
    48	    if not isinstance(c, dict) or not isinstance(t, dict):
    49	        return False
    50	    # dynamo counters only carry keys that occurred: graph_break / unimplemented
    51	    # are absent when zero; stats and inductor are always present
    52	    if not (isinstance(c.get('stats'), dict) and isinstance(c.get('inductor'), dict)):
    53	        return False
    54	    ug = c['stats'].get('unique_graphs')
    55	    if not (isinstance(ug, int) and not isinstance(ug, bool) and ug >= 0):
