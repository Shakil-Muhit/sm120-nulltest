   457	def csv_rows(path, required_cols):
   458	    """Parse an export: header must contain the required columns; returns row count."""
   459	    import csv
   460	    try:
   461	        with open(path, newline='') as f:
   462	            rd = csv.reader(f)
   463	            head = [h.strip().strip('"').lower() for h in next(rd)]
   464	            # nsys spells the correlation column 'CorrId' (GPU trace) and 'CorrID' (API trace)
   465	            if not all(any(c.lower() in h for h in head) for c in required_cols):
   466	                return None
   467	            return sum(1 for _ in rd)
   468	    except Exception:
   469	        return None
