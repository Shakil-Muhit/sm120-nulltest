    86	def _boot_ci(diffs, stat=statistics.median):
    87	    rnd = random.Random(BOOT_SEED)
    88	    vals = []
    89	    n = len(diffs)
    90	    for _ in range(BOOT_N):
    91	        vals.append(stat([diffs[rnd.randrange(n)] for _ in range(n)]))
    92	    vals.sort()
    93	    return [vals[int(0.025 * BOOT_N)], vals[int(0.975 * BOOT_N) - 1]]
