   323	        problems.append('planted fault run')
   324	    problems += validation_problems(rec)
   325	    if require_manifest and not rec.get('manifest_id'):
   326	        problems.append('not bound to a session manifest')
   327	    if require_timing:
   328	        b = _blocks_ok(rec.get('timing'), iters, repeats)
