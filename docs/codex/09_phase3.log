   310	def run_problems(rec, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS,
   311	                 require_manifest=True, require_timing=True):
   312	    """All reasons a single-arm record is NOT a qualified measurement."""
   313	    problems = []
   314	    if rec is None:
   315	        return ['record missing']
