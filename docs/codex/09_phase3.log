   410	def pair_problems(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   411	    problems = []
   412	    if m is None:
   413	        return ['record missing']
   414	    if m.get('status') != 'VALID':
   415	        problems.append(f"status {m.get('status')}")
   416	    if not m.get('manifest_id'):
   417	        problems.append('not bound to a session manifest')
   418	    if (m.get('iters'), m.get('repeats')) != (iters, repeats):
   419	        problems.append(f"protocol {m.get('repeats')}x{m.get('iters')} is not the registered {repeats}x{iters}")
   420	    js = m.get('joint_settle') or {}
   421	    if js.get('stable') is not True:
   422	        problems.append('joint settle not affirmatively stable')
   423	    if js.get('new_breaks_during_joint_settle'):
   424	        problems.append('new graph breaks during the joint settle')
   425	    # every required phase transition recomputed from the stored snapshots (gate-05 f62)
   426	    sn = m.get('snapshots') or {}
   427	    rounds = int(js.get('rounds') or 0)
   428	    jsn = list(sn.get('joint_settle') or [])
   429	    chain = jsn + [sn.get('before_validation'), sn.get('after_validation')] + list(sn.get('blocks') or [])
   430	    # exact schema (gate-06 f82): rounds+2 joint-settle snapshots, the two validation
   431	    # snapshots, and one snapshot per timed block — every one complete
   432	    if rounds < 1 or len(jsn) != rounds + 2 or len(list(sn.get('blocks') or [])) != repeats * 2 \
   433	            or any(not snapshot_complete(x) for x in chain):
   434	        problems.append('matched recording snapshots incomplete or malformed')
   435	    else:
   436	        verdicts = [recording_stable(a, b) for a, b in zip(chain, chain[1:])]
   437	        if any(v is None for v in verdicts) or not all(verdicts):
   438	            problems.append('recording state changed (or unresolved) across a matched phase transition')
   439	    if m.get('pair_eligible') is False and not problems:
   440	        problems.append(f"stored pair flag says ineligible: {m.get('ineligibility_reasons')}")
   441	    # exactly the two declared arms, each with its full numerical validation
   442	    # payload and stable blocks (gate-08 f112)
   443	    if sorted((m.get('arms') or {}).keys()) != sorted(x for x in (m.get('pair') or []) if x):
   444	        problems.append('matched record does not carry exactly the two declared arms')
   445	    for arm, a in (m.get('arms') or {}).items():
   446	        if a.get('build_status') != 'OK':
   447	            problems.append(f'{arm}: build {a.get("build_status")}')
   448	            continue
   449	        problems += [f'{arm}: {x}' for x in validation_problems({'arm': arm, 'validation': a.get('validation')})]
   450	        arm_blocks = [b for b in (m.get('blocks') or []) if b.get('arm') == arm]
   451	        if not arm_blocks or not all(b.get('counters_stable') is True for b in arm_blocks):
   452	            problems.append(f'{arm}: recording not affirmatively stable during every block')
   453	        # each arm reconciles its gate against the snapshot taken right after its own
   454	        # gate (the next arm's build clears the global counters)
   455	        problems += [f'{arm}: {x}' for x in gate_problems(arm, a.get('graph_gate'), a.get('gate_snapshot'))]
   456	        if (a.get('settle') or {}).get('settle_capped'):
   457	            problems.append(f'{arm}: settle capped')
   458	        blocks = sorted((b for b in (m.get('blocks') or []) if b.get('arm') == arm), key=lambda b: b.get('repeat', -1))
   459	        if len(blocks) != repeats or any(len(b.get('latency_ms_per_iter') or []) != iters for b in blocks) \
   460	                or [b.get('repeat') for b in blocks] != list(range(repeats)):
   461	            problems.append(f'{arm}: blocks do not hold the registered {repeats}x{iters} with unique repeat ids')
   462	        elif not all(_finite(b.get('throughput_ms_per_pass')) and b['throughput_ms_per_pass'] > 0 for b in blocks):
   463	            problems.append(f'{arm}: a block throughput is non-finite')
   464	        else:
   465	            meds = [_median(b['latency_ms_per_iter']) for b in blocks]
   466	            if not (all(_close(b.get('latency_median_ms'), mm, 1e-9, 1e-9) for b, mm in zip(blocks, meds))
   467	                    and isinstance(a.get('latency_medians_ms'), list) and len(a['latency_medians_ms']) == repeats
   468	                    and all(_close(x, y, 1e-9, 1e-9) for x, y in zip(a['latency_medians_ms'], meds))
   469	                    and _close(a.get('min_of_medians_ms'), min(meds), 1e-9, 1e-9)
   470	                    and _close(a.get('median_spread_ms'), max(meds) - min(meds), 1e-9, 1e-9)):
   471	                problems.append(f'{arm}: a stored matched summary differs from its samples')
   472	    # chronological alternation (gate-07 f103): finite, strictly increasing block
   473	    # timestamps whose (repeat, arm) order is exactly (0,a),(0,b),(1,a),(1,b),...
   474	    a_, b_ = (m.get('pair') or [None, None])[:2]
   475	    allb = list(m.get('blocks') or [])
   476	    if allb and all(_finite(x.get('unix_start')) and _finite(x.get('unix_end')) and x['unix_end'] >= x['unix_start'] for x in allb):
   477	        order = sorted(allb, key=lambda x: x['unix_start'])
   478	        starts = [x['unix_start'] for x in order]
   479	        ends = [x['unix_end'] for x in order]
   480	        expected = [(r, arm) for r in range(repeats) for arm in (a_, b_)]
   481	        if [(x.get('repeat'), x.get('arm')) for x in order] != expected:
   482	            problems.append('matched blocks are not in the registered alternating order')
   483	        if any(starts[i + 1] < ends[i] for i in range(len(order) - 1)):
   484	            problems.append('matched block timestamps overlap')
   485	    elif allb:
   486	        problems.append('a matched block lacks finite timestamps')
   487	    d = m.get('matched_delta_ms') or {}
   488	    rd = recomputed_matched_delta(m, iters, repeats)
   489	    if rd is None:
   490	        problems.append('matched delta cannot be recomputed from samples')
   491	    else:
   492	        ok = (isinstance(d.get('a_minus_b_per_block'), list) and len(d['a_minus_b_per_block']) == repeats
   493	              and all(_close(x, y, 1e-9, 1e-9) for x, y in zip(d['a_minus_b_per_block'], rd['a_minus_b_per_block']))
   494	              and all(_close(d.get(k), rd[k], 1e-9, 1e-9) for k in ('median', 'min', 'max', 'median_pct_of_a')))
   495	        if not ok:
   496	            problems.append('a stored matched delta summary differs from the value recomputed from samples')
   497	        elif not all(all(_finite(x) and x > 0 for x in b['latency_ms_per_iter']) for b in blocks):
   498	            problems.append(f'{arm}: a latency sample is non-finite or non-positive')
   499	        elif not all(_close(b.get('latency_median_ms'), _median(b['latency_ms_per_iter']), 1e-9, 1e-9) for b in blocks):
   500	            problems.append(f'{arm}: a stored block median differs from its samples')
   501	        if not all(b.get('counters_stable') is True for b in blocks):
   502	            problems.append(f'{arm}: recording not affirmatively stable during a block')
   503	        problems += [f'{arm}: {x}' for x in validation_problems({'arm': arm, 'validation': a.get('validation')})]
   504	    return problems
   505	
   506	
   507	def recomputed_matched_delta(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   508	    """Matched delta (a - b per block, median, % of a) recomputed from samples."""
   509	    a, b = m.get('pair') or (None, None)
   510	    per = {}
   511	    for arm in (a, b):
   512	        blocks = sorted((x for x in (m.get('blocks') or []) if x.get('arm') == arm), key=lambda x: x.get('repeat', 0))
   513	        if len(blocks) != repeats or [x.get('repeat') for x in blocks] != list(range(repeats)):
   514	            return None
   515	        if any(len(x.get('latency_ms_per_iter') or []) != iters or
   516	               not all(_finite(v) and v > 0 for v in x['latency_ms_per_iter']) for x in blocks):
   517	            return None
   518	        per[arm] = [_median(x['latency_ms_per_iter']) for x in blocks]
   519	    diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   520	    return {'a_minus_b_per_block': diffs, 'median': _median(diffs), 'min': min(diffs), 'max': max(diffs),
   521	            'median_pct_of_a': _median(diffs) / _median(per[a]) * 100.0}

