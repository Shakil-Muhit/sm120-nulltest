   389	def sdr_problems(rec, chunk, manifest_id, var):
   390	    """The registered SDR qualification record for a cell: r1, same manifest,
   391	    same variant, gate PASS at that operating point, clip outputs lineage-hashed."""
   392	    if not rec or not rec.get('sdr_gate'):
   393	        return ['no SDR record in r1']
   394	    out = []
   395	    g = rec['sdr_gate']
   396	    if manifest_id and rec.get('manifest_id') != manifest_id:
   397	        out.append('r1 SDR record belongs to another manifest')
   398	    if var and variant(rec) != var:
   399	        out.append('r1 SDR record has another effective variant')
   400	    if rec.get('chunk') != chunk:
   401	        out.append('r1 SDR record operating point mismatch')
   402	    st, why = sdr_recomputed(g)
   403	    if st != 'PASS':
   404	        out.append(f"SDR gate {why or st}")
   405	    if g.get('operating_point') != chunk:
   406	        out.append('SDR record operating point mismatch')
   407	    return out
