   507	def recomputed_matched_delta(m, iters=REGISTERED_ITERS, repeats=REGISTERED_REPEATS):
   508	    """Matched delta (a - b per block, median, % of a) recomputed from samples."""
   509	    a, b = m.get('pair') or (None, None)
   510	    per = {}
   511	    for arm in (a, b):
   512	        blocks = sorted((x for x in (m.get('blocks') or []) if x.get('arm') == arm), key=lambda x: x.get('repeat', 0))
   513	        if len(blocks) != repeats or [x.get('repeat') for x in blocks] != list(range(repeats)):
   514	            return None
   515	        if any(len(x.get('latency_ms_per_iter') or []) != iters or
   516	               not all(_finite(v) and v > 0 for v in x['latency_ms_per_iter']) for x in blocks):
   517	            return None
   518	        per[arm] = [_median(x['latency_ms_per_iter']) for x in blocks]
   519	    diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   520	    return {'a_minus_b_per_block': diffs, 'median': _median(diffs), 'min': min(diffs), 'max': max(diffs),
   521	            'median_pct_of_a': _median(diffs) / _median(per[a]) * 100.0}
   207	            if not block_stable:
