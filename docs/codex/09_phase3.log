   144	    def forward(self, x):                      # (1, T, n, dim)
   145	        assert x.shape[0] == 1 and x.shape[2] == self.n
   146	        t = x.shape[1]
   147	        h = x[0].transpose(0, 1)                                # (n, T, dim)
   148	        for j in range(self.depth - 1):
   149	            h = torch.tanh(torch.baddbmm(getattr(self, f'b{j}'), h,
