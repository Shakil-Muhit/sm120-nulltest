    30	        lora_checkpoint='', lora_checkpoint_loralib='')
    31	    checkpoint = torch.load(ckpt, weights_only=False, map_location='cpu')
    32	    load_start_checkpoint(ckpt_ns, model, checkpoint, type_='inference')
    33	    model = model.to(device).eval()
    34	
    35	    use_amp = config.training.use_amp
    36	    if not isinstance(use_amp, bool):
    37	        raise TypeError('config.training.use_amp must be an explicit boolean')
    38	    autocast_ctx = functools.partial(torch.autocast, 'cuda', enabled=use_amp)
    39	    # capture arms: the weight-cast cache must be off during graph capture
    40	    # (torch CUDA Graphs + AMP guidance) — prereg_amendments.md §1, arm B
    41	    autocast_nocache = functools.partial(torch.autocast, 'cuda', enabled=use_amp,
    42	                                         cache_enabled=False)
    43	    return model, config, use_amp, autocast_ctx, autocast_nocache
