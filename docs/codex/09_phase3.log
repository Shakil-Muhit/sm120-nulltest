     2	are cast to fp16 ONCE at install (external module swap; the pinned modules keep
     3	their fp32 parameters registered and untouched). Under autocast an fp16 weight
     4	needs no cast, so the per-pass `aten._to_copy` parameter casts that C3 replays
     5	inside its graph (X6a) disappear for these modules. Everything else is the
     6	public path. Registered contingency for E1 when freezing (C3F) does not
     7	compose with cudagraph trees or leaves the casts in place."""
     8	
     9	import hashlib
    10	import os
    11	
    12	import torch
    13	import torch.nn as nn
    14	import torch.nn.functional as F
