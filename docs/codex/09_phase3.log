     1	"""E9 cost model: wall(C3, L) - wall(H, L) as a function of chunk length L.
     2	
     3	Inputs (ONLY): the two node-level trace decompositions (docs/phase3/padbatch/
     4	decomposition_table.json, from the 8 s and 100 ms traces) and the four existing
     5	sweep points (SESSION_RESULT_v2.md headline walls at 4410, 22050, 88200, 352800).
     6	Frames per chunk F(L) = L/441 + 1 (hop 441; 352800 -> 801, 4410 -> 11).
     7	
     8	Term structure (all in ms, sign: + means H faster than C3):
     9	  D(L) = B                      batching benefit (gap/launch floor removed): fixed, mean of the two traces
    10	       - NF(F)                  non-GEMM front/tail delta (H - C3): linear in F through the two traces
    11	       - MID(F)                 transformer-middle delta (H - C3): linear in F through the two traces
    12	       - PAD(F)                 padded FLOPs (0.16094 GFLOP/frame) at rate_H(F)
    13	       - EFF(F)                 true work (0.4083 GFLOP/frame) x (1/rate_H(F) - 1/rate_C3(F))
    14	  rate_X(F) = R_X * F / (F + h_X) * q_X(F), q = tile-quantization factor F / (T ceil(F/T)) or 1.
    15	Model variants differ in q and in whether (R, h) come from the two traces alone
    16	(variant "traces_only") or are refit on the four sweep walls with the trace
    17	rates as soft constraints (variant "sweep_refit"). Every variant's in-sample
    18	residuals at the four sweep points are printed and stored; the registered
    19	variant is chosen by the smallest max |residual| and the choice is recorded
    20	BEFORE any held-out measurement. Held-out lengths: 176400 (F=401) and 264600
    21	(F=601). Never run those lengths on the shakedown host.
    22	"""
    23	import json, math, sys, itertools
    24	import numpy as np
    25	from scipy.optimize import least_squares
    26	
    27	ROOT = __file__.rsplit('/docs/', 1)[0]
    28	dec = json.load(open(f'{ROOT}/docs/phase3/padbatch/decomposition_table.json'))
    29	d8 = next(d for d in dec if d['O'] == 352800); d1 = next(d for d in dec if d['O'] == 4410)
    30	HOP = 441
    31	def F(L): return L // HOP + 1
    32	F8, F1 = F(352800), F(4410)
    33	
    34	# sweep walls (SESSION_RESULT_v2.md arms table: headline = median over restarts of min-of-medians)
    35	walls = {'C3': {352800: 28.8714, 4410: 3.2752, 22050: 4.2173, 88200: 8.6252},
    36	         'H':  {352800: 29.3624, 4410: 2.3386, 22050: 3.3184, 88200: 7.4558}}
    37	obs = {L: walls['C3'][L] - walls['H'][L] for L in walls['C3']}   # + = H faster
    38	matched = {352800: -0.4953803727403283, 4410: 0.936683383770287}  # matched-pair medians (same sign convention)
    39	
    40	B = 0.5 * (d8['batching_benefit_ms (gap/launch floor removed)'] + d1['batching_benefit_ms (gap/launch floor removed)'])
    41	def lin(y1, y8):
    42	    a = (y8 - y1) / (F8 - F1); return (y1 - a * F1, a)
    43	NF = lin(d1['non_GEMM_front_tail_delta_ms (H - C3)'], d8['non_GEMM_front_tail_delta_ms (H - C3)'])
    44	MID = lin(d1['transformer_middle_delta_ms (H - C3)'], d8['transformer_middle_delta_ms (H - C3)'])
    45	pad_gflop_per_frame = d8['extra_padded_GFLOP'] / F8
    46	eff1 = d1['kernel_efficiency_change_ms (true work at H rate vs C3 rate; + = H slower)']
    47	eff8 = d8['kernel_efficiency_change_ms (true work at H rate vs C3 rate; + = H slower)']
    48	rH1, rH8 = d1['H_fronttail_GEMM_rate_TFLOPS'], d8['H_fronttail_GEMM_rate_TFLOPS']
    49	rC1, rC8 = d1['C3_fronttail_GEMM_rate_TFLOPS'], d8['C3_fronttail_GEMM_rate_TFLOPS']
    50	true_gflop_per_frame = (eff8 / (1 / rH8 - 1 / rC8)) / F8       # ms / (ms/GFLOP)
    51	chk = (eff1 / (1 / rH1 - 1 / rC1)) / F1
    52	assert abs(true_gflop_per_frame - chk) / true_gflop_per_frame < 0.02, (true_gflop_per_frame, chk)
    53	
    54	def q_tile(T):
    55	    return (lambda f: f / (T * math.ceil(f / T))) if T else (lambda f: 1.0)
    56	
    57	def fit_rate_two_points(r1, r8, q):
    58	    # r = R F/(F+h) q(F) through (F1, r1), (F8, r8)
    59	    a1, a8 = r1 / q(F1), r8 / q(F8)
    60	    # a1 (F1+h)/F1 = a8 (F8+h)/F8  ->  h = (a8 F1 - a1 F8) / (a1 - a8) * ... solve linear
    61	    # a1*(F1+h)*F8 = a8*(F8+h)*F1 -> a1 F1 F8 + a1 F8 h = a8 F8 F1 + a8 F1 h -> h (a1 F8 - a8 F1) = F1 F8 (a8 - a1)
    62	    h = F1 * F8 * (a8 - a1) / (a1 * F8 - a8 * F1)
    63	    R = a1 * (F1 + h) / F1
    64	    return R, h
    65	
    66	def model_D(f, RH, hH, RC, hC, qH, qC):
    67	    rH = RH * f / (f + hH) * qH(f); rC = RC * f / (f + hC) * qC(f)
    68	    pad = pad_gflop_per_frame * f / rH
    69	    eff = true_gflop_per_frame * f * (1 / rH - 1 / rC)
    70	    return B - (NF[0] + NF[1] * f) - (MID[0] + MID[1] * f) - pad - eff, dict(rate_H=rH, rate_C3=rC, pad=pad, eff=eff,
    71	            nf=NF[0] + NF[1] * f, mid=MID[0] + MID[1] * f, B=B)
    72	
    73	variants = {}
    74	for TH, TC in itertools.product([None, 64, 128], [None, 64, 128]):
    75	    qH, qC = q_tile(TH), q_tile(TC)
    76	    RH, hH = fit_rate_two_points(rH1, rH8, qH); RC, hC = fit_rate_two_points(rC1, rC8, qC)
    77	    if min(RH, hH, RC, hC) <= 0: continue
    78	    name = f'traces_only_TH{TH}_TC{TC}'
    79	    pred = {L: model_D(F(L), RH, hH, RC, hC, qH, qC)[0] for L in obs}
    80	    res = {L: pred[L] - obs[L] for L in obs}
    81	    variants[name] = dict(params=dict(RH=RH, hH=hH, RC=RC, hC=hC, TH=TH, TC=TC), pred=pred, res=res,
    82	                          max_abs_res=max(abs(v) for v in res.values()))
    83	    # sweep refit: (RC, hC) free, H curve kept from traces; soft constraint on the two trace rates for C3
    84	    def resid(p):
    85	        RCx, hCx = p
    86	        r = [model_D(F(L), RH, hH, RCx, hCx, qH, qC)[0] - obs[L] for L in obs]
    87	        r += [0.2 * (RCx * F1 / (F1 + hCx) * qC(F1) - rC1) / rC1, 0.2 * (RCx * F8 / (F8 + hCx) * qC(F8) - rC8) / rC8]
    88	        return r
    89	    sol = least_squares(resid, x0=[RC, hC], bounds=([1, 0.1], [419, 5000]))
    90	    RCx, hCx = sol.x
    91	    pred = {L: model_D(F(L), RH, hH, RCx, hCx, qH, qC)[0] for L in obs}
    92	    res = {L: pred[L] - obs[L] for L in obs}
    93	    variants[name.replace('traces_only', 'sweep_refit')] = dict(params=dict(RH=RH, hH=hH, RC=RCx, hC=hCx, TH=TH, TC=TC),
    94	        pred=pred, res=res, max_abs_res=max(abs(v) for v in res.values()),
    95	        trace_rate_check=dict(rC1_model=RCx * F1 / (F1 + hCx) * qC(F1), rC1=rC1, rC8_model=RCx * F8 / (F8 + hCx) * qC(F8), rC8=rC8))
    96	
    97	for name, v in sorted(variants.items(), key=lambda kv: kv[1]['max_abs_res']):
    98	    print(f"{name:32s} max|res| {v['max_abs_res']:.3f}  res " + ' '.join(f"{L}:{v['res'][L]:+.3f}" for L in sorted(v['res'])))
    99	
   100	HELD = [176400, 264600]
   101	def crossover(v):
   102	    p = v['params']; qH, qC = q_tile(p['TH']), q_tile(p['TC'])
   103	    Ls = np.arange(4410, 352801, 441)
   104	    Ds = np.array([model_D(F(int(L)), p['RH'], p['hH'], p['RC'], p['hC'], qH, qC)[0] for L in Ls])
   105	    sign_changes = np.where(np.diff(np.sign(Ds)) != 0)[0]
   106	    return [int(Ls[i]) for i in sign_changes], Ls, Ds
   107	best_name = min(variants, key=lambda k: variants[k]['max_abs_res'])
   108	out = {'inputs': dict(B=B, NF=NF, MID=MID, pad_gflop_per_frame=pad_gflop_per_frame, true_gflop_per_frame=true_gflop_per_frame,
   109	                      trace_rates=dict(rH1=rH1, rH8=rH8, rC1=rC1, rC8=rC8), sweep_obs_C3_minus_H=obs, matched=matched, hop=HOP),
   110	       'variants': variants, 'registered_variant': best_name, 'held_out': {}}
   111	for name in [best_name, 'traces_only_THNone_TCNone']:
   112	    v = variants[name]; p = v['params']; qH, qC = q_tile(p['TH']), q_tile(p['TC'])
   113	    xs, Ls, Ds = crossover(v)
   114	    v['crossover_L_star'] = xs
   115	    v['held_out_pred'] = {L: model_D(F(L), p['RH'], p['hH'], p['RC'], p['hC'], qH, qC) for L in HELD}
   116	    v['held_out_pred'] = {L: dict(D_C3_minus_H_ms=val[0], terms=val[1]) for L, val in v['held_out_pred'].items()}
   117	    print(f"\n{name}: L* = {xs}  held-out: " + ' '.join(f"{L}:{v['held_out_pred'][L]['D_C3_minus_H_ms']:+.3f}" for L in HELD))
   118	json.dump(out, open(f'{ROOT}/docs/phase3/e9/e9_cost_model.json', 'w'), indent=1, default=float)
   119	print('written docs/phase3/e9/e9_cost_model.json')
