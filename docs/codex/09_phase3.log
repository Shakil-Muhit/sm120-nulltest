    16	
    17	class PreCastLinear(nn.Module):
    18	    def __init__(self, orig):
    19	        super().__init__()
    20	        assert isinstance(orig, nn.Linear)
    21	        self.orig = orig
    22	        self.register_buffer('w16', orig.weight.detach().to(torch.float16).contiguous(), persistent=False)
    23	        if orig.bias is not None:
    24	            self.register_buffer('b16', orig.bias.detach().to(torch.float16).contiguous(), persistent=False)
    25	        else:
    26	            self.b16 = None
    27	
    28	    def forward(self, x):
    29	        return F.linear(x, self.w16, self.b16)
