   216	def time_chain(launch, n, capture, label):
   217	    for _ in range(WARMUP):
   218	        launch()
   219	    torch.cuda.synchronize()
   220	    graph = None
   221	    if capture:
   222	        s = torch.cuda.Stream()
   223	        s.wait_stream(torch.cuda.current_stream())
   224	        with torch.cuda.stream(s):
   225	            launch()
   226	        torch.cuda.current_stream().wait_stream(s)
   227	        torch.cuda.synchronize()
   228	        graph = torch.cuda.CUDAGraph()
   229	        with torch.cuda.graph(graph):
   230	            launch()
   231	        graph.replay()
   232	        torch.cuda.synchronize()
   233	    times = []
   234	    torch.cuda.nvtx.range_push(label)
   235	    for _ in range(REPEATS):
   236	        e0 = torch.cuda.Event(enable_timing=True)
   237	        e1 = torch.cuda.Event(enable_timing=True)
   238	        e0.record()
   239	        if graph is not None:
   240	            graph.replay()
   241	        else:
   242	            launch()
   243	        e1.record()
   244	        torch.cuda.synchronize()
   245	        times.append(e0.elapsed_time(e1) * 1e3)      # us
   246	    torch.cuda.nvtx.range_pop()
   247	    return {'chain_us_median': statistics.median(times),
   248	            'chain_us_min': min(times), 'chain_us_max': max(times),
   249	            'per_launch_us': statistics.median(times) / n, 'n': n, 'repeats': REPEATS}
   250	
