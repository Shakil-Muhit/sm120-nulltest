    67	def joint_settle(built, arms, rounds=2, passes=3):
    68	    """Alternate the two steps. The recording state is snapshotted BEFORE the
    69	    first round and after every round; stable iff unchanged across ALL rounds
    70	    (a re-recording of the arm built first shows up in round 1), and no new
    71	    graph breaks / unimplemented ops appear at any point."""
    72	    snaps = [tm.recording_state()]
    73	    for r in range(rounds + 1):
    74	        for arm in arms:
    75	            b = built[arm]
    76	            with torch.no_grad(), b['ctx']():
    77	                for _ in range(passes):
    78	                    b['step'](b['x'])
    79	        torch.cuda.synchronize()
    80	        snaps.append(tm.recording_state())
    81	    verdicts = [tm.recording_stable(a, c) for a, c in zip(snaps, snaps[1:])]
    82	    breaks = [sum(x['counters'].get('graph_break', {}).values()) +
    83	              sum(x['counters'].get('unimplemented', {}).values()) for x in snaps]
    84	    return {'stable': (None if any(v is None for v in verdicts) else all(verdicts)),
    85	            'new_breaks_during_joint_settle': breaks[-1] - breaks[0],
    86	            'rounds': rounds, 'snapshots': snaps}
