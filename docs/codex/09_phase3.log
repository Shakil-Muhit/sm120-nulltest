   101	def install(model):
   102	    """Swap every (Attention, FeedForward) pair of every Transformer in the
   103	    pinned model for its folded wrapper via public ModuleList item assignment.
   104	    Returns the install record (counts, untouched parts, wrapper source hash)."""
   105	    n_attn = n_ff = n_tf = 0
   106	    for block in model.layers:                          # ModuleList([time_tf, freq_tf]) per depth
   107	        for tf in block:
   108	            if not hasattr(tf, 'layers'):
   109	                continue
   110	            n_tf += 1
   111	            for i, pair in enumerate(tf.layers):
   112	                attn, ff = pair[0], pair[1]
   113	                assert type(attn).__name__ == 'Attention', f'unexpected attention module {type(attn).__name__}'
   114	                assert type(ff).__name__ == 'FeedForward'
   115	                tf.layers[i] = nn.ModuleList([FoldedAttention(attn), FoldedFeedForward(ff)])
   116	                n_attn += 1
   117	                n_ff += 1
   118	    assert n_attn > 0
   119	    src = os.path.abspath(__file__)
   120	    return {'folded_attention': n_attn, 'folded_feedforward': n_ff, 'transformers': n_tf,
   121	            'untouched': ['band_split', 'mask_estimators', 'Transformer.norm (norm_output)', 'Transformer.forward residual adds'],
   122	            'folded_weight_dtype': 'float32 (autocast casts as for the public parameters)',
   123	            'source_sha256': hashlib.sha256(open(src, 'rb').read()).hexdigest()}
