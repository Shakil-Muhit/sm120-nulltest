   217	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   218	    """Five repeats of the 5a block; min-of-medians + median spread; every
   219	    per-iteration list preserved; block wall timestamps for the clock log."""
   220	    blocks = []
   221	    for r in range(repeats):
   222	        t_start = time.time()
   223	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   224	        t_end = time.time()
   225	        s = sorted(lat)
   226	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   227	                       'latency_median_ms': median(lat),
   228	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   229	                       'throughput_ms_per_pass': thr,
   230	                       'unix_start': t_start, 'unix_end': t_end})
   231	    meds = [b['latency_median_ms'] for b in blocks]
   232	    return {'blocks': blocks, 'latency_medians_ms': meds,
   233	            'min_of_medians_ms': min(meds),
   234	            'median_spread_ms': max(meds) - min(meds),
   235	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   236	            'serialization_delta_pct': [
