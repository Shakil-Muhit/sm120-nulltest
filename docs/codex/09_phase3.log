   317	        problems.append(f"status {rec.get('status')}")
   318	    if rec.get('arm') == 'ANVTX':
   319	        problems.append('attribution arm')
   320	    if rec.get('nvtx_pass'):
   321	        problems.append('traced/attribution run')
