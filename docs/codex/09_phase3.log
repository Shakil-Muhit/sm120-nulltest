     9	runs the GEMM on the un-normalized input, and applies s(x) (and the bias)
    10	after the GEMM, in the epilogue position (fused into the GEMM by a Triton
    11	template under max-autotune, else the smallest pointwise pass Inductor makes).
    12	s(x) is one small reduction per token, which Inductor fuses into the kernel
    13	that last wrote x when it can (the trace records which).
    14	The residual add of the public Transformer ('x = attn(x) + x; x = ff(x) + x')
    15	already follows the output projection; the wrapper leaves Transformer.forward
    16	untouched, so the residual lands in to_out's epilogue whenever the compiler
    17	fuses it. The Transformer's output RMSNorm (norm_output) is left untouched.
    18	Folded weights are kept as fp32 buffers so that autocast casts them exactly as
    19	it casts the public fp32 parameters (the E1/X6a cast behaviour is NOT changed
    20	by this wrapper; the two levers stay separable).
    21	
    22	Claim: ALGEBRAIC equivalence. Rounding points move (fp16 GEMM on x instead of
    23	on the fp32-normalized x; scale applied after accumulation), so agreement is
    24	verified at the loose tier plus the SDR gate on all eight clips (registered).
    25	The scale is never applied inside the GEMM inner loop (design note in the
    26	registration).
    27	"""
    28	
    29	import hashlib
    30	import os
    31	
    32	import torch
    33	import torch.nn as nn
    34	import torch.nn.functional as F
    35	from einops import rearrange
    36	
    37	
    38	def _rms_scale(x, scale):
    39	    n = torch.linalg.vector_norm(x.float(), dim=-1, keepdim=True)
    40	    return scale / torch.clamp(n, min=1e-12)          # (..., 1) fp32, matches F.normalize's eps
    41	
    42	
    43	def _is_rmsnorm(m):
    44	    return hasattr(m, 'gamma') and hasattr(m, 'scale') and isinstance(m.gamma, torch.Tensor)
    45	
    46	
    47	class FoldedAttention(nn.Module):
    48	    def __init__(self, orig):
    49	        super().__init__()
    50	        assert getattr(orig, 'pope_embed', None) is None, 'PoPE path not covered by the fold'
    51	        assert _is_rmsnorm(orig.norm) and isinstance(orig.to_qkv, nn.Linear) and orig.to_qkv.bias is None
    52	        assert isinstance(orig.to_gates, nn.Linear) and orig.to_gates.bias is not None
    53	        self.orig = orig                                  # parameters stay registered, untouched
    54	        g = orig.norm.gamma.detach().float()
    55	        self.scale = float(orig.norm.scale)
    56	        self.heads = int(orig.heads)
    57	        self.register_buffer('w_qkv', (orig.to_qkv.weight.detach().float() * g[None, :]).contiguous(), persistent=False)
    58	        self.register_buffer('w_gates', (orig.to_gates.weight.detach().float() * g[None, :]).contiguous(), persistent=False)
    59	        self.register_buffer('b_gates', orig.to_gates.bias.detach().float().clone(), persistent=False)
    60	
    61	    def forward(self, x):
    62	        o = self.orig
    63	        s = _rms_scale(x, self.scale)
    64	        qkv = F.linear(x, self.w_qkv)
    65	        qkv = (qkv.float() * s).to(qkv.dtype)
    66	        q, k, v = rearrange(qkv, 'b n (qkv h d) -> qkv b h n d', qkv=3, h=self.heads)
    67	        if o.rotary_embed is not None:
    68	            q = o.rotary_embed.rotate_queries_or_keys(q)
    69	            k = o.rotary_embed.rotate_queries_or_keys(k)
    70	        out = o.attend(q, k, v)
    71	        gates = F.linear(x, self.w_gates)
    72	        gates = (gates.float() * s + self.b_gates).to(gates.dtype)
    73	        out = out * rearrange(gates, 'b n h -> b h n 1').sigmoid()
    74	        out = rearrange(out, 'b h n d -> b n (h d)')
    75	        return o.to_out(out)
    76	
    77	
    78	class FoldedFeedForward(nn.Module):
    79	    def __init__(self, orig):
    80	        super().__init__()
    81	        net = orig.net
    82	        assert isinstance(net, nn.Sequential) and len(net) == 6
    83	        assert _is_rmsnorm(net[0]) and isinstance(net[1], nn.Linear) and net[1].bias is not None
    84	        assert isinstance(net[2], nn.GELU) and isinstance(net[4], nn.Linear)
    85	        self.orig = orig
    86	        g = net[0].gamma.detach().float()
    87	        self.scale = float(net[0].scale)
    88	        self.register_buffer('w1', (net[1].weight.detach().float() * g[None, :]).contiguous(), persistent=False)
    89	        self.register_buffer('b1', net[1].bias.detach().float().clone(), persistent=False)
    90	
    91	    def forward(self, x):
    92	        net = self.orig.net
    93	        s = _rms_scale(x, self.scale)
    94	        h = F.linear(x, self.w1)
    95	        h = (h.float() * s + self.b1).to(h.dtype)
    96	        h = net[2](h)
    97	        h = net[3](h)
    98	        return net[5](net[4](h))
    99	
