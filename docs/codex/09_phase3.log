    44	        model, config, use_amp, ctx, ctx_nocache, _vrec = variants.load_variant_model(
    45	            paths['msst'], paths['config'], variant, gen_dir)
    46	    else:
    47	        model, config, use_amp, ctx, ctx_nocache = loader.load_public_model(
    48	            paths['msst'], paths['ckpt'], paths['config'])
    49	    x = tm.make_input(chunk, tm.TIMING_SEED)
    50	    info = {'capture_scope': None, 'capture_adapter': None, 'capture_attempts': [],
    51	            'stream_count': None, 'compile_mode': None, 'notes': []}
    52	    step = arms_mod.build_arm_step(arm, model, x, ctx_nocache, streams, info, gen_dir)
    53	    settle = gate = gate_snapshot = None
    54	    if arms_mod.base_arm(arm) in arms_mod.COMPILE_ARMS:
    55	        settle = tm.settle_compile(step, x, ctx, settle_max, 5)
    56	        gate = tm.graph_gate(arms_mod.base_arm(arm) in arms_mod.REQUIRE_ZERO_BREAKS)
    57	        gate_snapshot = tm.recording_state()      # reconciliation reference for this arm's gate (gate-06 f83)
    58	    else:
    59	        with torch.no_grad(), ctx():
    60	            for _ in range(10):
    61	                step(x)
    62	        torch.cuda.synchronize()
    63	    return {'model': model, 'step': step, 'ctx': ctx, 'x': x, 'info': info,
    64	            'settle': settle, 'gate': gate, 'gate_snapshot': gate_snapshot, 'use_amp': use_amp}
