   211	                    'latency_medians_ms': per[arm], 'min_of_medians_ms': min(per[arm]),
   212	                    'median_spread_ms': max(per[arm]) - min(per[arm])})
   213	            diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   214	            result['matched_delta_ms'] = {'a_minus_b_per_block': diffs,
   215	                                          'median': statistics.median(diffs),
   216	                                          'min': min(diffs), 'max': max(diffs),
   217	                                          'median_pct_of_a': statistics.median(diffs) /
   218	                                          statistics.median(per[a]) * 100.0}
   219	            print(f'[matched] {a} - {b}: median {statistics.median(diffs):+.4f} ms')
   220	    except Exception:
   221	        result['status'], result['error'] = 'INVALID', traceback.format_exc()

