   252	def fit(points):
   253	    """least squares T = a + b*N over (N, T_median) points"""
   254	    if len(points) < 2:
   255	        return None
   256	    xs = [p[0] for p in points]
   257	    ys = [p[1] for p in points]
   258	    mx, my = sum(xs) / len(xs), sum(ys) / len(ys)
   259	    sxx = sum((x - mx) ** 2 for x in xs)
   260	    b = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / sxx if sxx else None
   261	    return {'slope_us_per_node': b, 'intercept_us': (my - b * mx) if b is not None else None,
   262	            'points': points}
