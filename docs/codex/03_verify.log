   187	def compare_outputs(out, ref, tier):
   188	    rtol, atol = TIERS[tier]
   189	    out = out.float()
   190	    ref = ref.float()
   191	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   192	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   193	    if out.shape != ref.shape:
   194	        rec['reason'] = 'shape mismatch'
   195	        rec['max_abs_diff'] = None
   196	        return rec
   197	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   198	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   199	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   200	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   201	    if not (fin_out and fin_ref):
   202	        rec['reason'] = 'non-finite values present'
   203	        return rec
   204	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   205	    if not rec['ok']:
   206	        rec['reason'] = 'tolerance exceeded'
   207	    return rec
