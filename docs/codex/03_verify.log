   435	def read_gpu_trace(path):
   436	    with open(path, newline='') as f:
   437	        rd = csv.reader(f)
   438	        head = next(rd)
   439	        def col(*names):
   440	            for name in names:
   441	                for i, h in enumerate(head):
   442	                    if h.strip().strip('"') == name:
   443	                        return i
   444	            return next(i for i, h in enumerate(head)
   445	                        if names[0].split(' ')[0] in h)
   446	        c_start = col('Start (ns)', 'Start(ns)', 'Start')
   447	        c_dur = col('Duration (ns)', 'Duration(ns)', 'Duration')
   448	        c_name = col('Name')
   449	        rows = []
   450	        for r in rd:
   451	            if len(r) <= max(c_start, c_dur, c_name) or not r[c_dur].strip():
   452	                continue
   453	            try:
   454	                rows.append({'start': int(float(r[c_start].replace(',', ''))),
   455	                             'dur': int(float(r[c_dur].replace(',', ''))),
   456	                             'name': r[c_name]})
   457	            except ValueError:
   458	                continue
   459	    rows.sort(key=lambda x: x['start'])
   460	    return rows
   461	
