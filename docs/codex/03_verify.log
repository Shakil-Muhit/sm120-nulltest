   463	def read_kern_sum(path):
   464	    """name -> total ns from the aggregate export (cross-check only)."""
   465	    out = {}
   466	    try:
   467	        with open(path, newline='') as f:
   468	            rd = csv.reader(f)
   469	            head = next(rd)
   470	            c_t = next(i for i, h in enumerate(head) if 'Total Time' in h)
   471	            c_n = next(i for i, h in enumerate(head)
   472	                       if h.strip().strip('"') == 'Name')
   473	            for r in rd:
   474	                if len(r) > max(c_t, c_n) and r[c_t].strip():
   475	                    try:
   476	                        out[r[c_n]] = out.get(r[c_n], 0) + int(
   477	                            float(r[c_t].replace(',', '')))
   478	                    except ValueError:
   479	                        continue
   480	    except Exception as e:
   481	        print(f'[map] WARN: kern_sum parse failed: {e}')
   482	    return out
