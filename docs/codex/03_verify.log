   133	def timed_run(step, x, ctx, iters=50, nvtx_pass=False):
   134	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   135	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   136	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   137	    pass windows for the exports; never inside compiled code)."""
   138	    with torch.no_grad(), ctx():
   139	        torch.cuda.synchronize()
   140	        torch.cuda.profiler.start()
   141	        latency_ms = []
   142	        for i in range(iters):
   143	            if nvtx_pass:
   144	                torch.cuda.nvtx.range_push(f'pass_{i}')
   145	            t0 = time.perf_counter()
   146	            step(x)
   147	            torch.cuda.synchronize()
   148	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   149	            if nvtx_pass:
   150	                torch.cuda.nvtx.range_pop()
   151	        torch.cuda.profiler.stop()
   152	
   153	        torch.cuda.synchronize()
   154	        t0 = time.perf_counter()
   155	        for _ in range(iters):
   156	            step(x)
   157	        torch.cuda.synchronize()
   158	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   159	    return latency_ms, throughput_ms
   160	
   161	
   162	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   163	    """Five repeats of the 5a block; min-of-medians + median spread; every
   164	    per-iteration list preserved; block wall timestamps for the clock log."""
   165	    blocks = []
   166	    for r in range(repeats):
   167	        t_start = time.time()
   168	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   169	        t_end = time.time()
   170	        s = sorted(lat)
   171	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   172	                       'latency_median_ms': median(lat),
   173	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   174	                       'throughput_ms_per_pass': thr,
   175	                       'unix_start': t_start, 'unix_end': t_end})
   176	    meds = [b['latency_median_ms'] for b in blocks]
   177	    return {'blocks': blocks, 'latency_medians_ms': meds,
   178	            'min_of_medians_ms': min(meds),
   179	            'median_spread_ms': max(meds) - min(meds),
   180	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   181	            'serialization_delta_pct': [
   182	                (b['latency_median_ms'] - b['throughput_ms_per_pass'])
   183	                / b['throughput_ms_per_pass'] * 100.0 for b in blocks],
   184	            'iters_per_block': iters, 'repeats': repeats}
