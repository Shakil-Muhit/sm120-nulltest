   153	    with open(args.out, 'w') as f:
   154	        json.dump(summary, f, indent=1)
   155	    m = summary['median']
   156	    print(f"[graph_verify] {args.arm}: {summary['verdict']} | graph launches/pass {m['graph_launch_calls']} "
   157	          f"(graphs {m['graphs_visited']}) | captured {m['captured_model_kernels']} staging "
   158	          f"{m['input_staging_kernels']} uncaptured {m['uncaptured_model_kernels']} unresolved "
   159	          f"{m['unresolved_kernels']} (max uncaptured {summary['max_uncaptured_in_any_pass']})")
