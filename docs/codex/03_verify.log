    93	def cudagraph_tree_state():
    94	    """Best-effort snapshot of the cudagraph-trees manager (torch 2.8):
    95	    number of recorded graphs / roots; None if the API is unavailable."""
    96	    try:
    97	        from torch._inductor import cudagraph_trees
    98	        container = cudagraph_trees.get_container(0)
    99	        mgr = getattr(container, 'tree_manager', None)
   100	        if mgr is None:
   101	            return {'available': False}
   102	        roots = getattr(mgr, 'roots', None)
   103	        n_roots = sum(len(v) for v in roots.values()) if isinstance(roots, dict) else None
   104	        ids = getattr(mgr, 'ids_to_funcs', None) or getattr(mgr, 'ids_to_stack', None)
   105	        return {'available': True, 'roots': n_roots,
   106	                'functions': len(ids) if ids is not None else None,
   107	                'current_gen': getattr(mgr, 'current_gen', None)}
   108	    except Exception as e:
   109	        return {'available': False, 'reason': f'{type(e).__name__}: {e}'[:120]}
