   415	def chain_class(ops, raw_name):
   416	    text = ' '.join(ops).lower() if ops else (raw_name or '').lower()
   417	    if any(h in text for h in NORM_OP_HINTS):
   418	        return 'norm'
   419	    if ops and all(o.strip() in PURE_COPY_OPS for o in ops):
   420	        return 'copy'
   421	    return 'pointwise'
