    18	  fused  : bytes = read + write bytes from the parser's access analysis;
    19	           any argument with unresolved dtype/shape/access -> UNRESOLVED
    20	Ideal = max(FLOPs / P, bytes / BW): BW_HBM = 1.79 TB/s; BW_L2 (measured by
    21	boundary_bench's L2-resident chain, passed in) applies when the CALL's own
    22	working set fits the device L2. Unresolved metadata never receives default
    23	pricing.
    24	"""
    25	
    26	import argparse
    27	import collections
    28	import csv
    29	import json
    30	import os
    31	import statistics
    32	import sys
    33	
    34	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'attrib'))
    35	from classify import classify                      # noqa: E402
    36	from kernel_map import (parse_output_code, arg_meta, refined_access, nbytes,   # noqa: E402
    37	                        read_gpu_trace, nvtx_pass_windows, split_passes)
    38	
    39	P_FP16_TFLOPS = 209.5
    40	P_FP32_TFLOPS = 104.8
    41	BW_HBM_TBPS = 1.79
    42	MODEL = {'heads': 8, 'dim_head': 64, 'bands': 60}
    43	FRAMES = {352800: 801, 4410: 11, 22050: 51, 88200: 201}
    44	
    45	
    46	def read_kern_sum(path):
    47	    with open(path, newline='') as f:
    48	        rd = csv.reader(f)
    49	        head = next(rd)
    50	        c_t = next(i for i, h in enumerate(head) if 'Total Time' in h)
    51	        c_i = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Instances', 'Kern Inst') or 'Instances' in h)
    52	        c_n = next(i for i, h in enumerate(head) if h.strip().strip('"') == 'Name')
    53	        out = {}
    54	        for r in rd:
    55	            try:
    56	                out[r[c_n]] = {'total_ns': int(float(r[c_t].replace(',', ''))),
    57	                               'instances': int(float(r[c_i].replace(',', '')))}
    58	            except (ValueError, IndexError):
    59	                continue
    60	    return out
    61	
    62	
    63	def per_pass_inventory(base):
    64	    rows = read_gpu_trace(base + '_cuda_gpu_trace.csv')
    65	    windows, err = nvtx_pass_windows(base + '_nvtx_gpu_proj_trace.csv')
    66	    if err or not windows:
    67	        return None, f'nvtx windows unavailable: {err}'
    68	    passes, _ = split_passes(rows, windows, classify)
    69	    invs = [collections.Counter(r['name'] for r in p if classify(r['name']) == 'INDUCTOR_FUSED')
    70	            for p in passes if p]
    71	    if not invs or any(c != invs[0] for c in invs):
    72	        return None, 'per-pass Triton inventories differ across passes'
    73	    return invs[0], None
    74	
    75	
    76	def select_variants(graphs, observed):
    77	    """Single graph with an exact match, else an ordered subset whose
    78	    multiset union matches exactly; else None."""
    79	    inv = [collections.Counter(c['name'] for c in g['calls'] if c['kind'] == 'triton') for g in graphs]
    80	    for g, c in zip(graphs, inv):
    81	        if c == observed:
    82	            return [g], 'single-graph exact match'
    83	    # ordered combination (graph-broken arms): greedy over graphs in dump order
    84	    total = collections.Counter()
    85	    chosen = []
    86	    for g, c in zip(graphs, inv):
    87	        if not c:
    88	            continue
    89	        if all(total[k] + c[k] <= observed[k] for k in c):
    90	            total += c
    91	            chosen.append(g)
    92	    if chosen and total == observed:
    93	        return chosen, f'{len(chosen)}-graph combination exact match'
    94	    return None, 'no variant set reproduces the per-pass Triton inventory'
    95	
    96	
    97	def sdpa_class_costs(chunk):
    98	    T = FRAMES[chunk]
    99	    H, D, F = MODEL['heads'], MODEL['dim_head'], MODEL['bands']
   100	    fl = by = 0.0
   101	    for B, N in ((F, T), (T, F)):
   102	        fl += 6 * 4.0 * B * H * N * N * D
   103	        by += 6 * 4 * B * H * N * D * 2
   104	    return fl, by
   105	
   106	
   107	def gemm_site(call, gr):
   108	    reads = [arg_meta(gr, a) for a in call['args'] if a.get('read')]
   109	    writes = [arg_meta(gr, a) for a in call['args'] if a.get('write')]
   110	    mats = [m for m in reads if len(m['shape']) in (2, 3)]
   111	    if len(mats) < 2 or not writes:
   112	        return None
   113	    a, b = mats[-2], mats[-1]
   114	    if any(m['dtype'] is None for m in mats + writes):
   115	        return None
   116	    if len(a['shape']) == 2 and len(b['shape']) == 2:
   117	        M, K = a['shape']; K2, N = b['shape']; batch = 1
   118	    elif len(a['shape']) == 3 and len(b['shape']) == 3:
   119	        batch, M, K = a['shape']; _, K2, N = b['shape']
   120	    else:
   121	        return None
   122	    if K != K2:
   123	        return None
   124	    by = sum(nbytes(m['shape'], m['dtype']) for m in mats) + sum(nbytes(m['shape'], m['dtype']) for m in writes)
   125	    return {'M': M, 'N': N, 'K': K, 'batch': batch, 'dtype': a['dtype'],
   126	            'flops': 2.0 * batch * M * N * K, 'bytes': by}
   127	
   128	
   129	def ideal_us(flops, by, dtype, bw_l2, l2_bytes):
   130	    p = (P_FP32_TFLOPS if dtype in ('torch.float32', 'torch.float64') else P_FP16_TFLOPS) * 1e12
   131	    t_flop = flops / p * 1e6
   132	    t_hbm = by / (BW_HBM_TBPS * 1e12) * 1e6
   133	    rec = {'ideal_us_hbm': max(t_flop, t_hbm)}
   134	    if bw_l2 and l2_bytes and by <= l2_bytes:
   135	        rec['ideal_us_l2'] = max(t_flop, by / (bw_l2 * 1e12) * 1e6)
   136	    return rec
   137	
   138	
   139	def main():
   140	    ap = argparse.ArgumentParser()
   141	    ap.add_argument('--base', required=True)
   142	    ap.add_argument('--chunk', type=int, required=True)
   143	    ap.add_argument('--arm', default='')
   144	    ap.add_argument('--dump-dir', default=None)
   145	    ap.add_argument('--passes', type=int, default=50)
   146	    ap.add_argument('--l2-bytes', type=int, default=None)
   147	    ap.add_argument('--bw-l2-tbps', type=float, default=None)
   148	    ap.add_argument('--out', required=True)
   149	    args = ap.parse_args()
   150	    ks = read_kern_sum(args.base + '_cuda_gpu_kern_sum.csv')
   151	    n_pass = max(1, args.passes)
   152	    out = {'arm': args.arm, 'chunk': args.chunk, 'passes': n_pass,
   153	           'constants': {'P_fp16_tflops': P_FP16_TFLOPS, 'P_fp32_tflops': P_FP32_TFLOPS,
   154	                         'BW_hbm_tbps': BW_HBM_TBPS, 'BW_l2_tbps': args.bw_l2_tbps, 'l2_bytes': args.l2_bytes},
   155	           'variant_selection': None, 'rows': [], 'gemm_sites': [], 'unresolved': []}
   156	
   157	    fused_bytes, gemm_sites = {}, []
   158	    if args.dump_dir and os.path.isdir(args.dump_dir):
   159	        graphs = parse_output_code(args.dump_dir)
   160	        observed, err = per_pass_inventory(args.base)
   161	        if observed is None:
   162	            out['variant_selection'] = {'status': 'UNRESOLVED', 'reason': err}
   163	        else:
   164	            chosen, how = select_variants(graphs, observed)
   165	            if chosen is None:
   166	                out['variant_selection'] = {'status': 'UNRESOLVED', 'reason': how,
   167	                                            'candidates': [os.path.relpath(g['path'], args.dump_dir) for g in graphs]}
   168	            else:
   169	                out['variant_selection'] = {'status': 'ok', 'rule': how,
   170	                                            'selected': [os.path.relpath(g['path'], args.dump_dir) for g in chosen]}
   171	                for g in chosen:
   172	                    for c in g['calls']:
   173	                        if c['kind'] == 'triton':
   174	                            k = g['kernels'].get(c['name'], {})
   175	                            b_read = b_write = 0
   176	                            unresolved = False
   177	                            for a in c['args']:
   178	                                r, w, unres = refined_access(k, a.get('role', ''))
   179	                                m = arg_meta(g, a)
   180	                                if unres or m['dtype'] is None or not m['shape']:
   181	                                    unresolved = True
   182	                                    continue
   183	                                nb = nbytes(m['shape'], m['dtype'])
   184	                                b_read += nb if r else 0
   185	                                b_write += nb if w else 0
   186	                            fused_bytes.setdefault(c['name'], []).append(None if unresolved else b_read + b_write)
   187	                        elif c['kind'] == 'extern' and any(t in c['name'] for t in ('mm', 'bmm', 'addmm')):
   188	                            gs = gemm_site(c, g)
   189	                            if gs is None:
   190	                                out['unresolved'].append({'call': c['name'], 'line': c['line'][:160],
   191	                                                          'reason': 'GEMM shapes/dtypes unresolved'})
   192	                            else:
   193	                                gs['name'] = c['name']
   194	                                gs.update(ideal_us(gs['flops'], gs['bytes'], gs['dtype'], args.bw_l2_tbps, args.l2_bytes))
   195	                                gemm_sites.append(gs)
   196	    else:
   197	        out['variant_selection'] = {'status': 'n/a', 'reason': 'eager arm: no generated code'}
   198	
   199	    rows = []
   200	    for name, v in ks.items():
   201	        cls = classify(name)
   202	        row = {'kernel': name[:120], 'class': cls, 'launches_per_pass': v['instances'] / n_pass,
   203	               'time_us_per_pass': v['total_ns'] / n_pass / 1e3, 'flops_per_pass': None,
   204	               'bytes_per_pass': None, 'ideal_us_hbm': None, 'ideal_us_l2': None, 'resolution': 'UNRESOLVED'}
   205	        if cls == 'INDUCTOR_FUSED' and name in fused_bytes:
   206	            vals = fused_bytes[name]
   207	            if all(x is not None for x in vals):
   208	                by = sum(vals)
   209	                row.update(flops_per_pass=0.0, bytes_per_pass=by, resolution='wrapper access bytes (all call sites)')
   210	                per_call_max = max(vals)
   211	                r = ideal_us(0.0, by, 'torch.float16', args.bw_l2_tbps,
   212	                             args.l2_bytes if per_call_max <= (args.l2_bytes or 0) else None)
   213	                row.update(r)
   214	            else:
   215	                row['resolution'] = 'UNRESOLVED: an access/dtype/shape could not be resolved'
   216	        elif cls == 'SDPA':
   217	            row['resolution'] = 'class-level (see sdpa_class)'
   218	        elif cls == 'GEMM':
   219	            row['resolution'] = 'class-level (cuBLAS names carry no shapes; see gemm_sites)'
   220	        rows.append(row)
   221	    out['rows'] = rows
   222	    out['gemm_sites'] = gemm_sites
   223	    out['class_totals_us_per_pass'] = {c: sum(r['time_us_per_pass'] for r in rows if r['class'] == c)
   224	                                       for c in ('GEMM', 'SDPA', 'INDUCTOR_FUSED', 'COPY', 'FFT', 'OTHER')}
   225	    fl, by = sdpa_class_costs(args.chunk)
   226	    out['sdpa_class'] = {'calls_per_pass': 12, 'flops_per_pass': fl, 'bytes_per_pass': by,
   227	                         **ideal_us(fl, by, 'torch.float16', None, None),
   228	                         'measured_us_per_pass': out['class_totals_us_per_pass']['SDPA'],
   229	                         'note': 'model shapes: 6 time-axis (60 x 8 x T x 64) + 6 freq-axis (T x 8 x 60 x 64)'}
   230	    if gemm_sites:
   231	        out['gemm_class'] = {'sites_per_pass': len(gemm_sites),
   232	                             'flops_per_pass': sum(g['flops'] for g in gemm_sites),
   233	                             'bytes_per_pass': sum(g['bytes'] for g in gemm_sites),
   234	                             'ideal_us_hbm_sum': sum(g['ideal_us_hbm'] for g in gemm_sites),
   235	                             'measured_us_per_pass': out['class_totals_us_per_pass']['GEMM']}
   236	    with open(args.out, 'w') as f:
   237	        json.dump(out, f, indent=1)
   238	    with open(args.out.replace('.json', '.csv'), 'w', newline='') as f:
   239	        w = csv.DictWriter(f, fieldnames=list(rows[0].keys()) if rows else ['kernel'])
   240	        w.writeheader()
   241	        for r in sorted(rows, key=lambda r: -r['time_us_per_pass']):
   242	            w.writerow(r)
   243	    sel = out['variant_selection']
   244	    print(f"[ideal] {args.arm}@{args.chunk}: variants={sel.get('status')} classes="
   245	          f"{json.dumps({k: round(v, 1) for k, v in out['class_totals_us_per_pass'].items()})} "
   246	          f"gemm_sites={len(gemm_sites)} unresolved={len(out['unresolved'])}")
   247	
   248	
   249	if __name__ == '__main__':
   250	    main()
     1	"""Attention backend microbenchmark (plan 1.5; prereg_amendments.md §5), v2.
     2	
     3	Two layout families per (operating point, axis):
     4	  model      : the layouts the compiled model actually feeds to SDPA (read
     5	               from the C3 generated code, axial-layout-scoping evidence):
     6	               q and k are (b, n, h, d)-contiguous rotary outputs presented
     7	               as (b, h, n, d) views — strides (n*h*d, d, h*d, 1); v is a
     8	               view into the fused qkv GEMM output (b, n, 3*h*d) — strides
     9	               (n*3*h*d, d, 3*h*d, 1), storage offset 2*h*d
    10	  contiguous : (b, h, n, d) contiguous (separate experiment, not the model)
    11	Shapes: time-axis batch = 60 bands, seq = T frames; freq-axis batch = T,
    12	seq = 60; heads 8, dim_head 64, fp16; scale = default (dim_head**-0.5),
    13	dropout 0 — the model's Attend settings. Backends forced one at a time
    14	(flash / efficient / cudnn / math); unsupported combinations are recorded.
    15	Reference for the error column: fp32 inputs with the MATH backend forced.
    16	Timing: CUDA-graph replay of BLOCK launches, events, median of REPEATS.
    17	The model's deployed backend is read from a trace kernel summary
    18	(--model-kern-sum, e.g. the C3 node trace): flash if flash kernels dominate
    19	the SDPA class, cudnn if cuDNN kernels do, else efficient; without a trace
    20	the ratio is reported against 'flash' and flagged ASSUMED.
    21	"""
    22	
    23	import argparse
    24	import csv
    25	import json
    26	import statistics
    27	
    28	import torch
    29	import torch.nn.functional as F
    30	from torch.nn.attention import SDPBackend, sdpa_kernel
    31	
    32	BLOCK = 20
    33	REPEATS = 20
    34	FRAMES = {352800: 801, 4410: 11}
    35	BACKENDS = {'flash': SDPBackend.FLASH_ATTENTION, 'efficient': SDPBackend.EFFICIENT_ATTENTION,
    36	            'cudnn': SDPBackend.CUDNN_ATTENTION, 'math': SDPBackend.MATH}
    37	H, D = 8, 64
    38	
    39	
    40	def model_layout(b, n, gen):
    41	    """q, k: views of (b, n, h, d)-contiguous buffers; v: view into (b, n, 3hd)."""
    42	    qk_store = [torch.randn(b, n, H, D, generator=gen).to('cuda', torch.float16) for _ in range(2)]
    43	    q = qk_store[0].permute(0, 2, 1, 3)
    44	    k = qk_store[1].permute(0, 2, 1, 3)
    45	    qkv = torch.randn(b, n, 3 * H * D, generator=gen).to('cuda', torch.float16)
    46	    v = qkv.view(b, n, 3, H, D)[:, :, 2].permute(0, 2, 1, 3)
    47	    assert q.stride() == (n * H * D, D, H * D, 1) and v.stride() == (n * 3 * H * D, D, 3 * H * D, 1)
    48	    return q, k, v, [qk_store, qkv]
    49	
    50	
    51	def contiguous_layout(b, n, gen):
    52	    t = [torch.randn(b, H, n, D, generator=gen).to('cuda', torch.float16) for _ in range(3)]
    53	    return t[0], t[1], t[2], t
    54	
    55	
    56	def bench(q, k, v, backend):
    57	    def fn():
    58	        with sdpa_kernel([backend]):
    59	            return F.scaled_dot_product_attention(q, k, v)
    60	    for _ in range(5):
    61	        fn()
    62	    torch.cuda.synchronize()
    63	    s = torch.cuda.Stream()
    64	    s.wait_stream(torch.cuda.current_stream())
    65	    with torch.cuda.stream(s):
    66	        fn()
    67	    torch.cuda.current_stream().wait_stream(s)
    68	    torch.cuda.synchronize()
    69	    g = torch.cuda.CUDAGraph()
    70	    with torch.cuda.graph(g):
    71	        for _ in range(BLOCK):
    72	            fn()
    73	    times = []
    74	    for _ in range(REPEATS):
    75	        e0 = torch.cuda.Event(enable_timing=True)
    76	        e1 = torch.cuda.Event(enable_timing=True)
    77	        e0.record()
    78	        g.replay()
    79	        e1.record()
    80	        torch.cuda.synchronize()
    81	        times.append(e0.elapsed_time(e1) * 1e3 / BLOCK)
    82	    return statistics.median(times), min(times), max(times)
    83	
    84	
    85	def deployed_backend(kern_sum_csv):
    86	    """From a node-level kernel summary: which SDPA kernel family carries the
    87	    SDPA class time."""
    88	    totals = {'flash': 0, 'cudnn': 0, 'efficient': 0}
    89	    with open(kern_sum_csv, newline='') as f:
    90	        rd = csv.reader(f)
    91	        head = next(rd)
    92	        c_t = next(i for i, h in enumerate(head) if 'Total Time' in h)
    93	        c_n = next(i for i, h in enumerate(head) if h.strip().strip('"') == 'Name')
    94	        for r in rd:
    95	            try:
    96	                t = int(float(r[c_t].replace(',', '')))
    97	            except (ValueError, IndexError):
    98	                continue
    99	            n = r[c_n].lower()
   100	            if 'flash' in n:
   101	                totals['flash'] += t
   102	            elif 'cudnn' in n and ('attn' in n or 'fmha' in n or 'sdpa' in n):
   103	                totals['cudnn'] += t
   104	            elif 'fmha' in n or 'mem_eff' in n or 'efficient' in n:
   105	                totals['efficient'] += t
   106	    if not any(totals.values()):
   107	        return None, totals
   108	    return max(totals, key=totals.get), totals
   109	
   110	
   111	def main():
   112	    ap = argparse.ArgumentParser()
   113	    ap.add_argument('--out', required=True)
   114	    ap.add_argument('--model-kern-sum', default=None,
   115	                    help='cuda_gpu_kern_sum csv of the deployed compiled arm (C3) trace')
   116	    args = ap.parse_args()
   117	    assert torch.cuda.is_available()
   118	    gen = torch.Generator(device='cpu').manual_seed(3)
   119	    if args.model_kern_sum:
   120	        mb, totals = deployed_backend(args.model_kern_sum)
   121	        model_backend = {'backend': mb, 'source': args.model_kern_sum, 'sdpa_class_ns': totals,
   122	                         'assumed': mb is None}
   123	        if mb is None:
   124	            model_backend['backend'] = 'flash'
   125	    else:
   126	        model_backend = {'backend': 'flash', 'source': None, 'assumed': True,
   127	                         'note': 'Attend cuda_config=(True,False,False) + repaired context (flash, cudnn)'}
   128	    result = {'device': torch.cuda.get_device_name(0), 'torch': torch.__version__,
   129	              'dtype': 'float16', 'heads': H, 'dim_head': D, 'bands': 60,
   130	              'scale': 'default dim_head**-0.5', 'dropout': 0.0,
   131	              'model_backend': model_backend, 'cases': {}}
   132	    for chunk, T in FRAMES.items():
   133	        for axis, (b, n) in {'time': (60, T), 'freq': (T, 60)}.items():
   134	            for layout, make in (('model', model_layout), ('contiguous', contiguous_layout)):
   135	                q, k, v, keep = make(b, n, gen)
   136	                case = {'chunk': chunk, 'axis': axis, 'layout': layout, 'batch': b, 'seq': n,
   137	                        'q_stride': list(q.stride()), 'v_stride': list(v.stride()),
   138	                        'v_storage_offset': v.storage_offset(), 'backends': {}}
   139	                with torch.no_grad():
   140	                    with sdpa_kernel([SDPBackend.MATH]):
   141	                        ref = F.scaled_dot_product_attention(q.float(), k.float(), v.float())
   142	                    for name, be in BACKENDS.items():
   143	                        try:
   144	                            with sdpa_kernel([be]):
   145	                                out = F.scaled_dot_product_attention(q, k, v)
   146	                            err = float((out.float() - ref).abs().max())
   147	                            med, mn, mx = bench(q, k, v, be)
   148	                            case['backends'][name] = {'us_median': med, 'us_min': mn, 'us_max': mx,
   149	                                                      'max_abs_err_vs_fp32_math': err, 'status': 'ok'}
   150	                            print(f'[attn] c{chunk} {axis} {layout} {name}: {med:.2f} us (err {err:.2e})')
   151	                        except Exception as e:
   152	                            case['backends'][name] = {'status': 'UNAVAILABLE',
   153	                                                      'reason': f'{type(e).__name__}: {e}'[:300]}
   154	                            print(f'[attn] c{chunk} {axis} {layout} {name}: UNAVAILABLE ({type(e).__name__})')
   155	                            torch.cuda.synchronize()
   156	                ok = {k2: v2['us_median'] for k2, v2 in case['backends'].items() if v2['status'] == 'ok'}
   157	                if ok:
   158	                    best = min(ok, key=ok.get)
   159	                    mbk = model_backend['backend']
   160	                    case['best_backend'] = best
   161	                    case['best_us'] = ok[best]
   162	                    case['model_backend_us'] = ok.get(mbk)
   163	                    case['ratio_best_over_model'] = (ok[best] / ok[mbk]) if mbk in ok else None
   164	                    case['ratio_note'] = ('model backend ASSUMED (no trace given)' if model_backend.get('assumed')
   165	                                          else f'model backend from trace: {mbk}')
   166	                result['cases'][f'c{chunk}_{axis}_{layout}'] = case
   167	                del keep
   168	    with open(args.out, 'w') as f:
   169	        json.dump(result, f, indent=1)
   170	    print(f'-> {args.out}')
   171	
   172	
   173	if __name__ == '__main__':
   174	    main()
     1	"""Post-processing (gate-02 f32): profiling-perturbation ratios (plan 1.6),
     2	boundary-bench perturbation, and the kernel -> source-op map with coverage
     3	(plan 1.3). Pure JSON/CSV; runs on the pod at the end of session 2 or off-pod.
     4	
     5	Perturbation: for each (arm, chunk) with pert_unprofiled / pert_graph /
