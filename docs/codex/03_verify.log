   520	def split_passes(rows, windows, classify):
   521	    if windows:
   522	        return [[r for r in rows if s <= r['start'] < e]
   523	                for s, e in windows], 'nvtx-windows'
   524	    sdpa_idx = [i for i, r in enumerate(rows) if classify(r['name']) == 'SDPA']
   525	    n_pass = max(1, round(len(sdpa_idx) / 12)) if sdpa_idx else 1
   526	    gaps = [(rows[i + 1]['start'] - (rows[i]['start'] + rows[i]['dur']), i)
   527	            for i in range(len(rows) - 1)]
   528	    cuts = sorted(i for _, i in sorted(gaps, key=lambda g: -g[0])[:n_pass - 1])
   529	    passes, prev = [], 0
   530	    for c in cuts:
   531	        passes.append(rows[prev:c + 1])
   532	        prev = c + 1
   533	    passes.append(rows[prev:])
   534	    return passes, 'gap-heuristic'
