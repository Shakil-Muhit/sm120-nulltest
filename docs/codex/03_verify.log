   214	def bind_refs(ref_dir, manifest_id, write=False):
   215	    """References belong to ONE session manifest (gate-02 f23)."""
   216	    path = os.path.join(ref_dir, 'manifest_id.txt')
   217	    if write:
   218	        os.makedirs(ref_dir, exist_ok=True)
   219	        with open(path, 'w') as f:
   220	            f.write(manifest_id + '\n')
   221	        return
   222	    if manifest_id is None:
   223	        return
   224	    if not os.path.exists(path) or open(path).read().strip() != manifest_id:
   225	        raise RuntimeError('reference outputs are not bound to this session manifest')
