     1	"""Three timing views for multi-stream arms (plan 1.7; prereg_amendments §5).
     2	
     3	From a node-level cuda_gpu_trace export with outer NVTX pass windows:
     4	  (i)   summed kernel durations per pass
     5	  (ii)  union of kernel intervals per pass (busy union — overlap collapsed)
     6	  (iii) OBSERVED-ORDER critical-path estimate per pass. DEPENDENCY MODEL
     7	        (stated; gate-02 f27): the trace exports no event/graph edges, so the
     8	        only dependencies that can be asserted are observed orderings —
     9	        edge a -> b iff a ENDED before b STARTED and (same stream) or
    10	        (different streams: the fork/join structure of F/G means a side-stream
    11	        kernel can only depend on main-stream work that finished before it,
    12	        and vice versa). Overlapping kernels never depend on each other.
    13	        Critical path = longest chain of pairwise non-overlapping kernels
    14	        (sum of durations). By construction critical_path <= union <= span
    15	        (asserted); this is an UPPER BOUND on the true dependency path, labelled
    16	        as such — never the true event graph.
    17	Every view is reported per pass and as the median over passes; "busy" is
    18	never reported without its view.
    19	"""
    20	
    21	import argparse
    22	import csv
    23	import json
    24	import re
    25	import statistics
    26	
    27	
    28	def read_rows(path):
    29	    with open(path, newline='') as f:
    30	        rd = csv.reader(f)
    31	        head = next(rd)
    32	        def col(*names, contains=None):
    33	            for n in names:
    34	                for i, h in enumerate(head):
    35	                    if h.strip().strip('"') == n:
    36	                        return i
    37	            if contains:
    38	                for i, h in enumerate(head):
    39	                    if contains in h:
    40	                        return i
    41	            return None
    42	        c_s, c_d = col('Start (ns)', contains='Start'), col('Duration (ns)', contains='Duration')
    43	        c_n, c_st = col('Name'), col('Strm', 'Stream', contains='Strm')
    44	        rows = []
    45	        for r in rd:
    46	            try:
    47	                rows.append({'start': int(float(r[c_s].replace(',', ''))),
    48	                             'dur': int(float(r[c_d].replace(',', ''))),
    49	                             'name': r[c_n], 'stream': r[c_st] if c_st is not None else '0'})
    50	            except (ValueError, IndexError):
    51	                continue
    52	    rows.sort(key=lambda x: x['start'])
    53	    return rows
    54	
    55	
    56	def windows(path):
    57	    with open(path, newline='') as f:
    58	        rd = csv.reader(f)
    59	        head = next(rd)
    60	        c_name = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Name', 'Range'))
    61	        c_start = next(i for i, h in enumerate(head) if 'Start' in h)
    62	        c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
    63	        wins = {}
    64	        for r in rd:
    65	            m = re.fullmatch(r'pass_(\d+)', r[c_name].strip().strip('"').split(':')[-1])
    66	            if m:
    67	                try:
    68	                    s = int(float(r[c_start].replace(',', '')))
    69	                    d = int(float(r[c_dur].replace(',', '')))
    70	                except ValueError:
    71	                    continue
    72	                wins[int(m.group(1))] = (s, s + d)
    73	    return [wins[i] for i in sorted(wins)]
    74	
    75	
    76	def union_ns(rows):
    77	    total, cur_s, cur_e = 0, None, None
    78	    for r in rows:
    79	        s, e = r['start'], r['start'] + r['dur']
    80	        if cur_e is None or s > cur_e:
    81	            if cur_e is not None:
    82	                total += cur_e - cur_s
    83	            cur_s, cur_e = s, e
    84	        else:
    85	            cur_e = max(cur_e, e)
    86	    if cur_e is not None:
    87	        total += cur_e - cur_s
    88	    return total
    89	
    90	
    91	def critical_path_ns(rows):
    92	    """Longest chain of pairwise non-overlapping kernels (ended-before-started
    93	    edges); O(n^2) per pass is fine for ~1-2k kernels."""
    94	    if not rows:
    95	        return 0, '-'
    96	    order = sorted(rows, key=lambda x: (x['start'], x['start'] + x['dur']))
    97	    ends = [r['start'] + r['dur'] for r in order]
    98	    best = [0] * len(order)
    99	    for i, r in enumerate(order):
   100	        pred = 0
   101	        for j in range(i):
   102	            if ends[j] <= r['start'] and best[j] > pred:
   103	                pred = best[j]
   104	        best[i] = pred + r['dur']
   105	    by_stream = {}
   106	    for r in rows:
   107	        by_stream[r['stream']] = by_stream.get(r['stream'], 0) + 1
   108	    dominant = max(by_stream, key=by_stream.get)
   109	    return max(best), dominant
   110	
   111	
   112	def main():
   113	    ap = argparse.ArgumentParser()
   114	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
   115	    ap.add_argument('--out', required=True)
   116	    ap.add_argument('--arm', default='')
   117	    args = ap.parse_args()
   118	    rows = read_rows(args.base + '_cuda_gpu_trace.csv')
   119	    wins = windows(args.base + '_nvtx_gpu_proj_trace.csv')
   120	    assert wins, 'no pass windows'
   121	    per = []
   122	    for s, e in wins:
   123	        p = [r for r in rows if s <= r['start'] < e]
   124	        cp, dom = critical_path_ns(p)
   125	        u = union_ns(p)
   126	        span = (max(r['start'] + r['dur'] for r in p) - min(r['start'] for r in p)) if p else 0
   127	        assert cp <= u + 1 and u <= span + 1, (cp, u, span)   # observed-order bound
   128	        per.append({'kernels': len(p), 'streams': sorted({r['stream'] for r in p}),
   129	                    'sum_ns': sum(r['dur'] for r in p), 'union_ns': u,
   130	                    'critical_path_observed_order_ns': cp, 'span_ns': span,
   131	                    'window_ns': e - s, 'dominant_stream': dom})
   132	    def med(k):
   133	        return statistics.median(x[k] for x in per)
   134	    out = {'arm': args.arm, 'passes': len(per),
   135	           'median_us': {k: med(k) / 1e3 for k in ('sum_ns', 'union_ns', 'critical_path_observed_order_ns', 'span_ns', 'window_ns')},
   136	           'median_kernels_per_pass': med('kernels'),
   137	           'streams_seen': sorted({s for x in per for s in x['streams']}),
   138	           'dependency_model': ('observed-order: edge a->b iff a ended before b started; '
   139	                                'longest chain of non-overlapping kernels; an UPPER BOUND on the '
   140	                                'true dependency path (no event/graph edges are exported)'),
   141	           'per_pass': per}
   142	    with open(args.out, 'w') as f:
   143	        json.dump(out, f, indent=1)
   144	    m = out['median_us']
   145	    print(f"[views] {args.arm}: sum {m['sum_ns']:.1f} us | union {m['union_ns']:.1f} us | "
   146	          f"observed-order critical path {m['critical_path_observed_order_ns']:.1f} us | span "
   147	          f"{m['span_ns']:.1f} us | streams {out['streams_seen']}")
   148	
   149	
   150	if __name__ == '__main__':
   151	    main()
     1	"""Task-quality gate (prereg_amendments.md §2): 8 fixed MUSDB18-HQ test clips,
     2	evaluated at EVERY compared operating point, paired against eager arm A at
     3	that same operating point.
     4	
     5	Reconstruction policy (registered): each 8.000-s clip (352800 samples) is
     6	processed as non-overlapping consecutive chunks of the operating point's size
     7	(1 x 352800, 4 x 88200, 16 x 22050, 80 x 4410) and the chunk outputs are
     8	concatenated (no overlap, no crossfade). Short-chunk SDR_ref values are
     9	therefore NOT quality claims about the model; the gate is the paired
    10	regression vs A under the identical policy.
    11	
    12	Metrics (stereo signals flattened to one vector; float64 accumulation):
    13	  SDR(ref, est)   = 10 log10( ||ref||^2 / ||ref - est||^2 )         (plain)
    14	  SI-SDR(ref, est): both zero-mean; s = <est,ref>/||ref||^2 * ref;
    15	                    10 log10( ||s||^2 / ||est - s||^2 )
    16	computed (a) vs the reference vocals stem and (b) vs the saved eager-A output
    17	for the same clip at the same operating point. A perfect match yields +inf
    18	(reported as the string "inf"). Gate: mean over the 8 clips of
    19	ΔSDR_ref = SDR_ref(arm) - SDR_ref(A) >= -0.1 dB; per-clip minimum, SI-SDR and
    20	the vs-A numbers are reported alongside (the gate is the mean).
    21	"""
    22	
    23	import hashlib
    24	import json
    25	import math
    26	import os
    27	
    28	import numpy as np
    29	import soundfile as sf
    30	import torch
    31	
    32	CLIP_SAMPLES = 352800
    33	THRESHOLD_DB = -0.1
    34	
    35	
    36	def _sha256(path):
    37	    h = hashlib.sha256()
    38	    with open(path, 'rb') as f:
    39	        for block in iter(lambda: f.read(1 << 20), b''):
    40	            h.update(block)
    41	    return h.hexdigest()
    42	
    43	
    44	def load_clips(clips_dir, manifest_path):
    45	    """Verifies every wav's sha256 against the manifest (loud failure)."""
    46	    with open(manifest_path) as f:
    47	        man = json.load(f)
    48	    clips = []
    49	    for c in man['clips']:
    50	        rec = {'index': c['index'], 'track': c['track'], 'start_sample': c['start_sample']}
    51	        for kind in ('mixture', 'vocals'):
    52	            entry = c['files'][kind]
    53	            path = os.path.join(clips_dir, entry['name'])
    54	            if not os.path.exists(path):
    55	                raise FileNotFoundError(f'clip missing: {path}')
    56	            got = _sha256(path)
    57	            if got != entry['sha256']:
    58	                raise ValueError(f'clip sha256 mismatch: {path} {got} != {entry["sha256"]}')
    59	            audio, sr = sf.read(path, dtype='float32', always_2d=True)   # (n, 2)
    60	            assert sr == 44100 and audio.shape == (CLIP_SAMPLES, 2), (path, sr, audio.shape)
    61	            rec[kind] = torch.from_numpy(audio.T.copy())                  # (2, n)
    62	        clips.append(rec)
    63	    assert len(clips) == 8, f'expected 8 clips, got {len(clips)}'
    64	    assert len({c['track'] for c in clips}) == 8, 'clips must come from 8 distinct tracks'
    65	    return man, clips
    66	
    67	
    68	def _db(num, den):
    69	    """Registered semantics: num>0, den==0 -> 'inf' (perfect match);
    70	    num==0 -> 'undefined' (zero reference/projection); non-finite inputs ->
    71	    'undefined'; else a float."""
    72	    if not (math.isfinite(num) and math.isfinite(den)):
    73	        return 'undefined'
    74	    if num == 0:
    75	        return 'undefined'
    76	    if den == 0:
    77	        return 'inf'
    78	    return float(10 * math.log10(num / den))
    79	
    80	
    81	def sdr_db(ref, est):
    82	    ref = ref.reshape(-1).double()
    83	    est = est.reshape(-1).double()
    84	    return _db(float((ref ** 2).sum()), float(((ref - est) ** 2).sum()))
    85	
    86	
    87	def si_sdr_db(ref, est):
    88	    ref = ref.reshape(-1).double()
    89	    est = est.reshape(-1).double()
    90	    ref = ref - ref.mean()
    91	    est = est - est.mean()
    92	    rr = float((ref ** 2).sum())
    93	    if rr == 0:
    94	        return 'undefined'
    95	    s = (est * ref).sum() / rr * ref
    96	    return _db(float((s ** 2).sum()), float(((est - s) ** 2).sum()))
    97	
    98	
    99	def _mean_with_inf(values):
   100	    finite = [v for v in values if isinstance(v, float)]
   101	    n_inf = sum(1 for v in values if v == 'inf')
   102	    n_undef = sum(1 for v in values if v == 'undefined')
   103	    return {'mean_finite_db': float(np.mean(finite)) if finite else None,
   104	            'n_finite': len(finite), 'n_inf': n_inf, 'n_undefined': n_undef}
   105	
   106	
   107	def a_output_path(ref_dir, chunk, index):
   108	    return os.path.join(ref_dir, f'sdr_A_c{chunk}_clip{index:02d}.pt')
   109	
   110	
   111	def separate_clip(step, ctx, mixture, chunk):
   112	    """Non-overlapping chunked processing + concatenation (registered policy)."""
   113	    assert CLIP_SAMPLES % chunk == 0, (CLIP_SAMPLES, chunk)
   114	    outs = []
   115	    with torch.no_grad(), ctx():
   116	        for i in range(CLIP_SAMPLES // chunk):
   117	            x = mixture[:, i * chunk:(i + 1) * chunk].unsqueeze(0).cuda()
   118	            out = step(x)
   119	            torch.cuda.synchronize()
   120	            out = out.float().clone()            # borrowed replay buffer -> owned
   121	            if out.dim() == 3:
   122	                out = out[0]
   123	            assert out.shape == (2, chunk), tuple(out.shape)
   124	            outs.append(out.cpu())
   125	    return torch.cat(outs, dim=-1)
   126	
   127	
   128	def run_gate(step, ctx, clips, ref_dir, chunk, save_reference=False):
   129	    rows = []
   130	    for c in clips:
   131	        est = separate_clip(step, ctx, c['mixture'], chunk)
   132	        vocals = c['vocals']
   133	        row = {'index': c['index'], 'track': c['track'],
   134	               'sdr_ref_db': sdr_db(vocals, est),
   135	               'si_sdr_ref_db': si_sdr_db(vocals, est),
   136	               'finite': bool(torch.isfinite(est).all())}
   137	        path = a_output_path(ref_dir, chunk, c['index'])
   138	        if save_reference:
   139	            os.makedirs(ref_dir, exist_ok=True)
   140	            torch.save(est, path)
   141	            row['saved'] = path
   142	        else:
   143	            if not os.path.exists(path):
   144	                raise FileNotFoundError(f'eager-A clip output missing: {path}')
   145	            a_out = torch.load(path, weights_only=True)
   146	            row['sdr_ref_A_db'] = sdr_db(vocals, a_out)
   147	            d = (row['sdr_ref_db'] - row['sdr_ref_A_db']
   148	                 if isinstance(row['sdr_ref_db'], float) and isinstance(row['sdr_ref_A_db'], float)
   149	                 else None)
   150	            row['delta_sdr_ref_db'] = d
   151	            row['sdr_vs_A_db'] = sdr_db(a_out, est)
   152	            row['si_sdr_vs_A_db'] = si_sdr_db(a_out, est)
   153	            row['max_abs_diff_vs_A'] = float((a_out - est).abs().max())
   154	        rows.append(row)
   155	    rec = {'clips': rows, 'operating_point': chunk,
   156	           'chunks_per_clip': CLIP_SAMPLES // chunk,
   157	           'reconstruction': 'non-overlapping concatenation',
   158	           'threshold_mean_delta_sdr_db': THRESHOLD_DB, 'n_clips': len(rows)}
   159	    rec['sdr_ref_summary'] = _mean_with_inf([r['sdr_ref_db'] for r in rows])
   160	    rec['mean_sdr_ref_db'] = rec['sdr_ref_summary']['mean_finite_db']
   161	    if save_reference:
   162	        rec['status'] = 'REFERENCE_SAVED'
   163	        return rec
   164	    # the gate uses the SDR_ref terms only: both arm and A must be finite
   165	    deltas = [r['delta_sdr_ref_db'] for r in rows]
   166	    if any(d is None for d in deltas):
   167	        rec['status'] = 'FAIL'
   168	        rec['reason'] = ('a paired SDR_ref term is non-finite ("inf" = perfect match to the '
   169	                         'reference stem, "undefined" = zero reference) — not gateable')
   170	        return rec
   171	    rec['mean_delta_sdr_ref_db'] = float(np.mean(deltas))
   172	    rec['min_delta_sdr_ref_db'] = float(np.min(deltas))
   173	    # output fidelity vs A: infinities are expected for A itself and are kept
   174	    rec['sdr_vs_A_summary'] = _mean_with_inf([r['sdr_vs_A_db'] for r in rows])
   175	    rec['all_finite'] = all(r['finite'] for r in rows)
   176	    rec['status'] = ('PASS' if rec['all_finite'] and
   177	                     rec['mean_delta_sdr_ref_db'] >= THRESHOLD_DB else 'FAIL')
   178	    return rec

