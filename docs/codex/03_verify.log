   112	def graph_gate(require_zero_breaks):
   113	    """Compile-arm gate (prereg_amendments.md §1, C3/H): graph breaks and
   114	    unimplemented ops from the Dynamo counters; cudagraph skips from the
   115	    Inductor counters (plan 0.3 input)."""
   116	    snap = dynamo_counters()
   117	    breaks = sum(snap.get('graph_break', {}).values())
   118	    unsupported = sum(snap.get('unimplemented', {}).values())
   119	    inductor = snap.get('inductor', {})
   120	    skips = {k: v for k, v in inductor.items() if 'cudagraph' in k}
   121	    rec = {'graph_break_count': breaks, 'unimplemented_count': unsupported,
   122	           'unique_graphs': snap.get('stats', {}).get('unique_graphs', 0),
   123	           'cudagraph_counters': skips,
   124	           'suppress_errors': bool(torch._dynamo.config.suppress_errors),
   125	           'require_zero_breaks': require_zero_breaks,
   126	           'graph_break_reasons': list(snap.get('graph_break', {}).keys())[:40]}
   127	    rec['status'] = ('PASS' if (not require_zero_breaks or
   128	                                (breaks == 0 and unsupported == 0))
   129	                     and not rec['suppress_errors'] else 'FAIL')
   130	    return rec
