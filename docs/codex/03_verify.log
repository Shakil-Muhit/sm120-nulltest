    56	    local rc=$?
    57	    if [ "$rc" = "124" ] || [ "$rc" = "137" ]; then
    58	        terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "timeout after ${cap}s"
    59	        echo "    TIMEOUT -> UNTESTED recorded"
    60	    elif [ "$rc" != "0" ]; then
    61	        echo "    process exit $rc"
    62	        [ -s "$path" ] || terminal_json "$path" "$arm" "$chunk" "$tag" INVALID "process exit $rc without JSON"
    63	    fi
    64	}
    65	
    66	# run_matched ARM_A ARM_B CHUNK TAG
    67	run_matched() {
    68	    local a="$1" b="$2" chunk="$3" tag="$4"
    69	    local path="$EVID/matched_${a}_${b}_c${chunk}_${tag}.json"
    70	    local cap; cap=$(cap_for "$T_COMPILE")
    71	    if [ "$cap" -lt "$T_MIN" ]; then
    72	        echo "--- matched $a/$b $tag: DEADLINE -> UNTESTED ---"
    73	        python3 -c "import json;json.dump({'pair':['$a','$b'],'chunk':$chunk,'tag':'$tag','status':'UNTESTED','error':'session deadline','pair_eligible':False},open('$path','w'),indent=1)"
    74	        return
    75	    fi
    76	    echo "--- matched pair $a vs $b chunk=$chunk tag=$tag $(date -Is) cap=${cap}s ---"
    77	    env TORCH_LOGS="graph_breaks,recompiles,cudagraphs" timeout -k 30 "$cap" python "$MATCHED" \
    78	        --pair "$a" "$b" --chunk "$chunk" --tag "$tag" --iters "$ITERS" --repeats "$REPEATS" \
    79	        --evidence-dir "$EVID" 2> "$EVID/torchlogs_matched_${a}_${b}_${chunk}_${tag}.log"
    80	    local rc=$?
    81	    [ "$rc" = "0" ] || echo "    matched exit $rc"
    82	    [ -s "$path" ] || python3 -c "import json;json.dump({'pair':['$a','$b'],'chunk':$chunk,'tag':'$tag','status':'UNTESTED','error':'exit $rc','pair_eligible':False},open('$path','w'),indent=1)"
    83	}
    84	
    85	# run_traced ARM CHUNK TAG GRAPHMODE(node|graph) [extra...]  — one 5a block under nsys
    86	run_traced() {
    87	    local arm="$1" chunk="$2" tag="$3" gmode="$4"; shift 4
    88	    local base="$EVID/traces/trace_${arm}_${chunk}_${tag}"
    89	    local path="$EVID/full_${arm}_c${chunk}_${tag}.json"
    90	    local cap; cap=$(cap_for "$(tmo_for "$arm")")
    91	    mkdir -p "$EVID/traces"
    92	    if [ "$cap" -lt "$T_MIN" ]; then
    93	        echo "--- TRACE $arm/$chunk/$tag: DEADLINE -> UNTESTED ---"
    94	        terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "session deadline: not started"
    95	        return 1
    96	    fi
    97	    local envv=("TORCHINDUCTOR_UNIQUE_KERNEL_NAMES=1") logs; logs="$(logs_for "$arm")"
    98	    [ -n "$logs" ] && envv+=("TORCH_LOGS=$logs")
    99	    if [ -n "$logs" ] && [ "$gmode" = "node" ]; then
   100	        local dump="$EVID/traces/dump_${arm}_${chunk}_${tag}"; rm -rf "$dump"; mkdir -p "$dump"
   101	        envv+=("TORCH_COMPILE_DEBUG=1" "TORCH_COMPILE_DEBUG_DIR=$dump" "TORCHINDUCTOR_FORCE_DISABLE_CACHES=1")
   102	    fi
   103	    echo "--- TRACE arm=$arm chunk=$chunk tag=$tag graph-trace=$gmode $(date -Is) cap=${cap}s ---"
   104	    env "${envv[@]}" timeout -k 30 "$cap" nsys profile --capture-range=cudaProfilerApi \
   105	        --capture-range-end=stop --cuda-graph-trace="$gmode" --force-overwrite=true \
   106	        -o "$base" python "$RUN" --arm "$arm" --chunk "$chunk" --tag "$tag" \
   107	        --iters "$ITERS" --repeats 1 --nvtx-pass --clips-dir "$CLIPS_DIR" --evidence-dir "$EVID" "$@" \
   108	        2> "$EVID/torchlogs_${arm}_${chunk}_${tag}.log"
   109	    local rc=$?
   110	    if [ "$rc" != "0" ]; then
   111	        echo "    trace run exit $rc"
   112	        [ -s "$path" ] || terminal_json "$path" "$arm" "$chunk" "$tag" UNTESTED "trace run exit $rc"
   113	        return 1
   114	    fi
   115	    [ -s "$base.nsys-rep" ] || { echo "    no .nsys-rep"; return 1; }
   116	    if [ "$gmode" = "node" ]; then
   117	        nsys stats --force-export=true --force-overwrite=true --format csv \
   118	            --report cuda_gpu_trace --report cuda_gpu_kern_sum --report cuda_api_trace \
   119	            --report nvtx_gpu_proj_trace --report nvtx_gpu_proj_sum \
   120	            --output "$base" "$base.nsys-rep" > /dev/null 2>&1 || echo "    WARN: some exports failed for $base"
   121	        local missing=0
   122	        for rep in cuda_gpu_trace cuda_gpu_kern_sum cuda_api_trace nvtx_gpu_proj_trace; do
   123	            [ -s "${base}_${rep}.csv" ] || { echo "    MISSING export: ${base}_${rep}.csv"; missing=1; }
   124	        done
   125	        python3 -c "import json;json.dump({'complete': $(( 1 - missing )) == 1, 'graph_trace_mode': '$gmode'}, open('${base}_exports.json','w'))"
   126	    fi
   127	    return 0
   128	}
   129	
   130	# bounded auxiliary command: run_aux NAME CAP -- cmd...
   131	run_aux() {
   132	    local name="$1" want="$2"; shift 2; [ "$1" = "--" ] && shift
   133	    local cap; cap=$(cap_for "$want")
   134	    if [ "$cap" -lt 60 ]; then echo "--- $name: DEADLINE -> skipped (UNTESTED) ---"; echo "UNTESTED: deadline" > "$EVID/${name}.UNTESTED"; return 1; fi
   135	    echo "--- $name $(date -Is) cap=${cap}s ---"
   136	    timeout -k 30 "$cap" "$@"; local rc=$?
   137	    [ "$rc" = "0" ] || { echo "    $name exit $rc"; echo "exit $rc" > "$EVID/${name}.FAILED"; }
   138	    return $rc
   139	}
   140	
   141	clocks_start() {   # file
   142	    nvidia-smi --query-gpu=timestamp,uuid,clocks.sm,clocks.mem,power.draw,temperature.gpu,utilization.gpu \
   143	        --format=csv,noheader -l 1 > "$1" 2>/dev/null &
   144	    CLK_PID=$!
   145	    trap 'kill $CLK_PID 2>/dev/null' EXIT
   146	}
     1	#!/bin/bash
     2	# SESSION 1 (prereg_amendments.md §5) — the full-model arm matrix, unprofiled.
     3	#   [0] preflight: nsys, deps, clip pack, provenance + SESSION MANIFEST,
     4	#       clock sampler (timestamp+uuid), session deadline clock
     5	#   [1] eager-A references at both operating points (validation refs + SDR
     6	#       clip outputs under the registered chunked policy)
     7	#   [2] planted-fault validator checks: tight (+1e-3) and loose (+5e-2) —
     8	#       both MUST FAIL; a PASS aborts the session
     9	#   [3] C3 DC-filter operator qualification per registered frame count
    10	#   [4] matched block-alternation pairs (plan 1.2) at 352800: (C1,C1A) once
    11	#       (expected compile failure), then (C1,C3) (C1,C1D) (C3,H) x RESTARTS
    12	#   [5] arm matrix, round-major (r1 of every arm, then r2, r3), priority
    13	#       order within a round; SDR gate in r1 at BOTH operating points.
    14	#       C1A is NOT in the matrix (its expected failure is recorded in [4]).
    15	#   [6] C2 last: aggregate allowance; a timed-out cold attempt is not retried
    16	#   [7] collection
    17	# Every launch is bounded by min(cap, remaining usable time) and leaves a
    18	# terminal JSON (scripts/session_lib.sh); unfinished mandatory cells are
    19	# UNTESTED and the session is reported INCOMPLETE — never salvaged.
    20	# Smoke knobs (engineering only, never evidence): SMOKE=1 selects a reduced
    21	# matrix; ARMS / PAIRS override the lists; SKIP_C2=1.
    22	set -u
    23	. "$(dirname "${BASH_SOURCE[0]}")/session_lib.sh"
    24	C2_BUDGET_S="${C2_BUDGET_S:-2400}"
    25	ARMS="${ARMS:-A C3 C1 H G B E D F C1D}"
    26	PAIRS="${PAIRS:-C1:C3 C1:C1D C3:H}"
    27	mkdir -p "$EVID" "$REF"
    28	cd "$REPO_DIR"
    29	exec > >(tee -a "$EVID/session1_console.log") 2>&1
    30	echo "SESSION1 START $(date -Is) iters=$ITERS repeats=$REPEATS restarts=$RESTARTS budget=${SESSION_BUDGET_S}s reserve=${EXTRACT_RESERVE_S}s"
    31	[ -z "${TMUX:-}" ] && echo "WARNING: not inside tmux"
    32	
    33	echo "=== [0] preflight ==="
    34	command -v nsys >/dev/null || { echo "FATAL: nsys missing — run setup.sh"; exit 1; }
    35	python - <<'PYEOF' || { echo "FATAL: preflight imports failed"; exit 1; }
    36	import torch, triton, numpy, librosa, soundfile, einops
    37	assert torch.cuda.is_available()
    38	print('torch', torch.__version__, '| triton', triton.__version__, '|', torch.cuda.get_device_name(0))
    39	PYEOF
    40	[ -d "$CLIPS_DIR" ] || { echo "FATAL: clip pack missing at $CLIPS_DIR"; exit 1; }
    41	python - "$EVID" session1 <<'PYEOF' || { echo "FATAL: provenance / session manifest failed"; exit 1; }
    42	import json, os, sys
    43	sys.path.insert(0, os.path.join(os.getcwd(), 'fullmodel'))
    44	import loader, provenance, timing
    45	ev, session = sys.argv[1], sys.argv[2]
    46	paths = loader.paths_from_env()
    47	rec = provenance.create_manifest(ev, paths, timing.env_fingerprint(), session)
    48	print('manifest', rec['manifest_id'], 'repo', rec['repo_commit'], 'msst', rec['provenance']['msst_commit'][:12],
    49	      'ckpt', rec['provenance']['ckpt_sha256'][:12])
    50	PYEOF
    51	{ nvidia-smi --query-gpu=name,uuid,driver_version,memory.total --format=csv,noheader
    52	  python -c "import torch, triton; print('torch', torch.__version__, 'triton', triton.__version__, 'cuda', torch.version.cuda)"
    53	  nsys --version | head -1; git -C "$REPO_DIR" rev-parse HEAD; date -Is
    54	} > "$EVID/env_snapshot_session1.txt" 2>&1
    55	clocks_start "$EVID/clocks_session1.csv"
    56	
    57	echo "=== [1] eager-A reference outputs (both operating points) ==="
    58	run_one A 352800 ref --save-reference --sdr --skip-timing
    59	run_one A 4410 ref --save-reference --sdr --skip-timing
    60	for f in ref_A_c352800_s1001.pt ref_A_c352800_s2002.pt ref_A_c4410_s1001.pt ref_A_c4410_s2002.pt \
    61	         sdr_A_c352800_clip00.pt sdr_A_c352800_clip07.pt sdr_A_c4410_clip00.pt sdr_A_c4410_clip07.pt manifest_id.txt; do
    62	    [ -s "$REF/$f" ] || { echo "FATAL: reference $f missing"; exit 1; }
    63	done
    64	
    65	echo "=== [2] planted-fault validator checks (both must FAIL) ==="
    66	run_one A 4410 planted_tight --planted-fault --skip-timing
    67	run_one A 4410 planted_loose --planted-fault --planted-const 0.05 --force-tier loose --skip-timing
    68	python3 - "$EVID/full_A_c4410_planted_tight.json" 0.001 "$EVID/full_A_c4410_planted_loose.json" 0.05 <<'PYEOF' || { echo "FATAL: a validator did not catch its planted fault"; exit 1; }
    69	import json, sys
    70	ok_all = True
    71	for path, const in ((sys.argv[1], float(sys.argv[2])), (sys.argv[3], float(sys.argv[4]))):
    72	    r = json.load(open(path)); v = r.get('validation') or {}; passes = v.get('passes') or []
    73	    diffs = [p.get('max_abs_diff') for p in passes]
    74	    ok = (v.get('status') == 'FAIL' and len(passes) == 2 and all(not p['ok'] for p in passes)
    75	          and all(d is not None and abs(d - const) < 1e-4 * const + 1e-6 for d in diffs))
    76	    print(f"planted {const} tier={v.get('tier')}: status={v.get('status')} max_abs_diff={diffs} -> {'CAUGHT' if ok else 'NOT CAUGHT'}")
    77	    ok_all &= ok
    78	sys.exit(0 if ok_all else 1)
    79	PYEOF
    80	
    81	echo "=== [3] C3 operator qualification per registered frame count ==="
    82	run_aux c3_operator_qualification 600 -- python - <<'PYEOF' > "$EVID/c3_operator_qualification.json" || { echo "FATAL: C3 operator qualification failed"; exit 1; }
    83	import json, os, sys
    84	sys.path.insert(0, os.path.join(os.getcwd(), 'fullmodel'))
    85	import fullarms
    86	print(json.dumps(fullarms.verify_c3_operator(), indent=1))
    87	PYEOF
    88	grep -q '"status": "PASS"' "$EVID/c3_operator_qualification.json" || { echo "FATAL: C3 qualification has no PASS"; exit 1; }
    89	
    90	echo "=== [4] matched block-alternation pairs @352800 (plan 1.2) ==="
    91	[ "${SMOKE:-0}" = "1" ] || run_matched C1 C1A 352800 m1
    92	for r in $(seq 1 "$RESTARTS"); do
    93	    for pr in $PAIRS; do
    94	        run_matched "${pr%%:*}" "${pr##*:}" 352800 "m$r"
    95	    done
    96	done
    97	
    98	echo "=== [5] arm matrix, round-major ==="
    99	for r in $(seq 1 "$RESTARTS"); do
   100	    for chunk in 352800 4410; do
   101	        for arm in $ARMS; do
   102	            [ "$chunk" != "352800" ] && [ "$arm" = "C1D" ] && continue
   103	            extra=""; [ "$r" = "1" ] && extra="--sdr"
   104	            run_one "$arm" "$chunk" "r$r" $extra
   105	        done
   106	    done
   107	done
   108	
   109	if [ "${SKIP_C2:-0}" != "1" ]; then
   110	echo "=== [6] C2 (max-autotune) last, aggregate allowance ${C2_BUDGET_S}s ==="
   111	C2_T0=$(date +%s)
   112	for chunk in 352800 4410; do
   113	    cold_timed_out=0
   114	    for r in $(seq 1 "$RESTARTS"); do
   115	        left=$(( C2_BUDGET_S - ($(date +%s) - C2_T0) ))
   116	        path="$EVID/full_C2_c${chunk}_r${r}.json"
   117	        if [ "$cold_timed_out" = "1" ]; then
   118	            terminal_json "$path" C2 "$chunk" "r$r" UNTESTED "not attempted: identical cold attempt timed out (no-retry rule)"; continue
   119	        fi
   120	        if [ "$left" -lt "$T_MIN" ]; then
   121	            terminal_json "$path" C2 "$chunk" "r$r" UNTESTED "C2 aggregate allowance exhausted"; continue
   122	        fi
   123	        extra=""; [ "$r" = "1" ] && extra="--sdr"
   124	        T_COMPILE_SAVED="$T_COMPILE"; T_COMPILE=$(( left < T_COMPILE ? left : T_COMPILE ))
   125	        run_one C2 "$chunk" "r$r" $extra
   126	        T_COMPILE="$T_COMPILE_SAVED"
   127	        grep -q '"status": "UNTESTED"' "$path" 2>/dev/null && [ "$r" = "1" ] && cold_timed_out=1
   128	    done
   129	done
   130	fi
   131	
   132	echo "=== [7] collection ==="
   133	python "$REPO_DIR/fullmodel/collect_full.py" --evidence-dir "$EVID" || true
   134	echo "SESSION1 DONE $(date -Is) elapsed=$(( $(date +%s) - T0 ))s remaining=$(remaining)s"
   135	echo ">>> EXTRACT evidence/ OFF-POD BEFORE TERMINATE:  tar czf /root/evidence_s1_\$(date +%Y%m%d_%H%M).tgz -C $REPO_DIR evidence"
     1	#!/bin/bash
     2	# SESSION 2 (prereg_amendments.md §5): sweep, node-level traces, profiling
     3	# perturbation, microbenchmarks, verification exports and post-processing.
     4	# Same deadline/reserve/terminal-record rules as session 1 (session_lib.sh).
     5	# Requires session-1 evidence/ (manifest + refs); on a fresh pod the
     6	# preflight creates a session-2 manifest and re-creates the references.
     7	set -u
     8	. "$(dirname "${BASH_SOURCE[0]}")/session_lib.sh"
     9	TRACE_ARMS="${TRACE_ARMS:-A ANVTX C3 G H C1 B E F}"
    10	SWEEP_ARMS="${SWEEP_ARMS:-A C3 G H}"
    11	mkdir -p "$EVID" "$REF" "$EVID/traces"
    12	cd "$REPO_DIR"
    13	exec > >(tee -a "$EVID/session2_console.log") 2>&1
    14	echo "SESSION2 START $(date -Is) budget=${SESSION_BUDGET_S}s reserve=${EXTRACT_RESERVE_S}s"
    15	[ -z "${TMUX:-}" ] && echo "WARNING: not inside tmux"
    16	
    17	echo "=== [0] preflight ==="
    18	command -v nsys >/dev/null || { echo "FATAL: nsys missing"; exit 1; }
    19	nsys profile --help 2>/dev/null | grep -q 'cuda-graph-trace' || { echo "FATAL: nsys lacks --cuda-graph-trace"; exit 1; }
    20	nsys --version | tee "$EVID/nsys_version_session2.txt"
    21	if [ ! -s "$EVID/session_manifest.json" ]; then
    22	    python - "$EVID" session2 <<'PYEOF' || { echo "FATAL: provenance / session manifest failed"; exit 1; }
    23	import os, sys
    24	sys.path.insert(0, os.path.join(os.getcwd(), 'fullmodel'))
    25	import loader, provenance, timing
    26	rec = provenance.create_manifest(sys.argv[1], loader.paths_from_env(), timing.env_fingerprint(), sys.argv[2])
    27	print('manifest', rec['manifest_id'])
    28	PYEOF
    29	else
    30	    python - "$EVID" <<'PYEOF' || { echo "FATAL: session manifest does not match this tree"; exit 1; }
    31	import os, sys
    32	sys.path.insert(0, os.path.join(os.getcwd(), 'fullmodel'))
    33	import provenance
    34	print('manifest ok', provenance.load_manifest(sys.argv[1])['manifest_id'])
    35	PYEOF
    36	fi
    37	clocks_start "$EVID/clocks_session2.csv"
    38	for chunk in 352800 4410 22050 88200; do
    39	    if [ ! -s "$REF/ref_A_c${chunk}_s2002.pt" ] || [ ! -s "$REF/sdr_A_c${chunk}_clip07.pt" ]; then
    40	        run_one A "$chunk" ref --save-reference --sdr --skip-timing
    41	    fi
    42	done
    43	
    44	echo "=== [1] chunk sweep: $SWEEP_ARMS x {22050, 88200} x $RESTARTS restarts (round-major) ==="
    45	for r in $(seq 1 "$RESTARTS"); do
    46	    for chunk in 22050 88200; do
    47	        for arm in $SWEEP_ARMS; do
    48	            extra=""; [ "$r" = "1" ] && extra="--sdr"
    49	            run_one "$arm" "$chunk" "r$r" $extra
    50	        done
    51	    done
    52	done
    53	
    54	echo "=== [2] node-level traces (+ graph verification, timing views) ==="
    55	for chunk in 352800 4410; do
    56	    for arm in $TRACE_ARMS; do
    57	        run_traced "$arm" "$chunk" trace node || continue
    58	        base="$EVID/traces/trace_${arm}_${chunk}_trace"
    59	        [ -s "${base}_cuda_gpu_trace.csv" ] || continue
    60	        python "$REPO_DIR/fullmodel/graph_verify.py" --base "$base" --arm "$arm" --expected-passes "$ITERS" \
    61	            --out "$EVID/traces/graph_verify_${arm}_${chunk}.json" || echo "    graph_verify failed for $arm/$chunk"
    62	        python "$REPO_DIR/fullmodel/timing_views.py" --base "$base" --arm "$arm" \
    63	            --out "$EVID/traces/timing_views_${arm}_${chunk}.json" || echo "    timing_views failed"
    64	    done
    65	done
    66	# C2 replay verification at 4410 only (registered: the §6 comparator point)
    67	if run_traced C2 4410 trace node; then
    68	    base="$EVID/traces/trace_C2_4410_trace"
    69	    python "$REPO_DIR/fullmodel/graph_verify.py" --base "$base" --arm C2 --expected-passes "$ITERS" \
    70	        --out "$EVID/traces/graph_verify_C2_4410.json" || echo "    graph_verify failed for C2"
    71	fi
    72	
    73	echo "=== [3] profiling perturbation: A, C3, G — unprofiled vs graph-level vs node-level (one block each) ==="
    74	for chunk in 352800 4410; do
    75	    for arm in A C3 G; do
    76	        run_one "$arm" "$chunk" pert_unprofiled --repeats 1
    77	        run_traced "$arm" "$chunk" pert_graph graph
    78	        run_traced "$arm" "$chunk" pert_node node
    79	    done
    80	done
    81	
    82	echo "=== [4] attention-backend microbench (model backend from the C3 trace) ==="
    83	KS="$EVID/traces/trace_C3_352800_trace_cuda_gpu_kern_sum.csv"
    84	run_aux attn_backend_bench 900 -- python "$REPO_DIR/fullmodel/attn_backend_bench.py" \
    85	    --out "$EVID/attn_backend_bench.json" $( [ -s "$KS" ] && echo "--model-kern-sum $KS" )
    86	
    87	echo "=== [5] boundary-cost microbench + its node-level trace ==="
    88	run_aux boundary_bench 900 -- python "$REPO_DIR/fullmodel/boundary_bench.py" --out "$EVID/boundary_bench.json"
    89	run_aux boundary_bench_trace 900 -- nsys profile --cuda-graph-trace=node --force-overwrite=true \
    90	    -o "$EVID/traces/trace_boundary_bench" \
    91	    python "$REPO_DIR/fullmodel/boundary_bench.py" --out "$EVID/boundary_bench_traced.json" \
    92	    && nsys stats --force-export=true --force-overwrite=true --format csv \
    93	        --report cuda_gpu_trace --report cuda_gpu_kern_sum --report nvtx_gpu_proj_trace \
    94	        --output "$EVID/traces/trace_boundary_bench" "$EVID/traces/trace_boundary_bench.nsys-rep" > /dev/null 2>&1 \
    95	    && python "$REPO_DIR/fullmodel/boundary_bench.py" --analyze-trace "$EVID/traces/trace_boundary_bench" \
    96	        --out "$EVID/boundary_bench_trace_analysis.json" \
    97	    || echo "WARN: boundary trace/analysis incomplete"
    98	
    99	echo "=== [6] per-kernel ideal costs (plan 1.4; measured L2 rate from [5]) ==="
   100	BW_L2=$(python3 -c "import json;print(json.load(open('$EVID/boundary_bench.json')).get('l2_resident_bandwidth',{}).get('tbps',''))" 2>/dev/null)
   101	L2B=$(python3 -c "import json;print(json.load(open('$EVID/boundary_bench.json')).get('l2_resident_bandwidth',{}).get('l2_cache_bytes',''))" 2>/dev/null)
   102	for chunk in 352800 4410; do
   103	    for arm in $TRACE_ARMS C2; do
   104	        base="$EVID/traces/trace_${arm}_${chunk}_trace"
   105	        [ -s "${base}_cuda_gpu_kern_sum.csv" ] || continue
   106	        dump="$EVID/traces/dump_${arm}_${chunk}_trace"; [ -d "$dump" ] || dump=""
   107	        python "$REPO_DIR/fullmodel/ideal_costs.py" --base "$base" --arm "$arm" --chunk "$chunk" \
   108	            ${dump:+--dump-dir "$dump"} --passes "$ITERS" \
   109	            ${BW_L2:+--bw-l2-tbps "$BW_L2"} ${L2B:+--l2-bytes "$L2B"} \
   110	            --out "$EVID/traces/ideal_costs_${arm}_${chunk}.json" || echo "    ideal_costs failed for $arm/$chunk"
   111	    done
   112	done
   113	
   114	echo "=== [7] post-processing: perturbation ratios, boundary perturbation, source map ==="
   115	python "$REPO_DIR/fullmodel/perturbation.py" --evidence-dir "$EVID" --iters "$ITERS" \
   116	    --out "$EVID/perturbation_and_source_map.json" || echo "WARN: post-processing failed"
   117	
   118	echo "=== [8] collection ==="
   119	python "$REPO_DIR/fullmodel/collect_full.py" --evidence-dir "$EVID" || true
   120	echo "SESSION2 DONE $(date -Is) elapsed=$(( $(date +%s) - T0 ))s remaining=$(remaining)s"
