   485	def nvtx_pass_windows(path):
   486	    """pass_<i> projected ranges; require unique ids and non-overlap."""
   487	    try:
   488	        with open(path, newline='') as f:
   489	            rd = csv.reader(f)
   490	            head = next(rd)
   491	            c_name = next(i for i, h in enumerate(head)
   492	                          if h.strip().strip('"') in ('Name', 'Range'))
   493	            c_start = next(i for i, h in enumerate(head) if 'Start' in h)
   494	            c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
   495	            wins = {}
   496	            for r in rd:
   497	                nm = r[c_name].strip().strip('"').split(':')[-1]
   498	                if re.fullmatch(r'pass_\d+', nm):
   499	                    try:
   500	                        s = int(float(r[c_start].replace(',', '')))
   501	                        d = int(float(r[c_dur].replace(',', '')))
   502	                    except ValueError:
   503	                        continue
   504	                    i = int(nm.split('_')[1])
   505	                    if i in wins:
   506	                        return [], f'duplicate nvtx pass id {i}'
   507	                    wins[i] = (s, s + d)
   508	            ids = sorted(wins)
   509	            if ids != list(range(len(ids))):
   510	                return [], f'non-contiguous nvtx pass ids ({len(ids)} found)'
   511	            ordered = [wins[i] for i in ids]
   512	            for a, b in zip(ordered, ordered[1:]):
   513	                if b[0] < a[1]:
   514	                    return [], 'overlapping nvtx pass windows'
   515	            return ordered, None
   516	    except Exception as e:
   517	        return [], f'nvtx parse failed: {e}'
