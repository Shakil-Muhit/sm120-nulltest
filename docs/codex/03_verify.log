   103	def verify_operator(frames=FRAMES):
   104	    """Per registered T: schema/fake checks, bitwise native equality,
   105	    CUDA-graph capture/replay, isolated full-graph compile."""
   106	    out = {}
   107	    for T in frames:
   108	        gen = torch.Generator(device='cpu').manual_seed(4242)
   109	        x = torch.randn((1025, 2, T), generator=gen, dtype=torch.complex64).to('cuda')
   110	        x = x.permute(1, 0, 2)
   111	        index = torch.tensor(0, device='cuda')
   112	        with torch.no_grad(), torch.autocast('cuda', enabled=True):
   113	            checks = torch.library.opcheck(native_dc_fill, (x, index),
   114	                                          test_utils=('test_schema', 'test_faketensor'))
   115	            reference = x.index_fill(1, index, 0.)
   116	            actual = native_dc_fill(x, index)
   117	            assert torch.equal(actual, reference)
   118	            graph = torch.cuda.CUDAGraph()
   119	            with torch.cuda.graph(graph):
   120	                captured = native_dc_fill(x, index)
   121	            graph.replay()
   122	            torch.cuda.synchronize()
   123	            assert torch.equal(captured, reference)
   124	            torch._dynamo.reset()
   125	            compiled = torch.compile(native_dc_fill, mode='reduce-overhead',
   126	                                     dynamic=False, fullgraph=True)
   127	            for _ in range(6):
   128	                result = compiled(x, index).clone()
   129	            torch.cuda.synchronize()
   130	            assert torch.equal(result, reference)
   131	        out[str(T)] = {'status': 'PASS', 'opcheck': checks, 'native_bitwise_equal': True,
   132	                       'cuda_graph_capture_and_replay': 'PASS', 'compiled_fullgraph': 'PASS',
   133	                       'output_shape': list(actual.shape), 'output_stride': list(actual.stride())}
   134	    torch._dynamo.reset()
   135	    return out

