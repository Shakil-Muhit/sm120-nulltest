     1	"""Matched block-alternation runner (plan 1.2; prereg_amendments.md §5), v2.
     2	
     3	Two arms in ONE fresh process. Lifecycle (gate-02 f19):
     4	  provenance + manifest → build A (settle, gate) → build B (settle, gate) →
     5	  JOINT settle of the actual alternation (a, b, a, b, … until the compile/
     6	  recording counters are stable across two full alternation rounds) →
     7	  validate A and B (after the joint settle) → alternating 5a blocks
     8	  a, b, a, b, … (five each) with wall timestamps and a counter snapshot per
     9	  block → pair verdict.
    10	Pair eligibility requires: both builds OK, both graph gates PASS, no capped
    11	settle, joint settle stable, both validations PASS, counters stable across
    12	every block. The SDR qualification at this operating point is joined at
    13	collection time from the arms' matrix cells (collect_full.py). Output:
    14	<evidence>/matched_<A>_<B>_c<chunk>_<tag>.json
    15	"""
    16	
    17	import argparse
    18	import json
    19	import os
    20	import statistics
    21	import sys
    22	import time
    23	import traceback
    24	
    25	_HERE = os.path.dirname(os.path.abspath(__file__))
    26	_ROOT = os.path.dirname(_HERE)
    27	for _p in (_ROOT, _HERE):
    28	    if _p not in sys.path:
    29	        sys.path.insert(0, _p)
    30	
    31	import torch                      # noqa: E402
    32	import fullarms as arms_mod       # noqa: E402
    33	import loader                     # noqa: E402
    34	import provenance                 # noqa: E402
    35	import timing as tm               # noqa: E402
    36	
    37	
    38	def build_one(arm, chunk, streams, gen_dir, paths, settle_max):
    39	    from torch._dynamo.utils import counters
    40	    counters.clear()               # this arm's gate reflects only its own compilation
    41	    model, config, use_amp, ctx, ctx_nocache = loader.load_public_model(
    42	        paths['msst'], paths['ckpt'], paths['config'])
    43	    x = tm.make_input(chunk, tm.TIMING_SEED)
    44	    info = {'capture_scope': None, 'capture_adapter': None, 'capture_attempts': [],
    45	            'stream_count': None, 'compile_mode': None, 'notes': []}
    46	    step = arms_mod.build_arm_step(arm, model, x, ctx_nocache, streams, info, gen_dir)
    47	    settle = gate = None
    48	    if arm in arms_mod.COMPILE_ARMS:
    49	        settle = tm.settle_compile(step, x, ctx, settle_max, 5)
    50	        gate = tm.graph_gate(arm in arms_mod.REQUIRE_ZERO_BREAKS)
    51	    else:
    52	        with torch.no_grad(), ctx():
    53	            for _ in range(10):
    54	                step(x)
    55	        torch.cuda.synchronize()
    56	    return {'model': model, 'step': step, 'ctx': ctx, 'x': x, 'info': info,
    57	            'settle': settle, 'gate': gate, 'use_amp': use_amp}
    58	
    59	
    60	def joint_settle(built, arms, rounds=2, passes=3):
    61	    """Alternate the two steps; stable iff counters unchanged across the
    62	    last two alternation rounds."""
    63	    snaps = []
    64	    for r in range(rounds + 1):
    65	        for arm in arms:
    66	            b = built[arm]
    67	            with torch.no_grad(), b['ctx']():
    68	                for _ in range(passes):
    69	                    b['step'](b['x'])
    70	        torch.cuda.synchronize()
    71	        snaps.append(tm.dynamo_counters())
    72	    stable = all(tm.compile_stable(a, c) for a, c in zip(snaps, snaps[1:]))
    73	    return {'stable': stable, 'rounds': rounds, 'snapshots': snaps}
    74	
    75	
    76	def main():
    77	    ap = argparse.ArgumentParser()
    78	    ap.add_argument('--pair', nargs=2, required=True, metavar=('ARM_A', 'ARM_B'))
    79	    ap.add_argument('--chunk', type=int, required=True, choices=list(arms_mod.CHUNKS))
    80	    ap.add_argument('--tag', default='m1')
    81	    ap.add_argument('--iters', type=int, default=50)
    82	    ap.add_argument('--repeats', type=int, default=5)
    83	    ap.add_argument('--streams', type=int, default=arms_mod.DEFAULT_STREAMS)
    84	    ap.add_argument('--settle-max', type=int, default=60)
    85	    ap.add_argument('--evidence-dir', '--out-dir', dest='evidence_dir',
    86	                    default=os.path.join(_ROOT, 'evidence'))
    87	    ap.add_argument('--ref-dir', default=None)
    88	    ap.add_argument('--no-manifest', action='store_true')
    89	    args = ap.parse_args()
    90	    assert torch.cuda.is_available()
    91	    os.makedirs(args.evidence_dir, exist_ok=True)
    92	    ref_dir = args.ref_dir or os.path.join(args.evidence_dir, 'ref')
    93	    a, b = args.pair
    94	    out_path = os.path.join(args.evidence_dir, f'matched_{a}_{b}_c{args.chunk}_{args.tag}.json')
    95	    result = {'pair': [a, b], 'chunk': args.chunk, 'tag': args.tag, 'status': 'VALID',
    96	              'error': None, 'env': tm.env_fingerprint(), 'arms': {}, 'blocks': [],
    97	              'torch_logs_env': os.environ.get('TORCH_LOGS'), 'manifest_id': None,
    98	              'pair_eligible': False, 'ineligibility_reasons': []}
    99	    reasons = result['ineligibility_reasons']
   100	    try:
   101	        paths = loader.paths_from_env()
   102	        result['provenance'] = provenance.verify(paths)
   103	        if not args.no_manifest:
   104	            result['manifest_id'] = provenance.load_manifest(args.evidence_dir)['manifest_id']
   105	            tm.bind_refs(ref_dir, result['manifest_id'])
   106	        else:
   107	            reasons.append('not bound to a session manifest')
   108	        built = {}
   109	        for arm in (a, b):
   110	            gen_dir = os.path.join(args.evidence_dir, 'generated', f'matched_{arm}_c{args.chunk}_{args.tag}')
   111	            try:
   112	                built[arm] = build_one(arm, args.chunk, args.streams, gen_dir, paths, args.settle_max)
   113	                bi = built[arm]
   114	                result['arms'][arm] = {'build_status': 'OK', 'settle': bi['settle'], 'graph_gate': bi['gate'],
   115	                                       'capture_scope': bi['info'].get('capture_scope'),
   116	                                       'capture_adapter_active': bi['info'].get('capture_adapter_active'),
   117	                                       'compile_mode': bi['info'].get('compile_mode')}
   118	                if bi['settle'] and bi['settle']['settle_capped']:
   119	                    reasons.append(f'{arm}: settle capped')
   120	                if bi['gate'] and bi['gate']['status'] != 'PASS':
   121	                    reasons.append(f'{arm}: graph gate FAIL')
   122	                print(f'[matched] {arm}: built (scope {bi["info"].get("capture_scope")}, gate '
   123	                      f'{(bi["gate"] or {}).get("status")})')
   124	            except Exception:
   125	                result['arms'][arm] = {'build_status': 'FAILED', 'error': traceback.format_exc()}
   126	                reasons.append(f'{arm}: build failed')
   127	                print(f'[matched] {arm}: BUILD FAILED (recorded)', file=sys.stderr)
   128	        if not all(result['arms'][x]['build_status'] == 'OK' for x in (a, b)):
   129	            result['status'] = 'INVALID'
   130	        else:
   131	            js = joint_settle(built, (a, b))
   132	            result['joint_settle'] = {'stable': js['stable'], 'rounds': js['rounds']}
   133	            if not js['stable']:
   134	                reasons.append('joint alternation did not settle')
   135	            for arm in (a, b):
   136	                v = tm.validate(built[arm]['step'], built[arm]['ctx'], arms_mod.TIER[arm],
   137	                                args.chunk, ref_dir)
   138	                result['arms'][arm]['validation'] = v
   139	                if v['status'] != 'PASS':
   140	                    reasons.append(f'{arm}: validation {v["status"]}')
   141	                print(f'[matched] {arm}: validation {v["status"]} '
   142	                      f'{[p.get("max_abs_diff") for p in v["passes"]]}')
   143	            per = {a: [], b: []}
   144	            prev = tm.dynamo_counters()
   145	            block_stable = True
   146	            for r in range(args.repeats):
   147	                for arm in (a, b):
   148	                    t0 = time.time()
   149	                    lat, thr = tm.timed_run(built[arm]['step'], built[arm]['x'],
   150	                                            built[arm]['ctx'], args.iters)
   151	                    t1 = time.time()
   152	                    cur = tm.dynamo_counters()
   153	                    stable = tm.compile_stable(prev, cur)
   154	                    block_stable &= stable
   155	                    prev = cur
   156	                    blk = {'repeat': r, 'arm': arm, 'latency_median_ms': tm.median(lat),
   157	                           'throughput_ms_per_pass': thr, 'latency_ms_per_iter': lat,
   158	                           'unix_start': t0, 'unix_end': t1, 'counters_stable': stable}
   159	                    result['blocks'].append(blk)
   160	                    per[arm].append(blk['latency_median_ms'])
   161	                    print(f'  block {r} {arm}: median {blk["latency_median_ms"]:.4f} ms')
   162	            if not block_stable:
   163	                reasons.append('compile/recording counters changed during the blocks')
   164	            for arm in (a, b):
   165	                result['arms'][arm].update({
   166	                    'latency_medians_ms': per[arm], 'min_of_medians_ms': min(per[arm]),
   167	                    'median_spread_ms': max(per[arm]) - min(per[arm])})
   168	            diffs = [pa - pb for pa, pb in zip(per[a], per[b])]
   169	            result['matched_delta_ms'] = {'a_minus_b_per_block': diffs,
   170	                                          'median': statistics.median(diffs),
   171	                                          'min': min(diffs), 'max': max(diffs),
   172	                                          'median_pct_of_a': statistics.median(diffs) /
   173	                                          statistics.median(per[a]) * 100.0}
   174	            print(f'[matched] {a} - {b}: median {statistics.median(diffs):+.4f} ms')
   175	    except Exception:
   176	        result['status'], result['error'] = 'INVALID', traceback.format_exc()
   177	        reasons.append('exception')
   178	        print(result['error'], file=sys.stderr)
   179	    result['pair_eligible'] = result['status'] == 'VALID' and not reasons
   180	    with open(out_path, 'w') as f:
   181	        json.dump(result, f, indent=1)
   182	    print(f'[matched] status={result["status"]} pair_eligible={result["pair_eligible"]} {reasons} -> {out_path}')
   183	
   184	
   185	if __name__ == '__main__':
   186	    main()
     1	"""Merge full_*.json / matched_*.json into the arms x chunks table.
     2	
     3	Headline rule (registered, gate-02 f20): a cell publishes a HEADLINE only if
     4	restarts r1, r2 AND r3 (exactly the registered set) all exist, are
     5	headline_eligible (which already requires the 5x50 protocol, validation
     6	PASS, stable counters, manifest binding), share the same effective variant
     7	(capture scope / adapter / compile mode), and the cell has an explicit SDR
     8	PASS at this operating point (from any restart that ran the gate). A failed
     9	required restart is never replaced by a later tag. Otherwise the cell is
    10	INCOMPLETE with reasons; diagnostic medians are shown separately.
    11	Matched pairs are eligible only if the pair verdict is True AND both arms'
    12	cells hold an SDR PASS at that operating point.
    13	"""
    14	
    15	import argparse
    16	import glob
    17	import json
    18	import os
    19	import statistics
    20	
    21	REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    22	ARMS = ('A', 'B', 'C1', 'C2', 'C3', 'C1A', 'C1D', 'D', 'E', 'F', 'G', 'H', 'ANVTX')
    23	CHUNKS = (352800, 4410, 22050, 88200)
    24	REQUIRED_RESTARTS = ('r1', 'r2', 'r3')
    25	
    26	
    27	def load(evidence_dir):
    28	    runs = {}
    29	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'full_*.json'))):
    30	        with open(path) as f:
    31	            r = json.load(f)
    32	        runs.setdefault((r['arm'], r['chunk']), {})[r['tag']] = r
    33	    return runs
    34	
    35	
    36	def sdr_status(tag_runs):
    37	    recs = [r.get('sdr_gate') for r in tag_runs.values() if r.get('sdr_gate')]
    38	    statuses = {r.get('status') for r in recs}
    39	    if not recs:
    40	        return 'NONE', None
    41	    if 'FAIL' in statuses:
    42	        return 'FAIL', next(r.get('mean_delta_sdr_ref_db') for r in recs if r.get('status') == 'FAIL')
    43	    if 'PASS' in statuses:
    44	        return 'PASS', next(r.get('mean_delta_sdr_ref_db') for r in recs if r.get('status') == 'PASS')
    45	    return '/'.join(sorted(s for s in statuses if s)), None
    46	
    47	
    48	def variant(r):
    49	    return (str(r.get('capture_scope')), str(r.get('capture_adapter_active')), str(r.get('compile_mode')))
    50	
    51	
    52	def cell(tag_runs):
    53	    req = {t: tag_runs.get(t) for t in REQUIRED_RESTARTS}
    54	    sdr, sdr_delta = sdr_status(tag_runs)
    55	    c = {'restarts_found': sorted(t for t in tag_runs if t.startswith('r')),
    56	         'statuses': {t: (r or {}).get('status', 'MISSING') for t, r in req.items()},
    57	         'tier': sorted({r.get('registered_tier') or r.get('tier') for r in tag_runs.values() if r.get('tier')}),
    58	         'validation': {t: ((r or {}).get('validation') or {}).get('status', 'NONE') for t, r in req.items()},
    59	         'sdr_gate': sdr, 'mean_delta_sdr_ref_db': sdr_delta,
    60	         'variants': sorted({'/'.join(variant(r)) for r in req.values() if r}),
    61	         'graph_breaks': sorted({str(((r or {}).get('graph_gate') or {}).get('graph_break_count')) for r in req.values() if r}),
    62	         'per_restart_min_of_medians_ms': {t: (r or {}).get('min_of_medians_ms') for t, r in req.items()},
    63	         'per_restart_spread_ms': {t: (r or {}).get('median_spread_ms') for t, r in req.items()},
    64	         'headline_status': 'INCOMPLETE', 'headline_ms': None, 'restart_spread_ms': None,
    65	         'throughput_best_ms': None, 'reasons': []}
    66	    for t, r in req.items():
    67	        if r is None:
    68	            c['reasons'].append(f'{t} missing')
    69	        elif not r.get('headline_eligible'):
    70	            c['reasons'].append(f"{t}: {'; '.join(r.get('ineligibility_reasons') or ['ineligible'])}")
    71	    if len(c['variants']) > 1:
    72	        c['reasons'].append(f"effective variants differ: {c['variants']}")
    73	    if sdr != 'PASS':
    74	        c['reasons'].append(f'SDR gate at this operating point: {sdr}')
    75	    if not c['reasons']:
    76	        vals = [req[t]['min_of_medians_ms'] for t in REQUIRED_RESTARTS]
    77	        c['headline_status'] = 'HEADLINE'
    78	        c['headline_ms'] = statistics.median(vals)
    79	        c['restart_spread_ms'] = max(vals) - min(vals)
    80	        c['throughput_best_ms'] = min(req[t]['throughput_ms_per_pass_best'] for t in REQUIRED_RESTARTS)
    81	    vals = [v for v in c['per_restart_min_of_medians_ms'].values() if v]
    82	    c['diagnostic_median_ms'] = statistics.median(vals) if vals else None
    83	    return c
    84	
    85	
    86	def fmt(v, spec='.4f'):
    87	    return format(v, spec) if isinstance(v, (int, float)) else '-'
    88	
    89	
    90	def main():
    91	    ap = argparse.ArgumentParser()
    92	    ap.add_argument('--evidence-dir', default=os.path.join(REPO_ROOT, 'evidence'))
    93	    args = ap.parse_args()
    94	    runs = load(args.evidence_dir)
    95	    cells = {k: cell(v) for k, v in runs.items()}
    96	    print('| arm | chunk | r1/r2/r3 status | tier | SDR (mean ΔSDR dB) | headline | ms | restart spread | best thr ms | variant / breaks | reasons |')
    97	    print('|---|---|---|---|---|---|---|---|---|---|---|')
    98	    for chunk in CHUNKS:
    99	        for arm in ARMS:
   100	            c = cells.get((arm, chunk))
   101	            if not c:
   102	                continue
   103	            st = '/'.join(c['statuses'][t][:4] for t in REQUIRED_RESTARTS)
   104	            print(f"| {arm} | {chunk} | {st} | {'/'.join(c['tier'])} | {c['sdr_gate']} "
   105	                  f"({fmt(c['mean_delta_sdr_ref_db'], '+.3f')}) | {c['headline_status']} | "
   106	                  f"{fmt(c['headline_ms'])} | {fmt(c['restart_spread_ms'])} | {fmt(c['throughput_best_ms'])} | "
   107	                  f"{' '.join(c['variants'])} b={'/'.join(c['graph_breaks'])} | {'; '.join(c['reasons'])[:120]} |")
   108	    pairs = {}
   109	    for path in sorted(glob.glob(os.path.join(args.evidence_dir, 'matched_*.json'))):
   110	        with open(path) as f:
   111	            m = json.load(f)
   112	        a, b = m['pair']
   113	        key = f"{a}_vs_{b}_c{m['chunk']}"
   114	        sdr_ok = all(cells.get((x, m['chunk']), {}).get('sdr_gate') == 'PASS' for x in (a, b))
   115	        eligible = bool(m.get('pair_eligible')) and sdr_ok
   116	        pairs.setdefault(key, []).append({
   117	            'tag': m['tag'], 'status': m['status'], 'pair_eligible': m.get('pair_eligible'),
   118	            'sdr_both_pass': sdr_ok, 'eligible': eligible, 'delta': m.get('matched_delta_ms'),
   119	            'reasons': m.get('ineligibility_reasons'),
   120	            'arms': {k: {kk: v.get(kk) for kk in ('min_of_medians_ms', 'build_status', 'capture_scope', 'compile_mode')}
   121	                     for k, v in (m.get('arms') or {}).items()}})
   122	    if pairs:
   123	        print('\nmatched pairs (median over alternating blocks of a - b, ms):')
   124	        for key, lst in sorted(pairs.items()):
   125	            for e in lst:
   126	                d = e['delta']
   127	                print(f"  {key} {e['tag']}: eligible={e['eligible']} "
   128	                      + (f"delta {d['median']:+.4f} ms ({d['median_pct_of_a']:+.2f}% of a) range [{d['min']:+.4f}, {d['max']:+.4f}]" if d else 'no delta')
   129	                      + (f" reasons={e['reasons']}" if e['reasons'] else ''))
   130	        for key, lst in sorted(pairs.items()):
   131	            el = [e['delta']['median'] for e in lst if e['eligible'] and e['delta']]
   132	            if el:
   133	                print(f"  {key}: eligible restarts {len(el)}/{len(lst)}; median of medians {statistics.median(el):+.4f} ms")
   134	    out = os.path.join(args.evidence_dir, 'summary_full.json')
   135	    with open(out, 'w') as f:
   136	        json.dump({'cells': {f'{a}_{c}': v for (a, c), v in cells.items()},
   137	                   'matched_pairs': pairs,
   138	                   'runs': {f'{a}_{c}_{t}': r for (a, c), tr in runs.items() for t, r in tr.items()}},
   139	                  f, indent=1)
   140	    print(f'\nwritten: {out}')
   141	
   142	
   143	if __name__ == '__main__':
   144	    main()

