    90	        except (ValueError, IndexError):
    91	            continue
    92	    graph_corrs = {a['corr'] for a in api if 'GraphLaunch' in a['name'] and a['corr']}
    93	    launch_corrs = {a['corr'] for a in api if 'LaunchKernel' in a['name'] and a['corr']}
    94	
    95	    head, rows = read_csv(args.base + '_cuda_gpu_trace.csv')
    96	    g_start, g_name = col(head, 'Start (ns)', contains='Start'), col(head, 'Name')
    97	    g_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
    98	    kern = []
    99	    for r in rows:
   100	        try:
   101	            kern.append({'start': int(float(r[g_start].replace(',', ''))), 'name': r[g_name],
   102	                         'corr': r[g_corr].strip() if g_corr is not None else ''})
   103	        except (ValueError, IndexError):
   104	            continue
   105	
   106	    per_pass = []
   107	    for w in wins:
   108	        cs, ce = w['cpu']
   109	        gs, ge = w['gpu']
   110	        a_in = [a for a in api if cs <= a['start'] < ce]
   111	        k_in = [k for k in kern if gs <= k['start'] < ge]
   112	        graph_launches = [a for a in a_in if 'GraphLaunch' in a['name']]
   113	        eager_launch = sum(1 for a in a_in if 'LaunchKernel' in a['name'])
   114	        memcpy_api = sum(1 for a in a_in if 'Memcpy' in a['name'] or 'Memset' in a['name'])
   115	        captured = [k for k in k_in if k['corr'] in graph_corrs]
   116	        eager = [k for k in k_in if k['corr'] in launch_corrs and k['corr'] not in graph_corrs]
   117	        unresolved = [k for k in k_in if k['corr'] not in graph_corrs and k['corr'] not in launch_corrs]
   118	        staging = [k for k in eager if any(m in k['name'] for m in STAGING_MARKERS)]
   119	        uncaptured = [k for k in eager if k not in staging]
   120	        per_pass.append({'graph_launch_calls': len(graph_launches),
   121	                         'graphs_visited': len({a['corr'] for a in graph_launches}),
   122	                         'eager_kernel_launch_calls': eager_launch,
   123	                         'memcpy_memset_api_calls': memcpy_api,
   124	                         'kernels_total': len(k_in),
   125	                         'captured_model_kernels': len(captured),
   126	                         'input_staging_kernels': len(staging),
   127	                         'uncaptured_model_kernels': len(uncaptured),
   128	                         'unresolved_kernels': len(unresolved),
   129	                         'uncaptured_names': sorted({k['name'][:90] for k in uncaptured}),
   130	                         'unresolved_names': sorted({k['name'][:90] for k in unresolved})})
   131	    keys = ('graph_launch_calls', 'graphs_visited', 'eager_kernel_launch_calls',
   132	            'memcpy_memset_api_calls', 'kernels_total', 'captured_model_kernels',
   133	            'input_staging_kernels', 'uncaptured_model_kernels', 'unresolved_kernels')
   134	    summary = {'arm': args.arm, 'passes': len(per_pass), 'expected_passes': args.expected_passes,
   135	               'method': 'CorrId correlation: kernel captured iff its CorrId belongs to a '
   136	                         'cudaGraphLaunch/cuGraphLaunch API call; CPU NVTX windows for API rows, '
   137	                         'GPU-projected windows for kernels',
   138	               'median': {k: statistics.median(p[k] for p in per_pass) for k in keys},
   139	               'max_uncaptured_in_any_pass': max(p['uncaptured_model_kernels'] for p in per_pass),
   140	               'max_unresolved_in_any_pass': max(p['unresolved_kernels'] for p in per_pass),
   141	               'min_graph_launches_in_any_pass': min(p['graph_launch_calls'] for p in per_pass),
   142	               'uncaptured_names_union': sorted({n for p in per_pass for n in p['uncaptured_names']}),
   143	               'unresolved_names_union': sorted({n for p in per_pass for n in p['unresolved_names']}),
   144	               'per_pass': per_pass}
   145	    complete = args.expected_passes is None or len(per_pass) == args.expected_passes
   146	    summary['pass_count_complete'] = complete
   147	    summary['fully_graphed'] = bool(complete and summary['min_graph_launches_in_any_pass'] >= 1
   148	                                    and summary['max_uncaptured_in_any_pass'] == 0
