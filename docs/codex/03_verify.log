    82	    head, rows = read_csv(args.base + '_cuda_api_trace.csv')
    83	    c_start, c_name = col(head, 'Start (ns)', contains='Start'), col(head, 'Name')
    84	    c_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
