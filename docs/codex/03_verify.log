    48	def pass_windows(nvtx_csv):
    49	    head, rows = read_csv(nvtx_csv)
    50	    c_name = col(head, 'Name', 'Range', contains='Name')
    51	    c_ps, c_pd = col(head, 'Projected Start (ns)', contains='Projected Start'), col(head, 'Projected Duration (ns)', contains='Projected Duration')
    52	    c_os, c_od = col(head, 'Orig Start (ns)', contains='Orig Start'), col(head, 'Orig Duration (ns)', contains='Orig Duration')
    53	    if c_ps is None:
    54	        c_ps, c_pd = col(head, contains='Start'), col(head, contains='Duration')
    55	    wins = {}
    56	    for r in rows:
    57	        m = re.fullmatch(r'pass_(\d+)', r[c_name].strip().strip('"').split(':')[-1])
    58	        if not m:
    59	            continue
    60	        try:
    61	            gs, gd = int(float(r[c_ps].replace(',', ''))), int(float(r[c_pd].replace(',', '')))
    62	            if c_os is not None:
    63	                cs, cd = int(float(r[c_os].replace(',', ''))), int(float(r[c_od].replace(',', '')))
    64	            else:
    65	                cs, cd = gs, gd
    66	        except ValueError:
    67	            continue
    68	        wins[int(m.group(1))] = {'gpu': (gs, gs + gd), 'cpu': (cs, cs + cd)}
    69	    return [wins[i] for i in sorted(wins)]
