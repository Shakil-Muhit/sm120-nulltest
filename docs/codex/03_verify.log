     1	#!/bin/bash
     2	# Bring up the session pod from muhit-pc (prereg_amendments.md §5; docs/fullmodel_runbook.md).
     3	#   1. create the RunPod secure-cloud RTX 5090 pod `melband_profiling`
     4	#   2. wait for SSH, record the pod id/host/port in evidence-local pod.env
     5	#   3. ship the COMMITTED tree as a git bundle (no credentials on the pod;
     6	#      the clone keeps .git so every run records the commit hash)
     7	#   4. ship the clip pack (audio never committed); run setup.sh on the pod
     8	# Usage:  bash scripts/pod_up.sh [DATA_CENTER_ID]     (default EU-CZ-1)
     9	set -u
    10	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    11	DCS="${1:-EU-CZ-1 EU-RO-1 EUR-IS-1 EUR-IS-2 EUR-NO-1}"   # tried in order until one has a 5090
    12	IMAGE="runpod/pytorch:1.1.0-rc.154-cu1281-torch280-ubuntu2204"
    13	NAME="melband_profiling"
    14	CLIPS="${CLIPS_SRC:-$HOME/ms/data/sdr_clips}"
    15	KEY="$HOME/.runpod/ssh/RunPod-Key-Go"
    16	export PATH="$HOME/.local/bin:$PATH"
    17	cd "$REPO_DIR"
    18	[ -z "$(git status --porcelain)" ] || { echo "FATAL: commit the tree first (session runs the audited commit)"; exit 1; }
    19	COMMIT=$(git rev-parse HEAD)
    20	POD_ID=""
    21	for DC in $DCS; do
    22	    echo "creating pod $NAME in $DC (image $IMAGE) for commit $COMMIT"
    23	    OUT=$(runpodctl pod create --name "$NAME" --gpu-id "NVIDIA GeForce RTX 5090" --image "$IMAGE" \
    24	          --container-disk-in-gb 40 --ports "22/tcp" --data-center-ids "$DC" -o json 2>&1)
    25	    echo "$OUT" | head -20
    26	    POD_ID=$(echo "$OUT" | python3 -c "import json,sys,re; t=sys.stdin.read(); m=re.search(r'\"id\"\s*:\s*\"([a-z0-9]+)\"', t); print(m.group(1) if m else '')")
    27	    [ -n "$POD_ID" ] && break
    28	    echo "no pod in $DC — trying the next datacenter"
    29	done
    30	[ -n "$POD_ID" ] || { echo "FATAL: no 5090 pod could be created in: $DCS"; exit 1; }
    31	echo "POD_DC=$DC" > "$REPO_DIR/pod.env"
    32	echo "POD_ID=$POD_ID" >> "$REPO_DIR/pod.env"
    33	echo "waiting for ssh info..."
    34	for i in $(seq 1 60); do
    35	    INFO=$(runpodctl ssh info "$POD_ID" 2>/dev/null)
    36	    HOST=$(echo "$INFO" | grep -oE 'root@[0-9.]+' | head -1 | cut -d@ -f2)
    37	    PORT=$(echo "$INFO" | grep -oE '\-p [0-9]+' | head -1 | awk '{print $2}')
    38	    if [ -n "$HOST" ] && [ -n "$PORT" ] && ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 -i "$KEY" -p "$PORT" "root@$HOST" true 2>/dev/null; then
    39	        break
    40	    fi
    41	    sleep 15
    42	done
    43	[ -n "${HOST:-}" ] && [ -n "${PORT:-}" ] || { echo "FATAL: ssh never came up (pod $POD_ID); check runpodctl pod get $POD_ID"; exit 1; }
    44	echo "POD_HOST=$HOST" >> "$REPO_DIR/pod.env"; echo "POD_PORT=$PORT" >> "$REPO_DIR/pod.env"
    45	SSH="ssh -o StrictHostKeyChecking=no -i $KEY -p $PORT root@$HOST"
    46	SCP="scp -o StrictHostKeyChecking=no -i $KEY -P $PORT"
    47	echo "pod up: $HOST:$PORT (id $POD_ID)"
    48	$SSH 'nvidia-smi --query-gpu=name,driver_version --format=csv,noheader; python -c "import torch,triton;print(torch.__version__, triton.__version__)"'
    49	git bundle create /tmp/sm120.bundle HEAD main 2>/dev/null || git bundle create /tmp/sm120.bundle HEAD
    50	$SCP /tmp/sm120.bundle "root@$HOST:/root/sm120.bundle"
    51	$SSH "rm -rf /root/sm120-nulltest && git clone -q /root/sm120.bundle /root/sm120-nulltest && cd /root/sm120-nulltest && git checkout -q $COMMIT && git config core.hooksPath .githooks && git rev-parse HEAD"
    52	$SSH 'mkdir -p /root/work'
    53	$SCP -r "$CLIPS" "root@$HOST:/root/work/sdr_clips"
    54	$SSH 'ls /root/work/sdr_clips | wc -l'
    55	echo "running setup.sh on the pod (nsys, deps, msst @ pin, checkpoint) ..."
    56	$SSH 'cd /root/sm120-nulltest && bash setup.sh 2>&1 | tail -15'
    57	echo "POD READY. Next (on the pod, inside tmux):  cd /root/sm120-nulltest && tmux new -s run && bash scripts/session1.sh"
    58	echo "ssh: $SSH"

