   383	        for a in c['args']:
   384	            base, _ = resolve(c['gr'], a['buf'])
   385	            if (a.get('read') and base in live and
   386	                    producer_before(c['g'], base, i) == live[base]):
   387	                hits.append(a)
   388	        if not hits:
   389	            continue
   390	        path.append(c['name'])
   391	        if c['kind'] == 'extern' and c['name'] in ('extern.mm', 'extern.addmm', 'extern.bmm'):
   392	            return 'true', path
   393	        k = c['gr']['kernels'].get(c['name'], {})
   394	        ops = k.get('ops', [])
   395	        if any(o in ('aten.clone', 'aten.copy', 'aten.copy_', 'aten.contiguous') for o in ops):
   396	            return 'false', path
   397	        if c['kind'] != 'triton' or not ops or not c.get('align_ok', False):
   398	            return 'unresolved', path
   399	        # Gating is arithmetic, but it must not conceal a fused layout copy.
   400	        if any(o not in ('aten.mul', 'aten.sigmoid', 'aten._to_copy',
   401	                         'prims.convert_element_type') for o in ops):
   402	            return 'unresolved', path
   403	        for a in hits:
   404	            state = read_permuted_state(k, a.get('role', ''), arg_meta(c['gr'], a))
   405	            if state != 'no':
   406	                return ('false' if state == 'yes' else 'unresolved'), path
   407	        outputs = [a for a in c['args'] if a.get('write')]
   408	        if not outputs:
   409	            return 'unresolved', path
   410	        for a in outputs:
   411	            live[resolve(c['gr'], a['buf'])[0]] = i
   412	    return 'unresolved', path
