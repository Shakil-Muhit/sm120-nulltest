   298	def arg_meta(gr, a):
   299	    """Effective (shape, stride, dtype, base) the kernel sees for arg a."""
   300	    base, alias_meta = resolve(gr, a['buf'])
   301	    alloc = gr['allocs'].get(base, {})
   302	    if a.get('reinterpret') and a.get('shape'):
   303	        shape, stride = a['shape'], a['stride']
   304	    elif alias_meta:
   305	        shape, stride = alias_meta['shape'], alias_meta['stride']
   306	    else:
   307	        shape, stride = alloc.get('shape', ()), alloc.get('stride', ())
   308	    return {'shape': shape or (), 'stride': stride or (),
   309	            'dtype': alloc.get('dtype'), 'base': base}
