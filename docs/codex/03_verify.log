   312	def refined_access(k, role):
   313	    """(reads, writes, unresolved) for a param role, derived from the kernel
   314	    SOURCE (gate-04 f32): in_out_ptr reads iff a tl.load on it exists and
   315	    writes iff a tl.store exists; neither found -> unresolved (charged
   316	    conservatively as read+write, and the site is flagged)."""
   317	    if role.startswith('in_out_ptr'):
   318	        r = role in k.get('loads_present', k.get('load_exprs', {}))
   319	        w = role in k.get('stores_present', k.get('store_exprs', {}))
   320	        return (r, w, not (r or w))
   321	    if role.startswith('in_ptr'):
   322	        return (True, False, role not in k.get('loads_present', k.get('load_exprs', {})))
   323	    if role.startswith('out_ptr'):
   324	        return (False, True, role not in k.get('stores_present', k.get('store_exprs', {})))
   325	    return (False, False, True)
