   348	def is_permuted(shape, stride):
   349	    """Permuted = the stride ORDER differs from row-major: fastest dim not
   350	    unit-stride OR strides (over size>1 dims) not non-increasing."""
   351	    if not shape or len(stride) != len(shape):
   352	        return False
   353	    nt = [(s, x) for s, x in zip(shape, stride) if s > 1]
   354	    if not nt:
   355	        return False
   356	    if nt[-1][1] != 1:
   357	        return True
   358	    return any(nt[i][1] < nt[i + 1][1] for i in range(len(nt) - 1))
