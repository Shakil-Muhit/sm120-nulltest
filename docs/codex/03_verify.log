   228	def validate(step, ctx, tier, chunk, ref_dir, save_reference=False):
   229	    """AUDIT-MAP[2] mechanics: two passes, different data (asserted), each
   230	    compared to the SAVED eager-A output for that (chunk, seed). With
   231	    save_reference=True (arm A reference step) the outputs are written
   232	    instead of compared."""
   233	    passes, prev_x = [], None
   234	    for seed in VAL_SEEDS:
   235	        x = make_input(chunk, seed)
   236	        if prev_x is not None:
   237	            assert not torch.equal(x, prev_x), \
   238	                'validation passes must use different input data'
   239	        prev_x = x
   240	        with torch.no_grad(), ctx():
   241	            out = step(x)
   242	            torch.cuda.synchronize()
   243	            out = out.clone()            # borrow discipline (build_spec rule 1)
   244	        path = ref_path(ref_dir, chunk, seed)
   245	        if save_reference:
   246	            os.makedirs(ref_dir, exist_ok=True)
   247	            torch.save(out.float().cpu(), path)
   248	            passes.append({'seed': seed, 'saved': path,
   249	                           'finite': bool(torch.isfinite(out).all())})
   250	            continue
   251	        if not os.path.exists(path):
   252	            raise FileNotFoundError(f'reference output missing: {path} '
   253	                                    '(run the arm-A reference step first)')
   254	        ref = torch.load(path, map_location='cuda', weights_only=True)
   255	        rec = compare_outputs(out, ref, tier)
   256	        rec['seed'] = seed
   257	        passes.append(rec)
   258	        del ref
   259	    if save_reference:
   260	        return {'status': 'REFERENCE_SAVED', 'tier': tier, 'passes': passes}
   261	    ok = all(p['ok'] for p in passes)
   262	    return {'status': 'PASS' if ok else 'FAIL', 'tier': tier,
   263	            'rtol': TIERS[tier][0], 'atol': TIERS[tier][1], 'passes': passes}
