   328	def read_permuted_state(k, role, meta):
   329	    """Tri-state permuted classification for one READING param (gate-04 f32):
   330	    'yes'  — view meta is permuted, or the load index expr differs from the
   331	             kernel's single store expr;
   332	    'no'   — load expr equals the single store expr;
   333	    'unresolved' — load expr missing, or zero / multiple distinct store exprs
   334	             (an unrelated output with the same expr could hide a permuted
   335	             read feeding another output)."""
   336	    stores = set(k.get('store_exprs', {}).values())
   337	    le = k.get('load_exprs', {}).get(role)
   338	    expected_stores = set(k.get('stores_present', k.get('store_exprs', {})))
   339	    if le is None or expected_stores != set(k.get('store_exprs', {})):
   340	        return 'unresolved'
   341	    if is_permuted(meta['shape'], meta['stride']):
   342	        return 'yes'
   343	    if len(stores) == 1:
   344	        return 'yes' if le not in stores else 'no'
   345	    return 'unresolved'
