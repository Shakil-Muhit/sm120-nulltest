   285	def resolve(gr, buf):
   286	    """Follow alias chain to the base buffer; return (base, view_meta|None)."""
   287	    meta = None
   288	    seen = set()
   289	    while buf in gr['aliases'] and buf not in seen:
   290	        seen.add(buf)
   291	        a = gr['aliases'][buf]
   292	        if meta is None and 'shape' in a:
   293	            meta = {'shape': a['shape'], 'stride': a['stride']}
   294	        buf = a['base']
   295	    return buf, meta
   296	
