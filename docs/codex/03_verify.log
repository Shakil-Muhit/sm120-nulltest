    36	def col(head, *names, contains=None):
    37	    for name in names:
    38	        for i, h in enumerate(head):
    39	            if h.strip().strip('"') == name:
    40	                return i
    41	    if contains:
    42	        for i, h in enumerate(head):
    43	            if contains in h:
    44	                return i
    45	    return None
