    84	class PadBatchMaskEstimator(nn.Module):
    85	    """Drop-in for the public MaskEstimator: (1, T, 60, dim) -> (1, T, sum K_i)."""
    86	
    87	    def __init__(self, orig):
    88	        super().__init__()
    89	        self.orig = orig
    90	        dims = tuple(int(d) for d in orig.dim_inputs)
    91	        n, kmax = len(dims), max(dims)
    92	        chains = []
    93	        for mlp in orig.to_freqs:
    94	            assert isinstance(mlp, nn.Sequential) and len(mlp) == 2
    95	            inner, glu = mlp[0], mlp[1]
    96	            assert isinstance(glu, nn.GLU) and glu.dim == -1
    97	            layers = list(inner)
    98	            lins = [m for m in layers if isinstance(m, nn.Linear)]
    99	            others = [m for m in layers if not isinstance(m, nn.Linear)]
   100	            assert all(isinstance(m, nn.Tanh) for m in others), others
   101	            # public MLP: Linear (Tanh Linear)* — activation after all but last
   102	            assert len(others) == len(lins) - 1
   103	            assert [type(m) for m in layers] == \
   104	                [nn.Linear if i % 2 == 0 else nn.Tanh for i in range(len(layers))]
   105	            chains.append(lins)
   106	        depth = len(chains[0])
   107	        assert all(len(c) == depth for c in chains)
   108	        dev = chains[0][0].weight.device
   109	        self.n, self.kmax, self.depth = n, kmax, depth
   110	        self.total = sum(dims)
   111	        for j in range(depth - 1):             # batched hidden layers
   112	            din, dout = chains[0][j].in_features, chains[0][j].out_features
   113	            w = torch.zeros(n, din, dout)
   114	            b = torch.zeros(n, 1, dout)
   115	            for i, lins in enumerate(chains):
   116	                assert lins[j].in_features == din and lins[j].out_features == dout
   117	                w[i] = lins[j].weight.detach().float().cpu().t()
   118	                b[i, 0] = lins[j].bias.detach().float().cpu()
   119	            self.register_buffer(f'w{j}', w.to(dev), persistent=False)
   120	            self.register_buffer(f'b{j}', b.to(dev), persistent=False)
   121	        # last layer: out = 2*K_i, laid out [a | b] halves each padded to kmax
   122	        din = chains[0][-1].in_features
   123	        w = torch.zeros(n, din, 2 * kmax)
   124	        b = torch.zeros(n, 1, 2 * kmax)
   125	        out_idx = torch.zeros(self.total, dtype=torch.long)
   126	        off = 0
   127	        for i, (lins, k) in enumerate(zip(chains, dims)):
   128	            last = lins[-1]
   129	            assert last.in_features == din and last.out_features == 2 * k
   130	            wt = last.weight.detach().float().cpu().t()         # (din, 2k)
   131	            bb = last.bias.detach().float().cpu()
   132	            w[i, :, :k] = wt[:, :k]
   133	            w[i, :, kmax:kmax + k] = wt[:, k:2 * k]
   134	            b[i, 0, :k] = bb[:k]
   135	            b[i, 0, kmax:kmax + k] = bb[k:2 * k]
   136	            out_idx[off:off + k] = i * kmax + torch.arange(k)
   137	            off += k
   138	        assert off == self.total
   139	        self.register_buffer('w_last', w.to(dev), persistent=False)
   140	        self.register_buffer('b_last', b.to(dev), persistent=False)
   141	        self.register_buffer('out_idx', out_idx.to(dev), persistent=False)
   142	
   143	    def forward(self, x):                      # (1, T, n, dim)
   144	        assert x.shape[0] == 1 and x.shape[2] == self.n
   145	        t = x.shape[1]
   146	        h = x[0].transpose(0, 1)                                # (n, T, dim)
   147	        for j in range(self.depth - 1):
   148	            h = torch.tanh(torch.baddbmm(getattr(self, f'b{j}'), h,
   149	                                         getattr(self, f'w{j}')))
   150	        o = torch.baddbmm(self.b_last, h, self.w_last)           # (n, T, 2kmax)
   151	        o = F.glu(o, dim=-1)                                     # (n, T, kmax)
   152	        flat = o.transpose(0, 1).reshape(t, self.n * self.kmax)
   153	        return flat[:, self.out_idx].unsqueeze(0)                # (1, T, total)
