     3	Generic reimplementation of the band-bmm idea (production code not used).
     4	External wrappers holding the ORIGINAL modules (parameters stay registered;
     5	nothing is modified) plus derived zero-padded weight buffers built once.
     6	
     7	Exactness (registered): padded entries are zero on every path —
     8	  band_split : F.normalize over a zero-padded row == per-band normalize (zeros
     9	               add nothing to the L2 norm); per-band scale K_i**0.5 as a
    10	               (60,1,1) vector; zero-padded gamma; bmm with zero-padded weight
    11	               rows contributes exactly 0; output order == torch.stack(dim=-2).
    12	  mask_est.  : three batched bmm chains; the last weight's columns are laid
    13	               out [a-half | b-half], each half zero-padded to K_max, so
    14	               GLU(dim=-1) over the padded width equals the per-band GLU
    15	               (pad columns: 0 * sigmoid(0) = 0); valid columns are gathered
    16	               back in band order == torch.cat(dim=-1).
    17	The only numerical difference is cuBLAS summation order (loose tier by the
    18	classification rule; H is compiled anyway).
    19	"""
    20	
    21	import torch
    22	import torch.nn as nn
    23	import torch.nn.functional as F
    24	
    25	
    26	def _band_split_parts(orig):
    27	    dims = tuple(int(d) for d in orig.dim_inputs)
    28	    parts = []
    29	    for seq in orig.to_features:
    30	        assert isinstance(seq, nn.Sequential) and len(seq) == 2
    31	        rms, lin = seq[0], seq[1]
    32	        assert isinstance(lin, nn.Linear) and lin.bias is not None
    33	        assert hasattr(rms, 'gamma') and hasattr(rms, 'scale')
    34	        parts.append((rms, lin))
    35	    assert len(parts) == len(dims)
    36	    return dims, parts
    37	
    38	
    39	class PadBatchBandSplit(nn.Module):
    40	    """Drop-in for the public BandSplit: (1, T, sum K_i) -> (1, T, 60, dim)."""
    41	
    42	    def __init__(self, orig):
    43	        super().__init__()
    44	        self.orig = orig                       # parameters stay registered
    45	        dims, parts = _band_split_parts(orig)
    46	        n, kmax = len(dims), max(dims)
    47	        dim_out = parts[0][1].out_features
    48	        total = sum(dims)
    49	        dev = parts[0][1].weight.device
    50	        idx = torch.full((n, kmax), total, dtype=torch.long)   # -> zero column
    51	        gamma = torch.zeros(n, kmax, dtype=torch.float32)
    52	        w = torch.zeros(n, kmax, dim_out, dtype=torch.float32)
    53	        b = torch.zeros(n, 1, dim_out, dtype=torch.float32)
    54	        scale = torch.zeros(n, 1, 1, dtype=torch.float32)
    55	        off = 0
    56	        for i, ((rms, lin), k) in enumerate(zip(parts, dims)):
    57	            assert lin.in_features == k and lin.out_features == dim_out
    58	            assert rms.gamma.shape == (k,)
    59	            idx[i, :k] = torch.arange(off, off + k)
    60	            gamma[i, :k] = rms.gamma.detach().float().cpu()
    61	            w[i, :k, :] = lin.weight.detach().float().cpu().t()
    62	            b[i, 0, :] = lin.bias.detach().float().cpu()
    63	            scale[i] = float(rms.scale)
    64	            off += k
    65	        assert off == total
    66	        self.n, self.kmax, self.total = n, kmax, total
    67	        self.register_buffer('idx', idx.to(dev), persistent=False)
    68	        self.register_buffer('gamma_pad', gamma.to(dev), persistent=False)
    69	        self.register_buffer('w_pad', w.to(dev), persistent=False)
    70	        self.register_buffer('b_pad', b.to(dev), persistent=False)
    71	        self.register_buffer('scale', scale.to(dev), persistent=False)
    72	
    73	    def forward(self, x):                      # (1, T, total)
    74	        assert x.shape[0] == 1 and x.shape[-1] == self.total
    75	        t = x.shape[1]
    76	        x_ext = torch.cat([x[0], x.new_zeros(t, 1)], dim=-1)   # (T, total+1)
    77	        xp = x_ext[:, self.idx]                                 # (T, n, kmax)
    78	        xp = xp.transpose(0, 1)                                 # (n, T, kmax)
    79	        xn = F.normalize(xp, dim=-1) * self.scale * self.gamma_pad[:, None, :]
    80	        y = torch.baddbmm(self.b_pad, xn, self.w_pad)           # (n, T, dim)
    81	        return y.transpose(0, 1).unsqueeze(0)                   # (1, T, n, dim)
