    77	
    78	def compile_stable(before, after):
    79	    """Recording/compilation stability (gate-02 f21): no NEW graph breaks or
    80	    unimplemented ops, the same number of unique Dynamo graphs, and EVERY
    81	    Inductor cudagraph counter unchanged (recordings, skips, non-static
    82	    input recordings). Per-call counters (calls, frames) are ignored."""
    83	    for k in STABILITY_KEYS:
    84	        if before.get(k, {}) != after.get(k, {}):
    85	            return False
    86	    if before.get('stats', {}).get('unique_graphs') != after.get('stats', {}).get('unique_graphs'):
    87	        return False
    88	    b_ind = {k: v for k, v in before.get('inductor', {}).items() if 'cudagraph' in k}
    89	    a_ind = {k: v for k, v in after.get('inductor', {}).items() if 'cudagraph' in k}
    90	    return b_ind == a_ind
