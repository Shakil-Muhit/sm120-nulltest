    32	def cell(tag_runs):
    33	    restarts = [r for t, r in sorted(tag_runs.items()) if RESTART_RE.match(t)]
    34	    valid = [r for r in restarts if r.get('status') == 'VALID' and r.get('min_of_medians_ms')]
    35	    c = {'n_restarts_found': len(restarts), 'n_restarts_valid': len(valid),
    36	         'statuses': sorted({r.get('status') for r in restarts}),
    37	         'validation': sorted({(r.get('validation') or {}).get('status', 'NONE') for r in restarts}),
    38	         'tier': sorted({r.get('tier') for r in restarts if r.get('tier')}),
    39	         'sdr_gate': sorted({(r.get('sdr_gate') or {}).get('status', '-') for r in restarts}),
    40	         'mean_delta_sdr_ref_db': next(((r.get('sdr_gate') or {}).get('mean_delta_sdr_ref_db')
    41	                                        for r in restarts if (r.get('sdr_gate') or {}).get('mean_delta_sdr_ref_db') is not None), None),
    42	         'capture_scope': sorted({str(r.get('capture_scope')) for r in restarts}),
    43	         'compile_mode': sorted({str(r.get('compile_mode')) for r in restarts}),
    44	         'graph_gate': sorted({str((r.get('graph_gate') or {}).get('status')) for r in restarts}),
    45	         'graph_breaks': sorted({str((r.get('graph_gate') or {}).get('graph_break_count')) for r in restarts}),
    46	         'settle_capped': sorted({str((r.get('settle') or {}).get('settle_capped')) for r in restarts}),
    47	         'per_restart_min_of_medians_ms': [r['min_of_medians_ms'] for r in valid],
    48	         'per_restart_spread_ms': [r['median_spread_ms'] for r in valid],
    49	         'headline_ms': None, 'restart_spread_ms': None, 'throughput_best_ms': None,
    50	         'errors': [ (r.get('error') or '')[-300:] for r in restarts if r.get('error')]}
    51	    # headline eligibility (registered): >= 3 complete VALID restarts, each
    52	    # headline_eligible, with the SAME effective variant (capture scope /
    53	    # adapter / compile mode); anything else is INCOMPLETE and carries reasons
    54	    eligible = [r for r in valid if r.get('headline_eligible', False)]
    55	    variants = {(str(r.get('capture_scope')), str(r.get('capture_adapter_active')),
    56	                 str(r.get('compile_mode'))) for r in eligible}
    57	    c['n_restarts_eligible'] = len(eligible)
    58	    c['effective_variants'] = sorted('/'.join(v) for v in variants)
    59	    c['ineligibility_reasons'] = sorted({x for r in restarts
    60	                                         for x in (r.get('ineligibility_reasons') or [])})
    61	    if len(eligible) >= 3 and len(variants) == 1:
    62	        vals = [r['min_of_medians_ms'] for r in eligible]
    63	        c['headline_status'] = 'HEADLINE'
    64	        c['headline_ms'] = statistics.median(vals)
    65	        c['restart_spread_ms'] = max(vals) - min(vals)
    66	        c['throughput_best_ms'] = min(r['throughput_ms_per_pass_best'] for r in eligible)
    67	    else:
    68	        c['headline_status'] = 'INCOMPLETE'
    69	        if valid:
    70	            vals = c['per_restart_min_of_medians_ms']
    71	            c['diagnostic_median_ms'] = statistics.median(vals)
    72	    return c
