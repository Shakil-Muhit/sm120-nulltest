    30	    local logs; logs="$(logs_for "$arm")"
    31	    echo "--- arm=$arm chunk=$chunk tag=$tag $(date -Is) ---"
    32	    TORCH_LOGS="$logs" timeout -k 30 "$(tmo_for "$arm")" python "$RUN" --arm "$arm" --chunk "$chunk" \
    33	        --tag "$tag" --iters "$ITERS" --clips-dir "$CLIPS_DIR" "$@" \
    34	        2> "$EVID/torchlogs_${arm}_${chunk}_${tag}.log" || echo "    exit $? (see JSON/log)"
