    74	def gemm_shape(call, gr):
    75	    """(M, N, K, dtype) from an extern mm/addmm/bmm wrapper call."""
    76	    reads = [arg_meta(gr, a) for a in call['args'] if a.get('read')]
    77	    writes = [arg_meta(gr, a) for a in call['args'] if a.get('write')]
    78	    mats = [m for m in reads if len(m['shape']) in (2, 3)]
    79	    if len(mats) < 2 or not writes:
    80	        return None
    81	    a, b = mats[-2], mats[-1]
    82	    if len(a['shape']) == 2 and len(b['shape']) == 2:
    83	        M, K = a['shape']; K2, N = b['shape']; batch = 1
    84	    elif len(a['shape']) == 3 and len(b['shape']) == 3:
    85	        batch, M, K = a['shape']; _, K2, N = b['shape']
    86	    else:
    87	        return None
    88	    if K != K2:
    89	        return None
    90	    dt = a['dtype'] or 'torch.float16'
    91	    bytes_ = sum(nbytes(m['shape'], m['dtype']) for m in mats) + \
    92	        sum(nbytes(m['shape'], m['dtype']) for m in writes)
    93	    return {'M': M, 'N': N, 'K': K, 'batch': batch, 'dtype': dt,
    94	            'flops': 2.0 * batch * M * N * K, 'bytes': bytes_}
