    92	def graph_gate(require_zero_breaks):
    93	    """Compile-arm gate (prereg_amendments.md §1, C3/H): graph breaks and
    94	    unimplemented ops from the Dynamo counters; cudagraph skips from the
    95	    Inductor counters (plan 0.3 input)."""
    96	    snap = dynamo_counters()
    97	    breaks = sum(snap.get('graph_break', {}).values())
    98	    unsupported = sum(snap.get('unimplemented', {}).values())
    99	    inductor = snap.get('inductor', {})
   100	    skips = {k: v for k, v in inductor.items() if 'cudagraph' in k}
   101	    rec = {'graph_break_count': breaks, 'unimplemented_count': unsupported,
   102	           'unique_graphs': snap.get('stats', {}).get('unique_graphs', 0),
   103	           'cudagraph_counters': skips,
   104	           'suppress_errors': bool(torch._dynamo.config.suppress_errors),
   105	           'require_zero_breaks': require_zero_breaks,
   106	           'graph_break_reasons': list(snap.get('graph_break', {}).keys())[:40]}
   107	    rec['status'] = ('PASS' if (not require_zero_breaks or
   108	                                (breaks == 0 and unsupported == 0))
   109	                     and not rec['suppress_errors'] else 'FAIL')
   110	    return rec
