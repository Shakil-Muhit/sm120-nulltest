   128	    || echo "WARN: boundary bench failed"
   129	nsys profile --cuda-graph-trace=node --force-overwrite=true -o "$EVID/traces/trace_boundary_bench" \
   130	    python "$REPO_DIR/fullmodel/boundary_bench.py" --out "$EVID/boundary_bench_traced.json" > /dev/null 2>&1 \
   131	    && nsys stats --force-export=true --force-overwrite=true --format csv \
   132	        --report cuda_gpu_trace --report cuda_gpu_kern_sum --report nvtx_gpu_proj_trace \
   133	        --output "$EVID/traces/trace_boundary_bench" "$EVID/traces/trace_boundary_bench.nsys-rep" > /dev/null 2>&1 \
   134	    && python "$REPO_DIR/fullmodel/boundary_bench.py" --analyze-trace "$EVID/traces/trace_boundary_bench" \
