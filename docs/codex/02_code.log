     5	Reconstruction policy (registered): each 8.000-s clip (352800 samples) is
     6	processed as non-overlapping consecutive chunks of the operating point's size
     7	(1 x 352800, 4 x 88200, 16 x 22050, 80 x 4410) and the chunk outputs are
     8	concatenated (no overlap, no crossfade). Short-chunk SDR_ref values are
     9	therefore NOT quality claims about the model; the gate is the paired
    10	regression vs A under the identical policy.
    11	
    12	Metrics (stereo signals flattened to one vector; float64 accumulation):
    13	  SDR(ref, est)   = 10 log10( ||ref||^2 / ||ref - est||^2 )         (plain)
    14	  SI-SDR(ref, est): both zero-mean; s = <est,ref>/||ref||^2 * ref;
    15	                    10 log10( ||s||^2 / ||est - s||^2 )
    16	computed (a) vs the reference vocals stem and (b) vs the saved eager-A output
    17	for the same clip at the same operating point. A perfect match yields +inf
    18	(reported as the string "inf"). Gate: mean over the 8 clips of
    19	ΔSDR_ref = SDR_ref(arm) - SDR_ref(A) >= -0.1 dB; per-clip minimum, SI-SDR and
    20	the vs-A numbers are reported alongside (the gate is the mean).
    21	"""
    22	
    23	import hashlib
    24	import json
    25	import math
    26	import os
    27	
    28	import numpy as np
    29	import soundfile as sf
    30	import torch
    31	
    32	CLIP_SAMPLES = 352800
    33	THRESHOLD_DB = -0.1
    34	
    35	
    36	def _sha256(path):
    37	    h = hashlib.sha256()
    38	    with open(path, 'rb') as f:
    39	        for block in iter(lambda: f.read(1 << 20), b''):
    40	            h.update(block)
    41	    return h.hexdigest()
    42	
    43	
    44	def load_clips(clips_dir, manifest_path):
    45	    """Verifies every wav's sha256 against the manifest (loud failure)."""
    46	    with open(manifest_path) as f:
    47	        man = json.load(f)
    48	    clips = []
    49	    for c in man['clips']:
    50	        rec = {'index': c['index'], 'track': c['track'], 'start_sample': c['start_sample']}
    51	        for kind in ('mixture', 'vocals'):
    52	            entry = c['files'][kind]
    53	            path = os.path.join(clips_dir, entry['name'])
    54	            if not os.path.exists(path):
    55	                raise FileNotFoundError(f'clip missing: {path}')
    56	            got = _sha256(path)
    57	            if got != entry['sha256']:
    58	                raise ValueError(f'clip sha256 mismatch: {path} {got} != {entry["sha256"]}')
    59	            audio, sr = sf.read(path, dtype='float32', always_2d=True)   # (n, 2)
    60	            assert sr == 44100 and audio.shape == (CLIP_SAMPLES, 2), (path, sr, audio.shape)
    61	            rec[kind] = torch.from_numpy(audio.T.copy())                  # (2, n)
    62	        clips.append(rec)
    63	    assert len(clips) == 8, f'expected 8 clips, got {len(clips)}'
    64	    assert len({c['track'] for c in clips}) == 8, 'clips must come from 8 distinct tracks'
    65	    return man, clips
    66	
    67	
    68	def _db(num, den):
    69	    if den == 0:
    70	        return 'inf'
    71	    return float(10 * math.log10(num / den))
    72	
    73	
    74	def sdr_db(ref, est):
    75	    ref = ref.reshape(-1).double()
    76	    est = est.reshape(-1).double()
    77	    return _db(float((ref ** 2).sum()), float(((ref - est) ** 2).sum()))
    78	
    79	
    80	def si_sdr_db(ref, est):
    81	    ref = ref.reshape(-1).double()
    82	    est = est.reshape(-1).double()
    83	    ref = ref - ref.mean()
    84	    est = est - est.mean()
    85	    s = (est * ref).sum() / (ref ** 2).sum() * ref
    86	    return _db(float((s ** 2).sum()), float(((est - s) ** 2).sum()))
    87	
    88	
    89	def a_output_path(ref_dir, chunk, index):
    90	    return os.path.join(ref_dir, f'sdr_A_c{chunk}_clip{index:02d}.pt')
    91	
    92	
    93	def separate_clip(step, ctx, mixture, chunk):
    94	    """Non-overlapping chunked processing + concatenation (registered policy)."""
    95	    assert CLIP_SAMPLES % chunk == 0, (CLIP_SAMPLES, chunk)
    96	    outs = []
    97	    with torch.no_grad(), ctx():
    98	        for i in range(CLIP_SAMPLES // chunk):
    99	            x = mixture[:, i * chunk:(i + 1) * chunk].unsqueeze(0).cuda()
   100	            out = step(x)
   101	            torch.cuda.synchronize()
   102	            out = out.float().clone()            # borrowed replay buffer -> owned
   103	            if out.dim() == 3:
   104	                out = out[0]
   105	            assert out.shape == (2, chunk), tuple(out.shape)
   106	            outs.append(out.cpu())
   107	    return torch.cat(outs, dim=-1)
   108	
   109	
   110	def run_gate(step, ctx, clips, ref_dir, chunk, save_reference=False):
   111	    rows = []
   112	    for c in clips:
   113	        est = separate_clip(step, ctx, c['mixture'], chunk)
   114	        vocals = c['vocals']
   115	        row = {'index': c['index'], 'track': c['track'],
   116	               'sdr_ref_db': sdr_db(vocals, est),
   117	               'si_sdr_ref_db': si_sdr_db(vocals, est),
   118	               'finite': bool(torch.isfinite(est).all())}
   119	        path = a_output_path(ref_dir, chunk, c['index'])
   120	        if save_reference:
   121	            os.makedirs(ref_dir, exist_ok=True)
   122	            torch.save(est, path)
   123	            row['saved'] = path
   124	        else:
   125	            if not os.path.exists(path):
   126	                raise FileNotFoundError(f'eager-A clip output missing: {path}')
   127	            a_out = torch.load(path, weights_only=True)
   128	            row['sdr_ref_A_db'] = sdr_db(vocals, a_out)
   129	            d = (row['sdr_ref_db'] - row['sdr_ref_A_db']
   130	                 if isinstance(row['sdr_ref_db'], float) and isinstance(row['sdr_ref_A_db'], float)
   131	                 else None)
   132	            row['delta_sdr_ref_db'] = d
   133	            row['sdr_vs_A_db'] = sdr_db(a_out, est)
   134	            row['si_sdr_vs_A_db'] = si_sdr_db(a_out, est)
   135	            row['max_abs_diff_vs_A'] = float((a_out - est).abs().max())
   136	        rows.append(row)
   137	    rec = {'clips': rows, 'operating_point': chunk,
   138	           'chunks_per_clip': CLIP_SAMPLES // chunk,
   139	           'reconstruction': 'non-overlapping concatenation',
   140	           'threshold_mean_delta_sdr_db': THRESHOLD_DB, 'n_clips': len(rows)}
   141	    finite_sdr = [r['sdr_ref_db'] for r in rows if isinstance(r['sdr_ref_db'], float)]
   142	    rec['mean_sdr_ref_db'] = float(np.mean(finite_sdr)) if finite_sdr else None
   143	    if save_reference:
   144	        rec['status'] = 'REFERENCE_SAVED'
   145	        return rec
   146	    deltas = [r['delta_sdr_ref_db'] for r in rows]
   147	    if any(d is None for d in deltas):
   148	        rec['status'] = 'FAIL'
   149	        rec['reason'] = 'non-finite SDR (perfect match or zero reference) in a paired row'
   150	        return rec
   151	    rec['mean_delta_sdr_ref_db'] = float(np.mean(deltas))
   152	    rec['min_delta_sdr_ref_db'] = float(np.min(deltas))
   153	    vsA = [r['sdr_vs_A_db'] for r in rows]
   154	    rec['mean_sdr_vs_A_db'] = (float(np.mean([v for v in vsA if isinstance(v, float)]))
   155	                               if any(isinstance(v, float) for v in vsA) else 'inf')
   156	    rec['all_finite'] = all(r['finite'] for r in rows)
   157	    rec['status'] = ('PASS' if rec['all_finite'] and
   158	                     rec['mean_delta_sdr_ref_db'] >= THRESHOLD_DB else 'FAIL')
   159	    return rec
