    17	REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    18	ARMS = ('A', 'B', 'C1', 'C2', 'C3', 'C1A', 'C1D', 'D', 'E', 'F', 'G', 'H', 'ANVTX')
    19	CHUNKS = (352800, 4410, 22050, 88200)
    20	RESTART_RE = re.compile(r'^r\d+$')
    21	
