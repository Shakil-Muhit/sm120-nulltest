   113	def timed_run(step, x, ctx, iters=50, nvtx_pass=False):
   114	    """PREREG 5a — PRIMARY per-iteration latency (sync every pass) inside the
   115	    cudaProfilerApi capture range; SECONDARY one free-running block outside it.
   116	    nvtx_pass=True pushes an OUTER eager NVTX range per pass (traced runs:
   117	    pass windows for the exports; never inside compiled code)."""
   118	    with torch.no_grad(), ctx():
   119	        torch.cuda.synchronize()
   120	        torch.cuda.profiler.start()
   121	        latency_ms = []
   122	        for i in range(iters):
   123	            if nvtx_pass:
   124	                torch.cuda.nvtx.range_push(f'pass_{i}')
   125	            t0 = time.perf_counter()
   126	            step(x)
   127	            torch.cuda.synchronize()
   128	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   129	            if nvtx_pass:
   130	                torch.cuda.nvtx.range_pop()
   131	        torch.cuda.profiler.stop()
   132	
   133	        torch.cuda.synchronize()
   134	        t0 = time.perf_counter()
   135	        for _ in range(iters):
   136	            step(x)
   137	        torch.cuda.synchronize()
   138	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   139	    return latency_ms, throughput_ms
