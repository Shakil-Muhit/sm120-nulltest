   194	def validate(step, ctx, tier, chunk, ref_dir, save_reference=False):
   195	    """AUDIT-MAP[2] mechanics: two passes, different data (asserted), each
   196	    compared to the SAVED eager-A output for that (chunk, seed). With
   197	    save_reference=True (arm A reference step) the outputs are written
   198	    instead of compared."""
   199	    passes, prev_x = [], None
   200	    for seed in VAL_SEEDS:
   201	        x = make_input(chunk, seed)
   202	        if prev_x is not None:
   203	            assert not torch.equal(x, prev_x), \
   204	                'validation passes must use different input data'
   205	        prev_x = x
   206	        with torch.no_grad(), ctx():
   207	            out = step(x)
   208	            torch.cuda.synchronize()
   209	            out = out.clone()            # borrow discipline (build_spec rule 1)
   210	        path = ref_path(ref_dir, chunk, seed)
   211	        if save_reference:
   212	            os.makedirs(ref_dir, exist_ok=True)
   213	            torch.save(out.float().cpu(), path)
   214	            passes.append({'seed': seed, 'saved': path,
   215	                           'finite': bool(torch.isfinite(out).all())})
   216	            continue
   217	        if not os.path.exists(path):
   218	            raise FileNotFoundError(f'reference output missing: {path} '
   219	                                    '(run the arm-A reference step first)')
   220	        ref = torch.load(path, map_location='cuda', weights_only=True)
   221	        rec = compare_outputs(out, ref, tier)
   222	        rec['seed'] = seed
   223	        passes.append(rec)
   224	        del ref
   225	    if save_reference:
   226	        return {'status': 'REFERENCE_SAVED', 'tier': tier, 'passes': passes}
   227	    ok = all(p['ok'] for p in passes)
   228	    return {'status': 'PASS' if ok else 'FAIL', 'tier': tier,
   229	            'rtol': TIERS[tier][0], 'atol': TIERS[tier][1], 'passes': passes}
