    68	def _db(num, den):
    69	    if den == 0:
    70	        return 'inf'
    71	    return float(10 * math.log10(num / den))
    72	
    73	
    74	def sdr_db(ref, est):
    75	    ref = ref.reshape(-1).double()
    76	    est = est.reshape(-1).double()
    77	    return _db(float((ref ** 2).sum()), float(((ref - est) ** 2).sum()))
    78	
    79	
    80	def si_sdr_db(ref, est):
    81	    ref = ref.reshape(-1).double()
    82	    est = est.reshape(-1).double()
    83	    ref = ref - ref.mean()
    84	    est = est - est.mean()
    85	    s = (est * ref).sum() / (ref ** 2).sum() * ref
    86	    return _db(float((s ** 2).sum()), float(((est - s) ** 2).sum()))
    87	
