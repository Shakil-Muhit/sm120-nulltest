     7	# range brackets exactly that block; traced walls are never headline numbers.
     8	set -u
     9	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    10	EVID="$REPO_DIR/evidence"
