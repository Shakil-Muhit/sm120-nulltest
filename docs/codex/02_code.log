   167	def compare_outputs(out, ref, tier):
   168	    rtol, atol = TIERS[tier]
   169	    out = out.float()
   170	    ref = ref.float()
   171	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   172	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   173	    if out.shape != ref.shape:
   174	        rec['reason'] = 'shape mismatch'
   175	        rec['max_abs_diff'] = None
   176	        return rec
   177	    fin_out, fin_ref = bool(torch.isfinite(out).all()), bool(torch.isfinite(ref).all())
   178	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   179	    rec['max_abs_diff'] = float((out - ref).abs().max().item())
   180	    rec['bitwise_equal'] = bool(torch.equal(out, ref))
   181	    if not (fin_out and fin_ref):
   182	        rec['reason'] = 'non-finite values present'
   183	        return rec
   184	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   185	    if not rec['ok']:
   186	        rec['reason'] = 'tolerance exceeded'
   187	    return rec
