    38	def sha256_file(path):
    39	    h = hashlib.sha256()
    40	    with open(path, 'rb') as f:
    41	        for block in iter(lambda: f.read(1 << 20), b''):
    42	            h.update(block)
    43	    return h.hexdigest()
