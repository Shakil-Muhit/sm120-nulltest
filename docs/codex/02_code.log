     1	#!/bin/bash
     2	# SESSION 2 (prereg_amendments.md §5): chunk sweep, node-level traces, profiling
     3	# perturbation, attention-backend and boundary microbenchmarks, graph-deployment
     4	# verification exports. Requires session-1 evidence/ref (validation refs) —
