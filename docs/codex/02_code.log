   167	            'mask_estimators': names, 'kmax_band_split': model.band_split.kmax,
   168	            'kmax_mask': model.mask_estimators[0].kmax,
   169	            'mask_depth': model.mask_estimators[0].depth,
   170	            'production_code_used': False}
