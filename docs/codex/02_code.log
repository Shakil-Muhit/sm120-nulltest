     1	"""Graph-deployment verification (plan 0.3; prereg_amendments.md §3).
     2	
     3	Reads the nsys exports of a traced run (capture window = the 5a latency block,
     4	one pass per outer NVTX range `pass_<i>`) and reports per pass:
     5	  cudaGraphLaunch calls, cudaLaunchKernel-family calls (eager launches outside
     6	  graph replay), memcpy/memset API calls, and the kernel names executed
     7	  outside graph replay. Cudagraph-trees input staging (copies of graph inputs
     8	  into the static pool) is reported as its own row and NOT counted as
     9	  uncaptured model work. "Zero graph breaks" is not accepted as evidence of
    10	  full capture; these counts are.
    11	
    12	Inputs: <base>_cuda_api_trace.csv, <base>_cuda_gpu_trace.csv,
    13	<base>_nvtx_gpu_proj_trace.csv (nsys stats reports cuda_api_trace,
    14	cuda_gpu_trace, nvtx_gpu_proj_trace). Kernel rows inside graph replay are
    15	identified by their graph-node id column when the export carries one
    16	(`--cuda-graph-trace=node`), else by the absence of a matching launch API
    17	row (correlation id).
    18	"""
    19	
    20	import argparse
    21	import csv
    22	import json
    23	import re
    24	import statistics
    25	
    26	# cudagraph-trees input staging: non-static inputs are copied into the static
    27	# pool before replay (torch 2.8 cudagraph_trees: _foreach_copy_ / copy kernels)
    28	STAGING_NAMES = ('Memcpy DtoD', 'copy_kernel', 'elementwise_kernel',
    29	                 'direct_copy_kernel', 'CUDA memcpy Device-to-Device',
    30	                 'foreach', 'multi_tensor_apply', 'MultiTensor', 'ForeachCopy')
    31	
    32	
    33	def read_csv(path):
    34	    with open(path, newline='') as f:
    35	        rows = list(csv.reader(f))
    36	    return rows[0], rows[1:]
    37	
    38	
    39	def col(head, *names, contains=None):
    40	    for name in names:
    41	        for i, h in enumerate(head):
    42	            if h.strip().strip('"') == name:
    43	                return i
    44	    if contains:
    45	        for i, h in enumerate(head):
    46	            if contains in h:
    47	                return i
    48	    return None
    49	
    50	
    51	def windows(nvtx_csv):
    52	    head, rows = read_csv(nvtx_csv)
    53	    c_name = col(head, 'Name', 'Range', contains='Name')
    54	    c_start = col(head, contains='Start')
    55	    c_dur = col(head, contains='Duration')
    56	    wins = {}
    57	    for r in rows:
    58	        nm = r[c_name].strip().strip('"').split(':')[-1]
    59	        m = re.fullmatch(r'pass_(\d+)', nm)
    60	        if not m:
    61	            continue
    62	        try:
    63	            s = int(float(r[c_start].replace(',', '')))
    64	            d = int(float(r[c_dur].replace(',', '')))
    65	        except ValueError:
    66	            continue
    67	        wins[int(m.group(1))] = (s, s + d)
    68	    return [wins[i] for i in sorted(wins)]
    69	
    70	
    71	def main():
    72	    ap = argparse.ArgumentParser()
    73	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
    74	    ap.add_argument('--out', required=True)
    75	    ap.add_argument('--arm', default='')
    76	    args = ap.parse_args()
    77	    wins = windows(args.base + '_nvtx_gpu_proj_trace.csv')
    78	    assert wins, 'no pass_<i> NVTX windows in the projection export'
    79	
    80	    head, rows = read_csv(args.base + '_cuda_api_trace.csv')
    81	    c_start = col(head, 'Start (ns)', contains='Start')
    82	    c_name = col(head, 'Name')
    83	    c_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
    84	    api = []
    85	    for r in rows:
    86	        try:
    87	            api.append({'start': int(float(r[c_start].replace(',', ''))),
    88	                        'name': r[c_name], 'corr': r[c_corr] if c_corr is not None else None})
    89	        except (ValueError, IndexError):
    90	            continue
    91	
    92	    head, rows = read_csv(args.base + '_cuda_gpu_trace.csv')
    93	    g_start = col(head, 'Start (ns)', contains='Start')
    94	    g_name = col(head, 'Name')
    95	    g_corr = col(head, 'CorrId', 'CorrID', contains='Corr')
    96	    g_graph = col(head, 'GraphNodeId', 'Graph Node Id', 'GraphId', contains='Graph')
    97	    kern = []
    98	    for r in rows:
    99	        try:
   100	            kern.append({'start': int(float(r[g_start].replace(',', ''))),
   101	                         'name': r[g_name],
   102	                         'corr': r[g_corr] if g_corr is not None else None,
   103	                         'graph': (r[g_graph].strip() if g_graph is not None and
   104	                                   len(r) > g_graph else '')})
   105	        except (ValueError, IndexError):
   106	            continue
   107	    launch_corrs = {a['corr'] for a in api if a['corr'] and 'LaunchKernel' in a['name']}
   108	
   109	    per_pass = []
   110	    for s, e in wins:
   111	        a_in = [a for a in api if s <= a['start'] < e]
   112	        k_in = [k for k in kern if s <= k['start'] < e]
   113	        # runtime AND driver entry points: cudaGraphLaunch / cuGraphLaunch;
   114	        # cudaLaunchKernel, cudaLaunchKernelExC, cuLaunchKernel, cuLaunchKernelEx
   115	        graph_launch = sum(1 for a in a_in if 'GraphLaunch' in a['name'])
   116	        eager_launch = sum(1 for a in a_in if 'LaunchKernel' in a['name'])
   117	        memcpy_api = sum(1 for a in a_in if 'Memcpy' in a['name'] or 'Memset' in a['name'])
   118	        graphs_visited = len({k['graph'] for k in k_in if k['graph']}) if g_graph is not None else None
   119	        if g_graph is not None:
   120	            outside = [k for k in k_in if not k['graph']]
   121	        else:
   122	            outside = [k for k in k_in if k['corr'] in launch_corrs]
   123	        staging = [k for k in outside if any(t in k['name'] for t in STAGING_NAMES)]
   124	        uncaptured = [k for k in outside if k not in staging]
   125	        per_pass.append({'graphs_visited': graphs_visited,
   126	                         'graph_launch_calls': graph_launch,
