     1	"""Three timing views for multi-stream arms (plan 1.7; prereg_amendments §5).
     2	
     3	From a node-level cuda_gpu_trace export with outer NVTX pass windows:
     4	  (i)   summed kernel durations per pass
     5	  (ii)  union of kernel intervals per pass (busy union — overlap collapsed)
     6	  (iii) dependency-critical-path estimate per pass. DEPENDENCY MODEL (stated):
     7	        kernels on the same stream execute in order (edge k_i -> k_{i+1});
     8	        a kernel on a side stream (not the pass's dominant stream) depends on
     9	        the latest dominant-stream kernel that STARTED before it (the fork);
    10	        the first dominant-stream kernel that starts after a side-stream
    11	        kernel ends depends on that kernel (the join). Critical path = longest
    12	        path (sum of kernel durations, gaps ignored) through this DAG.
    13	        This is an estimate from the trace's stream structure, not from the
    14	        program's event graph; F/G's fork/join events are exactly this shape.
    15	Every view is reported per pass and as the median over passes; "busy" is
    16	never reported without its view.
    17	"""
    18	
    19	import argparse
    20	import csv
    21	import json
    22	import re
    23	import statistics
    24	
    25	
    26	def read_rows(path):
    27	    with open(path, newline='') as f:
    28	        rd = csv.reader(f)
    29	        head = next(rd)
    30	        def col(*names, contains=None):
    31	            for n in names:
    32	                for i, h in enumerate(head):
    33	                    if h.strip().strip('"') == n:
    34	                        return i
    35	            if contains:
    36	                for i, h in enumerate(head):
    37	                    if contains in h:
    38	                        return i
    39	            return None
    40	        c_s, c_d = col('Start (ns)', contains='Start'), col('Duration (ns)', contains='Duration')
    41	        c_n, c_st = col('Name'), col('Strm', 'Stream', contains='Strm')
    42	        rows = []
    43	        for r in rd:
    44	            try:
    45	                rows.append({'start': int(float(r[c_s].replace(',', ''))),
    46	                             'dur': int(float(r[c_d].replace(',', ''))),
    47	                             'name': r[c_n], 'stream': r[c_st] if c_st is not None else '0'})
    48	            except (ValueError, IndexError):
    49	                continue
    50	    rows.sort(key=lambda x: x['start'])
    51	    return rows
    52	
    53	
    54	def windows(path):
    55	    with open(path, newline='') as f:
    56	        rd = csv.reader(f)
    57	        head = next(rd)
    58	        c_name = next(i for i, h in enumerate(head) if h.strip().strip('"') in ('Name', 'Range'))
    59	        c_start = next(i for i, h in enumerate(head) if 'Start' in h)
    60	        c_dur = next(i for i, h in enumerate(head) if 'Duration' in h)
    61	        wins = {}
    62	        for r in rd:
    63	            m = re.fullmatch(r'pass_(\d+)', r[c_name].strip().strip('"').split(':')[-1])
    64	            if m:
    65	                try:
    66	                    s = int(float(r[c_start].replace(',', '')))
    67	                    d = int(float(r[c_dur].replace(',', '')))
    68	                except ValueError:
    69	                    continue
    70	                wins[int(m.group(1))] = (s, s + d)
    71	    return [wins[i] for i in sorted(wins)]
    72	
    73	
    74	def union_ns(rows):
    75	    total, cur_s, cur_e = 0, None, None
    76	    for r in rows:
    77	        s, e = r['start'], r['start'] + r['dur']
    78	        if cur_e is None or s > cur_e:
    79	            if cur_e is not None:
    80	                total += cur_e - cur_s
    81	            cur_s, cur_e = s, e
    82	        else:
    83	            cur_e = max(cur_e, e)
    84	    if cur_e is not None:
    85	        total += cur_e - cur_s
    86	    return total
    87	
    88	
    89	def critical_path_ns(rows):
    90	    if not rows:
    91	        return 0, '-'
    92	    by_stream = {}
    93	    for r in rows:
    94	        by_stream.setdefault(r['stream'], []).append(r)
    95	    dominant = max(by_stream, key=lambda s: len(by_stream[s]))
    96	    main = by_stream[dominant]
    97	    dist = {}                                  # id(row) -> longest path ending at row
    98	    # dominant stream in order, with joins from side streams
    99	    side_rows = [r for s, lst in by_stream.items() if s != dominant for r in lst]
   100	    side_rows.sort(key=lambda x: x['start'])
   101	    # fork: side kernel depends on latest dominant kernel started before it
   102	    def longest_main_before(t):
   103	        best = 0
   104	        for m in main:
   105	            if m['start'] < t:
   106	                best = max(best, dist.get(id(m), 0))
   107	        return best
   108	    order = sorted(rows, key=lambda x: x['start'])
   109	    prev_on_stream = {}
   110	    for r in order:
   111	        preds = []
   112	        p = prev_on_stream.get(r['stream'])
   113	        if p is not None:
   114	            preds.append(dist[id(p)])
   115	        if r['stream'] != dominant:
   116	            preds.append(longest_main_before(r['start']))
   117	        else:
   118	            # join: side kernels that ended before this dominant kernel starts
   119	            for sr in side_rows:
   120	                if sr['start'] + sr['dur'] <= r['start'] and id(sr) in dist:
   121	                    preds.append(dist[id(sr)])
   122	        dist[id(r)] = (max(preds) if preds else 0) + r['dur']
   123	        prev_on_stream[r['stream']] = r
   124	    return max(dist.values()), dominant
   125	
   126	
   127	def main():
   128	    ap = argparse.ArgumentParser()
   129	    ap.add_argument('--base', required=True, help='export basename (…/trace_X)')
   130	    ap.add_argument('--out', required=True)
   131	    ap.add_argument('--arm', default='')
   132	    args = ap.parse_args()
   133	    rows = read_rows(args.base + '_cuda_gpu_trace.csv')
   134	    wins = windows(args.base + '_nvtx_gpu_proj_trace.csv')
   135	    assert wins, 'no pass windows'
   136	    per = []
   137	    for s, e in wins:
   138	        p = [r for r in rows if s <= r['start'] < e]
   139	        cp, dom = critical_path_ns(p)
   140	        per.append({'kernels': len(p), 'streams': sorted({r['stream'] for r in p}),
   141	                    'sum_ns': sum(r['dur'] for r in p), 'union_ns': union_ns(p),
   142	                    'critical_path_ns': cp, 'window_ns': e - s, 'dominant_stream': dom})
   143	    def med(k):
   144	        return statistics.median(x[k] for x in per)
   145	    out = {'arm': args.arm, 'passes': len(per),
   146	           'median_us': {k: med(k) / 1e3 for k in ('sum_ns', 'union_ns', 'critical_path_ns', 'window_ns')},
   147	           'median_kernels_per_pass': med('kernels'),
   148	           'streams_seen': sorted({s for x in per for s in x['streams']}),
   149	           'dependency_model': ('same-stream order; side-stream kernel depends on the latest '
   150	                                'dominant-stream kernel started before it (fork); a dominant '
   151	                                'kernel depends on every side kernel that ended before it '
   152	                                'started (join); longest path over kernel durations'),
   153	           'per_pass': per}
   154	    with open(args.out, 'w') as f:
   155	        json.dump(out, f, indent=1)
   156	    m = out['median_us']
   157	    print(f"[views] {args.arm}: sum {m['sum_ns']:.1f} us | union {m['union_ns']:.1f} us | "
   158	          f"critical path {m['critical_path_ns']:.1f} us | window {m['window_ns']:.1f} us | "
   159	          f"streams {out['streams_seen']}")
   160	
   161	
   162	if __name__ == '__main__':
   163	    main()

