from timing import compile_stable
class RMS(torch.nn.Module):
    def __init__(self,k):
        super().__init__(); self.gamma=torch.nn.Parameter(torch.randn(k)); self.scale=k**.5
    def forward(self,x):
        return torch.nn.functional.normalize(x,dim=-1)*self.scale*self.gamma
class Bands(torch.nn.Module):
    def __init__(self):
        super().__init__(); self.dim_inputs=(2,4,6); self.to_features=torch.nn.ModuleList([torch.nn.Sequential(RMS(k),torch.nn.Linear(k,5)) for k in self.dim_inputs])
    def forward(self,x):
        return torch.stack([m(p) for m,p in zip(self.to_features,x.split(self.dim_inputs,dim=-1))],dim=-2)
class Masks(torch.nn.Module):
    def __init__(self):
        super().__init__(); self.dim_inputs=(2,4,6); self.to_freqs=torch.nn.ModuleList([torch.nn.Sequential(torch.nn.Sequential(torch.nn.Linear(5,7),torch.nn.Tanh(),torch.nn.Linear(7,7),torch.nn.Tanh(),torch.nn.Linear(7,2*k)),torch.nn.GLU(-1)) for k in self.dim_inputs])
    def forward(self,x):
        return torch.cat([m(x[:,:,i,:]) for i,m in enumerate(self.to_freqs)],dim=-1)
