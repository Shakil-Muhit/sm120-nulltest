    78	def compile_stable(before, after):
    79	    """Recording/compilation stability: no NEW graph breaks or unimplemented
    80	    ops, the same number of unique Dynamo graphs, and unchanged Inductor
    81	    cudagraph skip counters. Per-call counters (calls, frames) are ignored."""
    82	    for k in STABILITY_KEYS:
    83	        if before.get(k, {}) != after.get(k, {}):
    84	            return False
    85	    if before.get('stats', {}).get('unique_graphs') != after.get('stats', {}).get('unique_graphs'):
    86	        return False
    87	    b_ind = {k: v for k, v in before.get('inductor', {}).items() if 'skip' in k}
    88	    a_ind = {k: v for k, v in after.get('inductor', {}).items() if 'skip' in k}
    89	    return b_ind == a_ind
