    46	def paths_from_env():
    47	    """Pod layout (setup.sh / fetch_checkpoint.sh): MSST_DIR, CKPT_DIR with
    48	    manifest.env; env overrides win; ml-beast shakedown sets AXIAL-style paths."""
    49	    home = os.path.expanduser('~')
    50	    msst = os.environ.get('MSST_DIR', os.path.join(home, 'work', 'msst'))
    51	    ckpt_dir = os.environ.get('CKPT_DIR', os.path.join(home, 'work', 'ckpt'))
    52	    ckpt = os.environ.get('CKPT_FILE')
    53	    config = os.environ.get('CONFIG_FILE')
    54	    manifest = os.path.join(ckpt_dir, 'manifest.env')
    55	    if (ckpt is None or config is None) and os.path.exists(manifest):
    56	        for line in open(manifest):
    57	            if '=' in line:
    58	                k, v = line.strip().split('=', 1)
    59	                v = v.strip('"')
    60	                if k == 'CKPT_FILE' and ckpt is None:
    61	                    ckpt = v
    62	                if k == 'CONFIG_FILE' and config is None:
    63	                    config = v
    64	    if ckpt is None:
    65	        ckpt = os.path.join(ckpt_dir, 'MelBandRoformer.ckpt')
    66	    if config is None:
    67	        config = os.path.join(msst, 'configs', 'KimberleyJensen',
    68	                              'config_vocals_mel_band_roformer_kj.yaml')
    69	    for p in (msst, ckpt, config):
    70	        if not os.path.exists(p):
    71	            raise FileNotFoundError(f'provenance path missing: {p} (run setup.sh)')
    72	    return {'msst': msst, 'ckpt': ckpt, 'config': config}
     1	"""Whole-forward CUDA-graph capture ladder for arms B/E/G (prereg_amendments §1).
     2	
     3	Ladder (scope RECORDED in the run JSON, every failure's traceback kept):
     4	  1. stock forward as-is;
     5	  2. the single external constant-hoist adapter: the forward's DC-filter index
     6	     `tensor(0, device=device)` is replaced by a pre-allocated device tensor.
     7	     A pageable host->device copy is illegal under stream capture — verified
     8	     empirically on ml-beast (torch 2.8.0+cu128): capturing
     9	     `x.index_fill(1, torch.tensor(0, device='cuda'), 0.)` fails with
    10	     "operation failed due to a previous error during capture". The adapter is
    11	     an AST-verified single-expression substitution of the public forward
    12	     (same pattern as axial-layout-scoping extensions/c3/native_tail.py); no
    13	     arithmetic changes;
    14	  2b. the iSTFT boundary adapter: with the DC index hoisted, capture still
    15	     fails at capture_end (ml-beast shakedown 2026-09-20). torch.istft performs
    16	     a host-side window-envelope check (ATen istft: the envelope minimum is
    17	     read with .item()) — a device->host sync, illegal under stream capture
    18	     (the C3 study recorded the same: native iSTFT is capture-unsafe). Rung 2b
    19	     keeps rung 2 and additionally replaces the forward's single
    20	     `torch.istft(...)` call by `_capture_istft(...)` with the SAME argument
    21	     list (AST-verified; reverse substitution restores the pinned source).
    22	     During capture, _capture_istft stashes its input (the graph's static
    23	     pre-iSTFT complex spectrogram) and returns a placeholder; each replay
    24	     is followed by the SAME public torch.istft call run eagerly on that
    25	     static buffer, then the forward's own post-iSTFT rearranges. Scope label:
    26	     'whole_forward_to_istft' — everything up to the iSTFT is graphed, the
    27	     iSTFT + two reshapes are eager. No arithmetic changes.
    28	  3. band_split-only capture (prereg P4 fallback), via the sm120 Recording/
    29	     ReplayBandSplit wrappers.
    30	
    31	Capture mechanics = sm120 arms/common.py::capture_graph (static I/O buffers,
    32	side-stream warmup, capture outside the timed region) with the repo's
    33	autocast context, cache_enabled=False during capture (torch AMP+graphs
    34	guidance).
    35	"""
    36	
    37	import ast
    38	import hashlib
    39	import inspect
    40	import os
    41	import textwrap
    42	import traceback
    43	import types
    44	
    45	import torch
    46	
    47	import common   # sm120 arms/common.py (Recording/ReplayBandSplit) — on sys.path via fullarms
    48	
    49	
    50	def capture_graph_amp(fn, example, ctx, warmup_iters=3):
    51	    """sm120 capture_graph with the autocast context on every pass."""
    52	    static_in = example.detach().clone()
    53	    side = torch.cuda.Stream()
    54	    side.wait_stream(torch.cuda.current_stream())
    55	    with torch.cuda.stream(side), torch.no_grad(), ctx():
    56	        for _ in range(warmup_iters):
    57	            fn(static_in)
    58	    torch.cuda.current_stream().wait_stream(side)
    59	    torch.cuda.synchronize()
    60	    graph = torch.cuda.CUDAGraph()
    61	    with torch.no_grad(), ctx(), torch.cuda.graph(graph):
    62	        static_out = fn(static_in)
    63	    return graph, static_in, static_out
    64	
    65	
    66	def _reset_after_failed_capture():
    67	    # torch 2.8: graph.__exit__ can leave the ambient stream on the capture
    68	    # stream after a failure (sm120 _capture_with_fallback note)
    69	    torch.cuda.set_stream(torch.cuda.default_stream())
    70	    torch.cuda.synchronize()
    71	
    72	
    73	def install_dc_index_hoist(model, out_dir):
    74	    """External forward copy differing ONLY in the DC-filter index expression."""
    75	    from models.bs_roformer.mel_band_roformer import MelBandRoformer
    76	    assert type(model) is MelBandRoformer
    77	    assert 'forward' not in model.__dict__, 'forward already replaced'
    78	    original = textwrap.dedent(inspect.getsource(MelBandRoformer.forward))
    79	    tree = ast.parse(original)
    80	    replacements = 0
    81	    for node in ast.walk(tree):
    82	        if (isinstance(node, ast.Call) and
    83	                ast.unparse(node.func) == 'stft_repr.index_fill'):
    84	            assert len(node.args) == 3 and not node.keywords
    85	            assert ast.unparse(node.args[0]) == '1'
    86	            assert ast.unparse(node.args[1]) == 'tensor(0, device=device)'
    87	            assert isinstance(node.args[2], ast.Constant) and node.args[2].value == 0.
    88	            node.args[1] = ast.Name(id='_capture_dc_index', ctx=ast.Load())
    89	            replacements += 1
    90	    assert replacements == 1, 'expected the single public DC-filter call'
    91	    source = ast.unparse(ast.fix_missing_locations(tree)) + '\n'
    92	    restored = ast.parse(source)
    93	    for node in ast.walk(restored):
    94	        if (isinstance(node, ast.Call) and
    95	                ast.unparse(node.func) == 'stft_repr.index_fill'):
    96	            node.args[1] = ast.parse('tensor(0, device=device)', mode='eval').body
    97	    assert ast.dump(restored) == ast.dump(ast.parse(original)), \
    98	        'external forward differs beyond the index hoist'
    99	    os.makedirs(out_dir, exist_ok=True)
   100	    dest = os.path.join(out_dir, 'generated_capture_forward.py')
   101	    with open(dest, 'w') as f:
   102	        f.write(source)
   103	    namespace = dict(MelBandRoformer.forward.__globals__)
   104	    namespace['_capture_dc_index'] = torch.tensor(0, device='cuda')
   105	    exec(compile(source, dest, 'exec'), namespace)
   106	    model.forward = types.MethodType(namespace['forward'], model)
   107	    return {'status': 'PASS', 'replacements': replacements,
   108	            'original_forward_sha256': hashlib.sha256(original.encode()).hexdigest(),
   109	            'external_forward_sha256': hashlib.sha256(source.encode()).hexdigest(),
   110	            'generated_source': dest,
   111	            'scope': 'public forward differs only in the DC-filter index expression'}
   112	
   113	
   114	class _IstftBoundary:
   115	    """Capture-time stand-in for torch.istft (rung 2b). Same signature."""
   116	
   117	    def __init__(self):
   118	        self.stash = None
   119	
   120	    def __call__(self, input, *args, **kwargs):
   121	        if torch.cuda.is_current_stream_capturing():
   122	            self.stash = {'input': input, 'args': args, 'kwargs': dict(kwargs)}
   123	            length = kwargs.get('length')
   124	            if length is None:
   125	                # torch.istft output length with center=True: hop * (frames - 1)
   126	                assert kwargs.get('center', True), 'istft boundary assumes center=True'
   127	                length = int(kwargs['hop_length']) * (int(input.shape[-1]) - 1)
   128	            self.placeholder_len = length
   129	            return torch.zeros(input.shape[0], length, device=input.device,
   130	                               dtype=torch.float32)
   131	        return torch.istft(input, *args, **kwargs)
   132	
   133	
   134	def install_istft_boundary(model, out_dir, boundary):
   135	    """External forward copy differing ONLY in the iSTFT callee (on top of the
   136	    DC-index hoist, which must already be installed)."""
   137	    from models.bs_roformer.mel_band_roformer import MelBandRoformer
   138	    assert type(model) is MelBandRoformer
   139	    assert 'forward' in model.__dict__, 'install the DC-index hoist first'
   140	    src_path = os.path.join(out_dir, 'generated_capture_forward.py')
   141	    original = open(src_path).read()
   142	    tree = ast.parse(original)
   143	    replacements = 0
   144	    for node in ast.walk(tree):
   145	        if isinstance(node, ast.Call) and ast.unparse(node.func) == 'torch.istft':
   146	            assert ast.unparse(node.args[0]) == 'stft_repr'
   147	            assert any(k.arg == 'length' for k in node.keywords)
   148	            node.func = ast.Name(id='_capture_istft', ctx=ast.Load())
   149	            replacements += 1
   150	    assert replacements == 1, 'expected the single public torch.istft call'
   151	    source = ast.unparse(ast.fix_missing_locations(tree)) + '\n'
   152	    restored = ast.parse(source)
   153	    for node in ast.walk(restored):
   154	        if isinstance(node, ast.Call) and ast.unparse(node.func) == '_capture_istft':
   155	            node.func = ast.parse('torch.istft', mode='eval').body
   156	    assert ast.dump(restored) == ast.dump(ast.parse(original)), \
   157	        'external forward differs beyond the iSTFT callee'
   158	    dest = os.path.join(out_dir, 'generated_capture_forward_istft.py')
   159	    with open(dest, 'w') as f:
   160	        f.write(source)
   161	    namespace = dict(MelBandRoformer.forward.__globals__)
   162	    namespace['_capture_dc_index'] = torch.tensor(0, device='cuda')
   163	    namespace['_capture_istft'] = boundary
   164	    exec(compile(source, dest, 'exec'), namespace)
   165	    model.forward = types.MethodType(namespace['forward'], model)
   166	    return {'status': 'PASS', 'replacements': replacements,
   167	            'external_forward_sha256': hashlib.sha256(source.encode()).hexdigest(),
   168	            'generated_source': dest,
   169	            'scope': 'public forward differs only in the DC-filter index expression '
   170	                     'and the iSTFT callee (same argument list)'}
   171	
   172	
   173	def capture_ladder(model, x_example, ctx_nocache, info, out_dir):
   174	    """Returns step(x). Mutates info: capture_scope, capture_adapter,
   175	    capture_attempts (tracebacks of the failed rungs)."""
   176	    info['capture_attempts'] = []
   177	
   178	    def whole_step(graph, static_in, static_out):
   179	        def step(x):
   180	            static_in.copy_(x)           # AUDIT-MAP[2]: fresh input each replay
   181	            graph.replay()
   182	            return static_out            # borrowed — validate() clones
   183	        return step
   184	
   185	    try:
   186	        graph, sin, sout = capture_graph_amp(model, x_example, ctx_nocache)
   187	        info['capture_scope'] = 'whole_forward'
   188	        info['capture_adapter_active'] = 'stock'
   189	        return whole_step(graph, sin, sout)
   190	    except Exception:
   191	        info['capture_attempts'].append(
   192	            {'rung': 'whole_forward_stock', 'traceback': traceback.format_exc()})
   193	        _reset_after_failed_capture()
   194	
   195	    try:
   196	        info['capture_adapter'] = install_dc_index_hoist(model, out_dir)
   197	        graph, sin, sout = capture_graph_amp(model, x_example, ctx_nocache)
   198	        info['capture_scope'] = 'whole_forward+dc_index_hoist'
   199	        info['capture_adapter_active'] = 'dc_hoist'
   200	        return whole_step(graph, sin, sout)
   201	    except Exception:
   202	        info['capture_attempts'].append(
   203	            {'rung': 'whole_forward_dc_index_hoist', 'traceback': traceback.format_exc()})
   204	        _reset_after_failed_capture()
   205	
   206	    try:
   207	        boundary = _IstftBoundary()
   208	        info['capture_adapter_istft'] = install_istft_boundary(model, out_dir, boundary)
   209	        graph, sin, sout = capture_graph_amp(model, x_example, ctx_nocache)
   210	        assert boundary.stash is not None, 'iSTFT boundary never reached during capture'
   211	        st = boundary.stash
   212	        from einops import rearrange
   213	        n_stems = len(model.mask_estimators)
   214	        channels = model.audio_channels
   215	
   216	        def step_istft(x):
   217	            sin.copy_(x)                     # AUDIT-MAP[2]: fresh input each replay
   218	            graph.replay()
   219	            audio = torch.istft(st['input'], *st['args'], **st['kwargs'])
   220	            assert audio.shape[-1] == boundary.placeholder_len, \
   221	                (audio.shape, boundary.placeholder_len)
   222	            audio = rearrange(audio, '(b n s) t -> b n s t', b=1, s=channels, n=n_stems)
   223	            if n_stems == 1:
   224	                audio = rearrange(audio, 'b 1 s t -> b s t')
   225	            return audio
   226	        info['capture_scope'] = 'whole_forward_to_istft'
   227	        info['capture_adapter_active'] = 'dc_hoist+istft_boundary'
   228	        return step_istft
   229	    except Exception:
   230	        info['capture_attempts'].append(
   231	            {'rung': 'whole_forward_to_istft', 'traceback': traceback.format_exc()})
   232	        _reset_after_failed_capture()
   233	
   234	    # rung 3 runs the STOCK forward eagerly (adapters removed) with only the
   235	    # band_split module replaced by its replay wrapper
   236	    if 'forward' in model.__dict__:
   237	        del model.__dict__['forward']
   238	    info['capture_adapter_active'] = None
   239	    band_split = model.band_split
   240	    recorder = common.RecordingBandSplit(band_split)
   241	    model.band_split = recorder
   242	    with torch.no_grad(), ctx_nocache():
   243	        model(x_example)
   244	    folded = recorder.last_input.detach().clone()
   245	    model.band_split = band_split
   246	    graph, sin, sout = capture_graph_amp(band_split, folded, ctx_nocache)
   247	    model.band_split = common.ReplayBandSplit(band_split, graph, sin, sout)
   248	    info['capture_scope'] = 'band_split_only'
   249	    return lambda x: model(x)
     1	"""Arm H — pad-and-batch band modules (prereg_amendments.md §1.1).
     2	
     3	Generic reimplementation of the band-bmm idea (production code not used).
     4	External wrappers holding the ORIGINAL modules (parameters stay registered;
     5	nothing is modified) plus derived zero-padded weight buffers built once.
     6	
     7	Exactness (registered): padded entries are zero on every path —
     8	  band_split : F.normalize over a zero-padded row == per-band normalize (zeros
     9	               add nothing to the L2 norm); per-band scale K_i**0.5 as a
    10	               (60,1,1) vector; zero-padded gamma; bmm with zero-padded weight
    11	               rows contributes exactly 0; output order == torch.stack(dim=-2).
    12	  mask_est.  : three batched bmm chains; the last weight's columns are laid
    13	               out [a-half | b-half], each half zero-padded to K_max, so
    14	               GLU(dim=-1) over the padded width equals the per-band GLU
    15	               (pad columns: 0 * sigmoid(0) = 0); valid columns are gathered
    16	               back in band order == torch.cat(dim=-1).
    17	The only numerical difference is cuBLAS summation order (loose tier by the
    18	classification rule; H is compiled anyway).
    19	"""
    20	
    21	import torch
    22	import torch.nn as nn
    23	import torch.nn.functional as F
    24	
    25	
    26	def _band_split_parts(orig):
    27	    dims = tuple(int(d) for d in orig.dim_inputs)
    28	    parts = []
    29	    for seq in orig.to_features:
    30	        assert isinstance(seq, nn.Sequential) and len(seq) == 2
    31	        rms, lin = seq[0], seq[1]
    32	        assert isinstance(lin, nn.Linear) and lin.bias is not None
    33	        assert hasattr(rms, 'gamma') and hasattr(rms, 'scale')
    34	        parts.append((rms, lin))
    35	    assert len(parts) == len(dims)
    36	    return dims, parts
    37	
    38	
    39	class PadBatchBandSplit(nn.Module):
    40	    """Drop-in for the public BandSplit: (1, T, sum K_i) -> (1, T, 60, dim)."""
    41	
    42	    def __init__(self, orig):
    43	        super().__init__()
    44	        self.orig = orig                       # parameters stay registered
    45	        dims, parts = _band_split_parts(orig)
    46	        n, kmax = len(dims), max(dims)
    47	        dim_out = parts[0][1].out_features
    48	        total = sum(dims)
    49	        dev = parts[0][1].weight.device
    50	        idx = torch.full((n, kmax), total, dtype=torch.long)   # -> zero column
    51	        gamma = torch.zeros(n, kmax, dtype=torch.float32)
    52	        w = torch.zeros(n, kmax, dim_out, dtype=torch.float32)
    53	        b = torch.zeros(n, 1, dim_out, dtype=torch.float32)
    54	        scale = torch.zeros(n, 1, 1, dtype=torch.float32)
    55	        off = 0
    56	        for i, ((rms, lin), k) in enumerate(zip(parts, dims)):
    57	            assert lin.in_features == k and lin.out_features == dim_out
    58	            assert rms.gamma.shape == (k,)
    59	            idx[i, :k] = torch.arange(off, off + k)
    60	            gamma[i, :k] = rms.gamma.detach().float().cpu()
    61	            w[i, :k, :] = lin.weight.detach().float().cpu().t()
    62	            b[i, 0, :] = lin.bias.detach().float().cpu()
    63	            scale[i] = float(rms.scale)
    64	            off += k
    65	        assert off == total
    66	        self.n, self.kmax, self.total = n, kmax, total
    67	        self.register_buffer('idx', idx.to(dev), persistent=False)
    68	        self.register_buffer('gamma_pad', gamma.to(dev), persistent=False)
    69	        self.register_buffer('w_pad', w.to(dev), persistent=False)
    70	        self.register_buffer('b_pad', b.to(dev), persistent=False)
    71	        self.register_buffer('scale', scale.to(dev), persistent=False)
    72	
    73	    def forward(self, x):                      # (1, T, total)
    74	        assert x.shape[0] == 1 and x.shape[-1] == self.total
    75	        t = x.shape[1]
    76	        x_ext = torch.cat([x[0], x.new_zeros(t, 1)], dim=-1)   # (T, total+1)
    77	        xp = x_ext[:, self.idx]                                 # (T, n, kmax)
    78	        xp = xp.transpose(0, 1)                                 # (n, T, kmax)
    79	        xn = F.normalize(xp, dim=-1) * self.scale * self.gamma_pad[:, None, :]
    80	        y = torch.baddbmm(self.b_pad, xn, self.w_pad)           # (n, T, dim)
    81	        return y.transpose(0, 1).unsqueeze(0)                   # (1, T, n, dim)
    82	
    83	
    84	class PadBatchMaskEstimator(nn.Module):
    85	    """Drop-in for the public MaskEstimator: (1, T, 60, dim) -> (1, T, sum K_i)."""
    86	
    87	    def __init__(self, orig):
    88	        super().__init__()
    89	        self.orig = orig
    90	        dims = tuple(int(d) for d in orig.dim_inputs)
    91	        n, kmax = len(dims), max(dims)
    92	        chains = []
    93	        for mlp in orig.to_freqs:
    94	            assert isinstance(mlp, nn.Sequential) and len(mlp) == 2
    95	            inner, glu = mlp[0], mlp[1]
    96	            assert isinstance(glu, nn.GLU) and glu.dim == -1
    97	            layers = list(inner)
    98	            lins = [m for m in layers if isinstance(m, nn.Linear)]
    99	            others = [m for m in layers if not isinstance(m, nn.Linear)]
   100	            assert all(isinstance(m, nn.Tanh) for m in others), others
   101	            # public MLP: Linear (Tanh Linear)* — activation after all but last
   102	            assert len(others) == len(lins) - 1
   103	            assert [type(m) for m in layers] == \
   104	                [nn.Linear if i % 2 == 0 else nn.Tanh for i in range(len(layers))]
   105	            chains.append(lins)
   106	        depth = len(chains[0])
   107	        assert all(len(c) == depth for c in chains)
   108	        dev = chains[0][0].weight.device
   109	        self.n, self.kmax, self.depth = n, kmax, depth
   110	        self.total = sum(dims)
   111	        for j in range(depth - 1):             # batched hidden layers
   112	            din, dout = chains[0][j].in_features, chains[0][j].out_features
   113	            w = torch.zeros(n, din, dout)
   114	            b = torch.zeros(n, 1, dout)
   115	            for i, lins in enumerate(chains):
   116	                assert lins[j].in_features == din and lins[j].out_features == dout
   117	                w[i] = lins[j].weight.detach().float().cpu().t()
   118	                b[i, 0] = lins[j].bias.detach().float().cpu()
   119	            self.register_buffer(f'w{j}', w.to(dev), persistent=False)
   120	            self.register_buffer(f'b{j}', b.to(dev), persistent=False)
   121	        # last layer: out = 2*K_i, laid out [a | b] halves each padded to kmax
   122	        din = chains[0][-1].in_features
   123	        w = torch.zeros(n, din, 2 * kmax)
   124	        b = torch.zeros(n, 1, 2 * kmax)
