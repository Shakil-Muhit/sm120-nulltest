    25	logs_for() { case "$1" in C1|C2|C3|C1A|C1D|H) echo "graph_breaks,recompiles,perf_hints,cudagraphs" ;; *) echo "" ;; esac; }
    26	tmo_for()  { case "$1" in C1|C2|C3|C1A|C1D|H) echo "$T_COMPILE" ;; *) echo "$T_OTHER" ;; esac; }
    27	
    28	run_plain() {   # arm chunk tag [extra...]
