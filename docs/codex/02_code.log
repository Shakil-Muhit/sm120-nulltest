     1	#!/bin/bash
     2	# Pre-commit integrity gate. Exists because of two real incidents (both editor
     3	# paste-overs into open buffers, discovered 2026-09-01): analysis/traces.sh
     4	# (self-paste at :131, mtime Aug 31 — bash -n failed) and setup.sh (terminal
     5	# session pasted at :57 — shipped broken to the remote in commit 10452d1).
     6	#
     7	# Checks STAGED CONTENT (git show :path), not the worktree — what gets
     8	# committed is what gets checked. Raise-don't-warn: any hit blocks the commit
     9	# and names the offending file and line.
    10	#   1. every staged *.sh must parse        (bash -n)
    11	#   2. every staged *.py must parse        (python ast)
    12	#   3. NO staged file may contain terminal-paste artifacts (shell prompts) —
    13	#      the corruption class is format-agnostic, so ALL files are scanned.
    14	#      Sole exemption: docs/audit_log.md, which legitimately quotes incident
    15	#      material by design (see its header).
    16	set -u
    17	fail=0
    18	say() { echo "precommit: $*" >&2; }
    19	
    20	STAGED=$(git diff --cached --name-only --diff-filter=ACM)
    21	[ -z "$STAGED" ] && exit 0
    22	TMP=$(mktemp -d)
    23	trap 'rm -rf "$TMP"' EXIT
    24	
    25	while IFS= read -r f; do
    26	    blob="$TMP/staged_blob"
    27	    git show ":$f" > "$blob" 2>/dev/null || continue
    28	
    29	    case "$f" in
    30	        *.sh)
    31	            if ! err=$(bash -n "$blob" 2>&1); then
    32	                say "SYNTAX FAIL (bash -n) in staged $f:"
    33	                echo "$err" | sed "s|$blob|$f|g" >&2
    34	                fail=1
    35	            fi ;;
    36	        *.py)
    37	            if ! err=$(python3 -c 'import ast, sys
    38	ast.parse(open(sys.argv[1]).read(), filename=sys.argv[2])' "$blob" "$f" 2>&1); then
    39	                say "SYNTAX FAIL (ast.parse) in staged $f:"
    40	                echo "$err" >&2
    41	                fail=1
    42	            fi ;;
    43	    esac
    44	
    45	    case "$f" in docs/audit_log.md) continue ;; esac
    46	    # pattern assembled from split literals so this file never matches itself
    47	    ART='muhit@muhit''-pc|\(base\) [a-z_]+@|[a-z_][a-z0-9_]*@[a-zA-Z0-9-]+:[^ ]*\$ '
    48	    if hits=$(grep -nI -E "$ART" "$blob"); then
    49	        say "PASTE ARTIFACT (terminal-prompt material) in staged $f:"
    50	        echo "$hits" | sed "s|^|  $f:|" >&2
    51	        fail=1
    52	    fi
    53	done <<< "$STAGED"
