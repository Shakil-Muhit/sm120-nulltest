    63	def sdpa_costs(chunk):
    64	    T = FRAMES[chunk]
    65	    H, D, F = MODEL['heads'], MODEL['dim_head'], MODEL['bands']
    66	    out = {}
    67	    for axis, (B, N) in {'time': (F, T), 'freq': (T, F)}.items():
    68	        flops = 4.0 * B * H * N * N * D           # QK^T and PV, forward
    69	        bytes_ = 4 * B * H * N * D * 2            # q, k, v, o fp16
    70	        out[axis] = {'batch': B, 'seq': N, 'flops': flops, 'bytes': bytes_}
    71	    return out
    72	
