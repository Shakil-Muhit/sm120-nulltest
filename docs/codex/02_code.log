   142	def five_repeats(step, x, ctx, iters=50, repeats=5, nvtx_pass=False):
   143	    """Five repeats of the 5a block; min-of-medians + median spread; every
   144	    per-iteration list preserved; block wall timestamps for the clock log."""
   145	    blocks = []
   146	    for r in range(repeats):
   147	        t_start = time.time()
   148	        lat, thr = timed_run(step, x, ctx, iters, nvtx_pass=nvtx_pass)
   149	        t_end = time.time()
   150	        s = sorted(lat)
   151	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   152	                       'latency_median_ms': median(lat),
   153	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   154	                       'throughput_ms_per_pass': thr,
   155	                       'unix_start': t_start, 'unix_end': t_end})
   156	    meds = [b['latency_median_ms'] for b in blocks]
   157	    return {'blocks': blocks, 'latency_medians_ms': meds,
   158	            'min_of_medians_ms': min(meds),
   159	            'median_spread_ms': max(meds) - min(meds),
   160	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   161	            'serialization_delta_pct': [
   162	                (b['latency_median_ms'] - b['throughput_ms_per_pass'])
   163	                / b['throughput_ms_per_pass'] * 100.0 for b in blocks],
   164	            'iters_per_block': iters, 'repeats': repeats}
