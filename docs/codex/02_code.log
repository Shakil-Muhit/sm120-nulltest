     1	"""Multi-stream band-loop machinery for arms F and G (prereg arms table).
     2	
     3	Fork/join with CUDA events:
     4	
     5	    main stream ── record fork_event ──┬─ stream 0: bands 0, N, 2N, ...
     6	                                       ├─ stream 1: bands 1, N+1, ...
     7	                                       │      ...
     8	    main stream ◄─ wait join_event[i] ─┴─ stream N-1: record join_event[i]
     9	    main stream:   torch.stack(outs)
    10	
    11	Correctness is unaffected by stream count: band i always runs the band-i
    12	modules on its input slice, and outputs are collected in band order before the
    13	stack (prereg / session-owner requirement for arm F).
    14	
    15	The same object works eagerly (arm F, and arm G's warmup) and inside a CUDA
    16	Graph capture (arm G): cudaEventRecord / cudaStreamWaitEvent become graph
    17	nodes, so the recorded graph replays the fork/join stream structure.
    18	Allocator note: Tensor.record_stream() is the documented guard for tensors
    19	allocated on one stream and consumed on another; during graph capture it is
    20	skipped — capture uses the graph's private memory pool, whose blocks are not
    21	returned while the graph is alive, so the guard is unnecessary there.
    22	"""
    23	
    24	import torch
    25	
    26	
    27	class MultiStreamBandLoop:
    28	    """num_streams side streams + fork/join events, reused across iterations."""
    29	
    30	    def __init__(self, num_streams, device):
    31	        assert num_streams >= 1
    32	        self.num_streams = num_streams
    33	        self.streams = [torch.cuda.Stream(device=device) for _ in range(num_streams)]
    34	        self.fork_event = torch.cuda.Event()
    35	        self.join_events = [torch.cuda.Event() for _ in range(num_streams)]
    36	
    37	    def run(self, band_fns, parts):
    38	        """Run band_fns[i](parts[i]) with band i on stream i % num_streams.
    39	
    40	        Returns outputs in band order. Caller stacks them on the main stream.
    41	        """
    42	        assert len(band_fns) == len(parts)
    43	        main = torch.cuda.current_stream()
    44	        capturing = torch.cuda.is_current_stream_capturing()
    45	
    46	        # fork: every side stream orders itself after main's work so far
    47	        self.fork_event.record(main)
    48	        for st in self.streams:
    49	            st.wait_event(self.fork_event)
    50	
    51	        outs = [None] * len(band_fns)
    52	        for i, (fn, part) in enumerate(zip(band_fns, parts)):
    53	            st = self.streams[i % self.num_streams]
    54	            if not capturing:
    55	                # part is a view of the folded tensor (allocated on main);
    56	                # mark its storage as used on the side stream
    57	                part.record_stream(st)
    58	            with torch.cuda.stream(st):
    59	                outs[i] = fn(part)
    60	
    61	        # join: main waits for every side stream before consuming outputs
    62	        for j, st in enumerate(self.streams):
    63	            self.join_events[j].record(st)
    64	            main.wait_event(self.join_events[j])
    65	        if not capturing:
    66	            for out in outs:
    67	                # allocated on a side stream, consumed (stacked/freed) on main
    68	                out.record_stream(main)
    69	        return outs
    70	
    71	
    72	class MultiStreamBandSplit(torch.nn.Module):
    73	    """Drop-in replacement for frontend.BandSplit that runs the per-band
    74	    RMSNorm+Linear loop across streams. Holds the ORIGINAL BandSplit (same
    75	    parameter tensors — no copies), so weights match the eager reference.
    76	
    77	    band_fns: one callable per band, taking that band's input slice. Arm F
    78	    passes the stock nn.Sequential(RMSNorm, Linear) modules; arm G passes
    79	    fused closures built in common.py.
    80	    """
    81	
    82	    def __init__(self, orig_band_split, band_fns, loop):
    83	        super().__init__()
    84	        self.orig = orig_band_split          # keeps parameters registered
    85	        self.band_fns = band_fns
    86	        self.loop = loop
    87	
    88	    def forward(self, x):
    89	        parts = x.split(self.orig.dim_inputs, dim=-1)
    90	        outs = self.loop.run(self.band_fns, parts)
    91	        return torch.stack(outs, dim=-2)     # same as frontend.BandSplit.forward

