     1	#!/bin/bash
     2	# Fetch + sha256-verify the public MelBandRoformer checkpoint named in
     3	# configs/checkpoint.txt.
     4	#
     5	# checkpoint.txt format (FINAL — session-owner resolution 2026-08-16):
     6	#   lines starting with # are comments — purely documentation, no exceptions;
     7	#   then EXACTLY THREE data lines, in order:
     8	#     1. checkpoint URL
     9	#     2. sha256 of the checkpoint file
    10	#     3. model config path, relative to the root of the pinned ZFTurbo clone
    11	#        (escape hatch: a path that exists relative to THIS repo's root is
    12	#        accepted as a vendored config — configs are never URL-fetched)
    13	#   The config is transitively hash-pinned by the clone's commit SHA (git
    14	#   content-addressing), so it needs no separate hash.
    15	#
    16	# Called by setup.sh [6/6] and defensively by scripts/p8_full_trace.sh.
    17	# Behavior (session-owner spec):
    18	#   - download target ${CKPT_DIR:-~/work/ckpt} — env-overridable so a RunPod
    19	#     persistent volume can be mounted there and the download survives pods
    20	#   - skip download if the file exists AND the sha256 matches
    21	#   - re-download on mismatch; HARD-FAIL with a clear message if the hash
    22	#     check fails twice; never proceed silently on a bad hash
    23	#   - HARD-FAIL if line 3's path does not exist in the pinned clone (or,
    24	#     escape hatch, in this repo) after checkout
    25	#
    26	# On success writes $CKPT_DIR/manifest.env with the resolved absolute paths
    27	# (CKPT_FILE, CONFIG_FILE, MODEL_TYPE) for scripts/p8_full_trace.sh to source.
    28	# MODEL_TYPE is the constant 'mel_band_roformer', env-overridable.
    29	set -u
    30	
    31	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    32	CFG="$REPO_DIR/configs/checkpoint.txt"
    33	CKPT_DIR="${CKPT_DIR:-$HOME/work/ckpt}"
    34	MSST_DIR="${MSST_DIR:-$HOME/work/msst}"
    35	MODEL_TYPE="${MODEL_TYPE:-mel_band_roformer}"
    36	
    37	[ -f "$CFG" ] || { echo "FATAL: $CFG missing"; exit 1; }
    38	
    39	# strip comments and blank lines -> the data lines, in order
    40	mapfile -t DATA < <(grep -v '^[[:space:]]*#' "$CFG" | grep '[^[:space:]]' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    41	if [ "${#DATA[@]}" -ne 3 ]; then
    42	    echo "FATAL: configs/checkpoint.txt must contain EXACTLY three data lines"
    43	    echo "       (URL / sha256 / config path relative to the pinned clone),"
    44	    echo "       found ${#DATA[@]}. Comment lines start with #."
    45	    exit 1
    46	fi
    47	CKPT_URL="${DATA[0]}"
    48	CKPT_SHA256="$(echo "${DATA[1]}" | tr 'A-F' 'a-f')"
    49	CONFIG_REL="${DATA[2]}"
    50	
    51	case "$CKPT_URL" in
    52	    http://*|https://*) ;;
    53	    *) echo "FATAL: checkpoint.txt line 1 is not an http(s) URL: '$CKPT_URL'"; exit 1 ;;
    54	esac
    55	case "$CKPT_SHA256" in
    56	    *[!0-9a-f]*|'') echo "FATAL: checkpoint.txt line 2 is not a sha256: '$CKPT_SHA256'"; exit 1 ;;
    57	esac
    58	[ "${#CKPT_SHA256}" -eq 64 ] \
    59	    || { echo "FATAL: checkpoint.txt line 2 must be 64 hex chars (got ${#CKPT_SHA256})"; exit 1; }
    60	case "$CONFIG_REL" in
    61	    /*) echo "FATAL: checkpoint.txt line 3 must be RELATIVE to the pinned clone: '$CONFIG_REL'"; exit 1 ;;
    62	esac
    63	
    64	mkdir -p "$CKPT_DIR"
    65	
    66	sha_ok() {  # $1 file  $2 expected sha256
    67	    [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d' ' -f1)" = "$2" ]
    68	}
    69	
    70	fetch_verify() {  # $1 url  $2 expected sha256  $3 dest — 2 attempts, then FATAL
    71	    local url="$1" sha="$2" dest="$3" attempt
    72	    if sha_ok "$dest" "$sha"; then
    73	        echo "cached, sha256 verified: $dest"
    74	        return 0
    75	    fi
    76	    for attempt in 1 2; do
    77	        [ -f "$dest" ] && { echo "sha256 mismatch on $dest — re-downloading"; rm -f "$dest"; }
    78	        echo "downloading (attempt $attempt): $url"
    79	        wget -q --show-progress -O "$dest" "$url" || rm -f "$dest"
    80	        if sha_ok "$dest" "$sha"; then
    81	            echo "downloaded, sha256 verified: $dest"
    82	            return 0
    83	        fi
    84	    done
    85	    rm -f "$dest"
    86	    echo "FATAL: sha256 verification failed twice for"
    87	    echo "       $url"
    88	    echo "       expected $sha — check configs/checkpoint.txt against the"
    89	    echo "       published hash. NOT proceeding on a bad hash."
    90	    exit 1
    91	}
    92	
    93	# strip any ?query-string before taking the basename (hugging-face style URLs)
    94	CKPT_FILE="$CKPT_DIR/$(basename "${CKPT_URL%%\?*}")"
    95	fetch_verify "$CKPT_URL" "$CKPT_SHA256" "$CKPT_FILE"
    96	
    97	# config: pinned clone first; vendored-in-this-repo escape hatch second
    98	if [ -f "$MSST_DIR/$CONFIG_REL" ]; then
    99	    CONFIG_FILE="$MSST_DIR/$CONFIG_REL"
   100	elif [ -f "$REPO_DIR/$CONFIG_REL" ]; then
   101	    CONFIG_FILE="$REPO_DIR/$CONFIG_REL"
   102	    echo "note: config resolved from THIS repo (vendored escape hatch): $CONFIG_FILE"
   103	else
   104	    echo "FATAL: config path from checkpoint.txt line 3 not found:"
   105	    echo "       neither $MSST_DIR/$CONFIG_REL"
   106	    echo "       nor     $REPO_DIR/$CONFIG_REL"
   107	    echo "       Is the msst clone checked out at the pinned commit (setup.sh"
   108	    echo "       [5/6])? Does the path exist at that commit?"
   109	    exit 1
   110	fi
   111	
   112	{   # values quoted: the manifest is sourced by p8_full_trace.sh and paths
   113	    # (CKPT_DIR override) may contain spaces
   114	    echo "CKPT_FILE=\"$CKPT_FILE\""
   115	    echo "CONFIG_FILE=\"$CONFIG_FILE\""
   116	    echo "MODEL_TYPE=\"$MODEL_TYPE\""
   117	} > "$CKPT_DIR/manifest.env"
   118	echo "manifest written: $CKPT_DIR/manifest.env"
