   106	        key = f"{m['pair'][0]}_vs_{m['pair'][1]}_c{m['chunk']}"
   107	        pairs.setdefault(key, []).append({'tag': m['tag'], 'status': m['status'],
   108	                                          'delta': m.get('matched_delta_ms'),
   109	                                          'arms': {k: {kk: v.get(kk) for kk in ('min_of_medians_ms', 'headline_eligible', 'build_status')}
   110	                                                   for k, v in (m.get('arms') or {}).items()}})
   111	    if pairs:
   112	        print('\nmatched pairs (median over blocks of a - b, ms):')
   113	        for key, lst in sorted(pairs.items()):
   114	            for e in lst:
   115	                d = e['delta']
   116	                print(f"  {key} {e['tag']}: {e['status']} "
   117	                      + (f"delta {d['median']:+.4f} ms ({d['median_pct_of_a']:+.2f}% of a) range [{d['min']:+.4f}, {d['max']:+.4f}]" if d else 'no delta'))
   118	    # legacy per-round view of the separate matrix runs
   119	    matched = {}
   120	    for arm in ('C1', 'C3', 'C1D', 'C1A'):
   121	        for tag, r in runs.get((arm, 352800), {}).items():
   122	            if RESTART_RE.match(tag) and r.get('min_of_medians_ms'):
   123	                matched.setdefault(tag, {})[arm] = r['min_of_medians_ms']
   124	    if matched:
   125	        print('\nmatched rounds @352800 (min-of-medians ms):')
   126	        for tag in sorted(matched):
   127	            row = matched[tag]
   128	            tax = (row['C1'] - row['C3']) if ('C1' in row and 'C3' in row) else None
   129	            print(f"  {tag}: " + ', '.join(f'{a}={v:.4f}' for a, v in row.items())
