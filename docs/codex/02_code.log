    75	def time_chain(launch, n, capture, label):
    76	    for _ in range(WARMUP):
    77	        launch()
    78	    torch.cuda.synchronize()
    79	    graph = None
    80	    if capture:
    81	        s = torch.cuda.Stream()
    82	        s.wait_stream(torch.cuda.current_stream())
    83	        with torch.cuda.stream(s):
    84	            launch()
    85	        torch.cuda.current_stream().wait_stream(s)
    86	        torch.cuda.synchronize()
    87	        graph = torch.cuda.CUDAGraph()
    88	        with torch.cuda.graph(graph):
    89	            launch()
    90	        graph.replay()
    91	        torch.cuda.synchronize()
    92	    times = []
    93	    torch.cuda.nvtx.range_push(label)
    94	    for _ in range(REPEATS):
    95	        e0 = torch.cuda.Event(enable_timing=True)
    96	        e1 = torch.cuda.Event(enable_timing=True)
    97	        e0.record()
    98	        if graph is not None:
    99	            graph.replay()
   100	        else:
   101	            launch()
   102	        e1.record()
   103	        torch.cuda.synchronize()
   104	        times.append(e0.elapsed_time(e1) * 1e3)      # us
   105	    torch.cuda.nvtx.range_pop()
   106	    return {'chain_us_median': statistics.median(times),
   107	            'chain_us_min': min(times), 'chain_us_max': max(times),
   108	            'per_launch_us': statistics.median(times) / n, 'n': n, 'repeats': REPEATS}
   109	
   110	
   111	def fit(points):
   112	    """least squares T = a + b*N over (N, T_median) points"""
   113	    if len(points) < 2:
   114	        return None
   115	    xs = [p[0] for p in points]
   116	    ys = [p[1] for p in points]
   117	    mx, my = sum(xs) / len(xs), sum(ys) / len(ys)
   118	    sxx = sum((x - mx) ** 2 for x in xs)
   119	    b = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / sxx if sxx else None
   120	    return {'slope_us_per_node': b, 'intercept_us': (my - b * mx) if b is not None else None,
   121	            'points': points}
