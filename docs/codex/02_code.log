     1	"""Attention backend microbenchmark (plan 1.5; prereg_amendments.md §5).
     2	
     3	SDPA at the model's shapes, fp16, forward only, contiguous (b, h, n, d)
     4	inputs (the model's flash inputs are rotary outputs, contiguous):
     5	  time-axis : batch = F bands = 60, seq = T frames, heads 8, dim_head 64
     6	  freq-axis : batch = T frames, seq = 60
     7	at T = 801 (352800) and T = 11 (4410). Backends: flash, efficient (mem-
     8	efficient), cudnn, math via torch.nn.attention.sdpa_kernel. Timing: CUDA
     9	graph replay of BLOCK launches, events, median of REPEATS (device time).
    10	Output: best backend per axis and the ratio to the backend the model actually
    11	uses (flash, per Attend's cuda_config and the C3 trace).
    12	"""
    13	
    14	import argparse
    15	import json
    16	import statistics
    17	import traceback
    18	
    19	import torch
    20	import torch.nn.functional as F
    21	from torch.nn.attention import SDPBackend, sdpa_kernel
    22	
    23	BLOCK = 20
    24	REPEATS = 20
    25	FRAMES = {352800: 801, 4410: 11}
    26	BACKENDS = {'flash': SDPBackend.FLASH_ATTENTION, 'efficient': SDPBackend.EFFICIENT_ATTENTION,
    27	            'cudnn': SDPBackend.CUDNN_ATTENTION, 'math': SDPBackend.MATH}
    28	
    29	
    30	def bench(q, k, v, backend):
    31	    def fn():
    32	        with sdpa_kernel([backend]):
    33	            return F.scaled_dot_product_attention(q, k, v)
    34	    for _ in range(5):
    35	        fn()
    36	    torch.cuda.synchronize()
    37	    s = torch.cuda.Stream()
    38	    s.wait_stream(torch.cuda.current_stream())
    39	    with torch.cuda.stream(s):
    40	        fn()
    41	    torch.cuda.current_stream().wait_stream(s)
    42	    torch.cuda.synchronize()
    43	    g = torch.cuda.CUDAGraph()
    44	    with torch.cuda.graph(g):
    45	        for _ in range(BLOCK):
    46	            fn()
    47	    times = []
    48	    for _ in range(REPEATS):
    49	        e0 = torch.cuda.Event(enable_timing=True)
    50	        e1 = torch.cuda.Event(enable_timing=True)
    51	        e0.record()
    52	        g.replay()
    53	        e1.record()
    54	        torch.cuda.synchronize()
    55	        times.append(e0.elapsed_time(e1) * 1e3 / BLOCK)
    56	    return statistics.median(times), min(times), max(times)
    57	
    58	
    59	def main():
    60	    ap = argparse.ArgumentParser()
    61	    ap.add_argument('--out', required=True)
    62	    args = ap.parse_args()
    63	    assert torch.cuda.is_available()
    64	    gen = torch.Generator(device='cpu').manual_seed(3)
    65	    result = {'device': torch.cuda.get_device_name(0), 'torch': torch.__version__,
    66	              'dtype': 'float16', 'heads': 8, 'dim_head': 64, 'bands': 60,
    67	              'model_backend': 'flash (Attend cuda_config=(True,False,False))', 'cases': {}}
    68	    for chunk, T in FRAMES.items():
    69	        for axis, (b, n) in {'time': (60, T), 'freq': (T, 60)}.items():
    70	            shape = (b, 8, n, 64)
    71	            q, k, v = (torch.randn(*shape, generator=gen).to('cuda', torch.float16)
    72	                       for _ in range(3))
    73	            case = {'chunk': chunk, 'axis': axis, 'batch': b, 'seq': n, 'backends': {}}
    74	            with torch.no_grad():
    75	                ref = F.scaled_dot_product_attention(q.float(), k.float(), v.float())
    76	                for name, be in BACKENDS.items():
    77	                    try:
    78	                        with sdpa_kernel([be]):
    79	                            out = F.scaled_dot_product_attention(q, k, v)
    80	                        err = float((out.float() - ref).abs().max())
    81	                        med, mn, mx = bench(q, k, v, be)
    82	                        case['backends'][name] = {'us_median': med, 'us_min': mn, 'us_max': mx,
    83	                                                  'max_abs_err_vs_fp32_math': err, 'status': 'ok'}
    84	                        print(f'[attn] c{chunk} {axis} {name}: {med:.2f} us (err {err:.2e})')
    85	                    except Exception as e:
    86	                        case['backends'][name] = {'status': 'UNAVAILABLE',
    87	                                                  'reason': f'{type(e).__name__}: {e}'[:300]}
    88	                        print(f'[attn] c{chunk} {axis} {name}: UNAVAILABLE ({type(e).__name__})')
    89	                        torch.cuda.synchronize()
    90	            ok = {k2: v2['us_median'] for k2, v2 in case['backends'].items() if v2['status'] == 'ok'}
    91	            if ok:
    92	                best = min(ok, key=ok.get)
    93	                case['best_backend'] = best
    94	                case['best_us'] = ok[best]
    95	                case['model_backend_us'] = ok.get('flash')
    96	                case['ratio_best_over_model'] = (ok[best] / ok['flash']) if 'flash' in ok else None
    97	            result['cases'][f'c{chunk}_{axis}'] = case
    98	    with open(args.out, 'w') as f:
    99	        json.dump(result, f, indent=1)
   100	    print(f'-> {args.out}')
   101	
   102	
   103	if __name__ == '__main__':
   104	    main()

