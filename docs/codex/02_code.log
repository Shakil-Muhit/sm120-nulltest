    44	def settle_compile(step, x, ctx, max_iters=60, consecutive=5):
    45	    """Run until torch._dynamo counters are unchanged for `consecutive`
    46	    passes (sm120 settle_compile; str-keyed snapshot)."""
    47	    import torch._dynamo.utils as dynamo_utils
    48	
    49	    def snap():
    50	        return {str(k): {str(kk): int(vv) for kk, vv in v.items()}
    51	                for k, v in dynamo_utils.counters.items()}
    52	
    53	    t0 = time.perf_counter()
    54	    prev, stable, it = snap(), 0, 0
    55	    with torch.no_grad(), ctx():
    56	        while stable < consecutive and it < max_iters:
    57	            step(x)
    58	            it += 1
    59	            cur = snap()
    60	            stable = stable + 1 if cur == prev else 0
    61	            prev = cur
    62	    torch.cuda.synchronize()
    63	    return {'settle_iters': it, 'settle_stable_tail': stable,
    64	            'settle_capped': stable < consecutive,
    65	            'settle_wall_s': round(time.perf_counter() - t0, 3),
    66	            'dynamo_counters': prev}
    67	
