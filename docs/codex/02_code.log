    79	def main():
    80	    ap = argparse.ArgumentParser()
    81	    ap.add_argument('--evidence-dir', default=os.path.join(REPO_ROOT, 'evidence'))
    82	    args = ap.parse_args()
    83	    runs = load(args.evidence_dir)
    84	    cells = {k: cell(v) for k, v in runs.items()}
    85	    print('| arm | chunk | eligible/found | tier | validation | SDR gate (mean ΔSDR dB) | headline | ms | restart spread | best thr ms | scope / mode / breaks |')
    86	    print('|---|---|---|---|---|---|---|---|---|---|---|')
    87	    for chunk in CHUNKS:
