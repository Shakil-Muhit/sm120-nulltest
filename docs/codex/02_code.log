    91	                continue
    92	            extra = ' '.join(x for x in ('/'.join(s for s in c['capture_scope'] if s != 'None'),
    93	                                          '/'.join(s for s in c['compile_mode'] if s != 'None'),
    94	                                          'breaks=' + '/'.join(c['graph_breaks']) if c['graph_breaks'] != ['None'] else '')
    95	                             if x)
    96	            print(f"| {arm} | {chunk} | {c['n_restarts_eligible']}/{c['n_restarts_found']} | "
    97	                  f"{'/'.join(c['tier'])} | {'/'.join(c['validation'])} | "
    98	                  f"{'/'.join(c['sdr_gate'])} ({fmt(c['mean_delta_sdr_ref_db'], '+.3f')}) | "
    99	                  f"{c['headline_status']} | {fmt(c['headline_ms'])} | {fmt(c['restart_spread_ms'])} | "
   100	                  f"{fmt(c['throughput_best_ms'])} | {extra} |")
   101	    # plan 1.2: matched block-alternation pairs (fullmodel/matched_run.py)
   102	    pairs = {}
   103	    for path in sorted(glob.glob(os.path.join(args.evidence_dir, 'matched_*.json'))):
   104	        with open(path) as f:
