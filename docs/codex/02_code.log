    23	def load(evidence_dir):
    24	    runs = {}
    25	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'full_*.json'))):
    26	        with open(path) as f:
    27	            r = json.load(f)
    28	        runs.setdefault((r['arm'], r['chunk']), {})[r['tag']] = r
    29	    return runs
