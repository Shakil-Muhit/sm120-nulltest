    38	    ckpt_ns = argparse.Namespace(
    39	        start_check_point=ckpt, model_type=model_type,
    40	        lora_checkpoint='', lora_checkpoint_loralib='')
    41	    checkpoint = torch.load(ckpt, weights_only=False, map_location='cpu')
    42	    load_start_checkpoint(ckpt_ns, model, checkpoint, type_='inference')
