   174	
   175	def capture_graph(fn, example, warmup_iters=3):
   176	    """PREREG graphs mechanics: static I/O buffers, warmup on a side stream,
   177	    capture OUTSIDE the timed region (this runs at build time; timed_run is
   178	    called later). Pattern follows the torch CUDA Graphs docs.
   179	
   180	    Returns (graph, static_in, static_out). Raises on capture failure —
   181	    build_arm_step() catches and falls back per prereg P4.
   182	    """
   183	    static_in = example.detach().clone()     # private contiguous input buffer
   184	    side = torch.cuda.Stream()
   185	    side.wait_stream(torch.cuda.current_stream())
   186	    with torch.cuda.stream(side), torch.no_grad():
   187	        for _ in range(warmup_iters):
   188	            fn(static_in)
   189	    torch.cuda.current_stream().wait_stream(side)
   190	    torch.cuda.synchronize()
   191	
   192	    graph = torch.cuda.CUDAGraph()
   193	    with torch.no_grad(), torch.cuda.graph(graph):
   194	        static_out = fn(static_in)
   195	    return graph, static_in, static_out
