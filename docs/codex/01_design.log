    33	def settle_compile(step, x, autocast_ctx, max_iters=60, consecutive=5):
    34	    """Run until recompilation stops: torch._dynamo counters unchanged for
    35	    `consecutive` passes. COPIED from sm120-nulltest@a997e27
    36	    arms/common.py::settle_compile (str-keyed snapshot included)."""
    37	    import torch._dynamo.utils as dynamo_utils
    38	
    39	    def snap():
    40	        return {str(k): {str(kk): int(vv) for kk, vv in v.items()}
    41	                for k, v in dynamo_utils.counters.items()}
    42	
    43	    t0 = time.perf_counter()
    44	    prev, stable, it = snap(), 0, 0
    45	    with torch.no_grad(), autocast_ctx():
    46	        while stable < consecutive and it < max_iters:
    47	            step(x)
    48	            it += 1
    49	            cur = snap()
    50	            stable = stable + 1 if cur == prev else 0
    51	            prev = cur
    52	    torch.cuda.synchronize()
    53	    return {'settle_iters': it, 'settle_stable_tail': stable,
    54	            'settle_capped': stable < consecutive,
    55	            'settle_wall_s': round(time.perf_counter() - t0, 3),
    56	            'dynamo_counters': prev}
