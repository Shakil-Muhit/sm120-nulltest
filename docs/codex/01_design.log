   189	
   190	    # the public repo's own construction path — no local model code
   191	    sys.path.insert(0, args.msst_dir)
   192	    from utils.settings import get_model_from_config
   193	    from utils.model_utils import load_start_checkpoint
   194	
   195	    model, config = get_model_from_config(args.model_type, args.config)
   196	    # mirrors the public repo's inference.py checkpoint-load lines exactly
   197	    ckpt_ns = argparse.Namespace(
