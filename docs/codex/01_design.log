    73	@triton.jit
    74	def rms_fused_kernel(x_ptr, out_ptr, ncols, stride_x, stride_out, gamma_ptr, scale, BLOCK_SIZE:tl.constexpr):
    75	    pid = tl.program_id(axis = 0)
    76	    x_ptrs = x_ptr + pid*stride_x + tl.arange(0, BLOCK_SIZE)
    77	    out_ptrs = out_ptr + pid*stride_out + tl.arange(0, BLOCK_SIZE)
    78	    mask = tl.arange(0, BLOCK_SIZE) < ncols
    79	
    80	    row = tl.load(x_ptrs, mask = mask, other = 0)
    81	    gamma = tl.load(gamma_ptr + tl.arange(0, BLOCK_SIZE), mask = mask, other = 0)
    82	    row_squared_sum = tl.maximum(1e-12,tl.sqrt(tl.sum(row*row, axis = 0)))
    83	    row_out = gamma * scale * row / row_squared_sum
    84	    tl.store(out_ptrs, row_out, mask = mask)
    85	
    86	
    87	def rms_fused(x, gamma, scale):
    88	    x = x.squeeze(0)
    89	    out = torch.empty_like(x)
    90	    n_rows, n_cols = x.shape
    91	    stride_0 = x.stride(0)
    92	    stride_1 = out.stride(0)
    93	    rms_fused_kernel[(n_rows,)](x, out, n_cols, stride_0, stride_1, gamma, scale, triton.next_power_of_2(n_cols))
    94	    # print('='*30, x.shape)
    95	    return out.unsqueeze(0)
