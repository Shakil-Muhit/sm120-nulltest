   422	# --------------------------------------------------------- result schema ----
   423	
   424	def env_fingerprint():
   425	    try:
   426	        driver = subprocess.run(
   427	            ['nvidia-smi', '--query-gpu=driver_version', '--format=csv,noheader'],
   428	            capture_output=True, text=True, timeout=10).stdout.strip().splitlines()[0]
   429	    except Exception:
   430	        driver = 'unavailable'
   431	    import triton
   432	    return {'torch': torch.__version__,
   433	            'triton': triton.__version__,
   434	            'cuda_build': torch.version.cuda,
   435	            'driver': driver,
   436	            'gpu': torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'none',
   437	            'capability': list(torch.cuda.get_device_capability(0)) if torch.cuda.is_available() else None,
   438	            'python': platform.python_version(),
   439	            'hostname': platform.node()}
   440	
   441	
   442	def result_json(arm, chunk, tag, iters, latency_ms, throughput_ms, validation,
   443	                info, settle, status, error=None):
   444	    """One JSON per run — the prereg result schema (session-owner list):
   445	    arm, chunk, versions, GPU, timestamp, iters, per-iter list, median/min/max,
   446	    validation status, capture scope, stream count, notes; plus the 5a fields
   447	    latency_*/throughput_ms_per_pass/serialization_delta_pct."""
   448	    med = mn = mx = delta = None
   449	    if latency_ms:
   450	        s = sorted(latency_ms)
   451	        n = len(s)
   452	        med = s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2
   453	        mn, mx = s[0], s[-1]
   454	        if throughput_ms:
   455	            delta = (med - throughput_ms) / throughput_ms * 100.0
   456	    return {
   457	        'arm': arm,
   458	        'chunk': chunk,
   459	        'tag': tag,
   460	        'status': status,                        # VALID | INVALID
   461	        'error': error,
   462	        'timestamp': datetime.now(timezone.utc).isoformat(),
   463	        'argv': sys.argv,
   464	        'env': env_fingerprint(),
   465	        'torch_logs_env': os.environ.get('TORCH_LOGS'),
   466	        'iters': iters,
   467	        'latency_ms_per_iter': latency_ms,       # PREREG: per-iteration list, always
   468	        'latency_median_ms': med,
   469	        'latency_min_ms': mn,
   470	        'latency_max_ms': mx,
   471	        'throughput_ms_per_pass': throughput_ms, # PREREG 5a secondary
   472	        'serialization_delta_pct': delta,        # PREREG 5a escalation input
   473	        'validation': validation,
   474	        'capture_scope': info.get('capture_scope'),
   475	        'stream_count': info.get('stream_count'),
   476	        'compile_mode': info.get('compile_mode'),
   477	        'settle': settle,
   478	        'notes': info.get('notes', []),
   479	    }

