   116	class RMSNorm(nn.Module):
   117	    def __init__(self, dim):
   118	        super().__init__()
   119	        self.scale = dim ** 0.5
   120	        self.gamma = nn.Parameter(torch.ones(dim))
   121	
   122	    def forward(self, x):
   123	        # return F.normalize(x, dim=-1) * self.scale * self.gamma
   124	        ret_torch = F.normalize(x, dim=-1) * self.scale * self.gamma
   125	        # ret_my_kernel = rms_fused(x, self.gamma, self.scale)
   126	        # assert torch.allclose(ret_torch, ret_my_kernel, atol=1e-5, rtol=1e-5)
   127	        # print(torch.allclose(ret_torch, ret_my_kernel, atol=1, rtol=1))
   128	        # print(ret_my_kernel,' ', ret_torch)
   129	        return ret_torch
