    42	    p.add_argument('--chunk', required=True, type=int, choices=list(common.CHUNKS),
    43	                   help='PREREG regimes only: 352800 (8 s) or 4410 (100 ms)')
    44	    p.add_argument('--iters', type=int, default=common.DEFAULT_ITERS,
    45	                   help='timed iterations per block (PREREG: >= 50)')
    46	    p.add_argument('--warmup', type=int, default=common.DEFAULT_WARMUP,
    47	                   help='warmup passes for non-compile arms')
    48	    p.add_argument('--streams', type=int, default=common.DEFAULT_STREAMS,
    49	                   help='stream count for arms F/G')
    50	    p.add_argument('--tag', default='adhoc',
