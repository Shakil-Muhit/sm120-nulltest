   137	def compare_outputs(out, ref, tier):
   138	    """Gate-02 finding 9 hardening: torch.allclose broadcasts and treats
   139	    matching infs as equal — require exact shape, finiteness of BOTH sides,
   140	    and report an explicit reason on failure."""
   141	    rtol, atol = TIERS[tier]
   142	    out = out.float()
   143	    ref = ref.float()
   144	    rec = {'ok': False, 'rtol': rtol, 'atol': atol,
   145	           'shape_out': list(out.shape), 'shape_ref': list(ref.shape)}
   146	    if out.shape != ref.shape:
   147	        rec['reason'] = 'shape mismatch'
   148	        rec['max_abs_diff'] = None
   149	        return rec
   150	    fin_out = bool(torch.isfinite(out).all())
   151	    fin_ref = bool(torch.isfinite(ref).all())
   152	    rec['finite_out'], rec['finite_ref'] = fin_out, fin_ref
   153	    rec['max_abs_diff'] = (float((out - ref).abs().max().item())
   154	                           if fin_out and fin_ref else None)
   155	    if not (fin_out and fin_ref):
   156	        rec['reason'] = 'non-finite values present'
   157	        return rec
   158	    rec['ok'] = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   159	    if not rec['ok']:
   160	        rec['reason'] = 'tolerance exceeded'
   161	    return rec
