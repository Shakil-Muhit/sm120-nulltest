    78	def backend_list(config):
    79	    # Exact ordering/default from torch 2.8.0 torch/backends/cuda/__init__.py
    80	    # sdp_kernel. The old API's unmentioned enable_cudnn parameter is True.
    81	    backend = torch.nn.attention.SDPBackend
    82	    result = []
    83	    if config.enable_flash:
    84	        result.append(backend.FLASH_ATTENTION)
    85	    if config.enable_mem_efficient:
    86	        result.append(backend.EFFICIENT_ATTENTION)
    87	    if config.enable_math:
    88	        result.append(backend.MATH)
    89	    result.append(backend.CUDNN_ATTENTION)
    90	    return result
    91	
    92	
    93	def backend_state():
    94	    cuda = torch.backends.cuda
    95	    return {name: bool(getattr(cuda, name + '_sdp_enabled')())
    96	            for name in ('flash', 'math', 'mem_efficient', 'cudnn')}
    97	
    98	
    99	def verify_backend_context(config):
   100	    assert inspect.signature(torch.backends.cuda.sdp_kernel).parameters[
   101	        'enable_cudnn'].default is True
   102	    before = backend_state()
   103	    with torch.backends.cuda.sdp_kernel(**config._asdict()):
   104	        original = backend_state()
   105	    assert backend_state() == before
   106	    with torch.nn.attention.sdpa_kernel(backend_list(config)):
   107	        replacement = backend_state()
   108	    assert backend_state() == before
   109	    assert original == replacement
   110	    return {'original': original, 'replacement': replacement,
   111	            'state_restored': True}
   112	
   113	
   114	def install(model):
   115	    from models.bs_roformer.attend import Attend
   116	    verification = verify_source(Attend.flash_attn)
   117	    pending = []
   118	    backend_checks = {}
   119	    for name, module in model.named_modules():
   120	        if type(module) is Attend:
   121	            assert module.flash and not module.training, name
   122	            assert module.flash_attn.__func__ is Attend.flash_attn, name
   123	            assert 'flash_attn' not in module.__dict__, name
   124	            assert not hasattr(module, '_c3_cuda_backends'), name
   125	            assert not hasattr(module, '_c3_cpu_backends'), name
   126	            for config in (module.cpu_config, module.cuda_config):
   127	                assert config is not None, name
   128	                assert tuple(config._fields) == (
   129	                    'enable_flash', 'enable_math', 'enable_mem_efficient'), name
   130	                assert all(isinstance(value, bool) for value in config), name
   131	                backend_checks[str(tuple(config))] = verify_backend_context(config)
   132	            pending.append((name, module, types.MethodType(flash_attn, module)))
   133	    assert len(pending) == 12, f'expected 12 Attend modules, got {len(pending)}'
   134	    applied = []
   135	    try:
   136	        for name, module, method in pending:
   137	            applied.append(module)
   138	            module._c3_cpu_backends = backend_list(module.cpu_config)
   139	            module._c3_cuda_backends = backend_list(module.cuda_config)
   140	            module.flash_attn = method
   141	    except Exception:
   142	        for module in applied:
   143	            for attr in ('flash_attn', '_c3_cpu_backends', '_c3_cuda_backends'):
   144	                if attr in module.__dict__:
   145	                    delattr(module, attr)
   146	        raise
   147	    return {**verification, 'modules': [name for name, _, _ in pending],
   148	            'count': len(pending), 'backend_context_checks': backend_checks,
   149	            'cuda_backend_order': [str(x) for x in pending[0][1]._c3_cuda_backends],
