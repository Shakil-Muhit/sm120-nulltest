   198	def _capture_with_fallback(fe, x_example, info):
   199	    """B/E/G shared protocol. Try whole-forward capture; on failure (prereg P4
   200	    predicts the complex STFT breaks it) fall back to capturing the band_split
   201	    stage only. The scope that actually captured is RECORDED in the result
   202	    JSON (info['capture_scope']) and stated in the log."""
   203	    try:
   204	        graph, static_in, static_out = capture_graph(fe, x_example)
   205	        info['capture_scope'] = 'whole_forward'
   206	
   207	        def step(x):
   208	            static_in.copy_(x)               # AUDIT-MAP[2]: fresh input each replay
   209	            graph.replay()
   210	            return static_out
   211	        return step
   212	    except Exception:
   213	        info['notes'].append(
   214	            'whole-forward capture FAILED (prereg P4 predicted this at the '
   215	            'complex STFT); falling back to band_split-only capture. '
   216	            'Traceback:\n' + traceback.format_exc())
   217	        # a failed capture can leave the ambient stream pointing at the graph
   218	        # ctx's internal capture stream (torch 2.8: graph.__exit__ ends the
   219	        # capture BEFORE restoring the stream, with no try/finally) — restore
   220	        # the default stream before building the fallback
   221	        torch.cuda.set_stream(torch.cuda.default_stream())
   222	        torch.cuda.synchronize()
   223	
   224	    # fallback: find the folded tensor's shape with one recorded eager pass,
   225	    # then capture ONLY the current band_split module (stock, fused, or
   226	    # multi-stream — whatever this arm installed)
   227	    band_split = fe.band_split
   228	    recorder = RecordingBandSplit(band_split)
   229	    fe.band_split = recorder
   230	    with torch.no_grad():
   231	        fe(x_example)
   232	    folded = recorder.last_input.detach().clone()
   233	    fe.band_split = band_split
   234	
   235	    graph, static_in, static_out = capture_graph(band_split, folded)
   236	    fe.band_split = ReplayBandSplit(band_split, graph, static_in, static_out)
   237	    info['capture_scope'] = 'band_split_only'
   238	    return lambda x: fe(x)
