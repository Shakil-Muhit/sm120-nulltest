    94	def build_stock_frontend(device):
    95	    """manual_seed(0) then FrontEnd(): identical weights for every arm model
    96	    and for the eager reference (run_arm.py asserts state_dict equality)."""
    97	    torch.manual_seed(0)
    98	    return frontend.FrontEnd().to(device).eval()
