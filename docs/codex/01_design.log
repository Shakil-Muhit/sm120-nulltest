   199	        lora_checkpoint='', lora_checkpoint_loralib='')
   200	    checkpoint = torch.load(args.ckpt, weights_only=False, map_location='cpu')
   201	    load_start_checkpoint(ckpt_ns, model, checkpoint, type_='inference')
   202	    model = model.cuda().eval()
   203	
   204	    # Precision: mirror the public repo's OWN inference path — demix() in
   205	    # utils/model_utils.py (lines 137-139 at the pinned commit) runs the
   206	    # forward inside torch.cuda.amp.autocast(enabled=config.training.use_amp),
   207	    # default True. Plain fp32 would ABORT here: the public config sets
   208	    # flash_attn=true and attend.py forces the flash SDPA backend, which has
   209	    # no fp32 kernels ("No available kernel" — 2026-08-17 smoke finding).
   210	    use_amp = bool(getattr(getattr(config, 'training', object()), 'use_amp', True))
   211	
   212	    stereo = bool(getattr(model, 'stereo', False))
   213	    x = torch.randn(1, 2 if stereo else 1, args.chunk, device='cuda')
   214	    print(f'[p8] model={args.model_type} stereo={stereo} '
   215	          f'input={tuple(x.shape)} warmup={args.warmup} iters={args.iters} '
   216	          f'use_amp={use_amp} (repo inference default)')
   217	
   218	    handles, boundary_mode = install_nvtx_hooks(model)
   219	    print(f'[p8] NVTX boundary mode: {boundary_mode}')
   220	
   221	    wall_ms = []
