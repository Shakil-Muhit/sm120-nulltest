   128	# Two-tier validation gate — values from sm120-nulltest@a997e27
   129	# arms/common.py::VAL_TOL, per the handoff section 2:
   130	#   loose (compiled vs eager; Inductor regenerates kernels): rtol 1e-2, atol 1e-3
   131	#   tight (patched vs compiled baseline; views change no arithmetic):
   132	#         rtol 1e-4, atol 1e-5 — a looser result is a finding, not a knob.
   133	TIERS = {'loose': (1e-2, 1e-3), 'tight': (1e-4, 1e-5)}
   134	VAL_SEEDS = (4242, 1337, 90210)   # handoff section 2
   135	
