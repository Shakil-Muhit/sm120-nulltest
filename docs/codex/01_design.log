    34	              'graph_break_count': breaks, 'unimplemented_count': unsupported,
    35	              'suppress_errors': torch._dynamo.config.suppress_errors,
    36	              'TORCH_LOGS': os.environ.get('TORCH_LOGS'), 'counters': snapshot}
    37	    write_json(out / f'graph_gate_{name}.json', record)
    38	    if not ok:
    39	        raise SystemExit('C3 graph-break gate FAILED; dependent work stopped')
