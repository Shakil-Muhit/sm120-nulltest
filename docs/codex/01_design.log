   110	# ---------------------------------------------- band_split substitutions ----
   111	
   112	def fused_band_fns(band_split):
   113	    """One closure per band: session owner's rms_fused kernel + F.linear, on
   114	    the ORIGINAL parameter tensors (no copies)."""
   115	    fns = []
   116	    for seq in band_split.to_features:       # nn.Sequential(RMSNorm, Linear)
   117	        rms, lin = seq[0], seq[1]
   118	        def fn(part, _g=rms.gamma, _s=rms.scale, _w=lin.weight, _b=lin.bias):
   119	            return F.linear(rms_fused(part, _g, _s), _w, _b)
   120	        fns.append(fn)
   121	    return fns
   122	
   123	
   124	class FusedBandSplit(torch.nn.Module):
   125	    """Arm D/E/G band_split: per-band fused-RMSNorm + Linear, serial loop
   126	    (arm G wraps the same closures in MultiStreamBandSplit instead)."""
   127	
   128	    def __init__(self, orig):
   129	        super().__init__()
   130	        self.orig = orig                     # keeps original parameters registered
   131	        self.band_fns = fused_band_fns(orig)
   132	
   133	    def forward(self, x):
   134	        # rms_fused squeezes the batch dim (see frontend_rms_fused.rms_fused)
   135	        assert x.shape[0] == 1, 'rms_fused wrapper assumes batch size 1'
   136	        parts = x.split(self.orig.dim_inputs, dim=-1)
   137	        outs = [fn(p) for fn, p in zip(self.band_fns, parts)]
   138	        return torch.stack(outs, dim=-2)     # same as frontend.BandSplit.forward
   139	
   140	
   141	class RecordingBandSplit(torch.nn.Module):
   142	    """Setup-time-only wrapper: remembers band_split's input tensor (the folded
   143	    spectrogram) so the capture fallback knows the static buffer's shape."""
   144	
   145	    def __init__(self, orig):
   146	        super().__init__()
   147	        self.orig = orig
   148	        self.last_input = None
   149	
   150	    def forward(self, x):
   151	        self.last_input = x
   152	        return self.orig(x)
   153	
   154	
   155	class ReplayBandSplit(torch.nn.Module):
   156	    """Capture-fallback band_split (prereg P4 pre-authorized scope): stages 1-5
   157	    stay eager in frontend.py's own forward; this module copies the folded
   158	    tensor into the static input buffer and replays the captured graph."""
   159	
   160	    def __init__(self, orig, graph, static_in, static_out):
   161	        super().__init__()
   162	        self.orig = orig                     # parameters stay registered
   163	        self.graph = graph
   164	        self.static_in = static_in
   165	        self.static_out = static_out
   166	
   167	    def forward(self, x):
   168	        self.static_in.copy_(x)              # fresh data into the static buffer
   169	        self.graph.replay()
   170	        return self.static_out               # reused buffer — validate() clones
   171	
   172	
   173	# -------------------------------------------------------------- capture ----
   174	
   175	def capture_graph(fn, example, warmup_iters=3):
   176	    """PREREG graphs mechanics: static I/O buffers, warmup on a side stream,
   177	    capture OUTSIDE the timed region (this runs at build time; timed_run is
   178	    called later). Pattern follows the torch CUDA Graphs docs.
   179	
   180	    Returns (graph, static_in, static_out). Raises on capture failure —
   181	    build_arm_step() catches and falls back per prereg P4.
   182	    """
   183	    static_in = example.detach().clone()     # private contiguous input buffer
   184	    side = torch.cuda.Stream()
   185	    side.wait_stream(torch.cuda.current_stream())
   186	    with torch.cuda.stream(side), torch.no_grad():
   187	        for _ in range(warmup_iters):
   188	            fn(static_in)
   189	    torch.cuda.current_stream().wait_stream(side)
   190	    torch.cuda.synchronize()
   191	
   192	    graph = torch.cuda.CUDAGraph()
   193	    with torch.no_grad(), torch.cuda.graph(graph):
   194	        static_out = fn(static_in)
   195	    return graph, static_in, static_out
   196	
   197	
   198	def _capture_with_fallback(fe, x_example, info):
   199	    """B/E/G shared protocol. Try whole-forward capture; on failure (prereg P4
   200	    predicts the complex STFT breaks it) fall back to capturing the band_split
   201	    stage only. The scope that actually captured is RECORDED in the result
   202	    JSON (info['capture_scope']) and stated in the log."""
   203	    try:
   204	        graph, static_in, static_out = capture_graph(fe, x_example)
   205	        info['capture_scope'] = 'whole_forward'
   206	
   207	        def step(x):
   208	            static_in.copy_(x)               # AUDIT-MAP[2]: fresh input each replay
   209	            graph.replay()
   210	            return static_out
   211	        return step
   212	    except Exception:
   213	        info['notes'].append(
   214	            'whole-forward capture FAILED (prereg P4 predicted this at the '
   215	            'complex STFT); falling back to band_split-only capture. '
   216	            'Traceback:\n' + traceback.format_exc())
   217	        # a failed capture can leave the ambient stream pointing at the graph
   218	        # ctx's internal capture stream (torch 2.8: graph.__exit__ ends the
   219	        # capture BEFORE restoring the stream, with no try/finally) — restore
   220	        # the default stream before building the fallback
   221	        torch.cuda.set_stream(torch.cuda.default_stream())
   222	        torch.cuda.synchronize()
   223	
   224	    # fallback: find the folded tensor's shape with one recorded eager pass,
   225	    # then capture ONLY the current band_split module (stock, fused, or
   226	    # multi-stream — whatever this arm installed)
   227	    band_split = fe.band_split
   228	    recorder = RecordingBandSplit(band_split)
   229	    fe.band_split = recorder
   230	    with torch.no_grad():
   231	        fe(x_example)
   232	    folded = recorder.last_input.detach().clone()
   233	    fe.band_split = band_split
   234	
   235	    graph, static_in, static_out = capture_graph(band_split, folded)
   236	    fe.band_split = ReplayBandSplit(band_split, graph, static_in, static_out)
   237	    info['capture_scope'] = 'band_split_only'
   238	    return lambda x: fe(x)
   239	
