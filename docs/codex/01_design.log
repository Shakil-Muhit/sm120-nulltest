     1	#!/bin/bash
     2	# nsys traces + kernel-count extraction (prereg structural evidence + GPU-busy).
     3	#
     4	# PREREG anchors:
     5	#   - "nsys timeline of (best generic arm) and (G): kernel count + gap
     6	#     structure. These two traces are the structural evidence either way."
     7	#   - "GPU-busy per arm: extract from the nsys kernel summary of that arm's
     8	#     trace where a trace exists; otherwise from a dedicated short nsys pass."
     9	#
    10	# Implementation choice (documented in README): EVERY (arm x regime) gets its
    11	# own nsys pass with an identical invocation, so GPU-busy always comes from
    12	# that arm's own trace and the "otherwise" branch is never exercised. The
    13	# best-generic and G traces are the two structural timelines; the rest exist
    14	# for the per-arm busy numbers.
    15	#
    16	# Each pass is a full arms/run_arm.py run with --tag trace. The cudaProfilerApi
    17	# capture range covers ONLY the prereg-5a latency block (common.timed_run), so
    18	#     busy_ms_per_pass = total kernel time / iters
    19	#     kernels_per_pass = total instances   / iters
    20	# and the decision rule's R pairs THIS run's latency median with THIS trace's
    21	# busy time — "busy from nsys kernel sum, same run".
    22	#
    23	# Usage:  bash analysis/traces.sh [BEST_GENERIC_ARM]
    24	#         (no argument: asks analysis/collect.py, which needs the r1-r3 arm
    25	#          runs to exist already — run_all.sh runs arms first)
    26	set -u
    27	
    28	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    29	EVID="$REPO_DIR/evidence"
    30	ITERS="${ITERS:-50}"
    31	ARMS="A B C1 C2 D E F G"
    32	
    33	BEST="${1:-}"
    34	if [ -z "$BEST" ]; then
    35	    BEST="$(python "$REPO_DIR/analysis/collect.py" --best-generic)" || {
    36	        echo "FATAL: best generic arm not determinable (arm runs missing?)."
    37	        echo "       Run the arms first, or pass it explicitly: traces.sh C1"
    38	        exit 1
    39	    }
    40	fi
    41	echo "[traces] structural timelines: best generic arm = $BEST, and G"
    42	
    43	# CRITICAL correctness gate: arms B/E/G replay manual CUDA graphs and C1/C2
    44	# replay inductor cudagraphs. Modern nsys defaults to whole-graph tracing, in
    45	# which replayed kernels DO NOT appear in the kernel summary — GPU-busy would
    46	# collapse to ~0 for those arms and the decision-rule R would inflate toward
    47	# the thesis-favoring verdict. --cuda-graph-trace=node traces kernels inside
    48	# graph replays individually. Refuse to produce busy numbers without it.
    49	if ! nsys profile --help 2>/dev/null | grep -q 'cuda-graph-trace'; then
    50	    echo "FATAL: this nsys does not support --cuda-graph-trace=node; busy"
    51	    echo "       numbers for graph-replaying arms would be silently wrong."
    52	    echo "       Install a newer nsight-systems (see setup.sh [2/4])."
    53	    exit 1
    54	fi
    55	nsys --version | tee "$EVID/nsys_version.txt"
    56	
    57	for chunk in 352800 4410; do
    58	    for arm in $ARMS; do
    59	        base="$EVID/trace_${arm}_${chunk}"
    60	        echo "[traces] nsys pass: arm=$arm chunk=$chunk -> $base.nsys-rep"
    61	        # never leave a stale busy file paired with a newer trace run
    62	        rm -f "$EVID/busy_${arm}_${chunk}.json"
    63	
    64	        # TORCH_LOGS on compile arms (prereg: captured on every compile arm).
    65	        # fd 9 carries the pass's stderr: a torchlogs FILE for C1/C2, else a
    66	        # DUP of the current stderr — never a /dev/stderr re-open, which
    67	        # would O_TRUNC the log when stderr is a regular file (nohup runs)
    68	        logs_env=""
    69	        case "$arm" in C1|C2) logs_env="recompiles,perf_hints" ;; esac
    70	        if [ -n "$logs_env" ]; then
    71	            exec 9> "$EVID/torchlogs_${arm}_${chunk}_trace.log"
    72	        else
    73	            exec 9>&2
    74	        fi
