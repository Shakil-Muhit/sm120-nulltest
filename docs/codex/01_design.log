   103	def five_repeats(step, x, autocast_ctx, iters=50, repeats=5):
   104	    """Handoff section 2: five repeats of the whole block; min-of-medians and
   105	    spread. Returns the full record for the evidence JSON. Wall-clock
   106	    timestamps per block let the background clock log (handoff rule 9) be
   107	    cross-referenced with the timed windows (gate-02 finding 13)."""
