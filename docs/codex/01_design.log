    28	    breaks = sum(snapshot.get('graph_break', {}).values())
    29	    unsupported = sum(snapshot.get('unimplemented', {}).values())
    30	    ok = (breaks == 0 and unsupported == 0 and
    31	          snapshot.get('stats', {}).get('unique_graphs', 0) > 0 and
    32	          not torch._dynamo.config.suppress_errors)
