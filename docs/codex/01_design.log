     1	#!/bin/bash
     2	# Full null-test session, in prereg order. AUDIT-MAP[4] — the ordering:
     3	#
     4	#   [0] preflight (imports, GPU, nsys; environment snapshot)
     5	#   [1] P8 full-forward trace FIRST         (prereg P8: session opener,
     6	#                                            before any arm)
     7	#   [2] C2 output_code reads, both chunks   (prereg: "first action ... before
     8	#                                            any timing" — runs before any
     9	#                                            TIMED arm; P8 is a trace, not an
    10	#                                            arm timing. Flagged in README.)
    11	#   [3] arms A-G x two regimes x 3 restarts (PREREG: separate OS process per
    12	#                                            run — fresh `python` every time;
    13	#                                            >= 3 restarts for headlines)
    14	#   [4] nsys traces + busy extraction       (analysis/traces.sh)
    15	#   [5] collection table                    (analysis/collect.py)
    16	#   [6] version-matrix venv check LAST      (prereg environment rule: torch
    17	#                                            never upgraded before/among arms)
    18	#
    19	# Everything lands in evidence/ — extract it off-pod BEFORE terminate (README).
    20	set -u
    21	
    22	REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    23	EVID="$REPO_DIR/evidence"
    24	mkdir -p "$EVID"
    25	RESTARTS="${RESTARTS:-3}"   # PREREG: >= 3 process restarts for headline numbers
    26	ITERS="${ITERS:-50}"        # PREREG: >= 50 timed iters after warmup
    27	# refuse quietly-degraded sessions (mirrors run_arm.py's --iters guard)
    28	[ "$RESTARTS" -ge 3 ] || { echo "FATAL: prereg requires >= 3 restarts (RESTARTS=$RESTARTS)"; exit 1; }
    29	[ "$ITERS" -ge 50 ]   || { echo "FATAL: prereg requires >= 50 timed iters (ITERS=$ITERS)"; exit 1; }
    30	cd "$REPO_DIR"
    31	
    32	# one master console log; per-run TORCH_LOGS still get dedicated files
    33	exec > >(tee -a "$EVID/session_console.log") 2>&1
    34	echo "SESSION START $(date -Is)  restarts=$RESTARTS iters=$ITERS"
    35	[ -z "${TMUX:-}" ] && echo "WARNING: not inside tmux — a dropped connection kills the session"
    36	
    37	echo "=== [0] preflight ==="
    38	command -v nsys >/dev/null || { echo "FATAL: nsys missing — run setup.sh"; exit 1; }
    39	python - <<'PYEOF' || { echo "FATAL: preflight failed"; exit 1; }
    40	import torch, triton, numpy, librosa
    41	assert torch.cuda.is_available(), 'no CUDA device'
    42	print('torch', torch.__version__, '| triton', triton.__version__,
    43	      '| cap', torch.cuda.get_device_capability(),
    44	      '|', torch.cuda.get_device_name(0))
    45	PYEOF
    46	{ nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
    47	  python -c "import torch, triton; print('torch', torch.__version__, 'triton', triton.__version__, 'cuda', torch.version.cuda)"
    48	} > "$EVID/env_snapshot.txt" 2>&1
    49	
    50	echo "=== [1] P8 full-forward trace (prereg P8 — session opener, before any arm) ==="
    51	if ! bash "$REPO_DIR/scripts/p8_full_trace.sh"; then
    52	    if [ "${SKIP_P8:-0}" = "1" ]; then
    53	        echo "WARNING: P8 opener FAILED but SKIP_P8=1 set — continuing."
    54	        echo "         This deviates from prereg order; document it."
    55	    else
    56	        echo "FATAL: P8 opener failed (prereg: it runs before any arm)."
    57	        echo "       Fix it (README troubleshooting) or accept the deviation"
    58	        echo "       explicitly by re-running with SKIP_P8=1."
    59	        exit 1
    60	    fi
    61	fi
    62	
    63	echo "=== [2] C2 output_code reads at both chunk sizes (kernel inventory) ==="
    64	for chunk in 352800 4410; do
    65	    echo "--- output_code: C2 chunk=$chunk ---"
    66	    # PREREG: TORCH_LOGS (perf_hints + recompile logs) on EVERY compile-arm
    67	    # run — the output_code inventory run included
    68	    TORCH_LOGS="output_code,recompiles,perf_hints" python "$REPO_DIR/arms/run_arm.py" \
    69	        --arm C2 --chunk "$chunk" --tag outputcode --skip-timing \
    70	        2> "$EVID/output_code_C2_${chunk}.log" || true
    71	    echo "    -> evidence/output_code_C2_${chunk}.log"
    72	done
    73	
    74	echo "=== [3] arms: {A..G} x {352800,4410} x $RESTARTS restarts, fresh process each ==="
    75	for chunk in 352800 4410; do
    76	    for arm in A B C1 C2 D E F G; do
    77	        for r in $(seq 1 "$RESTARTS"); do
    78	            echo "--- arm=$arm chunk=$chunk restart=r$r $(date -Is) ---"
    79	            case "$arm" in
    80	                C1|C2)  # PREREG: TORCH_LOGS captured on every compile arm
    81	                    TORCH_LOGS="recompiles,perf_hints" \
    82	                    python "$REPO_DIR/arms/run_arm.py" --arm "$arm" \
    83	                        --chunk "$chunk" --iters "$ITERS" --tag "r$r" \
    84	                        2> "$EVID/torchlogs_${arm}_${chunk}_r${r}.log" || true
    85	                    ;;
    86	                *)
    87	                    python "$REPO_DIR/arms/run_arm.py" --arm "$arm" \
    88	                        --chunk "$chunk" --iters "$ITERS" --tag "r$r" || true
    89	                    ;;
    90	            esac
    91	        done
    92	    done
    93	done
    94	
    95	echo "=== [4] nsys traces + GPU-busy / kernel-count extraction ==="
    96	bash "$REPO_DIR/analysis/traces.sh" \
    97	    || echo "WARNING: traces incomplete — busy numbers and R will be missing"
    98	
    99	echo "=== [5] collection table ==="
   100	python "$REPO_DIR/analysis/collect.py" || true
   101	
   102	echo "=== [6] version-matrix venv check (LAST — prereg environment rule) ==="
   103	bash "$REPO_DIR/scripts/version_matrix_check.sh" \
   104	    || echo "WARNING: version-matrix check failed — re-run standalone or use a micro-pod"
   105	
   106	echo ""
   107	echo "SESSION DONE $(date -Is)"
   108	echo ">>> EXTRACT evidence/ OFF-POD BEFORE TERMINATE, e.g.:"
   109	echo ">>>   tar czf /root/evidence_\$(date +%Y%m%d_%H%M).tgz -C $REPO_DIR evidence"
   110	echo ">>>   then scp/runpodctl it down. Nothing in evidence/ is committed."

FILE: analysis/collect.py
     1	"""Merge per-run JSONs from evidence/ into the arms x regimes table.
     2	
     3	PREREG anchors:
     4	  - ">= 3 process restarts for the headline numbers": the headline latency per
     5	    (arm x regime) is the MEDIAN OF THE PER-RESTART MEDIANS over tags r1/r2/r3
     6	    (conservative reading — the prereg does not name the cross-restart
     7	    statistic; flagged in README "Deviations & ambiguities"). Per-iteration
     8	    lists from every run are preserved verbatim in summary.json.
     9	  - decision rule: R = median wall-time / GPU-busy-time on arm G at the 4410
    10	    regime, busy from the nsys kernel sum of the SAME run — so R pairs the
    11	    trace-tagged run's own latency median with its trace's busy time
    12	    (analysis/traces.sh writes busy_*.json; headline walls stay untraced).
    13	  - 5a escalation: serialization_delta_pct surfaced per cell; > 5% at the
    14	    4410 regime is flagged for evaluation under both protocols.
    15	
    16	No plots, no further analysis — the collection table only (session-owner
    17	instruction). Usage:
    18	    python analysis/collect.py                  # table + evidence/summary.json
    19	    python analysis/collect.py --best-generic   # print best generic arm @4410
    20	"""
    21	
    22	import argparse
    23	import glob
    24	import json
    25	import os
    26	import re
    27	import statistics
    28	import sys
    29	
    30	REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    31	EVIDENCE = os.path.join(REPO_ROOT, 'evidence')
    32	
    33	ARMS = ('A', 'B', 'C1', 'C2', 'D', 'E', 'F', 'G')
    34	CHUNKS = (352800, 4410)
    35	GENERIC_ARMS = ('A', 'B', 'C1', 'C2', 'F')   # no custom kernel: the generic-
    36	                                             # tooling side of the null test
    37	# headline set = every r<digits> tag (r1..rN — run_all.sh RESTARTS knob may
    38	# exceed 3); 'trace' pairs with busy; 'outputcode'/'adhoc' never headline
    39	RESTART_TAG_RE = re.compile(r'^r\d+$')
    40	
    41	# GRAPH-TRACE-FAILURE GUARD (fix-pass 2026-08-18): arms whose timed region
    42	# replays a CUDA graph (manual capture: B/E/G; inductor cudagraph trees under
    43	# reduce-overhead / max-autotune in torch 2.8: C1/C2). If such an arm's trace
    44	# shows < KERNELS_PER_PASS_FLOOR kernels/pass, --cuda-graph-trace=node did not
    45	# take effect and the busy numbers are wrong in the thesis-favoring direction:
    46	# the cell's busy is marked INVALID and never feeds R. Mirrors the primary
    47	# guard in analysis/traces.sh (defense in depth against hand-made busy files).
    48	GRAPH_ARMS = ('B', 'E', 'G', 'C1', 'C2')
    49	KERNELS_PER_PASS_FLOOR = 100
    50	
    51	
    52	def load_runs(evidence_dir):
    53	    runs = {}
    54	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'arm_*.json'))):
    55	        with open(path) as f:
    56	            r = json.load(f)
    57	        runs.setdefault((r['arm'], r['chunk']), {})[r['tag']] = r
    58	    return runs
    59	
    60	
    61	def load_busy(evidence_dir):
    62	    busy = {}
    63	    for path in sorted(glob.glob(os.path.join(evidence_dir, 'busy_*.json'))):
    64	        with open(path) as f:
    65	            b = json.load(f)
    66	        busy[(b['arm'], b['chunk'])] = b
    67	    return busy
    68	
    69	
    70	def cell_summary(arm, tag_runs, busy_entry):
    71	    """Aggregate one (arm x chunk) cell from its runs."""
    72	    busy_rejected = None
    73	    if busy_entry and arm in GRAPH_ARMS:
    74	        kpp = busy_entry.get('kernels_per_pass')
    75	        # None/absent counts as failing the floor: a graph arm with NO kernel
    76	        # count must not contribute busy either (defense in depth is only
    77	        # defense if a hand-made file can't dodge it by omitting the field)
    78	        if kpp is None or kpp < KERNELS_PER_PASS_FLOOR:
    79	            shown = 'absent' if kpp is None else f'{kpp:.1f}'
    80	            busy_rejected = (
