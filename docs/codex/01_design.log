   297	# ------------------------------------------------------------- settling ----
   298	
   299	def settle_compile(step, x, max_iters=60, consecutive=5):
   300	    """PREREG: 'let autotune fully settle before timing' — run the compiled
   301	    model until recompilation stops, and log it. Detector: torch._dynamo's
   302	    counters unchanged for `consecutive` successive passes (compilations,
   303	    graph breaks and recompiles all move these counters). Runs BEFORE
   304	    validation and the timed region. TORCH_LOGS=recompiles,perf_hints goes to
   305	    stderr and is captured to evidence/ by run_all.sh."""
   306	    import torch._dynamo.utils as dynamo_utils
   307	
   308	    def snap():
   309	        # str() keys: the snapshot lands in the result JSON, and counter keys
   310	        # are not guaranteed to be strings on every torch version
   311	        return {str(k): {str(kk): int(vv) for kk, vv in v.items()}
   312	                for k, v in dynamo_utils.counters.items()}
   313	
   314	    t0 = time.perf_counter()
   315	    prev, stable, it = snap(), 0, 0
   316	    with torch.no_grad():
   317	        while stable < consecutive and it < max_iters:
   318	            step(x)
   319	            it += 1
   320	            cur = snap()
   321	            stable = stable + 1 if cur == prev else 0
   322	            prev = cur
   323	    torch.cuda.synchronize()
   324	    return {'settle_iters': it,
   325	            'settle_stable_tail': stable,
   326	            'settle_capped': stable < consecutive,    # hit max_iters still unsettled
   327	            'settle_wall_s': round(time.perf_counter() - t0, 3),
   328	            'dynamo_counters': prev}
   329	
   330	
   331	# ------------------------------------------------------------ validation ----
   332	
   333	def validate(step, reference, arm, chunk, device):
   334	    """AUDIT-MAP[2]. PREREG: >= 2-pass different-data validation on EVERY arm,
   335	    including D/E/G — stale-buffer aliasing under capture passes single-pass
   336	    checks while being wrong. Runs OUTSIDE the timed region (before it).
   337	
   338	    Tolerance is per arm class (VAL_TOL — two-tier, prereg amendment
   339	    2026-08-18): replay class tight, recompiled class loose. NOTE: C1/C2/E
   340	    have never been validated; first validation is a pod-session opening item
   341	    (D and F likewise have never run on hardware).
   342	
   343	    Pass 2 genuinely uses different data: distinct seeds, and torch.equal
   344	    inequality is asserted. For capture arms the step closure performs
   345	    static_in.copy_(x) before graph replay (see _capture_with_fallback /
   346	    ReplayBandSplit), so a broken copy path shows up here as pass 2 returning
   347	    pass 1's answer. A FAIL marks the run INVALID in the JSON; it never
   348	    crashes the session (run_arm.py catches and records)."""
   349	    rtol, atol = VAL_TOL[arm]
   350	    passes = []
   351	    prev_x = None 
   352	    for seed in VAL_SEEDS:
   353	        x = make_input(chunk, device, seed)
   354	        if prev_x is not None:
   355	            assert not torch.equal(x, prev_x), \
   356	                'validation passes must use different input data'
   357	        prev_x = x
   358	        with torch.no_grad():
   359	            ref = reference(x)
   360	            out = step(x)
   361	            torch.cuda.synchronize()
   362	            out = out.clone()    # replay arms reuse the output buffer — snapshot
   363	        ok = bool(torch.allclose(out, ref, rtol=rtol, atol=atol))
   364	        passes.append({'seed': seed, 'ok': ok,
   365	                       'max_abs_diff': float((out - ref).abs().max().item())})
   366	    return {'status': 'PASS' if all(p['ok'] for p in passes) else 'FAIL',
   367	            'rtol': rtol, 'atol': atol, 'tolerance_class':
   368	                ('recompiled' if arm in ('C1', 'C2') else 'replay'),
   369	            'passes': passes}
   370	
   371	
   372	# ---------------------------------------------------------------- timing ----
   373	
   374	def timed_run(step, x, iters):
   375	    """AUDIT-MAP[1]. PREREG constraint 5a — TIMING PROTOCOL (cited verbatim
   376	    per session-owner instruction; see prereg_null_test.md.pdf, methodology).
   377	
   378	    PRIMARY (defines "wall" for the decision rule): per-iteration LATENCY —
   379	    torch.cuda.synchronize() after every pass, per-iteration times returned
   380	    (run_arm.py prints and saves the full list; never only aggregates).
   381	    Rationale (5a): streaming semantics — chunks arrive on real-time cadence,
   382	    back-to-back pipelining is unavailable in deployment, so latency (not
   383	    throughput) is the decision quantity in the 4410 regime.
   384	
   385	    SECONDARY: one free-running block (sync, N iters, sync; total/N) recorded
   386	    as throughput_ms_per_pass — the honest offline metric for the 8 s regime,
   387	    the continuity bridge to the historical free-running baseline (5.5-7.5 ms),
   388	    and the empirical measure of the serialization delta. 5a known bias:
   389	    per-iteration sync can only inflate G's wall -> inflates R -> biases
   390	    AGAINST the kill verdict; expected < 2%. 5a escalation clause: if the
   391	    free-running delta at the 4410 regime exceeds 5%, the decision rule is
   392	    evaluated under BOTH protocols and any disagreement is escalated
   393	    (analysis/collect.py surfaces serialization_delta_pct per arm x regime).
   394	
   395	    Timed-region boundary (PREREG): model build, compile/autotune settling,
   396	    graph capture and warmup all happen BEFORE this function — see
   397	    run_arm.py main(). The nsys capture range (cudaProfilerApi, frontend.py's
   398	    pattern) brackets the LATENCY block only, so a traced run's kernel sum
   399	    pairs with that same run's latency wall — "busy from nsys kernel sum,
   400	    same run" (prereg decision rule).
   401	    """
   402	    with torch.no_grad():
   403	        torch.cuda.synchronize()
   404	        torch.cuda.profiler.start()              # nsys capture range: open
   405	        latency_ms = []
   406	        for _ in range(iters):
   407	            t0 = time.perf_counter()
   408	            step(x)
   409	            torch.cuda.synchronize()             # 5a PRIMARY: sync every pass
   410	            latency_ms.append((time.perf_counter() - t0) * 1e3)
   411	        torch.cuda.profiler.stop()               # nsys capture range: close
   412	
   413	        torch.cuda.synchronize()                 # 5a SECONDARY: free-running
   414	        t0 = time.perf_counter()
   415	        for _ in range(iters):
   416	            step(x)
   417	        torch.cuda.synchronize()
   418	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   419	    return latency_ms, throughput_ms
   420	
