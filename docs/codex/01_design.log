   149	        freq_indices, dim_inputs = build_band_indices()
   150	        self.register_buffer('freq_indices', freq_indices, persistent=False)
   151	        self.band_split = BandSplit(DIM, dim_inputs)
   152	
   153	    def forward(self, raw_audio):  # (b, s, t)
   154	        b, s, t = raw_audio.shape
   155	        device = raw_audio.device
   156	
   157	        _nvtx_push('1_window')
   158	        window = torch.hann_window(WIN_LENGTH, device=device)
   159	        _nvtx_pop()
   160	
   161	        _nvtx_push('2_stft')
   162	        spec = torch.stft(
   163	            raw_audio.reshape(b * s, t),
   164	            n_fft=N_FFT, hop_length=HOP_LENGTH, win_length=WIN_LENGTH,
   165	            normalized=NORMALIZED, window=window, return_complex=True,
   166	        )  # (b*s, f, frames) complex
   167	        _nvtx_pop()
   168	
   169	        _nvtx_push('3_view_as_real_merge_stereo')
   170	        spec = torch.view_as_real(spec)  # (b*s, f, frames, 2)
   171	        f, frames = spec.shape[1], spec.shape[2]
   172	        # 'b s f t c -> b (f s) t c'
   173	        spec = (
   174	            spec.reshape(b, s, f, frames, 2)
   175	            .permute(0, 2, 1, 3, 4)
   176	            .reshape(b, f * s, frames, 2)
   177	        )
   178	        _nvtx_pop()
   179	
   180	        _nvtx_push('4_band_gather')
   181	        batch_arange = torch.arange(b, device=device)[:, None]
   182	        x = spec[batch_arange, self.freq_indices]  # (b, F_gather, frames, 2)
   183	        _nvtx_pop()
   184	
   185	        _nvtx_push('5_fold_complex_into_freq')
   186	        # 'b f t c -> b t (f c)'
   187	        x = x.permute(0, 2, 1, 3).reshape(b, frames, -1)
   188	        _nvtx_pop()
   189	
   190	        _nvtx_push('6_band_split_norm_linear')
   191	        x = self.band_split(x)  # (b, frames, num_bands, dim)
   192	        _nvtx_pop()
   193	        return x
   194	
   195	
   196	def cli_chunk():
   197	    """Chunk size in samples from --chunk N, else the 8 s default. The op chain
   198	    has a hard floor: center=True reflect-pads n_fft/2 = 1024 samples each side,
   199	    and reflect padding requires pad < signal length."""
   200	    chunk = CHUNK_SIZE
   201	    if '--chunk' in sys.argv:
   202	        chunk = int(sys.argv[sys.argv.index('--chunk') + 1])
   203	    assert chunk > N_FFT // 2, \
   204	        f'chunk must be > {N_FFT // 2} samples: center=True reflect padding ' \
   205	        f'cannot exceed the signal length'
   206	    return chunk
   207	
   208	
   209	def sanity(device, chunk):
   210	    """Bitwise-compare this file's front-end against the repo model's own
   211	    buffers/modules driven by its forward() lines. Imports repo code — keep
   212	    this OFF the profiled path."""
   213	    from einops import rearrange
   214	    from models.bs_roformer.mel_band_roformer import MelBandRoformer
   215	
   216	    torch.manual_seed(0)
   217	    # depth / mask_estimator_depth don't influence the front-end; keep them
   218	    # minimal so instantiation is cheap
   219	    model = MelBandRoformer(
   220	        dim=DIM, depth=1, stereo=True, num_stems=1, num_bands=NUM_BANDS,
   221	        sample_rate=SAMPLE_RATE, stft_n_fft=N_FFT, stft_hop_length=HOP_LENGTH,
   222	        stft_win_length=WIN_LENGTH, stft_normalized=NORMALIZED,
   223	        flash_attn=False, mask_estimator_depth=1,
   224	    ).to(device).eval()
   225	
   226	    fe = FrontEnd().to(device).eval()
   227	
   228	    assert torch.equal(fe.freq_indices, model.freq_indices), 'freq_indices mismatch'
   229	    assert tuple(fe.band_split.dim_inputs) == tuple(model.band_split.dim_inputs), \
   230	        'band dim_inputs mismatch'
   231	    fe.band_split.load_state_dict(model.band_split.state_dict())
   232	
   233	    x = torch.randn(BATCH, CHANNELS, chunk, device=device)
   234	    with torch.no_grad():
   235	        mine = fe(x)
   236	
   237	        # the model's forward() front-end lines, using its own modules/buffers
   238	        window = model.stft_window_fn(device=device)
   239	        ref = torch.stft(x.reshape(BATCH * CHANNELS, -1), **model.stft_kwargs,
   240	                         window=window, return_complex=True)
   241	        ref = torch.view_as_real(ref)
   242	        ref = ref.reshape(BATCH, CHANNELS, *ref.shape[1:])
   243	        ref = rearrange(ref, 'b s f t c -> b (f s) t c')
   244	        ref = ref[torch.arange(BATCH, device=device)[..., None], model.freq_indices]
   245	        ref = rearrange(ref, 'b f t c -> b t (f c)')
   246	        ref = model.band_split(ref)
   247	
   248	    diff = (mine - ref).abs().max().item()
   249	    print(f'sanity [{device}]: shapes {tuple(mine.shape)} vs {tuple(ref.shape)}, '
   250	          f'max abs diff = {diff:.3e}')
   251	    assert mine.shape == ref.shape and diff == 0.0, 'front-end diverges from repo model'
   252	    print('sanity: bitwise exact')
   253	
   254	
   255	def main():
   256	    device = 'cuda' if torch.cuda.is_available() else 'cpu'
   257	    chunk = cli_chunk()
   258	
   259	    if '--sanity' in sys.argv:
   260	        sanity(device, chunk)
   261	        return
   262	
   263	    torch.manual_seed(0)
   264	    fe = FrontEnd().to(device).eval()
   265	    x = torch.randn(BATCH, CHANNELS, chunk, device=device)
   266	
   267	    dims = fe.band_split.dim_inputs
   268	    print(f'device={device}  input (b s t)={tuple(x.shape)}  '
   269	          f'({1e3 * chunk / SAMPLE_RATE:.1f} ms of audio)  fp32')
   270	    print(f'stft: n_fft={N_FFT} hop={HOP_LENGTH} -> freqs={N_FFT // 2 + 1} '
   271	          f'frames={1 + chunk // HOP_LENGTH}')
   272	    print(f'gather: {len(fe.freq_indices)} rows from '
   273	          f'{CHANNELS * (N_FFT // 2 + 1)} unique freq*channel rows '
   274	          f'(mel band overlap duplicates bins)')
   275	    print(f'band_split: {NUM_BANDS} bands, per-band in-dim min={min(dims)} '
   276	          f'max={max(dims)}, out dim={DIM}')
   277	
   278	    with torch.no_grad():
   279	        for _ in range(WARMUP_ITERS):  # cuFFT plans, allocator, autotune
   280	            fe(x)
   281	
   282	        if device == 'cuda':
   283	            torch.cuda.synchronize()
   284	            torch.cuda.profiler.start()  # opens the nsys capture range
   285	            t0 = time.perf_counter()
   286	            for _ in range(MEASURED_ITERS):
   287	                out = fe(x)
   288	            torch.cuda.synchronize()
   289	            elapsed = time.perf_counter() - t0
   290	            torch.cuda.profiler.stop()
   291	        else:
   292	            t0 = time.perf_counter()
   293	            for _ in range(MEASURED_ITERS):
   294	                out = fe(x)
   295	            elapsed = time.perf_counter() - t0
   296	
   297	    print(f'output (b t bands dim)={tuple(out.shape)}')
   298	    print(f'{MEASURED_ITERS} passes: {1e3 * elapsed / MEASURED_ITERS:.3f} ms/pass')
   299	
   300	
   301	if __name__ == '__main__':
   302	    main()

