    86	        reference = common.build_stock_frontend(device)
    87	        fe = common.build_stock_frontend(device)
    88	        ref_sd, fe_sd = reference.state_dict(), fe.state_dict()
    89	        assert ref_sd.keys() == fe_sd.keys() and all(
    90	            torch.equal(ref_sd[k], fe_sd[k]) for k in ref_sd), \
    91	            'arm model and eager reference must start from identical weights'
    92	        step = common.build_arm_step(
    93	            args.arm, fe, args.chunk, device, args.streams, info)
    94	        if info['capture_scope'] is not None:
    95	            print(f'[run_arm] capture scope: {info["capture_scope"]}')
    96	
    97	        x = common.make_input(args.chunk, device, common.TIMING_SEED)
    98	
    99	        # 3: settle / warmup (excluded from the timed region)
   100	        if args.arm in ('C1', 'C2'):
   101	            settle = common.settle_compile(
   102	                step, x, args.settle_max, args.settle_consecutive)
   103	            print(f'[run_arm] compile settled: {settle["settle_iters"]} passes, '
   104	                  f'capped={settle["settle_capped"]} '
   105	                  f'({settle["settle_wall_s"]} s)')
   106	            if settle['settle_capped']:
   107	                info['notes'].append(
   108	                    'compile settle hit --settle-max without stabilizing; '
   109	                    'see TORCH_LOGS capture for recompile reasons')
