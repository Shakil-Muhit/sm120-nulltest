    58	def install_nvtx_hooks(model):
    59	    """External NVTX boundary hooks; returns (handles, boundary_mode).
    60	
    61	    Outer ranges (unchanged): p8_frontend / p8_attention / p8_tail.
    62	
    63	    Sub-ranges (fix-pass 2026-08-18 — instruments the (b)-candidate so the
    64	    registered questions / P-B1/P-B2 are answerable): nested inside
    65	    p8_attention, one set per transformer block i:
    66	        p8_L<i>_linear_attn  the linear transformer (only when the block has 3
    67	                             modules — linear_transformer_depth > 0)
    68	        p8_L<i>_time_attn    the time-axis Transformer call
    69	        p8_L<i>_rearrange    the unpack -> rearrange -> pack between the time
    70	                             and freq calls (bracketed by time's post-hook and
    71	                             freq's pre-hook — module hooks cannot see inside
    72	                             forward(), but they CAN bracket the gap between
    73	                             two submodule calls)
    74	        p8_L<i>_freq_attn    the freq-axis Transformer call
    75	    Each block's pre-time pack/rearrange and post-freq unpack stay in the
    76	    parent p8_attention range; extraction reports that residual as
    77	    attention_other. boundary_mode records the realized granularity, e.g.
    78	    'frontend/attention/tail;sub=per_layer(time_attn,rearrange,freq_attn)x6'
    79	    or ';sub=none' when the block structure was not recognized.
    80	
    81	    Registration-order invariant: sub-hooks on layers[-1][-1] are registered
    82	    BEFORE after_last_transformer, so on the final freq module the sub-range
    83	    pop fires first and the attention->tail transition stays balanced
    84	    (forward hooks on one module fire in registration order).
    85	    """
    86	    nvtx = torch.cuda.nvtx
    87	    handles = []
    88	
    89	    # can we mark the end of the attention stack?
    90	    last_tx = None
    91	    try:
    92	        last_tx = model.layers[-1][-1]
    93	        if not isinstance(last_tx, torch.nn.Module):
    94	            last_tx = None
    95	    except (AttributeError, IndexError, TypeError):
    96	        last_tx = None
    97	    outer_mode = ('frontend/attention/tail' if last_tx is not None
    98	                  else 'frontend/rest')
    99	    mid_label = 'p8_attention' if last_tx is not None else 'p8_rest'
   100	
   101	    # hooks MUST return None: a non-None return from a forward (pre-)hook
   102	    # replaces the module's output (input), and nvtx range_push/range_pop
   103	    # return ints — so these are plain functions, never bare lambdas
   104	    def open_frontend(module, inputs):
   105	        nvtx.range_push('p8_frontend')
   106	
   107	    def after_band_split(module, inputs, output):
