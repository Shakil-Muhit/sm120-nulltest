    73	            'original_forward_sha256': hashlib.sha256(original.encode()).hexdigest(),
    74	            'external_forward_sha256': hashlib.sha256(source.encode()).hexdigest(),
    75	            'generated_source': str(dest), 'native_call': 'Tensor.index_fill',
