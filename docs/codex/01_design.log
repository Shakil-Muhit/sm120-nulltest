    98	def build_band_indices():
    99	    """Mel-scaled band grouping, identical to MelBandRoformer.__init__ (setup-time
   100	    only — never on the profiled path)."""
   101	    mel_fb = filters.mel(sr=SAMPLE_RATE, n_fft=N_FFT, n_mels=NUM_BANDS)
   102	    mel_fb[0, 0] = 1.0
   103	    mel_fb[-1, -1] = 1.0
   104	    freqs_per_band = mel_fb > 0  # (num_bands, n_fft//2+1)
   105	    assert freqs_per_band.any(axis=0).all(), 'every freq bin must belong to some band'
   106	
   107	    freq_indices = np.concatenate([np.flatnonzero(row) for row in freqs_per_band])
   108	    # stereo was merged into the freq dim as (f s): bin f -> rows f*2 (L) and f*2+1 (R)
   109	    freq_indices = np.stack([freq_indices * 2, freq_indices * 2 + 1], axis=-1).reshape(-1)
   110	
   111	    num_freqs_per_band = freqs_per_band.sum(axis=1)
   112	    dim_inputs = tuple(int(2 * CHANNELS * f) for f in num_freqs_per_band)  # 2 = (re, im)
   113	    return torch.from_numpy(freq_indices).long(), dim_inputs
