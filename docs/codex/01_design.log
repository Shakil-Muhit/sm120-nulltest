   109	        nvtx.range_push(mid_label)
   110	
   111	    def after_last_transformer(module, inputs, output):
   112	        nvtx.range_pop()
   113	        nvtx.range_push('p8_tail')
   114	
   115	    def close_forward(module, inputs, output):
   116	        nvtx.range_pop()
   117	
   118	    # None-returning hook factories for the sub-ranges
   119	    def mk_push(name):
   120	        def pre_hook(module, inputs):
   121	            nvtx.range_push(name)
   122	        return pre_hook
   123	
   124	    def mk_pop():
   125	        def post_hook(module, inputs, output):
   126	            nvtx.range_pop()
   127	        return post_hook
   128	
   129	    def mk_pop_push(name):
   130	        def post_hook(module, inputs, output):
   131	            nvtx.range_pop()
   132	            nvtx.range_push(name)
   133	        return post_hook
   134	
   135	    def mk_pre_pop_push(name):
   136	        def pre_hook(module, inputs):
   137	            nvtx.range_pop()          # closes p8_L<i>_rearrange
   138	            nvtx.range_push(name)
   139	        return pre_hook
   140	
   141	    handles.append(model.register_forward_pre_hook(open_frontend))
   142	    handles.append(model.band_split.register_forward_hook(after_band_split))
   143	
   144	    # sub-range hooks — only when the outer 3-range split is realized AND every
   145	    # block matches the pinned commit's structure: nn.ModuleList of
   146	    # [time, freq] or [linear, time, freq] (forward executes them in order,
   147	    # with rearrange/pack between time and freq)
   148	    sub_mode = 'none'
   149	    if last_tx is not None:
   150	        try:
   151	            blocks = list(model.layers)
   152	            shapes_ok = bool(blocks) and all(
   153	                isinstance(b, torch.nn.ModuleList) and len(b) in (2, 3)
   154	                and all(isinstance(m, torch.nn.Module) for m in b)
   155	                for b in blocks)
   156	        except (AttributeError, TypeError):
