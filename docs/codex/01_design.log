    19	
    20	def exists(val):
    21	    return val is not None
    22	
    23	
    24	def flash_attn(self, q, k, v):
    25	    _, heads, q_len, _, k_len, is_cuda, device = *q.shape, k.shape[-2], q.is_cuda, q.device
    26	
    27	    if exists(self.scale):
    28	        default_scale = q.shape[-1] ** -0.5
    29	        q = q * (self.scale / default_scale)
    30	
    31	    # Check if there is a compatible device for flash attention
    32	
    33	    config = self._c3_cuda_backends if is_cuda else self._c3_cpu_backends
    34	
    35	    # pytorch 2.0 flash attn: q, k, v, mask, dropout, softmax_scale
    36	
    37	    with torch.nn.attention.sdpa_kernel(config):
    38	        out = F.scaled_dot_product_attention(
    39	            q, k, v,
    40	            dropout_p = self.dropout if self.training else 0.
    41	        )
    42	
    43	    return out
