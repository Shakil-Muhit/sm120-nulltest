   101	def make_input(chunk, device, seed):
   102	    """Deterministic input, independent of device RNG state: drawn on CPU from
   103	    a dedicated generator, then moved. Same seed => same data in every process
   104	    and on every arm."""
   105	    gen = torch.Generator(device='cpu').manual_seed(seed)
   106	    x = torch.randn(frontend.BATCH, frontend.CHANNELS, chunk, generator=gen)
   107	    return x.to(device)
