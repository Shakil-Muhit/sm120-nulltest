    46	def verify_source(original):
    47	    source = textwrap.dedent(inspect.getsource(original))
    48	    tree = ast.parse(source)
    49	    replacements = 0
    50	    config_replacements = 0
    51	    for node in ast.walk(tree):
    52	        if (isinstance(node, ast.Assign) and len(node.targets) == 1 and
    53	                ast.unparse(node.targets[0]) == 'config'):
    54	            assert ast.unparse(node.value) == 'self.cuda_config if is_cuda else self.cpu_config'
    55	            node.value = ast.parse('self._c3_cuda_backends if is_cuda else self._c3_cpu_backends',
    56	                                   mode='eval').body
    57	            config_replacements += 1
    58	        if not isinstance(node, ast.Call):
    59	            continue
    60	        if ast.unparse(node.func) != 'torch.backends.cuda.sdp_kernel':
    61	            continue
    62	        assert not node.args and len(node.keywords) == 1
    63	        kw = node.keywords[0]
    64	        assert kw.arg is None and ast.unparse(kw.value) == 'config._asdict()'
    65	        node.func = ast.parse('torch.nn.attention.sdpa_kernel', mode='eval').body
    66	        node.args = [ast.Name(id='config', ctx=ast.Load())]
    67	        node.keywords = []
    68	        replacements += 1
    69	    assert replacements == config_replacements == 1
    70	    fixed_source = textwrap.dedent(inspect.getsource(flash_attn))
    71	    assert ast.dump(tree) == ast.dump(ast.parse(fixed_source)), \
    72	        'external method differs beyond the backend-context repair'
    73	    return {'status': 'PASS', 'replacements': replacements,
    74	            'original_source_sha256': hashlib.sha256(source.encode()).hexdigest(),
    75	            'replacement_source_sha256': hashlib.sha256(fixed_source.encode()).hexdigest()}
    76	
