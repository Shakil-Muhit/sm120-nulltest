   132	class BandSplit(nn.Module):
   133	    def __init__(self, dim, dim_inputs):
   134	        super().__init__()
   135	        self.dim_inputs = dim_inputs
   136	        self.to_features = nn.ModuleList(
   137	            nn.Sequential(RMSNorm(dim_in), nn.Linear(dim_in, dim)) for dim_in in dim_inputs
   138	        )
   139	
   140	    def forward(self, x):
   141	        parts = x.split(self.dim_inputs, dim=-1)
   142	        outs = [f(part) for part, f in zip(parts, self.to_features)]
   143	        return torch.stack(outs, dim=-2)
