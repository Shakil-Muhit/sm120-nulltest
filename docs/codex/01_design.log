    17	@torch.library.custom_op('axial_c3::native_dc_fill', mutates_args=())
    18	def native_dc_fill(input: torch.Tensor, index: torch.Tensor) -> torch.Tensor:
    19	    result = input.index_fill(1, index, 0.)
    20	    assert result.shape == input.shape == (2, 1025, 801)
    21	    assert result.stride() == input.stride() and result.storage_offset() == 0
    22	    assert result.dtype == input.dtype == torch.complex64
    23	    return result
