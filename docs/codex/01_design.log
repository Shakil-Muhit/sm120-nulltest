    59	def require_settled(settle, out_path=None):
    60	    """Gate-02 finding 8: a capped settle must FAIL CLOSED — nothing measured
    61	    on a still-recompiling model is meaningful. Writes the settle record (so
    62	    the failure is evidence) and exits 4."""
    63	    if settle['settle_capped']:
    64	        if out_path:
    65	            write_json(out_path, {'status': 'SETTLE_FAILED', 'settle': settle})
    66	        import sys
    67	        print('FATAL: compile did not settle (recompilations still occurring '
    68	              f'after {settle["settle_iters"]} passes) — aborting before any '
    69	              'measurement.', file=sys.stderr)
    70	        sys.exit(4)
