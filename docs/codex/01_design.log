    73	def timed_run(step, x, autocast_ctx, iters=50):
    74	    """PREREG-5a TIMING PROTOCOL — COPIED from sm120-nulltest@a997e27
    75	    arms/common.py::timed_run, with one adaptation: the forward runs inside
    76	    the caller-supplied autocast context (handoff rule 3 — precision mirrors
    77	    the public inference path), matching how the baseline executes.
    78	
    79	    PRIMARY: per-iteration latency, synchronize after every pass, inside the
    80	    cudaProfilerApi capture range (a no-op unless nsys is attached).
    81	    SECONDARY: one free-running block (sync, N iters, sync; total/N).
    82	    """
    83	    with torch.no_grad(), autocast_ctx():
    84	        torch.cuda.synchronize()
    85	        torch.cuda.profiler.start()              # nsys capture range: open
    86	        latency_ms = []
    87	        for _ in range(iters):
    88	            t0 = time.perf_counter()
    89	            step(x)
    90	            torch.cuda.synchronize()             # 5a PRIMARY: sync every pass
    91	            latency_ms.append((time.perf_counter() - t0) * 1e3)
    92	        torch.cuda.profiler.stop()               # nsys capture range: close
    93	
    94	        torch.cuda.synchronize()                 # 5a SECONDARY: free-running
    95	        t0 = time.perf_counter()
    96	        for _ in range(iters):
    97	            step(x)
    98	        torch.cuda.synchronize()
    99	        throughput_ms = (time.perf_counter() - t0) * 1e3 / iters
   100	    return latency_ms, throughput_ms
