   109	    for r in range(repeats):
   110	        t_start = time.time()
   111	        lat, thr = timed_run(step, x, autocast_ctx, iters)
   112	        t_end = time.time()
   113	        s = sorted(lat)
   114	        blocks.append({'repeat': r, 'latency_ms_per_iter': lat,
   115	                       'latency_median_ms': median(lat),
   116	                       'latency_min_ms': s[0], 'latency_max_ms': s[-1],
   117	                       'throughput_ms_per_pass': thr,
   118	                       'unix_start': t_start, 'unix_end': t_end})
   119	    medians = [b['latency_median_ms'] for b in blocks]
   120	    return {'blocks': blocks,
   121	            'latency_medians_ms': medians,
   122	            'min_of_medians_ms': min(medians),
   123	            'median_spread_ms': max(medians) - min(medians),
   124	            'throughput_ms_per_pass_best': min(b['throughput_ms_per_pass'] for b in blocks),
   125	            'iters_per_block': iters, 'repeats': repeats}
