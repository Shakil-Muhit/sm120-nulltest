   169	                 str(_physical_gpu_index())],
   170	                capture_output=True, text=True, timeout=10).stdout.strip()
   171	        except Exception:
   172	            return 'unavailable'
   173	    import triton
   174	    import os
   175	    return {'torch': torch.__version__, 'triton': triton.__version__,
   176	            'cuda_build': torch.version.cuda,
   177	            'gpu': torch.cuda.get_device_name(0),
   178	            'capability': list(torch.cuda.get_device_capability(0)),
   179	            'driver': q('driver_version'),
   180	            'cuda_visible_devices': os.environ.get('CUDA_VISIBLE_DEVICES', ''),
   181	            'nsys': nsys_path or 'n/a'}
