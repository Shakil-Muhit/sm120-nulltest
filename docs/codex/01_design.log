    76	        TORCH_LOGS="$logs_env" nsys profile \
    77	            --capture-range=cudaProfilerApi --capture-range-end=stop \
    78	            --cuda-graph-trace=node \
    79	            --force-overwrite=true -o "$base" \
    80	            python "$REPO_DIR/arms/run_arm.py" \
    81	                --arm "$arm" --chunk "$chunk" --iters "$ITERS" --tag trace \
    82	            2>&9 || { exec 9>&-; echo "[traces] WARN: nsys pass failed for $arm/$chunk — skipping"; continue; }
    83	        exec 9>&-
    84	
    85	        # kernel summary CSV (new report name first, legacy alias fallback)
    86	        nsys stats --force-export=true --force-overwrite=true \
    87	                -r cuda_gpu_kern_sum --format csv \
    88	                --output "$base" "$base.nsys-rep" >/dev/null 2>&1 \
    89	            || nsys stats --force-export=true --force-overwrite=true \
    90	                -r gpukernsum --format csv \
    91	                --output "$base" "$base.nsys-rep" >/dev/null \
    92	            || { echo "[traces] WARN: nsys stats failed for $arm/$chunk"; continue; }
    93	
    94	        python3 - "$arm" "$chunk" "$EVID" <<'PYEOF' \
    95	            || echo "[traces] WARN: busy extraction failed for $arm/$chunk — no busy_${arm}_${chunk}.json"
    96	import csv, glob, json, os, sys
    97	arm, chunk, evid = sys.argv[1], int(sys.argv[2]), sys.argv[3]
    98	base = os.path.join(evid, f'trace_{arm}_{chunk}')
    99	paths = sorted(glob.glob(base + '*kern*sum*.csv'))
   100	if not paths:
   101	    sys.exit(f'no kernel-summary csv found for {base}')
   102	total_ns, instances = 0, 0
   103	with open(paths[-1], newline='') as f:
   104	    rows = list(csv.reader(f))
   105	head = rows[0]
   106	def col(*names):
   107	    # exact header match first (any candidate), else guarded substring
   108	    for name in names:
   109	        for i, h in enumerate(head):
   110	            if h.strip().strip('"') == name:
   111	                return i
   112	    key = names[0].split(' ')[0]
   113	    return next(i for i, h in enumerate(head)
   114	                if key in h and 'Range' not in h and 'Proj' not in h
   115	                and 'NVTX' not in h)
   116	t_col = col('Total Time (ns)')
   117	i_col = col('Instances', 'Kern Inst')
   118	for row in rows[1:]:
   119	    if len(row) <= max(t_col, i_col) or not row[i_col].strip():
   120	        continue
   121	    total_ns += int(float(row[t_col].replace(',', '')))
   122	    instances += int(float(row[i_col].replace(',', '')))
   123	run_json = os.path.join(evid, f'arm_{arm}_c{chunk}_trace.json')
   124	with open(run_json) as f:
   125	    run = json.load(f)
   126	if run.get('status') != 'VALID':
   127	    sys.exit(f'trace run for {arm}/{chunk} is {run.get("status")} — refusing '
   128	             f'to write busy numbers from an invalid run')
   129	# divide by the number of passes ACTUALLY completed inside the capture range
   130	# (= the latency block; a partial run must not skew busy-per-pass)
   131	iters = len(run.get('latency_ms_per_iter') or [])
   132	busy_ms = total_ns / 1e6 / iters if iters else None
   133	out = {
   134	    'arm': arm, 'chunk': chunk,
   135	    'busy_ms_per_pass': busy_ms,
   136	    'kernels_per_pass': instances / iters if iters else None,
   137	    'total_kernel_time_ms': total_ns / 1e6,
   138	    'total_instances': instances,
   139	    'iters': iters,
   140	    'busy_source': 'own trace (capture range = latency block only)',
   141	    'source_trace': os.path.basename(paths[-1]),
   142	    'trace_latency_median_ms': run.get('latency_median_ms'),
   143	    'wall_over_busy_same_run': (run['latency_median_ms'] / busy_ms
   144	                                if busy_ms and run.get('latency_median_ms')
   145	                                else None),
   146	}
   147	# GRAPH-TRACE-FAILURE GUARD (fix-pass 2026-08-18): arms whose timed region
   148	# replays a CUDA graph (manual capture: B/E/G; inductor cudagraph trees under
   149	# reduce-overhead / max-autotune in torch 2.8: C1/C2) must show their kernels
   150	# individually. A graph arm reporting ~1 kernel/pass means
   151	# --cuda-graph-trace=node did not take effect; such busy numbers are wrong in
   152	# the thesis-favoring direction and must never be recorded. Floor = 100
   153	# (session-owner spec). Note C2's P2-predicted ~120 kernels/pass sits only
   154	# ~20% above the floor — a legitimately better-than-predicted Inductor fusion
   155	# would trip this guard, which fails toward human review, the safe direction.
   156	GRAPH_ARMS = ('B', 'E', 'G', 'C1', 'C2')
   157	KPP_FLOOR = 100
   158	kpp = out['kernels_per_pass']
   159	if arm in GRAPH_ARMS and kpp is not None and kpp < KPP_FLOOR:
   160	    sys.exit(f'GRAPH-TRACE GUARD: {arm}/{chunk} shows {kpp:.1f} kernels/pass '
   161	             f'(< {KPP_FLOOR}) on a graph-replay arm — INVALID; refusing to '
   162	             f'write busy numbers. Verify --cuda-graph-trace=node took effect '
   163	             f'(docs/profiling_crib.md section 4.1).')
   164	dest = os.path.join(evid, f'busy_{arm}_{chunk}.json')
   165	with open(dest, 'w') as f:
   166	    json.dump(out, f, indent=1)
   167	print(f"[traces] {arm}/{chunk}: busy {busy_ms and round(busy_ms, 4)} ms/pass, "
   168	      f"{out['kernels_per_pass'] and round(out['kernels_per_pass'], 1)} kernels/pass "
   169	      f"-> {dest}")
   170	PYEOF
   171	    done
   172	done
   173	
   174	echo ""
   175	echo "[traces] done. Structural timelines to inspect for gap structure and the"
   176	echo "[traces] ~60-separate-GEMMs criterion (prereg structural criterion):"
   177	echo "[traces]     ${EVID}/trace_${BEST}_<chunk>.nsys-rep   (best generic arm)"
   178	echo "[traces]     ${EVID}/trace_G_<chunk>.nsys-rep         (arm G)"
