   155	class ReplayBandSplit(torch.nn.Module):
   156	    """Capture-fallback band_split (prereg P4 pre-authorized scope): stages 1-5
   157	    stay eager in frontend.py's own forward; this module copies the folded
   158	    tensor into the static input buffer and replays the captured graph."""
   159	
   160	    def __init__(self, orig, graph, static_in, static_out):
   161	        super().__init__()
   162	        self.orig = orig                     # parameters stay registered
   163	        self.graph = graph
   164	        self.static_in = static_in
   165	        self.static_out = static_out
   166	
   167	    def forward(self, x):
   168	        self.static_in.copy_(x)              # fresh data into the static buffer
   169	        self.graph.replay()
   170	        return self.static_out               # reused buffer — validate() clones
