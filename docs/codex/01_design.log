   242	
   243	def build_arm_step(arm, fe, chunk, device, num_streams, info):
   244	    """Turn a freshly built stock FrontEnd into the requested arm.
   245	
   246	    Returns step: step(x) -> output tensor runs ONE pass. `info` is the
   247	    CALLER'S dict (run_arm.py) and is mutated in place — capture_scope
   248	    (B/E/G), stream_count (F/G), compile mode (C1/C2), notes — so that
   249	    everything recorded before a mid-build exception (e.g. the P4
   250	    whole-forward-capture traceback) still reaches the result JSON.
   251	    All build/compile/capture work happens HERE, before validation and before
   252	    the timed region (AUDIT-MAP[1]).
   253	    """
   254	    x_example = make_input(chunk, device, TIMING_SEED)
   255	
   256	    if arm == 'A':                # eager baseline, stock F.normalize chain
   257	        return lambda x: fe(x)
   258	
   259	    if arm == 'B':                # A + manual whole-forward capture (P4 fallback)
   260	        return _capture_with_fallback(fe, x_example, info)
   261	
   262	    if arm in ('C1', 'C2'):       # PREREG: torch.compile(..., dynamic=False)
   263	        mode = 'reduce-overhead' if arm == 'C1' else 'max-autotune'
   264	        info['compile_mode'] = mode
   265	        compiled = torch.compile(fe, mode=mode, dynamic=False)
   266	        return lambda x: compiled(x)
   267	
   268	    if arm == 'D':                # fused RMSNorm kernel, eager elsewhere
   269	        fe.band_split = FusedBandSplit(fe.band_split)
   270	        return lambda x: fe(x)
   271	
   272	    if arm == 'E':                # D + capture (same fallback protocol as B)
   273	        fe.band_split = FusedBandSplit(fe.band_split)
   274	        return _capture_with_fallback(fe, x_example, info)
   275	
   276	    if arm == 'F':                # A + multi-stream band loop
   277	        info['stream_count'] = num_streams
   278	        loop = streams.MultiStreamBandLoop(num_streams, device)
   279	        stock_fns = list(fe.band_split.to_features)      # original modules
   280	        fe.band_split = streams.MultiStreamBandSplit(fe.band_split, stock_fns, loop)
   281	        return lambda x: fe(x)
   282	
   283	    if arm == 'G':
   284	        # AUDIT-MAP[3]: honest counterfactual — fused kernel + multi-stream
   285	        # fork/join band loop, the whole stream-ordered structure captured
   286	        # into ONE graph (whole-forward first, band_split-only on P4 fallback;
   287	        # either way a single graph replay covers the multi-stream loop).
   288	        info['stream_count'] = num_streams
   289	        loop = streams.MultiStreamBandLoop(num_streams, device)
   290	        fns = fused_band_fns(fe.band_split)
   291	        fe.band_split = streams.MultiStreamBandSplit(fe.band_split, fns, loop)
   292	        return _capture_with_fallback(fe, x_example, info)
   293	
   294	    raise ValueError(f'unknown arm {arm!r}')
   295	
