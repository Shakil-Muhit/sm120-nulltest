"""Public construction path for the full model (prereg_amendments.md §1).

COPIED from axial-layout-scoping@a6f3e6f scoping/build_model.py::load_public_model
(itself mirroring sm120-nulltest scripts/p8_trace.py, AUDIT-MAP[5]): the model
comes ONLY from the pinned public clone via its own path —
utils.settings.get_model_from_config -> torch.load(weights_only=False,
map_location='cpu') -> utils.model_utils.load_start_checkpoint(type_='inference'),
the 3-line pattern of upstream inference.py at the pin. Precision: the repo's
own inference autocast, torch.autocast('cuda', enabled=config.training.use_amp).
"""

import argparse
import functools
import os
import sys

import torch


def load_public_model(msst_dir, ckpt, config_path,
                      model_type='mel_band_roformer', device='cuda'):
    if msst_dir not in sys.path:
        sys.path.insert(0, msst_dir)
    from utils.settings import get_model_from_config
    from utils.model_utils import load_start_checkpoint

    model, config = get_model_from_config(model_type, config_path)
    ckpt_ns = argparse.Namespace(
        start_check_point=ckpt, model_type=model_type,
        lora_checkpoint='', lora_checkpoint_loralib='')
    checkpoint = torch.load(ckpt, weights_only=False, map_location='cpu')
    load_start_checkpoint(ckpt_ns, model, checkpoint, type_='inference')
    model = model.to(device).eval()

    use_amp = config.training.use_amp
    if not isinstance(use_amp, bool):
        raise TypeError('config.training.use_amp must be an explicit boolean')
    autocast_ctx = functools.partial(torch.autocast, 'cuda', enabled=use_amp)
    # capture arms: the weight-cast cache must be off during graph capture
    # (torch CUDA Graphs + AMP guidance) — prereg_amendments.md §1, arm B
    autocast_nocache = functools.partial(torch.autocast, 'cuda', enabled=use_amp,
                                         cache_enabled=False)
    return model, config, use_amp, autocast_ctx, autocast_nocache


def paths_from_env():
    """Pod layout (setup.sh / fetch_checkpoint.sh): MSST_DIR, CKPT_DIR with
    manifest.env; env overrides win; ml-beast shakedown sets AXIAL-style paths."""
    home = os.path.expanduser('~')
    msst = os.environ.get('MSST_DIR', os.path.join(home, 'work', 'msst'))
    ckpt_dir = os.environ.get('CKPT_DIR', os.path.join(home, 'work', 'ckpt'))
    ckpt = os.environ.get('CKPT_FILE')
    config = os.environ.get('CONFIG_FILE')
    manifest = os.path.join(ckpt_dir, 'manifest.env')
    if (ckpt is None or config is None) and os.path.exists(manifest):
        for line in open(manifest):
            if '=' in line:
                k, v = line.strip().split('=', 1)
                v = v.strip('"')
                if k == 'CKPT_FILE' and ckpt is None:
                    ckpt = v
                if k == 'CONFIG_FILE' and config is None:
                    config = v
    if ckpt is None:
        ckpt = os.path.join(ckpt_dir, 'MelBandRoformer.ckpt')
    if config is None:
        config = os.path.join(msst, 'configs', 'KimberleyJensen',
                              'config_vocals_mel_band_roformer_kj.yaml')
    for p in (msst, ckpt, config):
        if not os.path.exists(p):
            raise FileNotFoundError(f'provenance path missing: {p} (run setup.sh)')
    return {'msst': msst, 'ckpt': ckpt, 'config': config}
def verify_c3_operator(frames=None):
    import native_tail_adapted
    return native_tail_adapted.verify_operator(tuple(frames) if frames else native_tail_adapted.FRAMES)


def _compile(model, mode, info):
    info['compile_mode'] = mode
    compiled = torch.compile(model, mode=mode, dynamic=False)
    return lambda x: compiled(x)


def _compile_opts(model, options, label, info):
    """Phase 3 (gate-09 f128): an Inductor knob set through a GLOBAL config change does not
    change the compiled artifact's identity, so Dynamo may reuse the control arm's
    compilation inside a matched process. Passing the knob as torch.compile `options`
    makes the backend wrapper differ (mode and options are exclusive, so the
    reduce-overhead setting `triton.cudagraphs` is merged in explicitly)."""
    opts = {'triton.cudagraphs': True}
    opts.update(options)
    info['compile_mode'] = label
    info['inductor_config'] = dict(options)
    compiled = torch.compile(model, options=opts, dynamic=False)
    return lambda x: compiled(x)


def build_arm_step(arm, model, x_example, ctx_nocache, num_streams, info, out_dir):
    arm = base_arm(arm)
    """info: caller's dict, mutated in place (capture_scope, capture_adapter,
    capture_attempts, stream_count, compile_mode, c3_fixes, padbatch,
    nvtx_boundary_mode, notes)."""
    if arm == 'A':
        return lambda x: model(x)

    if arm == 'ANVTX':
        from p8_trace import install_nvtx_hooks       # sm120 scripts/p8_trace.py
        handles, mode = install_nvtx_hooks(model)
        info['nvtx_boundary_mode'] = mode
        info['nvtx_hook_count'] = len(handles)
        return lambda x: model(x)

    if arm == 'B':
        return capture_mod.capture_ladder(model, x_example, ctx_nocache, info, out_dir)

    if arm in ('C1', 'C2'):
        return _compile(model, 'reduce-overhead' if arm == 'C1' else 'max-autotune', info)

    if arm == 'C3':
        info['c3_fixes'] = _c3_fixes(model, out_dir, attention=True, dc_filter=True)
        return _compile(model, 'reduce-overhead', info)

    if arm == 'C1A':
        info['c3_fixes'] = _c3_fixes(model, out_dir, attention=True, dc_filter=False)
        return _compile(model, 'reduce-overhead', info)

    if arm == 'C1D':
        info['c3_fixes'] = _c3_fixes(model, out_dir, attention=False, dc_filter=True)
        return _compile(model, 'reduce-overhead', info)

    if arm == 'D':
        model.band_split = common.FusedBandSplit(model.band_split)
        return lambda x: model(x)

    if arm == 'E':
        model.band_split = common.FusedBandSplit(model.band_split)
        return capture_mod.capture_ladder(model, x_example, ctx_nocache, info, out_dir)

    if arm == 'F':
        info['stream_count'] = num_streams
        loop = streams.MultiStreamBandLoop(num_streams, 'cuda')
        stock_fns = list(model.band_split.to_features)
        model.band_split = streams.MultiStreamBandSplit(model.band_split, stock_fns, loop)
