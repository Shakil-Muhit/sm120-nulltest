    96	            inner, glu = mlp[0], mlp[1]
    97	            assert isinstance(glu, nn.GLU) and glu.dim == -1
    98	            layers = list(inner)
    99	            lins = [m for m in layers if isinstance(m, nn.Linear)]
   100	            others = [m for m in layers if not isinstance(m, nn.Linear)]
   101	            assert all(isinstance(m, nn.Tanh) for m in others), others
   102	            # public MLP: Linear (Tanh Linear)* — activation after all but last
   103	            assert len(others) == len(lins) - 1
   104	            assert [type(m) for m in layers] == \
   105	                [nn.Linear if i % 2 == 0 else nn.Tanh for i in range(len(layers))]
   106	            chains.append(lins)
   107	        depth = len(chains[0])
   108	        assert all(len(c) == depth for c in chains)
   109	        dev = chains[0][0].weight.device
   110	        self.n, self.kmax, self.depth = n, kmax, depth
   111	        self.total = sum(dims)
   112	        for j in range(depth - 1):             # batched hidden layers
   113	            din, dout = chains[0][j].in_features, chains[0][j].out_features
   114	            w = torch.zeros(n, din, dout)
   115	            b = torch.zeros(n, 1, dout)
   116	            for i, lins in enumerate(chains):
   117	                assert lins[j].in_features == din and lins[j].out_features == dout
   118	                w[i] = lins[j].weight.detach().float().cpu().t()
