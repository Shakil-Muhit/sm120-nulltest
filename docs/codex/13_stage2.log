     1	"""Arm H — pad-and-batch band modules (prereg_amendments.md §1.1).
     2	
     3	Generic reimplementation of the band-bmm idea (production code not used).
     4	External wrappers holding the ORIGINAL modules (parameters stay registered;
     5	nothing is modified) plus derived zero-padded weight buffers built once.
     6	
     7	Exactness (registered): padded entries are zero on every path —
     8	  band_split : F.normalize over a zero-padded row == per-band normalize (zeros
     9	               add nothing to the L2 norm); per-band scale K_i**0.5 as a
    10	               (60,1,1) vector; zero-padded gamma; bmm with zero-padded weight
    11	               rows contributes exactly 0; output order == torch.stack(dim=-2).
    12	  mask_est.  : three batched bmm chains; the last weight's columns are laid
    13	               out [a-half | b-half], each half zero-padded to K_max, so
    14	               GLU(dim=-1) over the padded width equals the per-band GLU
    15	               (pad columns: 0 * sigmoid(0) = 0); valid columns are gathered
    16	               back in band order == torch.cat(dim=-1).
    17	Claim: ALGEBRAIC equivalence. Numerically the padded/batched program changes
    18	reduction trees (and the compiler changes fusion), so agreement is verified
    19	at the loose tier (the classification rule; H is compiled), never bitwise.
    20	"""
    21	
    22	import torch
    23	import torch.nn as nn
    24	import torch.nn.functional as F
    25	
    26	
    27	def _band_split_parts(orig):
    28	    dims = tuple(int(d) for d in orig.dim_inputs)
    29	    parts = []
    30	    for seq in orig.to_features:
    31	        assert isinstance(seq, nn.Sequential) and len(seq) == 2
    32	        rms, lin = seq[0], seq[1]
    33	        assert isinstance(lin, nn.Linear) and lin.bias is not None
    34	        assert hasattr(rms, 'gamma') and hasattr(rms, 'scale')
    35	        parts.append((rms, lin))
    36	    assert len(parts) == len(dims)
    37	    return dims, parts
    38	
    39	
    40	class PadBatchBandSplit(nn.Module):
    41	    """Drop-in for the public BandSplit: (1, T, sum K_i) -> (1, T, 60, dim)."""
    42	
    43	    def __init__(self, orig):
    44	        super().__init__()
    45	        self.orig = orig                       # parameters stay registered
    46	        dims, parts = _band_split_parts(orig)
    47	        n, kmax = len(dims), max(dims)
    48	        dim_out = parts[0][1].out_features
    49	        total = sum(dims)
    50	        dev = parts[0][1].weight.device
    51	        idx = torch.full((n, kmax), total, dtype=torch.long)   # -> zero column
    52	        gamma = torch.zeros(n, kmax, dtype=torch.float32)
    53	        w = torch.zeros(n, kmax, dim_out, dtype=torch.float32)
    54	        b = torch.zeros(n, 1, dim_out, dtype=torch.float32)
    55	        scale = torch.zeros(n, 1, 1, dtype=torch.float32)
    56	        off = 0
    57	        for i, ((rms, lin), k) in enumerate(zip(parts, dims)):
    58	            assert lin.in_features == k and lin.out_features == dim_out
    59	            assert rms.gamma.shape == (k,)
    60	            idx[i, :k] = torch.arange(off, off + k)
    61	            gamma[i, :k] = rms.gamma.detach().float().cpu()
    62	            w[i, :k, :] = lin.weight.detach().float().cpu().t()
    63	            b[i, 0, :] = lin.bias.detach().float().cpu()
    64	            scale[i] = float(rms.scale)
    65	            off += k
    66	        assert off == total
    67	        self.n, self.kmax, self.total = n, kmax, total
    68	        self.register_buffer('idx', idx.to(dev), persistent=False)
    69	        self.register_buffer('gamma_pad', gamma.to(dev), persistent=False)
    70	        self.register_buffer('w_pad', w.to(dev), persistent=False)
    71	        self.register_buffer('b_pad', b.to(dev), persistent=False)
    72	        self.register_buffer('scale', scale.to(dev), persistent=False)
    73	
    74	    def forward(self, x):                      # (1, T, total)
    75	        assert x.shape[0] == 1 and x.shape[-1] == self.total
    76	        t = x.shape[1]
    77	        x_ext = torch.cat([x[0], x.new_zeros(t, 1)], dim=-1)   # (T, total+1)
    78	        xp = x_ext[:, self.idx]                                 # (T, n, kmax)
    79	        xp = xp.transpose(0, 1)                                 # (n, T, kmax)
    80	        xn = F.normalize(xp, dim=-1) * self.scale * self.gamma_pad[:, None, :]
    81	        y = torch.baddbmm(self.b_pad, xn, self.w_pad)           # (n, T, dim)
    82	        return y.transpose(0, 1).unsqueeze(0)                   # (1, T, n, dim)
    83	
    84	
    85	class PadBatchMaskEstimator(nn.Module):
