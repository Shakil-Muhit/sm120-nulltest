# Outputs land in evidence/ on the pod and are extracted off-pod BEFORE
# terminate — never committed from the pod (session-owner instruction).
evidence/*
!evidence/.gitkeep
# owner's audit sign-off — deliberate exception (2026-09-01); run outputs
# produced on the pod remain unversioned as before
!evidence/audit_log.md

# shakedown outputs (scripts/smoke.sh) — engineering data, never session evidence
evidence_smoke/

__pycache__/
*.pyc

# nsys artifacts if a trace is ever written outside evidence/ by accident
*.nsys-rep
*.sqlite

# torch.compile debug dumps (output_code is captured via TORCH_LOGS to evidence/)
torch_compile_debug/

# version-matrix venv (scripts/version_matrix_check.sh) if created repo-locally
.venv_latest/

# ceiling-ledger sessions: clip audio and generated code never committed
data/
fullmodel/**/generated/
pod.env
pod.env.extracted
